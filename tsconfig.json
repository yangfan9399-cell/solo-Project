{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./node_modules"]
  },
  "include": ["src", "app.config.ts"],
  "exclude": [
    "src/server/api.ts",
    "src/server/entry.ts",
    "dev-server.mjs",
    "build.mjs"
  ]
}
