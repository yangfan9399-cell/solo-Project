{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "#imports": [".nuxt/imports"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue", ".nuxt/nuxt.d.ts"],
  "exclude": ["node_modules", ".nuxt/dist", "dist"]
}