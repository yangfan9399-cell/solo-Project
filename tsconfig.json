{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["solid-start/env", "node"],
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "baseUrl": "."
  }
}
