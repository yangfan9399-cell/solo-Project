{
  "name": "fishway-flow-assessment",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--experimental-sqlite' remix vite:build",
    "dev": "NODE_OPTIONS='--experimental-sqlite' remix vite:dev",
    "start": "NODE_OPTIONS='--experimental-sqlite' remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "seed": "node --experimental-sqlite --loader ts-node/esm app/db/seed.ts"
  },
  "dependencies": {
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@remix-run/serve": "^2.15.0",
    "isbot": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.0",
    "@rollup/wasm-node": "^4.62.0",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6",
    "vite": "^5.1.0",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
