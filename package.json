{
  "name": "silent-film-title-card-game",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "db:init": "node ./scripts/init-db.js",
    "db:seed": "node ./scripts/seed-db.js",
    "setup": "npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "@remix-run/node": "^2.10.0",
    "@remix-run/react": "^2.10.0",
    "@remix-run/serve": "^2.10.0",
    "isbot": "^5.1.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@rollup/wasm-node": "^4.62.0",
    "rollup": "npm:@rollup/wasm-node@^4.62.0"
  }
}
