{
  "name": "content-topic-review-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n build,server -c magenta,cyan \"npm run dev:build\" \"npm run dev:server\"",
    "dev:build": "node esbuild.config.mjs",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client",
    "build:client": "NODE_ENV=production node esbuild.config.mjs && cp index.html dist/client/index.html",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tanstack/react-router": "^1.114.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.61.1"
  }
}
