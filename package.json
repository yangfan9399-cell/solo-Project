{
  "name": "mineral-thin-section-archive",
  "version": "1.0.0",
  "description": "稀有矿物薄片显微观察档案管理系统",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/node/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run build.server\" to build for production'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "init": "tsx src/server/init-db.ts",
    "preview": "qwik build preview && vite preview --open",
    "start": "node server/entry.express",
    "start.dev": "tsx src/server/init-db.ts && vite --mode ssr",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@builder.io/qwik": "^1.5.7",
    "@builder.io/qwik-city": "^1.5.7",
    "@types/express": "^5.0.6",
    "csv-stringify": "^6.5.0",
    "express": "^5.2.1",
    "marked": "^12.0.2",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@builder.io/qwik-react": "^0.5.7",
    "@rollup/wasm-node": "^4.62.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.12",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "undici": "^6.18.2",
    "vite": "^5.2.11",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
