{
	"name": "q-239",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"setup:rollup": "node scripts/setup-rollup.mjs",
		"postinstall": "node scripts/setup-rollup.mjs 2>/dev/null || echo 'Skipping rollup setup (non-fatal)'",
		"dev": "node scripts/run-vite.mjs dev",
		"build": "node scripts/run-vite.mjs build",
		"preview": "node scripts/run-vite.mjs preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && npx svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && npx svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate": "npx prisma migrate dev",
		"db:seed": "npx prisma db seed",
		"db:push": "npx prisma db push",
		"db:studio": "npx prisma studio",
		"db:generate": "npx prisma generate"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/kit": "^2.65.0",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@types/node": "^25.9.3",
		"@types/pg": "^8.20.0",
		"svelte": "^5.56.3",
		"svelte-check": "^3.8.6",
		"typescript": "^6.0.3",
		"vite": "^5.4.21"
	},
	"prisma": {
		"seed": "npx tsx prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^5.22.0",
		"@prisma/client": "^5.22.0",
		"@rollup/wasm-node": "^4.62.0",
		"dotenv": "^17.4.2",
		"pg": "^8.21.0",
		"prisma": "^5.22.0",
		"tsx": "^4.22.4"
	}
}
