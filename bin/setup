#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

def banner(text)
  puts ""
  puts "=" * 60
  puts "  #{text}"
  puts "=" * 60
end

FileUtils.chdir APP_ROOT do
  banner "微生物培养皿领地游戏 - 环境初始化"

  puts ""
  puts "📦 安装 Ruby 依赖到 vendor/bundle ..."
  system("bundle check") || system!("bundle install")

  if ARGV.include?("--reset")
    puts ""
    puts "� 重置数据库（删除+重建+加载种子） ..."
    system! "./bin/rails db:reset"
  else
    puts ""
    puts "�🗄️  准备数据库 ..."
    system! "./bin/rails db:prepare"
    # db:prepare 在首次创建时会自动加载 seed
    # 如果数据库已存在但没有种子数据，手动加载
    if ARGV.include?("--seed")
      db_existed = File.exist?("storage/development.sqlite3")
      if db_existed
        puts ""
        puts "🌱 加载验收种子数据（3个经典场景） ..."
        system! "./bin/rails db:seed"
      end
    end
  end

  puts ""
  puts "🧹 清理旧日志和临时文件 ..."
  system! "./bin/rails log:clear tmp:clear"

  banner "初始化完成！"

  puts ""
  puts "🚀 启动开发服务器:"
  puts "   ./bin/dev          # 默认端口 3000"
  puts "   ./bin/dev -p 3001  # 指定端口"
  puts ""
  puts "📋 其他常用命令:"
  puts "   ./bin/rails console       # Rails 控制台"
  puts "   ./bin/rails routes        # 查看所有路由"
  puts "   ./bin/rails db:seed       # 追加加载种子数据"
  puts "   ./bin/setup --reset       # 重置数据库并重新播种"
  puts "   ./bin/setup --seed        # 初始化并确保种子已加载"
  puts ""
end
