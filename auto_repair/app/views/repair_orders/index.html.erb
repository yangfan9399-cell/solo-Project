<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-3xl font-bold text-gray-900">维修单列表</h1>
    <%= link_to '新建维修单', new_repair_order_path, class: 'bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700' %>
  </div>

  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">单号</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">车辆</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">金额</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">质保返修</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @repair_orders.each do |order| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="font-mono text-sm"><%= order.order_number %></span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <%= order.vehicle&.full_name || '未分配' %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class(order.status) %>">
                <%= order.status_name %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              ¥<%= '%.2f' % order.total_amount %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if order.warranty_repair? %>
                <span class="text-orange-600 font-medium">是</span>
                <span class="text-xs text-gray-500">(原: <%= order.parent_order&.order_number %>)</span>
              <% else %>
                <span class="text-gray-400">否</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <%= link_to '查看', repair_order_path(order), class: 'text-blue-600 hover:text-blue-900' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
