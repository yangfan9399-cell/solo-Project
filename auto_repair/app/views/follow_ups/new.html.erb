<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">添加回访记录</h1>

  <div class="bg-white shadow sm:rounded-lg">
    <%= form_with model: [@repair_order, @follow_up] do |form| %>
      <div class="px-4 py-5 sm:p-6 space-y-4">
        <div>
          <%= form.label :follow_up_at, '回访时间', class: 'block text-sm font-medium text-gray-700' %>
          <%= form.datetime_field :follow_up_at, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
        </div>

        <div>
          <%= form.label :contact_method, '联系方式', class: 'block text-sm font-medium text-gray-700' %>
          <%= form.select :contact_method, %w[phone wechat sms email].map { |m| [I18n.t("contact_methods.#{m}", default: m.humanize), m] }, {}, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
        </div>

        <div>
          <%= form.label :satisfaction, '满意度', class: 'block text-sm font-medium text-gray-700' %>
          <%= form.select :satisfaction, %w[very_satisfied satisfied neutral dissatisfied very_dissatisfied].map { |s| [I18n.t("satisfactions.#{s}", default: s.humanize), s] }, {}, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
        </div>

        <div>
          <%= form.label :feedback, '客户反馈', class: 'block text-sm font-medium text-gray-700' %>
          <%= form.text_area :feedback, rows: 4, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
        </div>

        <div>
          <%= form.label :notes, '备注', class: 'block text-sm font-medium text-gray-700' %>
          <%= form.text_area :notes, rows: 2, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
        </div>

        <div class="flex items-center">
          <%= form.check_box :completed, class: 'rounded border-gray-300' %>
          <%= form.label :completed, '已完成回访', class: 'ml-2 text-sm text-gray-700' %>
        </div>
      </div>

      <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
        <%= link_to '取消', repair_order_path(@repair_order), class: 'text-gray-600 hover:text-gray-900 mr-4' %>
        <%= form.submit '保存', class: 'bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700' %>
      </div>
    <% end %>
  </div>
</div>
