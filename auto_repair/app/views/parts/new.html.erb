<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">添加配件</h1>

  <div class="bg-white shadow sm:rounded-lg">
    <%= form_with model: [@repair_order, @part] do |form| %>
      <div class="px-4 py-5 sm:p-6 space-y-4">
        <div>
          <%= form.label :name, '配件名称', class: 'block text-sm font-medium text-gray-700' %>
          <%= form.text_field :name, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :part_number, '零件号', class: 'block text-sm font-medium text-gray-700' %>
            <%= form.text_field :part_number, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
          </div>
          <div>
            <%= form.label :brand, '品牌', class: 'block text-sm font-medium text-gray-700' %>
            <%= form.text_field :brand, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :quantity, '数量', class: 'block text-sm font-medium text-gray-700' %>
            <%= form.number_field :quantity, step: '0.01', value: 1, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
          </div>
          <div>
            <%= form.label :unit_price, '单价(元)', class: 'block text-sm font-medium text-gray-700' %>
            <%= form.number_field :unit_price, step: '0.01', class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
          </div>
        </div>

        <div>
          <%= form.label :status, '状态', class: 'block text-sm font-medium text-gray-700' %>
          <%= form.select :status, %w[pending ordered out_of_stock available used].map { |s| [I18n.t("part_statuses.#{s}", default: s.humanize), s] }, {}, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
        </div>

        <div>
          <%= form.label :notes, '备注', class: 'block text-sm font-medium text-gray-700' %>
          <%= form.text_area :notes, rows: 2, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500' %>
        </div>
      </div>

      <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
        <%= link_to '取消', repair_order_path(@repair_order), class: 'text-gray-600 hover:text-gray-900 mr-4' %>
        <%= form.submit '保存', class: 'bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700' %>
      </div>
    <% end %>
  </div>
</div>
