<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "企业印章用印申请与归档审计系统" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Seal Audit System">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-slate-800 text-white shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <%= link_to root_path, class: "flex items-center space-x-2 text-white font-bold text-lg" do %>
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/>
              </svg>
              <span>印章审计系统</span>
            <% end %>
            <div class="hidden md:block ml-10">
              <div class="flex items-baseline space-x-4">
                <%= link_to "首页", root_path, class: "#{current_page?(root_path) ? 'bg-slate-900 text-white' : 'text-gray-300 hover:bg-slate-700 hover:text-white' } px-3 py-2 rounded-md text-sm font-medium" %>
                <%= link_to "用印申请", seal_applications_path, class: "#{current_page?(seal_applications_path) || controller_name == 'seal_applications' && action_name == 'show' ? 'bg-slate-900 text-white' : 'text-gray-300 hover:bg-slate-700 hover:text-white' } px-3 py-2 rounded-md text-sm font-medium" %>
                <%= link_to "复盘统计", dashboard_review_path, class: "#{current_page?(dashboard_review_path) ? 'bg-slate-900 text-white' : 'text-gray-300 hover:bg-slate-700 hover:text-white' } px-3 py-2 rounded-md text-sm font-medium" %>
              </div>
            </div>
          </div>
          <div class="text-sm text-gray-300">
            当前用户: <%= current_user&.name %> (<%= current_user&.role_name %>)
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
      <% if notice %>
        <div class="mb-4 p-4 bg-green-50 border border-green-200 text-green-700 rounded-lg">
          <%= notice %>
        </div>
      <% end %>
      <% if alert %>
        <div class="mb-4 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="bg-slate-800 text-gray-400 text-sm py-4 mt-auto">
      <div class="max-w-7xl mx-auto px-4 text-center">
        企业印章用印申请与归档审计系统 &copy; 2024
      </div>
    </footer>
  </body>
</html>
