<div class="max-w-3xl mx-auto">
  <div class="flex items-center space-x-3 mb-6">
    <%= link_to seal_applications_path, class: "text-gray-500 hover:text-gray-700" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900">新建用印申请</h1>
  </div>

  <div class="bg-white rounded-lg shadow">
    <%= form_with model: @seal_application, class: "p-6 space-y-6" do |f| %>
      <% if @seal_application.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-md p-4">
          <h3 class="text-sm font-medium text-red-800">请修正以下错误:</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% @seal_application.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :contract_id, "选择合同", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :contract_id, options_from_collection_for_select(@contracts, :id, :title), { include_blank: "请选择合同" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= f.label :seal_id, "选择印章", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :seal_id, options_from_collection_for_select(@seals, :id, ->(s) { "#{s.name} (#{s.type_name})" }), { include_blank: "请选择印章" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= f.label :use_count, "用印次数", class: "block text-sm font-medium text-gray-700" %>
        <%= f.number_field :use_count, min: 1, value: 1, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= f.label :purpose, "用印用途", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_area :purpose, rows: 4, placeholder: "请详细描述用印用途...", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div class="flex justify-end space-x-3 pt-4 border-t">
        <%= link_to "取消", seal_applications_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-md text-sm font-medium" %>
        <%= f.submit "创建申请", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md text-sm font-medium cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
