<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-900">复盘统计</h1>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">按部门统计</h2>
      </div>
      <div class="p-6">
        <% if @by_department.present? %>
          <div class="space-y-3">
            <% @by_department.each do |dept, count| %>
              <div class="flex items-center justify-between">
                <span class="text-gray-700"><%= dept %></span>
                <span class="font-semibold text-blue-600"><%= count %> 件</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="bg-blue-600 h-2 rounded-full" style="width: <%= (count.to_f / @by_department.values.max * 100) %>%"></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-gray-500 text-center py-4">暂无数据</div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">按印章类型统计</h2>
      </div>
      <div class="p-6">
        <% if @by_seal_type.present? %>
          <div class="space-y-3">
            <% @by_seal_type.each do |type, count| %>
              <div class="flex items-center justify-between">
                <span class="text-gray-700"><%= seal_type_name(type) %></span>
                <span class="font-semibold text-green-600"><%= count %> 件</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="bg-green-600 h-2 rounded-full" style="width: <%= (count.to_f / @by_seal_type.values.max * 100) %>%"></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-gray-500 text-center py-4">暂无数据</div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">异常原因统计</h2>
      </div>
      <div class="p-6">
        <% if @by_anomaly.present? %>
          <div class="space-y-3">
            <% @by_anomaly.each do |status, count| %>
              <div class="flex items-center justify-between">
                <span class="text-gray-700"><%= anomaly_name(status) %></span>
                <span class="font-semibold text-red-600"><%= count %> 件</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="bg-red-600 h-2 rounded-full" style="width: <%= (count.to_f / @by_anomaly.values.max * 100) %>%"></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-gray-500 text-center py-4">暂无异常数据</div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">审批时长统计</h2>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-gray-50 rounded-lg p-4 text-center">
            <div class="text-sm text-gray-500">平均时长</div>
            <div class="text-2xl font-bold text-blue-600 mt-1"><%= format_duration(@duration_stats[:avg]) %></div>
          </div>
          <div class="bg-gray-50 rounded-lg p-4 text-center">
            <div class="text-sm text-gray-500">样本数</div>
            <div class="text-2xl font-bold text-gray-700 mt-1"><%= @duration_stats[:count] %> 件</div>
          </div>
          <div class="bg-gray-50 rounded-lg p-4 text-center">
            <div class="text-sm text-gray-500">最短时长</div>
            <div class="text-2xl font-bold text-green-600 mt-1"><%= format_duration(@duration_stats[:min]) %></div>
          </div>
          <div class="bg-gray-50 rounded-lg p-4 text-center">
            <div class="text-sm text-gray-500">最长时长</div>
            <div class="text-2xl font-bold text-orange-600 mt-1"><%= format_duration(@duration_stats[:max]) %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">所有申请明细</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">申请编号</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">合同名称</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">印章类型</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">部门</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">审批时长</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">异常</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @seal_applications.each do |app| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= link_to "##{app.id}", app, class: "text-blue-600 hover:text-blue-900" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= app.contract.title %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= app.seal.type_name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= app.contract.department.name %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_badge_class(app.status) %>">
                  <%= app.status_name %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= format_duration(app.total_approval_duration) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <% if app.abnormal? %>
                  <span class="text-red-600 font-medium"><%= app.anomaly_type %></span>
                <% else %>
                  <span class="text-green-600">正常</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @seal_applications.empty? %>
        <div class="px-6 py-12 text-center text-gray-500">
          暂无数据
        </div>
      <% end %>
    </div>
  </div>
</div>
