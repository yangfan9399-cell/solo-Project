<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-900">用印申请概览</h1>
    <%= link_to "新建用印申请", new_seal_application_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-sm font-medium text-gray-500">总申请数</div>
      <div class="text-3xl font-bold text-gray-900 mt-1"><%= @stats[:total] %></div>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-sm font-medium text-gray-500">待处理</div>
      <div class="text-3xl font-bold text-yellow-600 mt-1"><%= @stats[:pending] %></div>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-sm font-medium text-gray-500">已完成</div>
      <div class="text-3xl font-bold text-green-600 mt-1"><%= @stats[:completed] %></div>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-sm font-medium text-gray-500">异常</div>
      <div class="text-3xl font-bold text-red-600 mt-1"><%= @stats[:abnormal] %></div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">最近申请</h2>
    </div>
    <div class="divide-y divide-gray-200">
      <% @seal_applications.each do |app| %>
        <%= link_to app, class: "block hover:bg-gray-50" do %>
          <div class="px-6 py-4 flex items-center justify-between">
            <div class="flex-1">
              <div class="flex items-center space-x-3">
                <span class="font-medium text-gray-900"><%= app.contract.title %></span>
                <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_badge_class(app.status) %>">
                  <%= app.status_name %>
                </span>
              </div>
              <div class="mt-1 text-sm text-gray-500">
                印章: <%= app.seal.name %> | 用途: <%= app.purpose.truncate(50) %> | 申请人: <%= app.applicant.name %>
              </div>
            </div>
            <div class="text-sm text-gray-400">
              <%= time_ago_in_words(app.created_at) %>前
            </div>
          </div>
        <% end %>
      <% end %>
      <% if @seal_applications.empty? %>
        <div class="px-6 py-12 text-center text-gray-500">
          暂无用印申请
        </div>
      <% end %>
    </div>
  </div>
</div>
