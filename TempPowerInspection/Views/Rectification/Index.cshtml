@model IEnumerable<Rectification>

@{
    ViewData["Title"] = "整改列表";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>整改列表</h2>
        <a class="btn btn-primary" asp-action="Create">新增整改</a>
    </div>

    <div class="card">
        <div class="card-body">
            <table id="dataTable" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>配电箱</th>
                        <th>隐患类型</th>
                        <th>整改要求</th>
                        <th>整改状态</th>
                        <th>完成时间</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td><strong>@item.HiddenDanger?.DistributionBoxName</strong></td>
                            <td>@item.HiddenDanger?.DangerType</td>
                            <td>@item.Requirement?.Substring(0, Math.Min(30, item.Requirement?.Length ?? 0))...</td>
                            <td>
                                @{
                                    var statusClass = item.Status switch
                                    {
                                        RectificationStatus.待整改 => "bg-secondary",
                                        RectificationStatus.整改中 => "bg-primary",
                                        RectificationStatus.待复检 => "bg-info",
                                        RectificationStatus.已通过 => "bg-success",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @statusClass">@item.StatusName</span>
                            </td>
                            <td>@item.CompletedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">详情</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">编辑</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/zh-Hans.json'
                }
            });
        });
    </script>
}
