@model IEnumerable<PowerApproval>

@{
    ViewData["Title"] = "送电审批列表";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>送电审批列表</h2>
    </div>

    <div class="card">
        <div class="card-body">
            <table id="dataTable" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>配电箱</th>
                        <th>楼栋</th>
                        <th>隐患类型</th>
                        <th>审批结果</th>
                        <th>审批人</th>
                        <th>审批时间</th>
                        <th>可否送电</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td><strong>@item.HiddenDanger?.DistributionBoxName</strong></td>
                            <td>@item.HiddenDanger?.BuildingName</td>
                            <td>@item.HiddenDanger?.DangerType</td>
                            <td>
                                <span class="badge @item.ApprovalResultCssClass">@item.ApprovalResultName</span>
                            </td>
                            <td>@item.ApprovedBy</td>
                            <td>@item.ApprovedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (item.CanPowerOn)
                                {
                                    <span class="badge bg-success">是</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">否</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">详情</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/zh-Hans.json'
                }
            });
        });
    </script>
}
