@model PowerApproval

@{
    ViewData["Title"] = "送电审批";
}

<div class="container">
    <h2>项目经理复核送电</h2>
    <hr />
    <div class="row">
        <div class="col-md-8">
            <div class="alert alert-info">
                <strong>配电箱：</strong>
                @Model.HiddenDanger?.DistributionBoxName - @Model.HiddenDanger?.DangerType
                (等级: <span class="badge @Model.HiddenDanger?.DangerLevelCssClass">@Model.HiddenDanger?.DangerLevelName</span>)
            </div>

            <div class="card mb-3">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">审批信息</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">隐患描述</dt>
                        <dd class="col-sm-9">@Model.HiddenDanger?.Description</dd>

                        <dt class="col-sm-3">整改反馈</dt>
                        <dd class="col-sm-9">@Model.HiddenDanger?.Rectification?.Feedback</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Approve" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="HiddenDangerId" />

                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">审批操作</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">审批人</label>
                            <input asp-for="ApprovedBy" class="form-control" placeholder="请输入项目经理姓名" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">审批意见</label>
                            <textarea name="Comment" class="form-control" rows="3" placeholder="填写审批意见"></textarea>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-success">审批通过</button>
                        <button type="button" class="btn btn-danger" onclick="rejectApproval()">退回</button>
                        <a asp-action="Index" class="btn btn-secondary">取消</a>
                    </div>
                </div>
            </form>

            <form id="rejectForm" asp-action="Reject" method="post" class="mt-3">
                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">退回操作</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">退回原因</label>
                            <textarea name="Comment" class="form-control" rows="2" placeholder="说明退回原因"></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger">确认退回</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function rejectApproval() {
            $('#rejectForm').toggle();
        }

        $(document).ready(function() {
            $('#rejectForm').hide();
        });
    </script>
}
