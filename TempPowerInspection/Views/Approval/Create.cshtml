@model PowerApproval

@{
    ViewData["Title"] = "项目经理审批";
    var danger = ViewBag.HiddenDanger as HiddenDanger;
}

<div class="container">
    <h2>项目经理复核送电审批</h2>
    <hr />

    @if (danger != null)
    {
        <div class="alert alert-info">
            <h5>隐患信息</h5>
            <dl class="row mb-0">
                <dt class="col-sm-3">配电箱</dt>
                <dd class="col-sm-9"><strong>@danger.DistributionBoxName</strong></dd>
                <dt class="col-sm-3">隐患类型</dt>
                <dd class="col-sm-9">@danger.DangerType</dd>
                <dt class="col-sm-3">隐患等级</dt>
                <dd class="col-sm-9"><span class="badge @danger.DangerLevelCssClass">@danger.DangerLevelName</span></dd>
                <dt class="col-sm-3">整改反馈</dt>
                <dd class="col-sm-9">@danger.Rectification?.Feedback</dd>
            </dl>
        </div>
    }

    <div class="row mt-3">
        <div class="col-md-6">
            <!-- 审批通过表单 -->
            <form asp-action="Create" method="post">
                <div class="card border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">审批通过</h5>
                    </div>
                    <div class="card-body">
                        <input type="hidden" asp-for="HiddenDangerId" value="@danger?.Id" />

                        <div class="mb-3">
                            <label class="form-label">审批人</label>
                            <input asp-for="ApprovedBy" class="form-control" placeholder="请输入项目经理姓名" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">审批意见</label>
                            <textarea asp-for="Comment" class="form-control" rows="2" placeholder="填写审批意见"></textarea>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle"></i> 审批通过
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-md-6">
            <!-- 退回表单 -->
            <form asp-action="CreateAndReject" method="post">
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">退回整改</h5>
                    </div>
                    <div class="card-body">
                        <input type="hidden" name="HiddenDangerId" value="@danger?.Id" />

                        <div class="mb-3">
                            <label class="form-label">审批人</label>
                            <input name="ApprovedBy" class="form-control" placeholder="请输入项目经理姓名" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">退回原因</label>
                            <textarea name="Comment" class="form-control" rows="2" placeholder="说明退回原因，施工班组需重新整改" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-x-circle"></i> 退回整改
                        </button>
                        <small class="text-muted mt-2 d-block">退回后禁止送电，施工班组需重新整改</small>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="HiddenDanger" asp-action="Details" asp-route-id="@danger?.Id" class="btn btn-secondary">返回详情</a>
    </div>
</div>