@model ApplicationListViewModel
@{
    ViewData["Title"] = "用水指标申请列表";
}

<div class="alert alert-info mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <strong>💡 数据同步说明：</strong>
            本页面"摘要"列、详情页"结论"、看板"状态分布/月度趋势"共用同一份数据源。
            修改关键字段（关键时间/责任对象/金额数量/证据结论）后，三处数据将同步刷新。
        </div>
        <a asp-action="EditKeyFields" asp-route-id="2" class="btn btn-sm btn-outline-primary">
            演示：修改 WQ-2026-002 关键字段 →
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card card-summary text-white bg-primary" onclick="location.href='@Url.Action("Index","Application",new { statusFilter = (ApplicationStatus?)null })'">
            <div class="card-body text-center">
                <div class="stat-number">@Model.TotalCount</div>
                <div>全部申请</div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card card-summary text-white bg-success" onclick="location.href='@Url.Action("Index","Application",new { sampleTypeFilter = SampleType.NormalPass })'">
            <div class="card-body text-center">
                <div class="stat-number">@Model.NormalCount</div>
                <div>正常放行</div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card card-summary text-white bg-danger" onclick="location.href='@Url.Action("Index","Application",new { sampleTypeFilter = SampleType.OverLimit })'">
            <div class="card-body text-center">
                <div class="stat-number">@Model.BlockedCount</div>
                <div>指标超限</div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card card-summary text-white bg-warning" onclick="location.href='@Url.Action("Index","Application",new { sampleTypeFilter = SampleType.MissingEvidence })'">
            <div class="card-body text-center">
                <div class="stat-number">@Model.ReturnedCount</div>
                <div>退回补证</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-summary text-white bg-danger" onclick="location.href='@Url.Action("Index","Application",new { sampleTypeFilter = SampleType.ApprovalTimeout })'">
            <div class="card-body text-center">
                <div class="stat-number">@Model.TimeoutCount</div>
                <div>审批超时</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">用水指标申请记录</h5>
            <form method="get" class="d-flex gap-2" asp-action="Index">
                <select name="statusFilter" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                    <option value="">全部状态</option>
                    @foreach (ApplicationStatus s in Enum.GetValues(typeof(ApplicationStatus)))
                    {
                        <option value="@((int)s)" selected="@(Model.StatusFilter == s)">@(WaterQuotaSystem.Services.WorkflowService.GetStatusDisplayName(s))</option>
                    }
                </select>
                <select name="sampleTypeFilter" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                    <option value="">全部类型</option>
                    @foreach (SampleType st in Enum.GetValues(typeof(SampleType)))
                    {
                        <option value="@((int)st)" selected="@(Model.SampleTypeFilter == st)">@(WaterQuotaSystem.Services.WorkflowService.GetSampleTypeDisplayName(st))</option>
                    }
                </select>
                <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control form-control-sm" placeholder="搜索编号/园区/申请人" style="width:200px" />
                <button type="submit" class="btn btn-sm btn-outline-primary">搜索</button>
            </form>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>申请编号</th>
                    <th>园区名称</th>
                    <th>申请人</th>
                    <th>关键对象</th>
                    <th>申请指标</th>
                    <th>限额</th>
                    <th>样本类型</th>
                    <th>状态</th>
                    <th>当前责任人</th>
                    <th>摘要</th>
                    <th>结论</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model.Applications)
                {
                    <tr>
                        <td><strong>@app.ApplicationNo</strong></td>
                        <td>@app.ParkName</td>
                        <td>@app.ApplicantName</td>
                        <td>@app.KeyObject</td>
                        <td>@app.AppliedQuota @app.QuotaUnit</td>
                        <td>@app.QuotaLimit @app.QuotaUnit</td>
                        <td>
                            <span class="badge @WaterQuotaSystem.Services.WorkflowService.GetSampleTypeCssClass(app.SampleType) badge-status">
                                @WaterQuotaSystem.Services.WorkflowService.GetSampleTypeDisplayName(app.SampleType)
                            </span>
                        </td>
                        <td>
                            <span class="badge @WaterQuotaSystem.Services.WorkflowService.GetStatusCssClass(app.Status) badge-status">
                                @WaterQuotaSystem.Services.WorkflowService.GetStatusDisplayName(app.Status)
                            </span>
                        </td>
                        <td>@app.CurrentResponsiblePerson</td>
                        <td><small class="text-muted">@app.Summary</small></td>
                        <td><small>@app.Conclusion</small></td>
                        <td>
                            <a asp-action="Detail" asp-route-id="@app.Id" class="btn btn-sm btn-outline-info">详情</a>
                            @if (!app.IsReadOnly)
                            {
                                <a asp-action="Process" asp-route-id="@app.Id" asp-route-role="1" class="btn btn-sm btn-outline-primary">处理</a>
                                <a asp-action="Process" asp-route-id="@app.Id" asp-route-role="2" class="btn btn-sm btn-outline-warning">复核</a>
                                <a asp-action="EditKeyFields" asp-route-id="@app.Id" class="btn btn-sm btn-outline-secondary">🔑改关键字段</a>
                            }
                            else
                            {
                                <a asp-action="Process" asp-route-id="@app.Id" asp-route-role="2" class="btn btn-sm btn-outline-dark">🔄重新处理</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
