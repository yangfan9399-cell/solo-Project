@model WaterQuotaApplication
@{
    ViewData["Title"] = "新建用水指标申请";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0">新建用水指标申请</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ParkName" class="form-label">园区名称</label>
                            <input asp-for="ParkName" class="form-control" required />
                            <span asp-validation-for="ParkName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ApplicantName" class="form-label">申请人</label>
                            <input asp-for="ApplicantName" class="form-control" required />
                            <span asp-validation-for="ApplicantName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ApplicantDepartment" class="form-label">申请部门</label>
                            <input asp-for="ApplicantDepartment" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Source" class="form-label">来源</label>
                            <select asp-for="Source" class="form-select">
                                <option value="线上申报系统">线上申报系统</option>
                                <option value="线下窗口提交">线下窗口提交</option>
                                <option value="电话预约">电话预约</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="AppliedQuota" class="form-label">申请指标(吨/月)</label>
                            <input asp-for="AppliedQuota" type="number" step="0.01" class="form-control" required />
                            <span asp-validation-for="AppliedQuota" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="QuotaLimit" class="form-label">限额(吨/月)</label>
                            <input asp-for="QuotaLimit" type="number" step="0.01" class="form-control" value="8000" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ApplicationDate" class="form-label">申请日期</label>
                            <input asp-for="ApplicationDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="KeyObject" class="form-label">关键对象</label>
                        <input asp-for="KeyObject" class="form-control" placeholder="如：A栋办公楼用水指标" required />
                        <span asp-validation-for="KeyObject" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Basis" class="form-label">采用依据</label>
                        <textarea asp-for="Basis" class="form-control" rows="2" placeholder="如：《城市供水管理条例》第12条">《城市供水管理条例》第12条；园区年度用水计划配额标准</textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BusinessRecord" class="form-label">业务记录</label>
                        <textarea asp-for="BusinessRecord" class="form-control" rows="3" placeholder="填写业务背景说明..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Deadline" class="form-label">审批截止日期</label>
                        <input asp-for="Deadline" type="date" class="form-control" value="@DateTime.Now.AddDays(5).ToString("yyyy-MM-dd")" />
                    </div>

                    <input type="hidden" asp-for="QuotaUnit" value="吨/月" />
                    <input type="hidden" asp-for="SampleType" value="0" />

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">提交申请</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
