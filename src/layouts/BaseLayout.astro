---
import '../styles/global.css';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = '考古探方出土层位关系编辑器', activeNav = 'home' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="layout">
      <header class="header">
        <div class="container header-content">
          <div class="logo">
            <div class="logo-icon">🏺</div>
            <span>地层关系编辑器</span>
          </div>
          <nav class="nav">
            <a href="/" class={`nav-item ${activeNav === 'home' ? 'active' : ''}`}>项目台账</a>
            <a href="/about" class={`nav-item ${activeNav === 'about' ? 'active' : ''}`}>使用说明</a>
          </nav>
        </div>
      </header>
      <main class="main">
        <div class="container">
          <slot />
        </div>
      </main>
      <footer style="padding: 20px 0; text-align: center; color: var(--color-text-muted); font-size: 12px; border-top: 1px solid var(--color-border);">
        <div class="container">
          考古探方出土层位关系编辑器 · 基于 Harris 矩阵原理
        </div>
      </footer>
    </div>
  </body>
</html>
