@model BunkerApplicationDetailViewModel
@{
    ViewData["Title"] = $"加注申请详情 - {Model.Application.ApplicationNo}";
    var app = Model.Application;
}

<h1 class="mb-4">加注申请详情 - @app.ApplicationNo</h1>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 mb-2">
                <span class="text-muted">来源：</span><strong>@app.ApplicationSource</strong>
            </div>
            <div class="col-md-3 mb-2">
                <span class="text-muted">当前责任人：</span><strong>@app.CurrentResponsiblePerson</strong>
                <span class="text-muted">(@app.CurrentResponsibleRole.GetDisplayName())</span>
            </div>
            <div class="col-md-3 mb-2">
                <span class="text-muted">状态：</span>
                @{
                    var statusCss = app.Status switch
                    {
                        WorkflowStatus.Received => "bg-primary",
                        WorkflowStatus.Processing => "bg-warning text-dark",
                        WorkflowStatus.UnderReview => "bg-purple",
                        WorkflowStatus.Archived => "bg-secondary",
                        _ => "bg-light text-dark"
                    };
                }
                <span class="badge @statusCss">@app.Status.GetDisplayName()</span>
            </div>
            <div class="col-md-3 mb-2">
                <span class="text-muted">分类：</span>
                @{
                    var categoryCss = app.Category switch
                    {
                        ApplicationCategory.NormalPass => "bg-success",
                        ApplicationCategory.IndicatorOverLimit => "bg-danger",
                        ApplicationCategory.EvidenceMissing => "bg-warning text-dark",
                        ApplicationCategory.ApprovalTimeout => "bg-dark",
                        _ => "bg-light text-dark"
                    };
                }
                <span class="badge @categoryCss">@app.Category.GetDisplayName()</span>
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-md-3 mb-2">
                <span class="text-muted">创建时间：</span>@app.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
            </div>
            <div class="col-md-3 mb-2">
                <span class="text-muted">更新时间：</span>@app.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold">关键信息</div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-2"><span class="text-muted">船名：</span>@app.ShipName</div>
            <div class="col-md-4 mb-2"><span class="text-muted">航次：</span>@app.VoyageNo</div>
            <div class="col-md-4 mb-2"><span class="text-muted">燃油类型：</span>@app.FuelType</div>
            <div class="col-md-4 mb-2"><span class="text-muted">申领量：</span>@app.OrderedQuantity.ToString("N2") MT</div>
            <div class="col-md-4 mb-2"><span class="text-muted">实际量：</span>@app.ActualQuantity.ToString("N2") MT</div>
            <div class="col-md-4 mb-2"><span class="text-muted">单价：</span>@app.UnitPrice.ToString("N4")</div>
            <div class="col-md-4 mb-2"><span class="text-muted">总金额：</span>@app.TotalAmount.ToString("N2")</div>
            <div class="col-md-4 mb-2"><span class="text-muted">加注日期：</span>@app.BunkerDate.ToString("yyyy-MM-dd")</div>
            <div class="col-md-4 mb-2"><span class="text-muted">加注港口：</span>@app.BunkerPort</div>
            <div class="col-md-4 mb-2"><span class="text-muted">供应商：</span>@app.SupplierName</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(app.BlockedReason))
{
    <div class="alert alert-danger mb-4">
        <strong>&#9888;&#65039; 阻断原因：</strong>@app.BlockedReason
        @if (!string.IsNullOrEmpty(app.RemediationPath))
        {
            <br />
            <span>补救路径：@app.RemediationPath</span>
        }
    </div>
}

@if (!string.IsNullOrEmpty(app.Basis))
{
    <div class="alert alert-info mb-4">
        <strong>采用依据：</strong>@app.Basis
    </div>
}

<div class="card mb-4">
    <div class="card-header fw-bold">处理前后差异</div>
    <div class="card-body">
        @if (Model.DiscrepancyFields.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>字段名称</th>
                            <th>原值</th>
                            <th>现值</th>
                            <th>修改人</th>
                            <th>修改时间</th>
                            <th>是否关键字段</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var df in Model.DiscrepancyFields)
                        {
                            <tr class="@(df.IsKeyField ? "table-warning" : "")">
                                <td>@df.FieldLabel</td>
                                <td>@df.OriginalValue</td>
                                <td>@df.CurrentValue</td>
                                <td>@df.ChangedBy</td>
                                <td>@df.ChangedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(df.IsKeyField ? "是" : "否")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">无差异记录</p>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold">证据附件</div>
    <div class="card-body">
        @if (Model.EvidenceAttachments.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>文件名</th>
                            <th>类型</th>
                            <th>描述</th>
                            <th>上传人</th>
                            <th>上传时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var att in Model.EvidenceAttachments)
                        {
                            <tr>
                                <td>@att.FileName</td>
                                <td>@att.FileType</td>
                                <td>@(att.Description ?? "-")</td>
                                <td>@att.UploadedBy</td>
                                <td>@att.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (app.Category == ApplicationCategory.EvidenceMissing)
        {
            <div class="alert alert-danger mb-0">&#9888;&#65039; 现场证据缺失，请补充证据附件</div>
        }
        else
        {
            <p class="text-muted mb-0">无附件</p>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold">所有历史节点</div>
    <div class="card-body">
        @if (Model.ProcessNodes.Any())
        {
            <div class="list-group">
                @foreach (var node in Model.ProcessNodes)
                {
                    <div class="list-group-item">
                        <div class="d-flex align-items-center mb-1">
                            <span class="badge bg-info me-2">@node.NodeType.GetDisplayName()</span>
                            <strong class="me-2">@node.OperatorName</strong>
                            <span class="text-muted me-2">(@node.OperatorRole.GetDisplayName())</span>
                            <span class="text-muted ms-auto">@node.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </div>
                        <div class="mb-1">
                            <span class="text-muted">动作：</span>@node.Action
                        </div>
                        @if (!string.IsNullOrEmpty(node.Comment))
                        {
                            <div class="mb-1">
                                <span class="text-muted">评论：</span>@node.Comment
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(node.BlockedReason))
                        {
                            <div class="text-danger mb-1">
                                <span>阻断原因：@node.BlockedReason</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(node.RemediationPath))
                        {
                            <div class="text-muted mb-1">
                                <span>补救路径：@node.RemediationPath</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted mb-0">无历史节点</p>
        }
    </div>
</div>

<div class="mb-4">
    @if (Model.CanProcess)
    {
        <a asp-action="Process" asp-route-id="@app.Id" asp-route-role="OnSitePersonnel" class="btn btn-primary me-2">前往处理台</a>
    }
    @if (Model.CanReview)
    {
        <a asp-action="Process" asp-route-id="@app.Id" asp-route-role="SupervisorReviewer" class="btn btn-primary me-2">前往处理台</a>
    }
    @if (Model.IsReadOnly && !Model.CanReprocess)
    {
        <span class="badge bg-secondary me-2">已归档 - 只读</span>
    }
    @if (Model.CanReprocess)
    {
        <a asp-action="Process" asp-route-id="@app.Id" asp-route-role="OnSitePersonnel" class="btn btn-warning me-2">重新处理</a>
        <span class="badge bg-secondary me-2">已归档</span>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
</div>

<style>
    .bg-purple {
        background-color: #6f42c1 !important;
        color: #fff;
    }
</style>
