generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HANDLER
  REVIEWER
  APPROVER
}

enum ClaimStatus {
  DRAFT
  MATERIALS_MISSING
  MATERIALS_SUPPLEMENTED
  UNDER_REVIEW
  LIABILITY_DISPUTE
  AMOUNT_EXCEEDED
  APPROVED
  PAID
  REJECTED
  ARCHIVED
  REOPENED
}

enum DocumentStatus {
  PENDING
  RECEIVED
  REJECTED
  SUPPLEMENT_REQUIRED
}

enum ReviewResult {
  PENDING
  APPROVED
  REJECTED
  SUPPLEMENT_REQUIRED
  DISPUTE
}

model User {
  id        String   @id @default(cuid())
  name      String
  role      UserRole
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handledClaims  Claim[] @relation("Handler")
  reviewedClaims Claim[] @relation("Reviewer")
  approvedClaims Claim[] @relation("Approver")
  reviews        Review[]
  historyNodes   HistoryNode[]
}

model Claim {
  id              String      @id @default(cuid())
  claimNo         String      @unique
  status          ClaimStatus @default(DRAFT)
  policyId        String
  policy          Policy      @relation(fields: [policyId], references: [id])
  accidentId      String
  accident        Accident    @relation(fields: [accidentId], references: [id])
  calculationId   String?
  calculation     Calculation? @relation(fields: [calculationId], references: [id])

  handlerId       String?
  handler         User?        @relation("Handler", fields: [handlerId], references: [id])
  reviewerId      String?
  reviewer        User?        @relation("Reviewer", fields: [reviewerId], references: [id])
  approverId      String?
  approver        User?        @relation("Approver", fields: [approverId], references: [id])

  description     String?
  isArchived      Boolean      @default(false)
  archiveReason   String?
  previousConclusion String?
  reopenedFrom    String?

  documents       Document[]
  reviews         Review[]
  historyNodes    HistoryNode[]
  disputeTerms    DisputeTerm[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Policy {
  id            String   @id @default(cuid())
  policyNo      String   @unique
  policyType    String
  insuredName   String
  insuredIdNo   String
  coverageAmount Decimal  @db.Decimal(12, 2)
  premium       Decimal  @db.Decimal(10, 2)
  effectiveDate DateTime
  expiryDate    DateTime
  beneficiary   String?
  remarks       String?

  claims        Claim[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Accident {
  id            String   @id @default(cuid())
  accidentType  String
  accidentDate  DateTime
  accidentLocation String
  description   String
  injuryLevel   String?
  damageAmount  Decimal? @db.Decimal(12, 2)
  policeReport  String?
  witness       String?

  claims        Claim[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Document {
  id            String         @id @default(cuid())
  claimId       String
  claim         Claim          @relation(fields: [claimId], references: [id])
  name          String
  type          String
  status        DocumentStatus @default(PENDING)
  receivedDate  DateTime?
  remarks       String?
  required      Boolean        @default(true)
  supplementReason String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Calculation {
  id              String   @id @default(cuid())
  totalLoss       Decimal  @db.Decimal(12, 2)
  deductible      Decimal  @db.Decimal(12, 2)
  coverageRatio   Decimal  @db.Decimal(5, 4)
  payableAmount   Decimal  @db.Decimal(12, 2)
  limitExceeded   Boolean  @default(false)
  limitAmount     Decimal? @db.Decimal(12, 2)
  calculationNote String?

  claims          Claim[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id          String       @id @default(cuid())
  claimId     String
  claim       Claim        @relation(fields: [claimId], references: [id])
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  stage       String
  result      ReviewResult @default(PENDING)
  opinion     String?
  isLiabilityConfirmed Boolean @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model HistoryNode {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  status    ClaimStatus
  remark    String?
  timestamp DateTime @default(now())

  createdAt DateTime @default(now())
}

model DisputeTerm {
  id                String   @id @default(cuid())
  claimId           String
  claim             Claim    @relation(fields: [claimId], references: [id])
  termClause        String
  termDescription   String
  disputeReason     String
  supplementPath    String
  isResolved        Boolean  @default(false)
  resolutionNote    String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
