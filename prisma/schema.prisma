generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  role      String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handledClaims  Claim[] @relation("Handler")
  reviewedClaims Claim[] @relation("Reviewer")
  approvedClaims Claim[] @relation("Approver")
  reviews        Review[]
  historyNodes   HistoryNode[]
}

model Claim {
  id                   String   @id @default(cuid())
  claimNo              String   @unique
  status               String   @default("DRAFT")
  policyId             String
  policy               Policy   @relation(fields: [policyId], references: [id])
  accidentId           String
  accident             Accident @relation(fields: [accidentId], references: [id])
  calculationId        String?
  calculation          Calculation? @relation(fields: [calculationId], references: [id])

  handlerId            String?
  handler              User?    @relation("Handler", fields: [handlerId], references: [id])
  reviewerId           String?
  reviewer             User?    @relation("Reviewer", fields: [reviewerId], references: [id])
  approverId           String?
  approver             User?    @relation("Approver", fields: [approverId], references: [id])

  description          String?
  isArchived           Boolean  @default(false)
  archiveReason        String?
  archiveDate          DateTime?
  previousConclusion   String?
  previousConclusionText String?
  reopenedFrom         String?
  reopenReason         String?
  reopenDate           DateTime?
  lastArchiveReason    String?

  documents            Document[]
  reviews              Review[]
  historyNodes         HistoryNode[]
  disputeTerms         DisputeTerm[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Policy {
  id             String   @id @default(cuid())
  policyNo       String   @unique
  policyType     String
  insuredName    String
  insuredIdNo    String
  coverageAmount Float
  premium        Float
  effectiveDate  DateTime
  expiryDate     DateTime
  beneficiary    String?
  remarks        String?

  claims         Claim[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Accident {
  id               String   @id @default(cuid())
  accidentType     String
  accidentDate     DateTime
  accidentLocation String
  description      String
  injuryLevel      String?
  damageAmount     Float?
  policeReport     String?
  witness          String?

  claims           Claim[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Document {
  id               String   @id @default(cuid())
  claimId          String
  claim            Claim    @relation(fields: [claimId], references: [id])
  name             String
  type             String
  status           String   @default("PENDING")
  receivedDate     DateTime?
  remarks          String?
  required         Boolean  @default(true)
  supplementReason String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Calculation {
  id              String   @id @default(cuid())
  totalLoss       Float
  deductible      Float
  coverageRatio   Float
  payableAmount   Float
  limitExceeded   Boolean  @default(false)
  limitAmount     Float?
  calculationNote String?

  claims          Claim[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id                   String   @id @default(cuid())
  claimId              String
  claim                Claim    @relation(fields: [claimId], references: [id])
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  stage                String
  result               String   @default("PENDING")
  opinion              String?
  isLiabilityConfirmed Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model HistoryNode {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  status    String
  remark    String?
  timestamp DateTime @default(now())

  createdAt DateTime @default(now())
}

model DisputeTerm {
  id                String   @id @default(cuid())
  claimId           String
  claim             Claim    @relation(fields: [claimId], references: [id])
  termClause        String
  termDescription   String
  disputeReason     String
  supplementPath    String
  isResolved        Boolean  @default(false)
  resolutionNote    String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
