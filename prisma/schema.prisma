generator client {
  provider  = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donations             DonationBatch[]    @relation("DonationCreator")
  inspections           Inspection[]
  stockEntries          StockEntry[]
  applications          Application[]      @relation("ApplicationApplicant")
  approvedApplications  Application[]      @relation("ApplicationApprover")
  distributions         Distribution[]
  reportedExceptions    ExceptionRecord[]  @relation("ExceptionReporter")
  processedExceptions   ExceptionRecord[]  @relation("ExceptionProcessor")
}

model DonationBatch {
  id          String   @id @default(cuid())
  batchNo     String   @unique
  donorName   String
  donorPhone  String?
  donorEmail  String?
  description String?
  status      String   @default("PENDING")
  totalItems  Int      @default(0)
  totalValue  Float    @default(0)
  receivedAt  DateTime @default(now())
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User           @relation(fields: [createdBy], references: [id], name: "DonationCreator")
  materials   DonationMaterial[]
  inspections Inspection[]
  stockEntries StockEntry[]
  exceptions  ExceptionRecord[]
}

model Material {
  id          String   @id @default(cuid())
  name        String
  category    String
  unit        String
  description String?
  specs       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  donations        DonationMaterial[]
  stock            Stock[]
  stockItems       StockEntryItem[]
  applicationItems ApplicationItem[]
  distributionItems DistributionItem[]
}

model DonationMaterial {
  id           String   @id @default(cuid())
  batchId      String
  materialId   String
  quantity     Int
  unitPrice    Float
  expiredAt    DateTime?
  remark       String?
  createdAt    DateTime @default(now())

  batch        DonationBatch @relation(fields: [batchId], references: [id])
  material     Material      @relation(fields: [materialId], references: [id])
  inspections  InspectionItem[]
  stockItems   StockEntryItem[]
}

model Inspection {
  id             String   @id @default(cuid())
  batchId        String
  inspectorId    String
  result         String
  remark         String?
  inspectionDate DateTime @default(now())
  createdAt      DateTime @default(now())

  batch        DonationBatch    @relation(fields: [batchId], references: [id])
  inspector    User             @relation(fields: [inspectorId], references: [id])
  items        InspectionItem[]
}

model InspectionItem {
  id                 String @id @default(cuid())
  inspectionId       String
  donationMaterialId String
  quantity           Int
  qualifiedQty       Int
  result             String
  remark             String?

  inspection       Inspection      @relation(fields: [inspectionId], references: [id])
  donationMaterial DonationMaterial @relation(fields: [donationMaterialId], references: [id])
}

model StockEntry {
  id        String   @id @default(cuid())
  entryNo   String   @unique
  batchId   String
  entryBy   String
  entryDate DateTime @default(now())
  remark    String?
  createdAt DateTime @default(now())

  batch DonationBatch  @relation(fields: [batchId], references: [id])
  user  User           @relation(fields: [entryBy], references: [id])
  items StockEntryItem[]
}

model StockEntryItem {
  id                String  @id @default(cuid())
  entryId           String
  donationMaterialId String
  materialId        String
  quantity          Int
  warehouseLocation String?

  entry            StockEntry      @relation(fields: [entryId], references: [id])
  donationMaterial DonationMaterial @relation(fields: [donationMaterialId], references: [id])
  material         Material        @relation(fields: [materialId], references: [id])
}

model Stock {
  id               String   @id @default(cuid())
  materialId       String
  quantity         Int      @default(0)
  reservedQty      Int      @default(0)
  availableQty     Int      @default(0)
  minWarningQty    Int      @default(10)
  maxWarningQty    Int?
  warehouseLocation String?
  updatedAt        DateTime @updatedAt

  material Material     @relation(fields: [materialId], references: [id])
  alerts   StockAlert[]

  @@unique([materialId, warehouseLocation])
}

model Recipient {
  id          String   @id @default(cuid())
  name        String
  idCard      String?
  phone       String?
  address     String?
  category    String?
  description String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
}

model Application {
  id            String   @id @default(cuid())
  appNo         String   @unique
  recipientId   String
  applicantId   String
  title         String
  description   String?
  status        String   @default("PENDING")
  appliedAt     DateTime @default(now())
  approvedAt    DateTime?
  approvedBy    String?
  approveRemark String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recipient    Recipient         @relation(fields: [recipientId], references: [id])
  applicant    User              @relation(fields: [applicantId], references: [id], name: "ApplicationApplicant")
  approver     User?             @relation(fields: [approvedBy], references: [id], name: "ApplicationApprover")
  items        ApplicationItem[]
  distributions Distribution[]
}

model ApplicationItem {
  id            String @id @default(cuid())
  applicationId String
  materialId    String
  requestedQty  Int
  approvedQty   Int?
  remark        String?

  application Application @relation(fields: [applicationId], references: [id])
  material    Material    @relation(fields: [materialId], references: [id])
}

model Distribution {
  id           String   @id @default(cuid())
  distNo       String   @unique
  applicationId String
  distributorId String
  status       String   @default("PREPARING")
  shippedAt    DateTime?
  deliveredAt  DateTime?
  signedAt     DateTime?
  signedBy     String?
  signImageUrl String?
  signRemark   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  application Application       @relation(fields: [applicationId], references: [id])
  distributor User              @relation(fields: [distributorId], references: [id])
  items       DistributionItem[]
  exceptions  ExceptionRecord[]
}

model DistributionItem {
  id             String @id @default(cuid())
  distributionId String
  materialId     String
  quantity       Int
  actualQty      Int?
  remark         String?

  distribution Distribution @relation(fields: [distributionId], references: [id])
  material     Material     @relation(fields: [materialId], references: [id])
}

model StockAlert {
  id         String   @id @default(cuid())
  stockId    String
  alertType  String
  message    String
  threshold  Int
  currentQty Int
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  stock Stock @relation(fields: [stockId], references: [id])
}

model ExceptionRecord {
  id             String   @id @default(cuid())
  exceptionNo    String   @unique
  type           String
  title          String
  description    String
  status         String   @default("OPEN")
  relatedBatchId String?
  relatedDistId  String?
  reportedBy     String
  processedBy    String?
  processedAt    DateTime?
  resolution     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reporter     User           @relation(fields: [reportedBy], references: [id], name: "ExceptionReporter")
  processor    User?          @relation(fields: [processedBy], references: [id], name: "ExceptionProcessor")
  batch        DonationBatch? @relation(fields: [relatedBatchId], references: [id])
  distribution Distribution?  @relation(fields: [relatedDistId], references: [id])
}
