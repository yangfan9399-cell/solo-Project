<div id="<%= dom_id project %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= project.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= project.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Pdf filename:</strong>
    <%= project.pdf_filename %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Total pages:</strong>
    <%= project.total_pages %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= project.status %>
  </div>
</div>
