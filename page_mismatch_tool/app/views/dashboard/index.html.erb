<% content_for :title, "仪表盘" %>
<% content_for :header_actions do %>
  <%= link_to new_project_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors" do %>
    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    新建项目
  <% end %>
<% end %>

<div class="space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0 p-3 bg-blue-100 rounded-lg">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-500">总项目数</p>
          <p class="text-2xl font-bold text-gray-900"><%= @total_projects %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0 p-3 bg-red-100 rounded-lg">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-500">未解决异常</p>
          <p class="text-2xl font-bold text-gray-900"><%= @total_anomalies %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0 p-3 bg-green-100 rounded-lg">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-500">已完成项目</p>
          <p class="text-2xl font-bold text-gray-900"><%= @projects_by_status["completed"] || 0 %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h3 class="text-base font-semibold text-gray-900">最近项目</h3>
        <%= link_to "查看全部", projects_path, class: "text-sm text-blue-600 hover:text-blue-800 font-medium" %>
      </div>
      <% if @recent_projects.any? %>
        <ul class="divide-y divide-gray-100">
          <% @recent_projects.each do |project| %>
            <li class="px-6 py-4 hover:bg-gray-50 transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex-1 min-w-0">
                  <%= link_to project.name, project, class: "text-sm font-medium text-gray-900 hover:text-blue-600 truncate block" %>
                  <p class="text-xs text-gray-500 mt-0.5"><%= project.pdf_filename.presence || "未上传PDF" %> · <%= project.total_pages.presence ? "#{project.total_pages}页" : "未设置页数" %></p>
                </div>
                <div class="ml-4 flex items-center space-x-2">
                  <%= project_status_badge(project.status) %>
                  <% if project.anomaly_count > 0 %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700"><%= project.anomaly_count %> 异常</span>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="px-6 py-12 text-center">
          <svg class="mx-auto w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          <p class="mt-2 text-sm text-gray-500">暂无项目</p>
          <%= link_to "创建第一个项目", new_project_path, class: "mt-3 inline-flex items-center text-sm text-blue-600 hover:text-blue-800 font-medium" %>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-base font-semibold text-gray-900">最近异常</h3>
      </div>
      <% if @recent_anomalies.any? %>
        <ul class="divide-y divide-gray-100">
          <% @recent_anomalies.each do |anomaly| %>
            <li class="px-6 py-3 hover:bg-gray-50 transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3 min-w-0 flex-1">
                  <%= anomaly_type_badge(anomaly.anomaly_type) %>
                  <p class="text-sm text-gray-700 truncate"><%= anomaly.description %></p>
                </div>
                <div class="ml-4 flex-shrink-0">
                  <span class="text-xs text-gray-400"><%= time_ago_in_words(anomaly.created_at) %>前</span>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="px-6 py-12 text-center">
          <svg class="mx-auto w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <p class="mt-2 text-sm text-gray-500">暂无未解决异常</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
