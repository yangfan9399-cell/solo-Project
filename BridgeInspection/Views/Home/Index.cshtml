@{
    ViewData["Title"] = "首页";
}

<div class="mb-4">
    <h2>📊 系统概览</h2>
    <p class="text-muted">公路桥梁巡检裂缝监测与维修闭环管理系统</p>
</div>

<div class="row mb-4">
    <div class="col-xl-2 col-md-4 mb-3">
        <div class="card bg-primary text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">病害总数</h6>
                        <h3 class="mb-0">@ViewBag.TotalDefects</h3>
                    </div>
                    <div class="display-5 opacity-50">📋</div>
                </div>
            </div>
            <div class="card-footer bg-primary bg-opacity-75">
                <a asp-controller="Defect" asp-action="Index" class="text-white text-decoration-none small">
                    查看详情 →
                </a>
            </div>
        </div>
    </div>

    <div class="col-xl-2 col-md-4 mb-3">
        <div class="card bg-warning text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">待处理</h6>
                        <h3 class="mb-0">@ViewBag.PendingDefects</h3>
                    </div>
                    <div class="display-5 opacity-50">⏳</div>
                </div>
            </div>
            <div class="card-footer bg-warning bg-opacity-75">
                <a asp-controller="Defect" asp-action="Index" class="text-white text-decoration-none small">
                    查看详情 →
                </a>
            </div>
        </div>
    </div>

    <div class="col-xl-2 col-md-4 mb-3">
        <div class="card bg-success text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">已销项</h6>
                        <h3 class="mb-0">@ViewBag.ClosedDefects</h3>
                    </div>
                    <div class="display-5 opacity-50">✅</div>
                </div>
            </div>
            <div class="card-footer bg-success bg-opacity-75">
                <a asp-controller="Defect" asp-action="Index" asp-route-status="6" class="text-white text-decoration-none small">
                    查看详情 →
                </a>
            </div>
        </div>
    </div>

    <div class="col-xl-2 col-md-4 mb-3">
        <div class="card bg-danger text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">结构性病害</h6>
                        <h3 class="mb-0">@ViewBag.StructuralDefects</h3>
                    </div>
                    <div class="display-5 opacity-50">⚠️</div>
                </div>
            </div>
            <div class="card-footer bg-danger bg-opacity-75">
                <a asp-controller="Defect" asp-action="Index" asp-route-severity="4" class="text-white text-decoration-none small">
                    查看详情 →
                </a>
            </div>
        </div>
    </div>

    <div class="col-xl-2 col-md-4 mb-3">
        <div class="card bg-info text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">桥梁总数</h6>
                        <h3 class="mb-0">@ViewBag.TotalBridges</h3>
                    </div>
                    <div class="display-5 opacity-50">🌉</div>
                </div>
            </div>
            <div class="card-footer bg-info bg-opacity-75">
                <a asp-controller="Bridge" asp-action="Index" class="text-white text-decoration-none small">
                    查看详情 →
                </a>
            </div>
        </div>
    </div>

    <div class="col-xl-2 col-md-4 mb-3">
        <div class="card bg-secondary text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">离线传感器</h6>
                        <h3 class="mb-0">@ViewBag.OfflineSensors</h3>
                    </div>
                    <div class="display-5 opacity-50">📡</div>
                </div>
            </div>
            <div class="card-footer bg-secondary bg-opacity-75">
                <span class="text-white small">需关注传感器状态</span>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">📝 近期病害</h5>
                <a asp-controller="Defect" asp-action="Index" class="btn btn-sm btn-outline-primary">查看全部</a>
            </div>
            <div class="card-body p-0">
                @{
                    var recentDefects = ViewBag.RecentDefects as IEnumerable<BridgeInspection.Models.Defect>;
                }
                @if (recentDefects != null && recentDefects.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>编号</th>
                                    <th>桥梁</th>
                                    <th>病害标题</th>
                                    <th>等级</th>
                                    <th>状态</th>
                                    <th>登记时间</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var defect in recentDefects)
                                {
                                    <tr onclick="location.href='@Url.Action("Details", "Defect", new { id = defect.Id })'" style="cursor: pointer;">
                                        <td>#@defect.Id</td>
                                        <td>@defect.Bridge?.Name</td>
                                        <td>@defect.Title</td>
                                        <td>
                                            @if (defect.Severity.HasValue)
                                            {
                                                var severityClass = defect.Severity.Value switch
                                                {
                                                    DefectSeverity.Slight => "badge bg-success",
                                                    DefectSeverity.Moderate => "badge bg-warning",
                                                    DefectSeverity.Severe => "badge bg-danger",
                                                    DefectSeverity.Structural => "badge bg-dark",
                                                    _ => "badge bg-secondary"
                                                };
                                                var severityText = defect.Severity.Value switch
                                                {
                                                    DefectSeverity.Slight => "轻微",
                                                    DefectSeverity.Moderate => "一般",
                                                    DefectSeverity.Severe => "严重",
                                                    DefectSeverity.Structural => "结构性",
                                                    _ => "未知"
                                                };
                                                <span class="@severityClass">@severityText</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">待评定</span>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                var statusText = defect.Status switch
                                                {
                                                    DefectStatus.PendingAssessment => "待评定",
                                                    DefectStatus.Assessing => "评定中",
                                                    DefectStatus.PendingMaintenance => "待维修",
                                                    DefectStatus.MaintenanceInProgress => "维修中",
                                                    DefectStatus.PendingAcceptance => "待验收",
                                                    DefectStatus.Closed => "已销项",
                                                    DefectStatus.Returned => "已退回",
                                                    _ => "未知"
                                                };
                                                var statusClass = defect.Status switch
                                                {
                                                    DefectStatus.PendingAssessment => "badge bg-secondary",
                                                    DefectStatus.Assessing => "badge bg-info",
                                                    DefectStatus.PendingMaintenance => "badge bg-warning",
                                                    DefectStatus.MaintenanceInProgress => "badge bg-primary",
                                                    DefectStatus.PendingAcceptance => "badge bg-info",
                                                    DefectStatus.Closed => "badge bg-success",
                                                    DefectStatus.Returned => "badge bg-danger",
                                                    _ => "badge bg-secondary"
                                                };
                                                <span class="@statusClass">@statusText</span>
                                            }
                                        </td>
                                        <td>@defect.ReportedAt.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <p class="text-muted mb-0">暂无病害数据</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">🔄 业务流程</h5>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column align-items-center">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <span class="h5 mb-0">1</span>
                    </div>
                    <p class="mt-2 mb-1 small">巡检员登记病害</p>
                    <div class="text-primary">↓</div>

                    <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <span class="h5 mb-0">2</span>
                    </div>
                    <p class="mt-2 mb-1 small">工程师评定等级</p>
                    <div class="text-primary">↓</div>

                    <div class="bg-warning text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <span class="h5 mb-0">3</span>
                    </div>
                    <p class="mt-2 mb-1 small">养护单位维修</p>
                    <div class="text-primary">↓</div>

                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <span class="h5 mb-0">4</span>
                    </div>
                    <p class="mt-2 mb-0 small">验收人销项/退回</p>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">⚡ 快捷操作</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @if (User.IsInRole("Inspector") || User.IsInRole("Admin"))
                    {
                        <a asp-controller="Defect" asp-action="Create" class="btn btn-primary">
                            ➕ 登记病害
                        </a>
                    }
                    <a asp-controller="Defect" asp-action="Index" asp-route-status="1" class="btn btn-outline-secondary">
                        📋 待评定病害
                    </a>
                    <a asp-controller="Defect" asp-action="Index" asp-route-status="3" class="btn btn-outline-warning">
                        🔧 待维修病害
                    </a>
                    <a asp-controller="Defect" asp-action="Index" asp-route-status="5" class="btn btn-outline-info">
                        ✅ 待验收病害
                    </a>
                    <a asp-controller="Statistics" asp-action="Index" class="btn btn-outline-success">
                        📊 复盘统计
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
