@model BridgeInspection.ViewModels.DefectReportViewModel
@{
    ViewData["Title"] = "登记病害";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Defect" asp-action="Index">病害管理</a></li>
            <li class="breadcrumb-item active" aria-current="page">登记病害</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">📝 病害登记</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Defect" asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="BridgeId" class="form-label">桥梁 <span class="text-danger">*</span></label>
                        <select asp-for="BridgeId" class="form-select">
                            <option value="">请选择桥梁</option>
                            @foreach (var bridge in Model.AvailableBridges!)
                            {
                                <option value="@bridge.Id">@bridge.Name - @bridge.RouteName</option>
                            }
                        </select>
                        <span asp-validation-for="BridgeId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">病害标题 <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="请输入病害标题，如：主梁底部裂缝" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LocationOnBridge" class="form-label">桥上位置</label>
                        <input asp-for="LocationOnBridge" class="form-control" placeholder="如：主跨L/4截面底板" />
                        <span asp-validation-for="LocationOnBridge" class="text-danger"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="CrackLength" class="form-label">裂缝长度 (米)</label>
                            <input asp-for="CrackLength" type="number" step="0.01" class="form-control" placeholder="如：0.25" />
                            <span asp-validation-for="CrackLength" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CrackWidth" class="form-label">裂缝宽度 (毫米)</label>
                            <input asp-for="CrackWidth" type="number" step="0.01" class="form-control" placeholder="如：0.08" />
                            <span asp-validation-for="CrackWidth" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CrackDepth" class="form-label">裂缝深度 (米)</label>
                            <input asp-for="CrackDepth" type="number" step="0.001" class="form-control" placeholder="如：0.015" />
                            <span asp-validation-for="CrackDepth" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CrackDirection" class="form-label">裂缝走向</label>
                        <input asp-for="CrackDirection" class="form-control" placeholder="如：横向、纵向、网状、斜向45度" />
                        <span asp-validation-for="CrackDirection" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">病害描述</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="请详细描述病害情况..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-controller="Defect" asp-action="Index" class="btn btn-secondary">取消</a>
                        <button type="submit" class="btn btn-primary">提交登记</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
