@model BridgeInspection.ViewModels.MaintenanceSubmitViewModel
@{
    ViewData["Title"] = "提交维修结果";
    var defect = ViewBag.Defect as BridgeInspection.Models.Defect;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Defect" asp-action="Index">病害管理</a></li>
            <li class="breadcrumb-item"><a asp-controller="Defect" asp-action="Details" asp-route-id="@Model.DefectId">病害详情</a></li>
            <li class="breadcrumb-item active" aria-current="page">提交维修结果</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="mb-0">🔧 提交维修结果</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <h6 class="alert-heading">📋 病害信息</h6>
                    <p class="mb-1"><strong>编号：</strong>#@defect?.Id</p>
                    <p class="mb-1"><strong>标题：</strong>@defect?.Title</p>
                    <p class="mb-1"><strong>桥梁：</strong>@defect?.Bridge?.Name</p>
                    <p class="mb-0">
                        <strong>等级：</strong>
                        @if (defect?.Severity.HasValue == true)
                        {
                            var severityText = defect.Severity.Value switch
                            {
                                DefectSeverity.Slight => "轻微",
                                DefectSeverity.Moderate => "一般",
                                DefectSeverity.Severe => "严重",
                                DefectSeverity.Structural => "结构性",
                                _ => "未知"
                            };
                            @severityText
                        }
                    </p>
                </div>

                <form asp-controller="Defect" asp-action="SubmitMaintenance" method="post">
                    <input type="hidden" asp-for="DefectId" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="MaintenanceStartedAt" class="form-label">维修开始时间</label>
                            <input asp-for="MaintenanceStartedAt" type="datetime-local" class="form-control" />
                            <span asp-validation-for="MaintenanceStartedAt" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MaintenanceCompletedAt" class="form-label">维修完成时间</label>
                            <input asp-for="MaintenanceCompletedAt" type="datetime-local" class="form-control" />
                            <span asp-validation-for="MaintenanceCompletedAt" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaintenanceDurationHours" class="form-label">维修耗时 (小时)</label>
                        <input asp-for="MaintenanceDurationHours" type="number" class="form-control" placeholder="留空将自动计算" />
                        <span asp-validation-for="MaintenanceDurationHours" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaintenancePlan" class="form-label">维修方案</label>
                        <textarea asp-for="MaintenancePlan" class="form-control" rows="4" placeholder="请描述维修方案..."></textarea>
                        <span asp-validation-for="MaintenancePlan" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaintenanceResult" class="form-label">维修结果 <span class="text-danger">*</span></label>
                        <textarea asp-for="MaintenanceResult" class="form-control" rows="6" placeholder="请详细描述维修结果..."></textarea>
                        <span asp-validation-for="MaintenanceResult" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-controller="Defect" asp-action="Details" asp-route-id="@Model.DefectId" class="btn btn-secondary">取消</a>
                        <button type="submit" class="btn btn-primary">提交维修结果</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
