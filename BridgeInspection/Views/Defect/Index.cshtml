@model IEnumerable<BridgeInspection.ViewModels.DefectListViewModel>
@{
    ViewData["Title"] = "病害管理";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2>📋 病害管理</h2>
    @if (User.IsInRole("Inspector") || User.IsInRole("Admin"))
    {
        <a asp-controller="Defect" asp-action="Create" class="btn btn-primary">
            ➕ 登记病害
        </a>
    }
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-controller="Defect" asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">状态</label>
                    <select name="status" class="form-select">
                        <option value="">全部状态</option>
                        <option value="1" selected="@(ViewBag.Status != null && ViewBag.Status == DefectStatus.PendingAssessment ? "selected" : null)">待评定</option>
                        <option value="2" selected="@(ViewBag.Status != null && ViewBag.Status == DefectStatus.Assessing ? "selected" : null)">评定中</option>
                        <option value="3" selected="@(ViewBag.Status != null && ViewBag.Status == DefectStatus.PendingMaintenance ? "selected" : null)">待维修</option>
                        <option value="4" selected="@(ViewBag.Status != null && ViewBag.Status == DefectStatus.MaintenanceInProgress ? "selected" : null)">维修中</option>
                        <option value="5" selected="@(ViewBag.Status != null && ViewBag.Status == DefectStatus.PendingAcceptance ? "selected" : null)">待验收</option>
                        <option value="6" selected="@(ViewBag.Status != null && ViewBag.Status == DefectStatus.Closed ? "selected" : null)">已销项</option>
                        <option value="7" selected="@(ViewBag.Status != null && ViewBag.Status == DefectStatus.Returned ? "selected" : null)">已退回</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">等级</label>
                    <select name="severity" class="form-select">
                        <option value="">全部等级</option>
                        <option value="1" selected="@(ViewBag.Severity != null && ViewBag.Severity == DefectSeverity.Slight ? "selected" : null)">轻微</option>
                        <option value="2" selected="@(ViewBag.Severity != null && ViewBag.Severity == DefectSeverity.Moderate ? "selected" : null)">一般</option>
                        <option value="3" selected="@(ViewBag.Severity != null && ViewBag.Severity == DefectSeverity.Severe ? "selected" : null)">严重</option>
                        <option value="4" selected="@(ViewBag.Severity != null && ViewBag.Severity == DefectSeverity.Structural ? "selected" : null)">结构性</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">桥梁</label>
                    <select name="bridgeId" class="form-select">
                        <option value="">全部桥梁</option>
                        @foreach (var bridge in ViewBag.Bridges)
                        {
                            <option value="@bridge.Id" selected="@(ViewBag.BridgeId != null && ViewBag.BridgeId == bridge.Id ? "selected" : null)">@bridge.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">搜索</label>
                    <input type="text" name="searchString" class="form-control" placeholder="输入关键词搜索" value="@ViewBag.SearchString" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">🔍 筛选</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>编号</th>
                            <th>桥梁</th>
                            <th>病害标题</th>
                            <th>位置</th>
                            <th>等级</th>
                            <th>状态</th>
                            <th>巡检员</th>
                            <th>登记时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.Id</strong></td>
                                <td>@item.BridgeName</td>
                                <td>@item.Title</td>
                                <td>@item.LocationOnBridge</td>
                                <td>
                                    @if (item.Severity.HasValue)
                                    {
                                        var severityClass = item.Severity.Value switch
                                        {
                                            DefectSeverity.Slight => "badge bg-success",
                                            DefectSeverity.Moderate => "badge bg-warning",
                                            DefectSeverity.Severe => "badge bg-danger",
                                            DefectSeverity.Structural => "badge bg-dark",
                                            _ => "badge bg-secondary"
                                        };
                                        var severityText = item.Severity.Value switch
                                        {
                                            DefectSeverity.Slight => "轻微",
                                            DefectSeverity.Moderate => "一般",
                                            DefectSeverity.Severe => "严重",
                                            DefectSeverity.Structural => "结构性",
                                            _ => "未知"
                                        };
                                        <span class="@severityClass">
                                            @if (item.IsUpgraded || item.RequiresStructuralReview)
                                            {
                                                <span class="me-1">⬆️</span>
                                            }
                                            @severityText
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">待评定</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var statusText = item.Status switch
                                        {
                                            DefectStatus.PendingAssessment => "待评定",
                                            DefectStatus.Assessing => "评定中",
                                            DefectStatus.PendingMaintenance => "待维修",
                                            DefectStatus.MaintenanceInProgress => "维修中",
                                            DefectStatus.PendingAcceptance => "待验收",
                                            DefectStatus.Closed => "已销项",
                                            DefectStatus.Returned => "已退回",
                                            _ => "未知"
                                        };
                                        var statusClass = item.Status switch
                                        {
                                            DefectStatus.PendingAssessment => "badge bg-secondary",
                                            DefectStatus.Assessing => "badge bg-info",
                                            DefectStatus.PendingMaintenance => "badge bg-warning",
                                            DefectStatus.MaintenanceInProgress => "badge bg-primary",
                                            DefectStatus.PendingAcceptance => "badge bg-info",
                                            DefectStatus.Closed => "badge bg-success",
                                            DefectStatus.Returned => "badge bg-danger",
                                            _ => "badge bg-secondary"
                                        };
                                        <span class="@statusClass">@statusText</span>
                                    }
                                </td>
                                <td>@item.ReporterName</td>
                                <td>@item.ReportedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <a asp-controller="Defect" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        详情
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted mb-3">暂无病害数据</p>
                @if (User.IsInRole("Inspector") || User.IsInRole("Admin"))
                {
                    <a asp-controller="Defect" asp-action="Create" class="btn btn-primary btn-sm">
                        ➕ 登记第一条病害
                    </a>
                }
            </div>
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">共 @ViewBag.TotalCount 条记录，第 @ViewBag.Page / @ViewBag.TotalPages 页</span>
    <nav>
        <ul class="pagination mb-0">
            @if (ViewBag.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Defect" asp-action="Index" 
                       asp-route-status="@ViewBag.Status" 
                       asp-route-severity="@ViewBag.Severity"
                       asp-route-bridgeId="@ViewBag.BridgeId"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-page="@(ViewBag.Page - 1)">上一页</a>
                </li>
            }
            @for (int i = 1; i <= ViewBag.TotalPages && i <= 10; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-controller="Defect" asp-action="Index"
                       asp-route-status="@ViewBag.Status" 
                       asp-route-severity="@ViewBag.Severity"
                       asp-route-bridgeId="@ViewBag.BridgeId"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-page="@i">@i</a>
                </li>
            }
            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Defect" asp-action="Index"
                       asp-route-status="@ViewBag.Status" 
                       asp-route-severity="@ViewBag.Severity"
                       asp-route-bridgeId="@ViewBag.BridgeId"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-page="@(ViewBag.Page + 1)">下一页</a>
                </li>
            }
        </ul>
    </nav>
</div>
