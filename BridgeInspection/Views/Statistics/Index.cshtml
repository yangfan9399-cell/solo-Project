@model BridgeInspection.ViewModels.StatisticsViewModel
@{
    ViewData["Title"] = "复盘统计";
}

<div class="mb-4">
    <h2>📊 复盘统计</h2>
    <p class="text-muted">按路线、桥型、病害等级和维修耗时聚合分析</p>
</div>

<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card bg-primary text-white h-100">
            <div class="card-body">
                <h6 class="card-title">病害总数</h6>
                <h3 class="mb-0">@Model.TotalDefects</h3>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card bg-success text-white h-100">
            <div class="card-body">
                <h6 class="card-title">已销项</h6>
                <h3 class="mb-0">@Model.ClosedDefects</h3>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card bg-warning text-white h-100">
            <div class="card-body">
                <h6 class="card-title">进行中</h6>
                <h3 class="mb-0">@Model.PendingDefects</h3>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card bg-info text-white h-100">
            <div class="card-body">
                <h6 class="card-title">销项率</h6>
                <h3 class="mb-0">
                    @(Model.TotalDefects > 0 
                        ? Math.Round((double)Model.ClosedDefects / Model.TotalDefects * 100, 1) 
                        : 0)%
                </h3>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">🛣️ 按路线统计</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.RouteStats != null && Model.RouteStats.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>路线名称</th>
                                    <th>病害数</th>
                                    <th>已销项</th>
                                    <th>平均维修耗时</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stat in Model.RouteStats)
                                {
                                    <tr>
                                        <td><strong>@stat.RouteName</strong></td>
                                        <td><span class="badge bg-primary">@stat.DefectCount</span></td>
                                        <td><span class="badge bg-success">@stat.ClosedCount</span></td>
                                        <td>
                                            @if (stat.AverageDurationHours > 0)
                                            {
                                                @Math.Round(stat.AverageDurationHours, 1) 小时
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-center text-muted py-4 mb-0">暂无数据</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">🌉 按桥型统计</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.BridgeTypeStats != null && Model.BridgeTypeStats.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>桥型</th>
                                    <th>病害数</th>
                                    <th>已销项</th>
                                    <th>销项率</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stat in Model.BridgeTypeStats)
                                {
                                    var typeName = stat.BridgeType switch
                                    {
                                        BridgeType.BeamBridge => "梁桥",
                                        BridgeType.ArchBridge => "拱桥",
                                        BridgeType.CableStayedBridge => "斜拉桥",
                                        BridgeType.SuspensionBridge => "悬索桥",
                                        BridgeType.TrussBridge => "桁架桥",
                                        BridgeType.BoxGirderBridge => "箱梁桥",
                                        _ => "未知"
                                    };
                                    var closeRate = stat.DefectCount > 0
                                        ? (double)stat.ClosedCount / stat.DefectCount * 100
                                        : 0;

                                    <tr>
                                        <td><strong>@typeName</strong></td>
                                        <td><span class="badge bg-primary">@stat.DefectCount</span></td>
                                        <td><span class="badge bg-success">@stat.ClosedCount</span></td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-success" role="progressbar" 
                                                     style="width: @closeRate%"
                                                     aria-valuenow="@closeRate" aria-valuemin="0" aria-valuemax="100">
                                                    @Math.Round(closeRate, 1)%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-center text-muted py-4 mb-0">暂无数据</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">⚠️ 按病害等级统计</h5>
            </div>
            <div class="card-body">
                @if (Model.SeverityStats != null && Model.SeverityStats.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var stat in Model.SeverityStats)
                        {
                            var severityText = stat.Severity switch
                            {
                                DefectSeverity.Slight => "轻微",
                                DefectSeverity.Moderate => "一般",
                                DefectSeverity.Severe => "严重",
                                DefectSeverity.Structural => "结构性",
                                _ => "未知"
                            };
                            var severityColor = stat.Severity switch
                            {
                                DefectSeverity.Slight => "success",
                                DefectSeverity.Moderate => "warning",
                                DefectSeverity.Severe => "danger",
                                DefectSeverity.Structural => "dark",
                                _ => "secondary"
                            };

                            <div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-bold">@severityText</span>
                                    <span>@stat.Count 个 | 销项率 @Math.Round(stat.CloseRate * 100, 1)%</span>
                                </div>
                                <div class="progress" style="height: 24px;">
                                    <div class="progress-bar bg-@severityColor" role="progressbar" 
                                         style="width: @(stat.CloseRate * 100)%"
                                         aria-valuenow="@(stat.CloseRate * 100)" aria-valuemin="0" aria-valuemax="100">
                                        @Math.Round(stat.CloseRate * 100, 1)%
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-center text-muted py-4 mb-0">暂无数据</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">⏱️ 按维修耗时统计</h5>
            </div>
            <div class="card-body">
                @if (Model.DurationStats != null && Model.DurationStats.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var stat in Model.DurationStats)
                        {
                            var maxCount = Model.DurationStats.Max(s => s.Count);
                            var percentage = maxCount > 0 ? (double)stat.Count / maxCount * 100 : 0;

                            <div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-bold">@stat.DurationRange</span>
                                    <span>@stat.Count 个</span>
                                </div>
                                <div class="progress" style="height: 24px;">
                                    <div class="progress-bar bg-info" role="progressbar" 
                                         style="width: @percentage%"
                                         aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                                        @stat.Count
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="mt-4 alert alert-info mb-0">
                        <small>
                            📌 <strong>说明：</strong>维修耗时统计仅包含已销项的病害，
                            按维修持续时间分布进行聚合分析。
                        </small>
                    </div>
                }
                else
                {
                    <p class="text-center text-muted py-4 mb-0">暂无数据</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">📈 统计说明</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <h6>📊 数据范围</h6>
                <ul class="text-muted mb-0">
                    <li>统计所有已登记的病害记录</li>
                    <li>销项率 = 已销项病害数 / 病害总数</li>
                    <li>平均维修耗时基于已完成维修的病害</li>
                </ul>
            </div>
            <div class="col-md-6 mb-3">
                <h6>⚠️ 等级说明</h6>
                <ul class="text-muted mb-0">
                    <li><span class="badge bg-success">轻微</span> - 表面细小裂缝</li>
                    <li><span class="badge bg-warning">一般</span> - 较明显裂缝</li>
                    <li><span class="badge bg-danger">严重</span> - 较大较深裂缝</li>
                    <li><span class="badge bg-dark">结构性</span> - 结构性病害，需升级处理</li>
                </ul>
            </div>
        </div>
    </div>
</div>
