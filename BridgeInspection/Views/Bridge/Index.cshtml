@model IEnumerable<BridgeInspection.Models.Bridge>
@{
    ViewData["Title"] = "桥梁信息";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2>🌉 桥梁信息</h2>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-controller="Bridge" asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">搜索</label>
                    <input type="text" name="searchString" class="form-control" placeholder="输入桥名、路线或位置搜索" value="@ViewBag.SearchString" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">🔍 搜索</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var bridge in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@bridge.Name</h5>
                        <span class="badge bg-light text-primary">
                            @(bridge.BridgeType switch
                            {
                                BridgeType.BeamBridge => "梁桥",
                                BridgeType.ArchBridge => "拱桥",
                                BridgeType.CableStayedBridge => "斜拉桥",
                                BridgeType.SuspensionBridge => "悬索桥",
                                BridgeType.TrussBridge => "桁架桥",
                                BridgeType.BoxGirderBridge => "箱梁桥",
                                _ => "未知"
                            })
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="mb-2"><span class="text-muted">路线：</span>@bridge.RouteName</p>
                        <p class="mb-2"><span class="text-muted">位置：</span>@bridge.Location</p>
                        <p class="mb-2"><span class="text-muted">长度：</span>@bridge.Length 米</p>
                        <p class="mb-2"><span class="text-muted">宽度：</span>@bridge.Width 米</p>
                        <p class="mb-0"><span class="text-muted">建成年份：</span>@bridge.BuildYear 年</p>
                    </div>
                    <div class="card-footer bg-light">
                        <a asp-controller="Bridge" asp-action="Details" asp-route-id="@bridge.Id" class="btn btn-outline-primary btn-sm w-100">
                            查看详情 →
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="text-center py-5">
                <p class="text-muted mb-0">暂无桥梁数据</p>
            </div>
        </div>
    }
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">共 @ViewBag.TotalCount 条记录，第 @ViewBag.Page / @ViewBag.TotalPages 页</span>
    <nav>
        <ul class="pagination mb-0">
            @if (ViewBag.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Bridge" asp-action="Index"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-page="@(ViewBag.Page - 1)">上一页</a>
                </li>
            }
            @for (int i = 1; i <= ViewBag.TotalPages && i <= 10; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-controller="Bridge" asp-action="Index"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-page="@i">@i</a>
                </li>
            }
            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Bridge" asp-action="Index"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-page="@(ViewBag.Page + 1)">下一页</a>
                </li>
            }
        </ul>
    </nav>
</div>
