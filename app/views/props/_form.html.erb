<%= form_with(model: prop, local: true) do |form| %>
  <% if prop.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h2 class="text-lg font-semibold text-red-800 mb-2">
        有 <%= prop.errors.count %> 个错误需要修正：
      </h2>
      <ul class="list-disc list-inside text-sm text-red-600">
        <% prop.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :name, "道具名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :name, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
    </div>

    <div>
      <%= form.label :code, "道具编号", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :code, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
    </div>

    <div>
      <%= form.label :category, "类别", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :category, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500", placeholder: "如：家具道具、瓷器道具" %>
    </div>

    <div>
      <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :status, Prop.statuses.keys.map { |s| [I18n.t("prop_statuses.#{s}", default: s.humanize), s] }, {}, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
    </div>

    <div>
      <%= form.label :value, "估值（元）", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :value, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
    </div>

    <div>
      <%= form.label :photo_url, "照片链接", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :photo_url, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500", placeholder: "可选" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :description, "描述", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :description, rows: 3, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :notes, "备注", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :notes, rows: 2, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
    </div>
  </div>

  <div class="mt-8 flex justify-end space-x-3">
    <%= link_to "取消", props_path, class: "px-6 py-2 border border-gray-300 rounded-lg hover:bg-gray-50" %>
    <%= form.submit class: "px-6 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 cursor-pointer" %>
  </div>
<% end %>
