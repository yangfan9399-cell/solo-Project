<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <%= link_to "← 返回道具详情", prop_path(@prop), class: "text-gray-500 hover:text-gray-700" %>
      <h1 class="text-2xl font-bold text-gray-900"><%= @prop.name %> - 检查记录</h1>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="divide-y divide-gray-200">
      <% @inspection_records.each do |record| %>
        <div class="px-6 py-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center space-x-3">
              <span class="px-3 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">
                <%= record.inspection_type_name %>
              </span>
              <span class="px-3 py-1 text-xs font-medium rounded-full <%= condition_badge_class(record.condition) %>">
                <%= record.condition_name %>
              </span>
            </div>
            <span class="text-sm text-gray-500"><%= format_datetime(record.created_at) %></span>
          </div>
          <p class="text-sm text-gray-600">
            检查人：<%= record.inspector&.name || "未知" %>
            <% if record.borrow_record.present? %>
              · 借调 ##{record.borrow_record.id}
            <% end %>
          </p>
          <% if record.notes.present? %>
            <p class="text-sm text-gray-600 mt-2"><%= record.notes %></p>
          <% end %>
          <% if record.issues_found.present? %>
            <p class="text-sm text-red-600 mt-1">发现问题：<%= record.issues_found %></p>
          <% end %>
        </div>
      <% end %>
      <% if @inspection_records.empty? %>
        <div class="px-6 py-12 text-center text-gray-500">
          暂无检查记录
        </div>
      <% end %>
    </div>
  </div>
</div>
