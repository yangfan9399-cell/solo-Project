<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <%= link_to "← 返回道具详情", prop_path(@prop), class: "text-gray-500 hover:text-gray-700" %>
      <h1 class="text-2xl font-bold text-gray-900"><%= @prop.name %> - 借调历史</h1>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">剧组</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">借调周期</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">申请人</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @borrow_records.each do |borrow| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <p class="font-medium"><%= borrow.crew.name %></p>
              <p class="text-sm text-gray-500"><%= borrow.crew.play_name %></p>
            </td>
            <td class="px-6 py-4">
              <p class="text-sm"><%= format_date(borrow.expected_start_date) %></p>
              <p class="text-sm text-gray-500">至 <%= format_date(borrow.expected_end_date) %></p>
            </td>
            <td class="px-6 py-4">
              <span class="px-3 py-1 text-xs font-medium rounded-full <%= status_badge_class(borrow.status) %>">
                <%= borrow.status_name %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= borrow.applicant&.name || "-" %>
            </td>
            <td class="px-6 py-4 text-right text-sm font-medium">
              <%= link_to "详情", borrow_record_path(borrow), class: "text-amber-600 hover:text-amber-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @borrow_records.empty? %>
      <div class="px-6 py-12 text-center text-gray-500">
        暂无借调记录
      </div>
    <% end %>
  </div>
</div>
