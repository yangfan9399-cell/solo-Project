<% content_for :title, "新建记录 - #{@project.name}" %>
<% content_for :page_title, "新建记录" %>
<% content_for :page_subtitle, @project.name %>

<div class="max-w-3xl mx-auto">
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
    <%= form_with model: @record, url: project_records_path(@project) do |form| %>
      <div class="p-6 space-y-6">
        <% if @record.errors.any? %>
          <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
            <h4 class="text-sm font-medium text-red-800">请修正以下错误：</h4>
            <ul class="mt-2 text-sm text-red-600 list-disc list-inside">
              <% @record.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :batch_number, "批次号", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
            <%= form.text_field :batch_number, placeholder: "如：2024-S-001", class: "w-full h-10 px-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent font-mono" %>
          </div>
          <div>
            <%= form.label :record_date, "记录日期", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
            <%= form.date_field :record_date, class: "w-full h-10 px-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :version_type, "版本类型", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
            <%= form.select :version_type, options_for_select([["普查", "survey"], ["复查", "review"], ["专项", "special"]], @record.version_type), {}, class: "w-full h-10 px-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          </div>
          <div>
            <%= form.label :photographer, "拍摄者", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
            <%= form.text_field :photographer, class: "w-full h-10 px-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          </div>
        </div>

        <div>
          <%= form.label :image_url, "图像地址", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= form.text_field :image_url, placeholder: "高精度图像 URL", class: "w-full h-10 px-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          <p class="mt-1 text-xs text-slate-500">支持 SVG、PNG 等高精度图像，建议使用带坐标的正射影像</p>
        </div>

        <div class="grid grid-cols-3 gap-4">
          <div>
            <%= form.label :weather, "天气", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
            <%= form.text_field :weather, placeholder: "晴/阴/雨", class: "w-full h-10 px-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          </div>
          <div>
            <%= form.label :temperature, "温度 (°C)", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
            <%= form.number_field :temperature, step: "0.1", class: "w-full h-10 px-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          </div>
          <div>
            <%= form.label :humidity, "湿度 (%)", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
            <%= form.number_field :humidity, step: "0.1", class: "w-full h-10 px-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          </div>
        </div>

        <div>
          <%= form.label :observer, "观察者", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= form.text_field :observer, class: "w-full h-10 px-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
        </div>

        <div>
          <%= form.label :notes, "备注", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= form.text_area :notes, rows: 3, class: "w-full px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
        </div>
      </div>

      <div class="p-4 bg-slate-50 border-t border-slate-200 rounded-b-xl flex justify-end gap-3">
        <%= link_to "取消", project_path(@project), class: "px-4 py-2 text-sm text-slate-600 hover:text-slate-800" %>
        <%= form.submit "创建并开始标注", class: "px-4 py-2 bg-amber-600 text-white text-sm font-medium rounded-lg hover:bg-amber-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
