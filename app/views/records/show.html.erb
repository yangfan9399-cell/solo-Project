<% content_for :title, "#{@record.batch_number} - 记录详情" %>
<% content_for :page_title, "记录详情" %>
<% content_for :page_subtitle, "#{@project.name} · #{@record.batch_number}" %>

<div class="space-y-6">
  <div class="flex items-start justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-slate-900"><%= @record.batch_number %></h1>
        <% type_class = { survey: "bg-blue-100 text-blue-700", review: "bg-emerald-100 text-emerald-700", special: "bg-purple-100 text-purple-700" }[@record.version_type.to_sym] %>
        <span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full <%= type_class %>">
          <%= @record.version_type_i18n %>
        </span>
        <% if @record.abnormal? %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-amber-700 bg-amber-50 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            数据异常
          </span>
        <% end %>
      </div>
      <div class="flex items-center gap-4 mt-2 text-sm text-slate-500">
        <span>记录日期: <%= @record.record_date %></span>
        <span>·</span>
        <span>拍摄者: <%= @record.photographer || "未知" %></span>
        <span>·</span>
        <span>观察者: <%= @record.observer || "未知" %></span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to project_path(@project), class: "inline-flex items-center gap-2 px-4 py-2 border border-slate-200 text-slate-700 text-sm rounded-lg hover:bg-slate-50" do %>
        ← 返回项目
      <% end %>
      <%= link_to editor_project_record_path(@project, @record), class: "inline-flex items-center gap-2 px-4 py-2 bg-amber-600 text-white text-sm rounded-lg hover:bg-amber-700" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        编辑标注
      <% end %>
    </div>
  </div>

  <% if @record.abnormal? %>
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
      <div class="flex items-start gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div>
          <h4 class="font-medium text-amber-800">异常数据提示</h4>
          <p class="text-sm text-amber-700 mt-1"><%= @record.abnormal_reasons.join("、") %></p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-3 gap-6">
    <div class="col-span-2 space-y-6">
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-200 flex items-center justify-between">
          <h3 class="font-semibold text-slate-800">壁画图像</h3>
          <%= link_to "在编辑器中查看", editor_project_record_path(@project, @record), class: "text-sm text-amber-600 hover:text-amber-700" %>
        </div>
        <div class="bg-slate-900 p-8 flex items-center justify-center">
          <% if @record.image_url.present? %>
            <img src="<%= @record.image_url %>" alt="壁画图像" class="max-w-full max-h-96 rounded shadow-lg">
          <% else %>
            <div class="w-full h-72 bg-gradient-to-br from-amber-700/30 to-amber-900/30 rounded-lg flex items-center justify-center border border-amber-600/30">
              <div class="text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-amber-500/50 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="text-amber-400/70 text-sm">暂无高精度图像</p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="p-4 border-b border-slate-200 flex items-center justify-between">
          <h3 class="font-semibold text-slate-800">病害标注</h3>
          <span class="text-sm text-slate-400"><%= @annotations.size %> 处</span>
        </div>
        <% if @annotations.any? %>
          <div class="divide-y divide-slate-100">
            <% @annotations.each do |ann| %>
              <div class="p-4 hover:bg-slate-50">
                <div class="flex items-start justify-between">
                  <div class="flex items-start gap-3">
                    <span class="w-4 h-4 rounded-sm mt-0.5 shrink-0" style="background-color: <%= ann.color_hex %>"></span>
                    <div>
                      <div class="flex items-center gap-2">
                        <span class="font-medium text-slate-800"><%= ann.disease_type_i18n %></span>
                        <% sev_cls = { mild: "text-emerald-600 bg-emerald-50", moderate: "text-amber-600 bg-amber-50", severe: "text-red-600 bg-red-50" }[ann.severity.to_sym] %>
                        <span class="px-2 py-0.5 text-xs font-medium rounded <%= sev_cls %>"><%= ann.severity_i18n %></span>
                      </div>
                      <p class="text-sm text-slate-500 mt-1">
                        位置: (<%= ann.x %>, <%= ann.y %>) · 尺寸: <%= ann.width %> × <%= ann.height %> px
                      </p>
                      <% if ann.description.present? %>
                        <p class="text-sm text-slate-600 mt-2"><%= ann.description %></p>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-8 text-center">
            <p class="text-slate-400 text-sm">暂无病害标注</p>
            <%= link_to "添加标注", editor_project_record_path(@project, @record), class: "text-amber-600 hover:text-amber-700 text-sm mt-2 inline-block" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="p-4 border-b border-slate-200">
          <h3 class="font-semibold text-slate-800">记录信息</h3>
        </div>
        <div class="p-4 space-y-3 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-500">批次号</span>
            <span class="text-slate-800 font-mono"><%= @record.batch_number %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">记录日期</span>
            <span class="text-slate-800"><%= @record.record_date %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">版本类型</span>
            <span class="text-slate-800"><%= @record.version_type_i18n %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">拍摄者</span>
            <span class="text-slate-800"><%= @record.photographer || "-" %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">观察者</span>
            <span class="text-slate-800"><%= @record.observer || "-" %></span>
          </div>
          <div class="border-t border-slate-100 pt-3">
            <div class="flex justify-between">
              <span class="text-slate-500">天气</span>
              <span class="text-slate-800"><%= @record.weather || "-" %></span>
            </div>
            <div class="flex justify-between mt-2">
              <span class="text-slate-500">温度</span>
              <span class="text-slate-800"><%= @record.temperature ? "#{@record.temperature}°C" : "-" %></span>
            </div>
            <div class="flex justify-between mt-2">
              <span class="text-slate-500">湿度</span>
              <span class="text-slate-800"><%= @record.humidity ? "#{@record.humidity}%" : "-" %></span>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="p-4 border-b border-slate-200">
          <h3 class="font-semibold text-slate-800">病害统计</h3>
        </div>
        <div class="p-4 space-y-3">
          <% disease_counts = @record.disease_count_by_type %>
          <% [["flaking", "起甲", "#ef4444"], ["efflorescence", "酥碱", "#f59e0b"], ["discoloration", "变色", "#8b5cf6"], ["crack", "裂隙", "#3b82f6"], ["other", "其他", "#6b7280"]].each do |type, label, color| %>
            <% count = disease_counts[type] || 0 %>
            <div>
              <div class="flex items-center justify-between mb-1">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-sm" style="background-color: <%= color %>"></span>
                  <span class="text-sm text-slate-600"><%= label %></span>
                </div>
                <span class="text-sm font-medium text-slate-800"><%= count %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <% if @scale_markers.any? %>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
          <div class="p-4 border-b border-slate-200">
            <h3 class="font-semibold text-slate-800">尺度标记</h3>
          </div>
          <div class="p-4 space-y-2 text-sm">
            <% @scale_markers.each do |marker| %>
              <div class="flex items-center justify-between p-2 bg-emerald-50 rounded">
                <span class="text-emerald-700"><%= marker.length_cm %> cm 尺度尺</span>
                <span class="text-emerald-600 text-xs"><%= marker.length_pixels %> px</span>
              </div>
            <% end %>
            <p class="text-xs text-slate-500 mt-2">
              比例尺: 1cm ≈ <%= (@scale_markers.first.length_pixels / @scale_markers.first.length_cm).round(1) %> px
            </p>
          </div>
        </div>
      <% end %>

      <% if @record.notes.present? %>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
          <div class="p-4 border-b border-slate-200">
            <h3 class="font-semibold text-slate-800">备注</h3>
          </div>
          <div class="p-4">
            <p class="text-sm text-slate-600 leading-relaxed"><%= @record.notes %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
