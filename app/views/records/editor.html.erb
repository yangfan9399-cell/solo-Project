<% content_for :title, "标注编辑 - #{@record.batch_number}" %>
<% content_for :page_title, "标注工作台" %>
<% content_for :page_subtitle, "#{@project.name} · #{@record.batch_number}" %>

<div class="h-[calc(100vh-140px)] flex gap-4" data-controller="annotation-editor" data-annotation-editor-project-id-value="<%= @project.id %>" data-annotation-editor-record-id-value="<%= @record.id %>" data-annotation-editor-csrf-token-value="<%= form_authenticity_token %>">
  <div class="w-64 bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col shrink-0">
    <div class="p-4 border-b border-slate-200">
      <h3 class="font-semibold text-slate-800 text-sm">标注工具</h3>
    </div>

    <div class="flex-1 overflow-y-auto p-4 space-y-5">
      <div>
        <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">病害类型</label>
        <div class="mt-2 space-y-1.5">
          <% [
            ["flaking", "起甲", "#ef4444", "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"],
            ["efflorescence", "酥碱", "#f59e0b", "M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"],
            ["discoloration", "变色", "#8b5cf6", "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"],
            ["crack", "裂隙", "#3b82f6", "M4 20L20 4M4 4l16 16"],
            ["other", "其他", "#6b7280", "M12 6v6m0 0v6m0-6h6m-6 0H6"]
          ].each do |type, label, color, icon_path| %>
            <button type="button" class="tool-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50 transition-colors" data-tool="rectangle" data-disease="<%= type %>" data-color="<%= color %>">
              <span class="w-3 h-3 rounded-sm" style="background-color: <%= color %>"></span>
              <span class="flex-1 text-left"><%= label %></span>
              <span class="text-xs text-slate-400"><%= @annotations.select { |a| a.disease_type == type }.size %></span>
            </button>
          <% end %>
        </div>
      </div>

      <div class="border-t border-slate-100 pt-4">
        <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">严重程度</label>
        <div class="mt-2 flex gap-1">
          <% [["mild", "轻微", "bg-emerald-100 text-emerald-700"], ["moderate", "中等", "bg-amber-100 text-amber-700"], ["severe", "重度", "bg-red-100 text-red-700"]].each do |sev, label, cls| %>
            <button type="button" class="severity-btn flex-1 py-1.5 text-xs font-medium rounded-md transition-colors <%= sev == 'moderate' ? cls + ' ring-2 ring-offset-1 ring-slate-300' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>" data-severity="<%= sev %>">
              <%= label %>
            </button>
          <% end %>
        </div>
      </div>

      <div class="border-t border-slate-100 pt-4">
        <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">操作工具</label>
        <div class="mt-2 space-y-1.5">
          <button type="button" class="tool-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50" data-tool="select">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
            </svg>
            <span>选择/移动</span>
          </button>
          <button type="button" class="tool-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50" data-tool="scale">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
            </svg>
            <span>添加尺度尺</span>
          </button>
        </div>
      </div>

      <div class="border-t border-slate-100 pt-4">
        <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">视图控制</label>
        <div class="mt-2 flex items-center gap-2">
          <button type="button" id="zoom-out" class="flex-1 py-2 text-sm text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200">−</button>
          <span id="zoom-level" class="text-xs text-slate-500 w-12 text-center">100%</span>
          <button type="button" id="zoom-in" class="flex-1 py-2 text-sm text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200">+</button>
        </div>
        <button type="button" id="fit-view" class="w-full mt-2 py-1.5 text-xs text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200">
          适应窗口
        </button>
      </div>
    </div>

    <div class="p-4 border-t border-slate-200 space-y-2">
      <div id="annotation-count-info" class="text-xs text-slate-500">
        <span>标注总数:</span>
        <span class="font-medium text-slate-700"><%= @annotations.size %></span>
        <span class="mx-2">·</span>
        <span>尺度尺:</span>
        <span class="font-medium text-slate-700"><%= @scale_markers.size %></span>
      </div>
      <% if @record.abnormal? %>
        <div class="text-xs text-amber-600 bg-amber-50 px-2 py-1 rounded">
          ⚠ <%= @record.abnormal_reasons.join("、") %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex-1 bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden">
    <div class="h-12 px-4 border-b border-slate-200 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-4 text-sm">
        <span class="text-slate-500">批次: <span class="text-slate-800 font-mono"><%= @record.batch_number %></span></span>
        <span class="text-slate-500">日期: <span class="text-slate-800"><%= @record.record_date %></span></span>
        <span class="text-slate-500">类型: <span class="text-slate-800"><%= @record.version_type_i18n %></span></span>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to "返回详情", project_record_path(@project, @record), class: "text-sm text-slate-600 hover:text-slate-800" %>
      </div>
    </div>

    <div id="canvas-container" class="flex-1 overflow-hidden bg-slate-900 relative cursor-crosshair relative">
      <div id="canvas-wrapper" class="absolute inset-0 flex items-center justify-center overflow-hidden">
        <div id="canvas-content" class="relative" style="transform-origin: center center;">
          <% if @record.image_url.present? %>
            <img id="base-image" src="<%= @record.image_url %>" alt="壁画图像" class="max-w-none select-none pointer-events-none">
          <% else %>
            <svg id="base-image" width="1200" height="800" class="max-w-none select-none" style="background: linear-gradient(135deg, #d4a574 0%, #c4956a 50%, #b8865a 100%);">
              <defs>
                <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(0,0,0,0.1)" stroke-width="0.5"/>
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill="url(#grid)" />
              <text x="50%" y="50%" text-anchor="middle" dy=".3em" fill="rgba(255,255,255,0.5)" font-size="24" font-family="sans-serif">
                壁画高精度图像区域（示例）
              </text>
            </svg>
          <% end %>

          <div id="annotations-layer" class="absolute inset-0 pointer-events-none">
            <% @annotations.each do |ann| %>
              <div class="annotation-box absolute border-2 cursor-pointer pointer-events-auto"
                   data-id="<%= ann.id %>"
                   data-disease="<%= ann.disease_type %>"
                   data-severity="<%= ann.severity %>"
                   data-description="<%= ann.description %>"
                   style="left: <%= ann.x %>px; top: <%= ann.y %>px; width: <%= ann.width %>px; height: <%= ann.height %>px; border-color: <%= ann.color_hex %>; background-color: <%= ann.color_hex %>20;">
                <div class="absolute -top-6 left-0 px-1.5 py-0.5 text-xs font-medium text-white rounded" style="background-color: <%= ann.color_hex %>;">
                  <%= ann.disease_type_i18n %>
                </div>
                <div class="resize-handle absolute bottom-1 right-1 w-3 h-3 bg-white rounded-full cursor-nwse-resize" style="border: 2px solid <%= ann.color_hex %>;"></div>
              </div>
            <% end %>

            <% @scale_markers.each do |marker| %>
              <div class="scale-marker absolute pointer-events-auto"
                   data-id="<%= marker.id %>"
                   style="left: <%= marker.x %>px; top: <%= marker.y %>px;">
                <% if marker.horizontal? %>
                  <div class="relative" style="width: <%= marker.length_pixels %>px; height: 2px; background: #22c55e;">
                    <div class="absolute -left-0.5 -top-1.5 w-1 h-4 bg-emerald-500"></div>
                    <div class="absolute -right-0.5 -top-1.5 w-1 h-4 bg-emerald-500"></div>
                  </div>
                <% else %>
                  <div class="relative" style="width: 2px; height: <%= marker.length_pixels %>px; background: #22c55e;">
                    <div class="absolute -top-0.5 -left-1.5 w-4 h-1 bg-emerald-500"></div>
                    <div class="absolute -bottom-0.5 -left-1.5 w-4 h-1 bg-emerald-500"></div>
                  </div>
                <% end %>
                <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 text-xs font-medium text-emerald-400 whitespace-nowrap">
                  <%= marker.length_cm %> cm
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-black/60 backdrop-blur px-4 py-2 rounded-full text-white text-xs flex items-center gap-4">
        <span id="cursor-pos">X: 0, Y: 0</span>
        <span class="w-px h-4 bg-white/30"></span>
        <span id="selected-info">未选择标注</span>
      </div>
    </div>
  </div>

  <div class="w-72 bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col shrink-0">
    <div class="p-4 border-b border-slate-200">
      <h3 class="font-semibold text-slate-800 text-sm">标注列表</h3>
    </div>

    <div id="annotation-list-panel" class="flex-1 overflow-y-auto">
      <% unless @annotations.empty? %>
        <div id="annotation-list-container" class="divide-y divide-slate-100">
          <% @annotations.each do |ann| %>
            <div class="annotation-item p-3 hover:bg-slate-50 cursor-pointer" data-id="<%= ann.id %>">
              <div class="flex items-start gap-3">
                <span class="w-3 h-3 rounded-sm mt-0.5 shrink-0" style="background-color: <%= ann.color_hex %>"></span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-medium text-slate-800"><%= ann.disease_type_i18n %></span>
                    <% sev_cls = { mild: "text-emerald-600 bg-emerald-50", moderate: "text-amber-600 bg-amber-50", severe: "text-red-600 bg-red-50" }[ann.severity.to_sym] %>
                    <span class="px-1.5 py-0.5 text-xs font-medium rounded <%= sev_cls %>"><%= ann.severity_i18n %></span>
                  </div>
                  <p class="text-xs text-slate-500 mt-0.5">
                    <%= ann.width %> × <%= ann.height %> px
                  </p>
                  <% if ann.description.present? %>
                    <p class="text-xs text-slate-400 mt-1 truncate"><%= ann.description %></p>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div id="annotation-list-container" class="divide-y divide-slate-100"></div>
        <div id="annotation-empty-state" class="p-8 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-slate-300 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          <p class="text-sm text-slate-400">暂无标注</p>
          <p class="text-xs text-slate-400 mt-1">在画布上拖拽创建标注</p>
        </div>
      <% end %>
    </div>

    <div id="annotation-properties" class="border-t border-slate-200 p-4 hidden">
      <h4 class="text-sm font-medium text-slate-800 mb-3">标注属性</h4>
      <div class="space-y-3">
        <div>
          <label class="text-xs text-slate-500">病害类型</label>
          <select id="prop-disease" class="w-full h-8 mt-1 text-sm border border-slate-200 rounded">
            <option value="flaking">起甲</option>
            <option value="efflorescence">酥碱</option>
            <option value="discoloration">变色</option>
            <option value="crack">裂隙</option>
            <option value="other">其他</option>
          </select>
        </div>
        <div>
          <label class="text-xs text-slate-500">严重程度</label>
          <select id="prop-severity" class="w-full h-8 mt-1 text-sm border border-slate-200 rounded">
            <option value="mild">轻微</option>
            <option value="moderate">中等</option>
            <option value="severe">重度</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="text-xs text-slate-500">X</label>
            <input type="number" id="prop-x" class="w-full h-8 mt-1 px-2 text-sm border border-slate-200 rounded">
          </div>
          <div>
            <label class="text-xs text-slate-500">Y</label>
            <input type="number" id="prop-y" class="w-full h-8 mt-1 px-2 text-sm border border-slate-200 rounded">
          </div>
          <div>
            <label class="text-xs text-slate-500">宽</label>
            <input type="number" id="prop-width" class="w-full h-8 mt-1 px-2 text-sm border border-slate-200 rounded">
          </div>
          <div>
            <label class="text-xs text-slate-500">高</label>
            <input type="number" id="prop-height" class="w-full h-8 mt-1 px-2 text-sm border border-slate-200 rounded">
          </div>
        </div>
        <div>
          <label class="text-xs text-slate-500">描述</label>
          <textarea id="prop-description" rows="2" class="w-full mt-1 px-2 py-1 text-sm border border-slate-200 rounded"></textarea>
        </div>
        <div class="flex gap-2 pt-2">
          <button id="save-annotation" class="flex-1 py-1.5 text-xs font-medium text-white bg-amber-600 rounded hover:bg-amber-700">保存</button>
          <button id="delete-annotation" class="px-3 py-1.5 text-xs font-medium text-red-600 bg-red-50 rounded hover:bg-red-100">删除</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2 pointer-events-none">
</div>

<%= content_for :javascript do %>
<script>
  const projectId = <%= @project.id %>;
  const recordId = <%= @record.id %>;
  const csrfToken = "<%= form_authenticity_token %>";
</script>
<% end %>
