<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">新建批次</h1>
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: @batch, local: true do |form| %>
      <div class="space-y-4">
        <div>
          <%= form.label :material_id, class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :material_id, @materials.map { |m| [m.name, m.id] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
        <div>
          <%= form.label :store_id, class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :store_id, @stores.map { |s| [s.name, s.id] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
        <div>
          <%= form.label :batch_number, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :batch_number, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :production_date, class: "block text-sm font-medium text-gray-700" %>
            <%= form.date_field :production_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
          </div>
          <div>
            <%= form.label :expiry_date, class: "block text-sm font-medium text-gray-700" %>
            <%= form.date_field :expiry_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :quantity, class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :quantity, step: "0.01", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
          </div>
          <div>
            <%= form.label :available_quantity, class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :available_quantity, step: "0.01", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
          </div>
        </div>
      </div>
      <div class="mt-6 flex justify-end">
        <%= form.submit "创建批次", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
