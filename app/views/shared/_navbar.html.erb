<nav class="bg-slate-800 text-white shadow-lg sticky top-0 z-50">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-8">
        <%= link_to root_path, class: "flex items-center gap-2 text-xl font-bold hover:text-amber-300 transition-colors" do %>
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          <span>站台门故障抢修系统</span>
        <% end %>
        <div class="hidden md:flex items-center gap-1">
          <%= link_to "工单列表", fault_records_path, class: "px-4 py-2 rounded-md hover:bg-slate-700 transition-colors #{request.path == fault_records_path ? 'bg-slate-700 text-amber-300' : ''}" %>
          <%= link_to "复盘看板", dashboard_fault_records_path, class: "px-4 py-2 rounded-md hover:bg-slate-700 transition-colors #{request.path == dashboard_fault_records_path ? 'bg-slate-700 text-amber-300' : ''}" %>
          <%= link_to "新建工单", new_fault_record_path, class: "px-4 py-2 rounded-md hover:bg-slate-700 transition-colors" %>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2 text-sm">
          <span class="text-slate-400">当前身份:</span>
          <%= form_tag switch_user_path, method: :post, class: "inline-block" do %>
            <%= select_tag :user_id, options_from_collection_for_select(User.all, :id, :display_name, current_user.id), class: "bg-slate-700 text-white text-sm rounded px-2 py-1 border border-slate-600 focus:outline-none focus:ring-2 focus:ring-amber-500", onchange: "this.form.submit()" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</nav>
