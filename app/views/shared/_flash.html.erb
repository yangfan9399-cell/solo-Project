<%= turbo_stream_from 'flash' %>

<div id="flash-container" class="fixed top-4 right-4 z-50 w-80 space-y-2">
  <% if notice.present? %>
    <div class="bg-green-50 border-l-4 border-green-400 p-4 rounded shadow-lg flex items-start gap-3 animate-slide-in">
      <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <div class="flex-1">
        <p class="text-sm font-medium text-green-800">成功</p>
        <p class="text-sm text-green-700 mt-0.5"><%= notice %></p>
      </div>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded shadow-lg flex items-start gap-3 animate-slide-in">
      <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
      </svg>
      <div class="flex-1">
        <p class="text-sm font-medium text-red-800">错误</p>
        <p class="text-sm text-red-700 mt-0.5"><%= alert %></p>
      </div>
    </div>
  <% end %>
</div>
