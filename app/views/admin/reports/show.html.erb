<div class="card">
  <div class="card-header">
    <div class="row">
      <div class="col-md-8">
        <h3>报告审核 - <%= @report.report_no %></h3>
      </div>
      <div class="col-md-4 text-right">
        <span class="status-badge status-<%= @report.status %>"><%= @report.status.humanize %></span>
      </div>
    </div>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <h4>患者信息</h4>
        <table class="table table-borderless">
          <tr><th>姓名</th><td><%= @report.patient&.name %></td></tr>
          <tr><th>身份证号</th><td><%= @report.patient&.id_card %></td></tr>
          <tr><th>联系电话</th><td><%= @report.patient&.phone %></td></tr>
        </table>
      </div>
      <div class="col-md-6">
        <h4>检查信息</h4>
        <table class="table table-borderless">
          <tr><th>检查类型</th><td><%= @report.exam&.exam_type.humanize %></td></tr>
          <tr><th>检查日期</th><td><%= @report.exam&.exam_date %></td></tr>
          <tr><th>报告日期</th><td><%= @report.issue_date %></td></tr>
        </table>
      </div>
    </div>

    <div class="row mt-4">
      <div class="col-md-12">
        <h4>操作历史</h4>
        <div class="history-list">
          <% @history_records.each do |record| %>
            <div class="history-item">
              <div class="row">
                <div class="col-md-3"><strong><%= record.operation_text %></strong></div>
                <div class="col-md-2"><%= record.operator %></div>
                <div class="col-md-4"><%= record.created_at.strftime("%Y-%m-%d %H:%M") %></div>
                <div class="col-md-3"><%= record.remark.present? ? record.remark : "-" %></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="card-footer">
    <div class="btn-group">
      <% if @report.reissue_requested? %>
        <%= link_to "批准补打", approve_reissue_admin_report_path(@report), method: :post, class: "btn btn-success" %>
        <%= link_to "拒绝补打", reject_reissue_admin_report_path(@report), method: :post, class: "btn btn-danger", data: { confirm: "确定拒绝此补打申请?" } %>
      <% end %>
      <%= link_to "返回列表", admin_reports_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>