<div class="card">
  <div class="card-header">
    <h3>报告审核管理</h3>
  </div>
  <div class="card-body p-0">
    <table class="table table-striped table-hover">
      <thead>
        <tr>
          <th>报告号</th>
          <th>患者</th>
          <th>检查类型</th>
          <th>状态</th>
          <th>补打次数</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @reports.each do |report| %>
          <tr>
            <td><%= link_to report.report_no, admin_report_path(report) %></td>
            <td><%= report.patient&.name %></td>
            <td><%= report.exam&.exam_type.humanize %></td>
            <td><span class="status-badge status-<%= report.status %>"><%= report.status.humanize %></span></td>
            <td><%= report.reissue_count %></td>
            <td><%= link_to "详情", admin_report_path(report), class: "btn btn-info btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
</div>