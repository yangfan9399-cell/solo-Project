<li>
  <div class="relative pb-8">
    <% unless last %>
      <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></span>
    <% end %>
    <div class="relative flex space-x-3">
      <div>
        <span class="h-8 w-8 rounded-full flex items-center justify-center ring-8 ring-white
          <%= case node.node_type.to_s
              when 'acceptance' then 'bg-blue-500'
              when 'processing_start' then 'bg-yellow-500'
              when 'review_submit' then 'bg-purple-500'
              when 'review_start' then 'bg-indigo-500'
              when 'approval' then 'bg-green-500'
              when 'rejection' then 'bg-red-500'
              when 'reprocessing' then 'bg-orange-500'
              when 'archive' then 'bg-gray-500'
              else 'bg-gray-400'
              end %>">
          <% case node.node_type.to_s %>
          <% when 'acceptance' %>
            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          <% when 'processing_start' %>
            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          <% when 'review_submit', 'review_start' %>
            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
          <% when 'approval' %>
            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          <% when 'rejection' %>
            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          <% when 'reprocessing' %>
            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          <% when 'archive' %>
            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
          <% else %>
            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          <% end %>
        </span>
      </div>
      <div class="min-w-0 flex-1 flex justify-between space-x-4">
        <div>
          <div class="flex items-center gap-2">
            <p class="text-sm font-medium text-gray-900"><%= node.event_text %></p>
            <span class="px-2 py-0.5 text-xs rounded-full <%= state_badge_class(node.to_state) %>">
              <%= node.to_state_text %>
            </span>
          </div>
          <p class="mt-0.5 text-xs text-gray-500">
            <%= node.operator_name %> · <%= node.operator_role %>
          </p>
          <% if node.remark.present? %>
            <p class="mt-2 text-sm text-gray-600"><%= node.remark %></p>
          <% end %>

          <% if node.has_diff? %>
            <div class="mt-3 bg-gray-50 rounded p-3">
              <p class="text-xs font-medium text-gray-700 mb-2">字段变更：</p>
              <div class="space-y-1">
                <% node.formatted_diff.each do |diff| %>
                  <div class="flex items-center gap-2 text-xs">
                    <span class="font-medium text-gray-600 w-28"><%= diff[:field_name] %>:</span>
                    <span class="text-red-600 line-through"><%= diff[:old_value] || '空' %></span>
                    <svg class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                    <span class="text-green-600"><%= diff[:new_value] || '空' %></span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if node.correction_record %>
            <div class="mt-3 bg-green-50 border border-green-200 rounded p-3">
              <p class="text-xs font-medium text-green-700 mb-2">整改记录：</p>
              <div class="space-y-1 text-xs text-green-800">
                <p><span class="font-medium">业务记录：</span><%= node.correction_record.business_record %></p>
                <p><span class="font-medium">现场说明：</span><%= node.correction_record.site_description %></p>
                <% if node.correction_record.correction_measure.present? %>
                  <p><span class="font-medium">整改措施：</span><%= node.correction_record.correction_measure %></p>
                <% end %>
                <% if node.correction_record.correction_result.present? %>
                  <p><span class="font-medium">整改结果：</span><%= node.correction_record.correction_result %></p>
                <% end %>
                <% if node.correction_record.remark.present? %>
                  <p><span class="font-medium">备注：</span><%= node.correction_record.remark %></p>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if node.evidence_attachments.any? %>
            <div class="mt-3">
              <p class="text-xs font-medium text-gray-700 mb-2">证据附件：</p>
              <div class="flex gap-2 flex-wrap">
                <% node.evidence_attachments.each do |attachment| %>
                  <%= link_to download_inspection_record_evidence_attachment_path(node.inspection_record, attachment), class: 'inline-flex items-center px-2 py-1 bg-gray-100 rounded text-xs text-gray-700 hover:bg-gray-200' do %>
                    <% if attachment.file_type == 'image' %>
                      <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    <% else %>
                      <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    <% end %>
                    <%= attachment.file_name %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <div class="text-right flex-shrink-0">
          <p class="text-xs text-gray-500"><%= node.created_at.strftime('%Y-%m-%d') %></p>
          <p class="text-xs text-gray-400"><%= node.created_at.strftime('%H:%M:%S') %></p>
        </div>
      </div>
    </div>
  </div>
</li>
