<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">借调记录</h1>
    <div class="flex space-x-2">
      <%= link_to "活跃借调", active_borrow_records_path, class: "px-4 py-2 border rounded hover:bg-gray-50 #{'bg-amber-100 border-amber-300' if params[:action] == 'active'}" %>
      <%= link_to "逾期借调", overdue_borrow_records_path, class: "px-4 py-2 border rounded hover:bg-gray-50 #{'bg-red-100 border-red-300' if params[:action] == 'overdue'}" %>
      <%= link_to "新建借调", new_borrow_record_path, class: "px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-4">
    <%= form_tag borrow_records_path, method: :get, class: "flex flex-wrap gap-4" do %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">状态</label>
        <%= select_tag :status, options_for_select(BorrowRecord.statuses.keys.map { |s| [I18n.t("borrow_statuses.#{s}", default: s.humanize), s] }, params[:status]), include_blank: "全部状态", class: "border rounded px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">剧组</label>
        <%= select_tag :crew_id, options_from_collection_for_select(Crew.all, :id, :name, params[:crew_id]), include_blank: "全部剧组", class: "border rounded px-3 py-2" %>
      </div>
      <div class="self-end">
        <%= submit_tag "筛选", class: "px-4 py-2 bg-gray-200 rounded hover:bg-gray-300 cursor-pointer" %>
        <%= link_to "重置", borrow_records_path, class: "px-4 py-2 text-gray-500 hover:text-gray-700 ml-2" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">道具</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">剧组</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">借调周期</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">申请人</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @borrow_records.each do |borrow| %>
          <tr class="hover:bg-gray-50 <%= 'bg-red-50' if borrow.overdue? %>">
            <td class="px-6 py-4">
              <div class="flex items-center">
                <div class="w-10 h-10 bg-gray-200 rounded flex items-center justify-center text-xl mr-3">
                  <%= prop_icon(borrow.prop.category) %>
                </div>
                <div>
                  <p class="font-medium text-gray-900">
                    <%= link_to borrow.prop.name, borrow_record_path(borrow), class: "hover:text-amber-600" %>
                  </p>
                  <p class="text-sm text-gray-500"><%= borrow.prop.category %></p>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <p class="font-medium text-gray-900"><%= borrow.crew.name %></p>
              <p class="text-sm text-gray-500"><%= borrow.crew.play_name %></p>
            </td>
            <td class="px-6 py-4">
              <p class="text-sm text-gray-900">
                <%= format_date(borrow.expected_start_date) %>
              </p>
              <p class="text-sm text-gray-500">
                至 <%= format_date(borrow.expected_end_date) %>
              </p>
              <% if borrow.overdue? %>
                <span class="text-xs text-red-600 font-medium">已逾期</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-3 py-1 text-xs font-medium rounded-full <%= status_badge_class(borrow.status) %>">
                <%= borrow.status_name %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= borrow.applicant&.name || "未知" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "详情", borrow_record_path(borrow), class: "text-amber-600 hover:text-amber-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @borrow_records.empty? %>
      <div class="px-6 py-12 text-center text-gray-500">
        暂无借调记录
      </div>
    <% end %>
  </div>
</div>
