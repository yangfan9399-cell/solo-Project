<%= form_with(model: borrow_record, local: true) do |form| %>
  <% if borrow_record.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h2 class="text-lg font-semibold text-red-800 mb-2">
        有 <%= borrow_record.errors.count %> 个错误需要修正：
      </h2>
      <ul class="list-disc list-inside text-sm text-red-600">
        <% borrow_record.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :prop_id, "道具", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.collection_select :prop_id, Prop.available.order(:name), :id, :name, { include_blank: "请选择道具" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
      </div>

      <div>
        <%= form.label :crew_id, "剧组", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.collection_select :crew_id, Crew.all.order(:name), :id, :name, { include_blank: "请选择剧组" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
      </div>

      <div>
        <%= form.label :expected_start_date, "预计借出日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.date_field :expected_start_date, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
      </div>

      <div>
        <%= form.label :expected_end_date, "预计归还日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.date_field :expected_end_date, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
      </div>
    </div>

    <div>
      <%= form.label :purpose, "使用用途", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :purpose, rows: 3, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500 focus:border-amber-500", placeholder: "请描述道具的使用场景和用途..." %>
    </div>

    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <p class="text-sm text-blue-700">
        <strong>提示：</strong>提交后需由剧组负责人确认。如所选时间段与其他剧组已确认的借调冲突，将无法确认出库。
      </p>
    </div>
  </div>

  <div class="mt-8 flex justify-end space-x-3">
    <%= link_to "取消", borrow_records_path, class: "px-6 py-2 border border-gray-300 rounded-lg hover:bg-gray-50" %>
    <%= form.submit "提交借调申请", class: "px-6 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 cursor-pointer" %>
  </div>
<% end %>
