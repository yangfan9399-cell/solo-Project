<div class="space-y-6">
  <div class="flex items-center space-x-4">
    <%= link_to "← 返回借调详情", borrow_record_path(@borrow_record), class: "text-gray-500 hover:text-gray-700" %>
    <h1 class="text-2xl font-bold text-gray-900">借调冲突详情</h1>
  </div>

  <div class="bg-red-50 border border-red-200 rounded-lg p-6">
    <div class="flex items-start">
      <span class="text-4xl mr-4">🚫</span>
      <div>
        <h2 class="text-xl font-semibold text-red-800 mb-2">借调冲突</h2>
        <p class="text-red-700">
          道具 <strong><%= @borrow_record.prop.name %></strong> 在
          <strong><%= format_date(@borrow_record.expected_start_date) %></strong> 至
          <strong><%= format_date(@borrow_record.expected_end_date) %></strong>
          期间存在借调冲突，无法确认出库。
        </p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">⚠️ 冲突的借调记录</h2>
    </div>
    <div class="divide-y divide-gray-200">
      <% @conflicting_records.each do |record| %>
        <div class="px-6 py-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-medium text-gray-900"><%= record.crew.name %></p>
              <p class="text-sm text-gray-500"><%= record.crew.play_name %></p>
              <p class="text-sm text-gray-600 mt-1">
                📅 <%= format_date(record.expected_start_date) %> - <%= format_date(record.expected_end_date) %>
              </p>
            </div>
            <span class="px-3 py-1 text-sm font-medium rounded-full <%= status_badge_class(record.status) %>">
              <%= record.status_name %>
            </span>
          </div>
          <div class="mt-3">
            <div class="w-full bg-gray-200 rounded-full h-2">
              <% conflict_days = ([record.expected_end_date, @borrow_record.expected_end_date].min - [record.expected_start_date, @borrow_record.expected_start_date].max).to_i + 1 %>
              <% total_days = @borrow_record.duration_days %>
              <% overlap_percent = (conflict_days.to_f / total_days * 100).round %>
              <div class="bg-red-500 h-2 rounded-full" style="width: <%= [overlap_percent, 100].min %>%"></div>
            </div>
            <p class="text-xs text-gray-500 mt-1">冲突天数：<%= conflict_days %> 天</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">✅ 可替代档期</h2>
      <p class="text-sm text-gray-500 mt-1">以下为未来30天内可用的档期（至少 <%= @borrow_record.duration_days %> 天）</p>
    </div>
    <div class="divide-y divide-gray-200">
      <% if @alternative_slots.any? %>
        <% @alternative_slots.each_with_index do |slot, index| %>
          <div class="px-6 py-4 hover:bg-green-50">
            <div class="flex items-center justify-between">
              <div>
                <p class="font-medium text-green-700">可替代档期 #<%= index + 1 %></p>
                <p class="text-sm text-gray-600">
                  📅 <%= format_date(slot[:start_date]) %> - <%= format_date(slot[:end_date]) %>
                </p>
                <p class="text-sm text-gray-500">
                  共 <%= (slot[:end_date] - slot[:start_date]).to_i + 1 %> 天可用
                </p>
              </div>
              <span class="px-3 py-1 text-sm font-medium rounded-full bg-green-100 text-green-800">
                可用
              </span>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="px-6 py-8 text-center text-gray-500">
          <p>未来30天内暂无可用的完整档期</p>
          <p class="text-sm mt-2">建议调整借调时长或选择其他道具</p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-amber-50 border border-amber-200 rounded-lg p-6">
    <h3 class="text-lg font-semibold text-amber-800 mb-3">💡 建议处理方式</h3>
    <ul class="space-y-2 text-amber-700">
      <li>1. 与冲突剧组协商，协调调整使用时间</li>
      <li>2. 选择上方列出的可替代档期重新申请</li>
      <li>3. 考虑使用其他同类道具替代</li>
      <li>4. 如确需该时间段，可提交特殊申请由资产部协调</li>
    </ul>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "返回借调详情", borrow_record_path(@borrow_record), class: "px-6 py-2 border border-gray-300 rounded-lg hover:bg-gray-50" %>
    <% if @borrow_record.pending? %>
      <%= link_to "修改借调申请", edit_borrow_record_path(@borrow_record), class: "px-6 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700" %>
    <% end %>
  </div>
</div>
