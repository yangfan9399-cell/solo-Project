<div class="min-h-screen bg-gray-50">
  <nav class="bg-blue-600 text-white px-6 py-4">
    <div class="flex justify-between items-center">
      <h1 class="text-xl font-bold">印刷厂工单打样系统</h1>
      <div class="flex space-x-4">
        <a href="/work_orders" class="bg-white text-blue-600 px-4 py-2 rounded-lg hover:bg-gray-100">工单列表</a>
        <a href="/work_orders/new" class="bg-blue-700 text-white px-4 py-2 rounded-lg hover:bg-blue-800">新建工单</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto px-4 py-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">统计分析</h2>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <div class="bg-white rounded-lg shadow p-4">
        <div class="text-sm text-gray-500 mb-1">总工单数</div>
        <div class="text-3xl font-bold text-gray-800"><%= @total_work_orders %></div>
      </div>
      <div class="bg-white rounded-lg shadow p-4">
        <div class="text-sm text-gray-500 mb-1">已完成</div>
        <div class="text-3xl font-bold text-green-600"><%= @completed_work_orders %></div>
      </div>
      <div class="bg-white rounded-lg shadow p-4">
        <div class="text-sm text-gray-500 mb-1">返工数</div>
        <div class="text-3xl font-bold text-red-600"><%= @rejected_count %></div>
      </div>
      <div class="bg-white rounded-lg shadow p-4">
        <div class="text-sm text-gray-500 mb-1">平均确认时长(天)</div>
        <div class="text-3xl font-bold text-blue-600"><%= @avg_confirmation_days %></div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">按客户统计</h3>
        <div class="space-y-3">
          <% @by_customer.each do |name, count| %>
            <div class="flex justify-between items-center">
              <span class="text-gray-700"><%= name %></span>
              <span class="font-medium text-gray-800"><%= count %> 单</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-blue-600 h-2 rounded-full" style="width: <%= (count.to_f / @by_customer.values.max * 100) %>%"></div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">按机台统计</h3>
        <div class="space-y-3">
          <% @by_machine.each do |machine, count| %>
            <div class="flex justify-between items-center">
              <span class="text-gray-700"><%= machine || '未指定' %></span>
              <span class="font-medium text-gray-800"><%= count %> 单</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-green-600 h-2 rounded-full" style="width: <%= (count.to_f / @by_machine.values.max * 100) %>%"></div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">返工原因统计</h3>
        <div class="space-y-3">
          <% @reject_reasons.each do |reason, count| %>
            <div class="flex justify-between items-center">
              <span class="text-gray-700"><%= reason %></span>
              <span class="font-medium text-gray-800"><%= count %> 次</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-red-600 h-2 rounded-full" style="width: <%= (count.to_f / @reject_reasons.values.max * 100) %>%"></div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">确认时长统计（按打样提交到客户确认）</h3>
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-gray-700">统计工单数</span>
            <span class="font-medium text-gray-800"><%= @confirmation_count %> 单</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-700">平均确认时长</span>
            <span class="font-medium text-blue-600"><%= @avg_confirmation_days %> 天</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-700">最长确认时长</span>
            <span class="font-medium text-red-600"><%= @max_confirmation_days %> 天</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-700">最短确认时长</span>
            <span class="font-medium text-green-600"><%= @min_confirmation_days %> 天</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>