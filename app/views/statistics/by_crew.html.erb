<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <%= link_to "← 返回统计", statistics_path, class: "text-gray-500 hover:text-gray-700" %>
      <h1 class="text-2xl font-bold text-gray-900">🎬 按剧组统计</h1>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">剧组</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">剧目</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">借调次数</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">损坏次数</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">赔付总额</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @crew_stats.each do |stat| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="flex items-center">
                <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mr-3">
                  <span class="text-xl">🎭</span>
                </div>
                <div>
                  <p class="font-medium">
                    <%= link_to stat[:crew].name, crew_path(stat[:crew]), class: "hover:text-blue-600" %>
                  </p>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 text-gray-600">
              <%= stat[:crew].play_name || "-" %>
            </td>
            <td class="px-6 py-4 text-center">
              <span class="font-medium text-blue-600"><%= stat[:borrow_count] %></span>
            </td>
            <td class="px-6 py-4 text-center">
              <span class="font-medium <%= stat[:damage_count] > 0 ? 'text-red-600' : 'text-gray-400' %>">
                <%= stat[:damage_count] %>
              </span>
            </td>
            <td class="px-6 py-4 text-right">
              <span class="font-medium text-amber-600">¥ <%= stat[:compensation_total].to_i %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">各剧组借调次数对比</h3>
    <% if @crew_stats.any? %>
      <% max_borrows = @crew_stats.map { |s| s[:borrow_count] }.max || 1 %>
      <div class="space-y-4">
        <% @crew_stats.first(5).each do |stat| %>
          <div class="flex items-center">
            <span class="w-32 text-sm text-gray-600 truncate"><%= stat[:crew].name %></span>
            <div class="flex-1 mx-4">
              <div class="w-full bg-gray-200 rounded-full h-6">
                <% percent = max_borrows > 0 ? (stat[:borrow_count].to_f / max_borrows * 100).round : 0 %>
                <div class="h-6 rounded-full bg-blue-500 flex items-center justify-end pr-2" style="width: <%= [percent, 100].min %>%">
                  <% if percent > 20 %>
                    <span class="text-xs text-white font-medium"><%= stat[:borrow_count] %> 次</span>
                  <% end %>
                </div>
              </div>
            </div>
            <% if percent <= 20 %>
              <span class="w-16 text-sm font-medium"><%= stat[:borrow_count] %> 次</span>
            <% else %>
              <span class="w-16"></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
