<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <%= link_to "← 返回统计", statistics_path, class: "text-gray-500 hover:text-gray-700" %>
      <h1 class="text-2xl font-bold text-gray-900">🏷️ 按道具类别统计</h1>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div class="bg-white rounded-lg shadow p-4">
      <p class="text-sm text-gray-500">道具类别数</p>
      <p class="text-2xl font-bold text-amber-600"><%= @category_summary.count %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
      <p class="text-sm text-gray-500">总道具数</p>
      <p class="text-2xl font-bold text-gray-900"><%= @category_summary.values.sum %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
      <p class="text-sm text-gray-500">损坏道具数</p>
      <p class="text-2xl font-bold text-red-600"><%= @category_stats.count { |s| s[:damage_count] > 0 } %></p>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">道具</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">类别</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">借调次数</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">损坏次数</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">赔付总额</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @category_stats.each do |stat| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="flex items-center">
                <div class="w-10 h-10 bg-gray-200 rounded flex items-center justify-center text-xl mr-3">
                  <%= prop_icon(stat[:prop].category) %>
                </div>
                <div>
                  <p class="font-medium">
                    <%= link_to stat[:prop].name, prop_path(stat[:prop]), class: "hover:text-amber-600" %>
                  </p>
                  <p class="text-sm text-gray-500"><%= stat[:prop].code %></p>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded">
                <%= stat[:prop].category %>
              </span>
            </td>
            <td class="px-6 py-4 text-center">
              <span class="font-medium text-blue-600"><%= stat[:borrow_count] %></span>
            </td>
            <td class="px-6 py-4 text-center">
              <span class="font-medium <%= stat[:damage_count] > 0 ? 'text-red-600' : 'text-gray-400' %>">
                <%= stat[:damage_count] %>
              </span>
            </td>
            <td class="px-6 py-4 text-right">
              <span class="font-medium text-amber-600">¥ <%= stat[:compensation_total].to_i %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">各类别道具数量分布</h3>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      <% @category_summary.each do |category, count| %>
        <div class="p-4 bg-amber-50 rounded-lg text-center">
          <p class="text-2xl font-bold text-amber-600"><%= count %></p>
          <p class="text-sm text-gray-600 mt-1"><%= category %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
