<div class="min-h-screen bg-gray-50">
  <nav class="bg-blue-600 text-white px-6 py-4">
    <div class="flex justify-between items-center">
      <h1 class="text-xl font-bold">印刷厂工单打样系统</h1>
      <div class="flex space-x-4">
        <a href="/work_orders" class="bg-blue-700 text-white px-4 py-2 rounded-lg hover:bg-blue-800">工单列表</a>
        <a href="/statistics" class="bg-blue-700 text-white px-4 py-2 rounded-lg hover:bg-blue-800">统计分析</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto px-4 py-6">
    <div class="max-w-2xl mx-auto">
      <a href="/work_orders/<%= @work_order.id %>" class="text-blue-600 hover:text-blue-800 mb-4 block">返回工单</a>
      <h2 class="text-2xl font-bold text-gray-800 mb-6">编辑工单 #<%= @work_order.id %></h2>

      <form action="/work_orders/<%= @work_order.id %>" method="patch" class="bg-white rounded-lg shadow p-6">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">客户 *</label>
            <select name="work_order[customer_id]" class="w-full border rounded-lg px-3 py-2" required>
              <option value="">请选择客户</option>
              <% @customers.each do |customer| %>
                <option value="<%= customer.id %>" <%= @work_order.customer_id == customer.id ? 'selected' : '' %>><%= customer.name %></option>
              <% end %>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">品类 *</label>
            <input type="text" name="work_order[category]" value="<%= @work_order.category %>" class="w-full border rounded-lg px-3 py-2" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">目标色值 *</label>
            <input type="text" name="work_order[target_color]" value="<%= @work_order.target_color %>" class="w-full border rounded-lg px-3 py-2" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">纸张类型 *</label>
            <input type="text" name="work_order[paper_type]" value="<%= @work_order.paper_type %>" class="w-full border rounded-lg px-3 py-2" required>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">机台</label>
            <input type="text" name="work_order[machine]" value="<%= @work_order.machine %>" class="w-full border rounded-lg px-3 py-2">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">责任人 *</label>
            <input type="text" name="work_order[responsible_person]" value="<%= @work_order.responsible_person %>" class="w-full border rounded-lg px-3 py-2" required>
          </div>
        </div>
        <div class="mt-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">备注</label>
          <textarea name="work_order[remark]" class="w-full border rounded-lg px-3 py-2" rows="3"><%= @work_order.remark %></textarea>
        </div>
        <div class="mt-6 flex space-x-4">
          <button type="submit" class="flex-1 bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700">更新工单</button>
          <a href="/work_orders/<%= @work_order.id %>" class="flex-1 text-center bg-gray-200 text-gray-700 py-2 rounded-lg hover:bg-gray-300">取消</a>
        </div>
      </form>
    </div>
  </div>
</div>