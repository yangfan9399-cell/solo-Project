<div class="min-h-screen bg-gray-50">
  <nav class="bg-blue-600 text-white px-6 py-4">
    <div class="flex justify-between items-center">
      <h1 class="text-xl font-bold">印刷厂工单打样系统</h1>
      <div class="flex space-x-4">
        <a href="/work_orders/new" class="bg-white text-blue-600 px-4 py-2 rounded-lg hover:bg-gray-100">新建工单</a>
        <a href="/statistics" class="bg-blue-700 text-white px-4 py-2 rounded-lg hover:bg-blue-800">统计分析</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto px-4 py-6">
    <div class="mb-6">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">工单列表</h2>
      <div class="flex space-x-2">
        <a href="/work_orders" class="px-3 py-1 rounded-full text-sm <%= @status_filter.blank? ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700' %>">全部</a>
        <% WorkOrder.statuses.each do |key, value| %>
          <a href="/work_orders?status=<%= key %>" class="px-3 py-1 rounded-full text-sm <%= @status_filter == key ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700' %>">
            <%= status_label(key) %>
          </a>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">编号</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">客户</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">品类</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">目标色值</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">纸张</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">机台</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">责任人</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">打样版本</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @work_orders.each do |order| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap"><a href="/work_orders/<%= order.id %>" class="text-blue-600 hover:text-blue-800">#<%= order.id %></a></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= order.customer&.name %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= order.category %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= order.target_color %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= order.paper_type %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= order.machine %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= order.responsible_person %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_color(order.status) %>">
                  <%= status_label(order.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">v<%= order.latest_proof&.version || 0 %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <a href="/work_orders/<%= order.id %>/edit" class="text-blue-600 hover:text-blue-800 mr-2">编辑</a>
                <a data-turbo-method="delete" href="/work_orders/<%= order.id %>" class="text-red-600 hover:text-red-800">删除</a>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    document.querySelectorAll('[data-turbo-method="delete"]').forEach(function(el) {
      el.addEventListener('click', function(e) {
        if (!confirm('确定要删除吗？')) {
          e.preventDefault();
        }
      });
    });
  });
</script>