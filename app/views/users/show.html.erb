<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <%= link_to "← 返回列表", users_path, class: "text-gray-500 hover:text-gray-700" %>
      <h1 class="text-2xl font-bold text-gray-900"><%= @user.name %></h1>
      <span class="px-3 py-1 text-sm font-medium rounded-full
        <%= @user.role == 'stage_manager' ? 'bg-purple-100 text-purple-800' : '' %>
        <%= @user.role == 'crew_leader' ? 'bg-blue-100 text-blue-800' : '' %>
        <%= @user.role == 'asset_auditor' ? 'bg-amber-100 text-amber-800' : '' %>">
        <%= @user.role_name %>
      </span>
    </div>
    <%= link_to "编辑", edit_user_path(@user), class: "px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-center mb-6">
        <div class="w-20 h-20 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <span class="text-3xl text-amber-600 font-bold"><%= @user.name.first %></span>
        </div>
        <h2 class="text-xl font-bold text-gray-900"><%= @user.name %></h2>
        <p class="text-gray-500"><%= @user.role_name %></p>
      </div>
      <div class="space-y-3">
        <% if @user.phone.present? %>
          <div class="flex justify-between">
            <span class="text-gray-500">电话</span>
            <span class="font-medium"><%= @user.phone %></span>
          </div>
        <% end %>
        <% if @user.email.present? %>
          <div class="flex justify-between">
            <span class="text-gray-500">邮箱</span>
            <span class="font-medium"><%= @user.email %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="lg:col-span-2 bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">相关借调记录</h3>
      </div>
      <div class="divide-y divide-gray-200">
        <% @borrow_records.limit(10).each do |borrow| %>
          <div class="px-6 py-3 hover:bg-gray-50">
            <div class="flex items-center justify-between">
              <div>
                <p class="font-medium"><%= borrow.prop.name %></p>
                <p class="text-sm text-gray-500">
                  <%= borrow.crew.name %> ·
                  <%= format_date(borrow.expected_start_date) %> - <%= format_date(borrow.expected_end_date) %>
                </p>
              </div>
              <span class="px-3 py-1 text-xs font-medium rounded-full <%= status_badge_class(borrow.status) %>">
                <%= borrow.status_name %>
              </span>
            </div>
          </div>
        <% end %>
        <% if @borrow_records.empty? %>
          <div class="px-6 py-8 text-center text-gray-500">
            暂无相关借调记录
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
