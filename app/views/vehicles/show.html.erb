<% content_for :title, "#{@vehicle.plate_number} - 车辆详情" %>
<%
  status_colors = {
    'available' => { badge: 'bg-green-100 text-green-800 ring-green-600/20', text: '正常' },
    'in_maintenance' => { badge: 'bg-blue-100 text-blue-800 ring-blue-600/20', text: '保养中' },
    'under_repair' => { badge: 'bg-orange-100 text-orange-800 ring-orange-600/20', text: '维修中' },
    'pending_review' => { badge: 'bg-yellow-100 text-yellow-800 ring-yellow-600/20', text: '待复核' },
    'decommissioned' => { badge: 'bg-red-100 text-red-800 ring-red-600/20', text: '停用' }
  }
  status_info = status_colors[@vehicle.status] || status_colors['available']
  car_age = @vehicle.purchase_date ? ((Date.today - @vehicle.purchase_date).to_i / 365.25).round(1) : nil
  pending_trip = @vehicle.trip_records.where(review_status: :pending).order(created_at: :desc).first
  blocking_issues = @vehicle.blocking_issues_for_dispatch
  first_pending_maintenance = @maintenance_plans.select { |p| p.pending? || p.overdue? || p.in_progress? }.first
  first_unfinished_repair = @repair_records.reject { |r| r.completed? || r.cancelled? }.first
%>

<div class="min-h-screen bg-slate-50 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center gap-2 mb-5">
      <%= link_to vehicles_path, class: 'inline-flex items-center gap-1.5 text-sm text-slate-600 hover:text-slate-900 transition' do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        返回列表
      <% end %>
    </div>

    <%= turbo_frame_tag 'vehicle_header' do %>
      <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-6">
        <div class="p-6">
          <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
            <div class="flex-1">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-slate-100 to-slate-200 border border-slate-200 flex items-center justify-center shrink-0">
                  <svg class="w-8 h-8 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 17h8m-8 0a2 2 0 01-2-2V7l6-4 6 4v8a2 2 0 01-2 2m-8 0v2m8-2v2M7 7h10"/></svg>
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-3 mb-1 flex-wrap">
                    <h1 class="text-3xl font-bold text-slate-900 tracking-wide"><%= @vehicle.plate_number %></h1>
                    <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold ring-1 ring-inset <%= status_info[:badge] %>">
                      <%= status_info[:text] %>
                    </span>
                  </div>
                  <p class="text-base text-slate-600">
                    <%= @vehicle.vehicle_model&.brand %> · <%= @vehicle.vehicle_model&.name %>
                    <% if @vehicle.vehicle_model&.category.present? %>
                      <span class="ml-2 px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-xs">
                        <%= { 'garbage_truck' => '垃圾车', 'sweeper' => '清扫车', 'sprinkler' => '洒水车', 'vacuum_truck' => '吸尘车', 'transport' => '运输车', 'other' => '其他' }[@vehicle.vehicle_model.category] || @vehicle.vehicle_model.category %>
                      </span>
                    <% end %>
                  </p>
                </div>
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-4">
                <div>
                  <p class="text-xs text-slate-500 mb-1">司机</p>
                  <p class="text-sm font-semibold text-slate-900 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    <%= @vehicle.driver_name || '未指派' %>
                  </p>
                </div>
                <div>
                  <p class="text-xs text-slate-500 mb-1">当前里程</p>
                  <p class="text-sm font-semibold text-slate-900 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    <%= @vehicle.current_mileage ? "#{number_with_delimiter(@vehicle.current_mileage.to_i)} km" : '-' %>
                  </p>
                </div>
                <div>
                  <p class="text-xs text-slate-500 mb-1">所属车队</p>
                  <p class="text-sm font-semibold text-slate-900 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <%= @vehicle.fleet&.name || '-' %>
                  </p>
                </div>
                <div>
                  <p class="text-xs text-slate-500 mb-1">购买日期</p>
                  <p class="text-sm font-semibold text-slate-900 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    <%= @vehicle.purchase_date || '-' %>
                  </p>
                </div>
                <div>
                  <p class="text-xs text-slate-500 mb-1">车龄</p>
                  <p class="text-sm font-semibold text-slate-900 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <%= car_age ? "#{car_age} 年" : '-' %>
                  </p>
                </div>
              </div>

              <div class="mt-5 pt-5 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50">
                  <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs text-slate-500">线路名称</p>
                    <p class="text-sm font-semibold text-slate-900 truncate"><%= @current_route&.name || '未分配' %></p>
                  </div>
                </div>
                <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50">
                  <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs text-slate-500">线路里程</p>
                    <p class="text-sm font-semibold text-slate-900"><%= @current_route&.distance ? "#{number_with_delimiter(@current_route.distance.to_i)} km" : '-' %></p>
                  </div>
                </div>
              </div>
            </div>

            <div class="lg:w-80 shrink-0">
              <p class="text-xs font-semibold text-slate-700 uppercase tracking-wider mb-3">快捷操作</p>
              <div class="grid grid-cols-2 gap-2">
                <% if first_pending_maintenance %>
                  <% if first_pending_maintenance.pending? || first_pending_maintenance.overdue? %>
                    <%= button_to start_maintenance_vehicle_path(@vehicle, maintenance_plan_id: first_pending_maintenance.id), method: :patch, class: 'col-span-2 inline-flex items-center justify-center gap-2 px-3 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-xl shadow-sm transition' do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766"/></svg>
                      开始保养
                    <% end %>
                  <% elsif first_pending_maintenance.in_progress? %>
                    <%= button_to complete_maintenance_vehicle_path(@vehicle, maintenance_plan_id: first_pending_maintenance.id), method: :patch, class: 'col-span-2 inline-flex items-center justify-center gap-2 px-3 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-xl shadow-sm transition' do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      完成保养
                    <% end %>
                  <% end %>
                <% else %>
                  <%= link_to new_maintenance_plan_path(vehicle_id: @vehicle.id), class: 'col-span-2 inline-flex items-center justify-center gap-2 px-3 py-2.5 bg-blue-50 border border-blue-200 text-blue-700 hover:bg-blue-100 text-sm font-medium rounded-xl transition' do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877"/></svg>
                    创建保养
                  <% end %>
                <% end %>

                <% unless first_unfinished_repair %>
                  <button type="button" onclick="document.getElementById('new_repair_modal').classList.remove('hidden')" class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 bg-orange-50 border border-orange-200 text-orange-700 hover:bg-orange-100 text-sm font-medium rounded-xl transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0"/></svg>
                    创建维修
                  </button>
                <% else %>
                  <%= button_to complete_repair_vehicle_path(@vehicle, repair_record_id: first_unfinished_repair.id), method: :patch, class: 'inline-flex items-center justify-center gap-1.5 px-3 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-xl shadow-sm transition' do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    完成维修
                  <% end %>
                <% end %>

                <%= link_to new_trip_record_path(vehicle_id: @vehicle.id), class: "inline-flex items-center justify-center gap-1.5 px-3 py-2.5 text-sm font-medium rounded-xl transition #{@vehicle.can_dispatch? ? 'bg-emerald-50 border border-emerald-200 text-emerald-700 hover:bg-emerald-100' : 'bg-slate-100 text-slate-400 cursor-not-allowed border border-slate-200'}" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                  出车申请
                <% end %>

                <%= link_to new_inspection_record_path(vehicle_id: @vehicle.id), class: 'inline-flex items-center justify-center gap-1.5 px-3 py-2.5 bg-cyan-50 border border-cyan-200 text-cyan-700 hover:bg-cyan-100 text-sm font-medium rounded-xl transition' do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  车况检查
                <% end %>

                <%= link_to new_fuel_record_path(vehicle_id: @vehicle.id), class: 'col-span-2 inline-flex items-center justify-center gap-1.5 px-3 py-2.5 bg-amber-50 border border-amber-200 text-amber-700 hover:bg-amber-100 text-sm font-medium rounded-xl transition' do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  油耗登记
                <% end %>

                <%= link_to edit_vehicle_path(@vehicle), class: 'col-span-2 inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm font-medium rounded-xl transition' do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  编辑车辆
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if blocking_issues.any? %>
      <div class="bg-red-50 border border-red-200 rounded-2xl p-5 mb-6 shadow-sm">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div class="flex-1">
            <h3 class="text-sm font-bold text-red-900 mb-2">出车阻止项（<%= blocking_issues.size %>项）</h3>
            <ul class="space-y-1.5">
              <% blocking_issues.each do |issue| %>
                <li class="flex items-start gap-2 text-sm text-red-800">
                  <svg class="w-4 h-4 mt-0.5 shrink-0 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <%= issue %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>

    <% if pending_trip %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-5 mb-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <div class="flex items-start gap-3 flex-1">
            <div class="w-10 h-10 rounded-xl bg-yellow-100 text-yellow-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1 flex-wrap">
                <h3 class="text-sm font-bold text-yellow-900">待复核出车单</h3>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-yellow-100 text-yellow-800 ring-1 ring-inset ring-yellow-600/20">
                  待复核
                </span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-2 text-sm">
                <div>
                  <p class="text-xs text-yellow-700/70">计划出发</p>
                  <p class="font-semibold text-yellow-900"><%= pending_trip.planned_departure_time&.strftime('%Y-%m-%d %H:%M') %></p>
                </div>
                <div>
                  <p class="text-xs text-yellow-700/70">线路</p>
                  <p class="font-semibold text-yellow-900 truncate"><%= pending_trip.route&.name %></p>
                </div>
                <div>
                  <p class="text-xs text-yellow-700/70">司机</p>
                  <p class="font-semibold text-yellow-900"><%= pending_trip.driver_name %></p>
                </div>
                <div>
                  <p class="text-xs text-yellow-700/70">申请时间</p>
                  <p class="font-semibold text-yellow-900"><%= pending_trip.created_at&.strftime('%m-%d %H:%M') %></p>
                </div>
              </div>
              <% trip_blocking = pending_trip.blocking_issues %>
              <% if trip_blocking.any? %>
                <div class="mt-3 p-3 rounded-xl bg-red-100/60 border border-red-200">
                  <p class="text-xs font-semibold text-red-800 mb-1.5 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                    阻止复核原因：
                  </p>
                  <ul class="space-y-1">
                    <% trip_blocking.each do |b| %>
                      <li class="text-xs text-red-700 flex items-start gap-1"><span class="mt-0.5">•</span><%= b %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          </div>
          <div class="flex sm:flex-col gap-2 shrink-0">
            <%= button_to approve_trip_vehicle_path(@vehicle, trip_record_id: pending_trip.id), method: :patch, disabled: trip_blocking.any?, class: "inline-flex items-center justify-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-xl shadow-sm transition #{trip_blocking.any? ? 'bg-slate-200 text-slate-400 cursor-not-allowed' : 'bg-green-600 hover:bg-green-700 text-white'}" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              通过
            <% end %>
            <%= button_to reject_trip_vehicle_path(@vehicle, trip_record_id: pending_trip.id), method: :patch, class: 'inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-white border border-red-200 text-red-600 hover:bg-red-50 text-sm font-semibold rounded-xl transition' do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              驳回
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%= turbo_frame_tag 'vehicle_details' do %>
      <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="border-b border-slate-200 px-4 sm:px-6">
          <nav class="flex gap-1 overflow-x-auto -mb-px" role="tablist" aria-label="Vehicle tabs">
            <%
              tabs = [
                { id: 'maintenance', label: '保养计划', icon: 'M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877' },
                { id: 'repair', label: '维修记录', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0' },
                { id: 'fuel', label: '油耗记录', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
                { id: 'inspection', label: '检查记录', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04' },
                { id: 'trip', label: '出车记录', icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4' },
                { id: 'history', label: '历史时间线', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' }
              ]
              active_tab = params[:tab] || 'maintenance'
            %>
            <% tabs.each do |tab| %>
              <% is_active = active_tab == tab[:id] %>
              <%= link_to vehicle_path(@vehicle, tab: tab[:id]), data: { turbo_frame: 'vehicle_details', turbo_action: 'advance' }, class: "tab-btn whitespace-nowrap inline-flex items-center gap-2 px-4 py-4 border-b-2 text-sm font-medium transition-colors #{is_active ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'}" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="<%= tab[:icon] %>"/></svg>
                <%= tab[:label] %>
              <% end %>
            <% end %>
          </nav>
        </div>
        <div class="p-5 sm:p-6">
          <% case active_tab %>
          <% when 'maintenance' %>
            <%= render 'vehicles/maintenance_section' %>
          <% when 'repair' %>
            <%= render 'vehicles/repair_section' %>
          <% when 'fuel' %>
            <%= render 'vehicles/fuel_section' %>
          <% when 'inspection' %>
            <%= render 'vehicles/inspection_section' %>
          <% when 'trip' %>
            <%= render 'vehicles/trip_section' %>
          <% when 'history' %>
            <%= render 'vehicles/history_timeline' %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div id="new_repair_modal" class="hidden fixed inset-0 z-50 overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" onclick="document.getElementById('new_repair_modal').classList.add('hidden')"></div>
    <div class="inline-block align-bottom bg-white rounded-2xl shadow-xl text-left overflow-hidden transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full border border-slate-200">
      <%= form_with url: start_repair_vehicle_path(@vehicle), method: :patch, local: true do |f| %>
        <div class="px-6 py-5 border-b border-slate-100">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900">创建维修记录</h3>
            <button type="button" onclick="document.getElementById('new_repair_modal').classList.add('hidden')" class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 flex items-center justify-center transition">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
        </div>
        <div class="px-6 py-5 space-y-4">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">维修类型</label>
            <%= f.select 'repair_record[repair_type]', options_for_select([['故障维修', 'breakdown'], ['预防性维修', 'preventive'], ['事故维修', 'accident']], 'breakdown'), {}, class: 'w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none bg-white' %>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">问题描述</label>
            <%= f.text_area 'repair_record[issue_description]', required: true, rows: 3, placeholder: '请描述车辆问题...', class: 'w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none' %>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">开始日期</label>
              <%= f.date_field 'repair_record[start_date]', value: Date.today, class: 'w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none bg-white' %>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">技师</label>
              <%= f.text_field 'repair_record[technician]', placeholder: '维修技师姓名', class: 'w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none' %>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">维修站</label>
              <%= f.text_field 'repair_record[workshop]', placeholder: '维修厂名称', class: 'w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none' %>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">预估费用</label>
              <%= f.number_field 'repair_record[estimated_cost]', min: 0, step: 0.01, placeholder: '¥ 0.00', class: 'w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none' %>
            </div>
          </div>
        </div>
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-3">
          <button type="button" onclick="document.getElementById('new_repair_modal').classList.add('hidden')" class="px-4 py-2.5 text-sm font-semibold text-slate-700 bg-white border border-slate-300 rounded-xl hover:bg-slate-50 transition">
            取消
          </button>
          <%= f.submit '提交维修', class: 'px-5 py-2.5 text-sm font-semibold text-white bg-orange-600 hover:bg-orange-700 rounded-xl shadow-sm transition' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
