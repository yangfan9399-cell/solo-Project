<%
  review_colors = {
    'pending' => 'bg-yellow-100 text-yellow-800 ring-yellow-600/20',
    'approved' => 'bg-green-100 text-green-800 ring-green-600/20',
    'rejected' => 'bg-red-100 text-red-800 ring-red-600/20',
    'decommissioned' => 'bg-gray-100 text-gray-800 ring-gray-600/20'
  }
  review_texts = { 'pending' => '待复核', 'approved' => '已通过', 'rejected' => '已驳回', 'decommissioned' => '已作废' }
%>

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h3 class="text-base font-semibold text-slate-900">出车记录列表</h3>
    <%= link_to new_trip_record_path(vehicle_id: @vehicle.id), class: 'inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-lg transition' do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
      申请出车
    <% end %>
  </div>

  <% if @trip_records.any? %>
    <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-4 py-3 text-left font-semibold text-slate-700 whitespace-nowrap">计划出发</th>
            <th class="px-4 py-3 text-left font-semibold text-slate-700 whitespace-nowrap">线路</th>
            <th class="px-4 py-3 text-left font-semibold text-slate-700 whitespace-nowrap">司机</th>
            <th class="px-4 py-3 text-left font-semibold text-slate-700 whitespace-nowrap">复核状态</th>
            <th class="px-4 py-3 text-right font-semibold text-slate-700 whitespace-nowrap">起始里程</th>
            <th class="px-4 py-3 text-right font-semibold text-slate-700 whitespace-nowrap">结束里程</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @trip_records.each do |record| %>
            <tr class="<%= record.pending? ? 'bg-yellow-50/50' : 'hover:bg-slate-50' %> transition-colors">
              <td class="px-4 py-3 whitespace-nowrap text-slate-900">
                <%= record.planned_departure_time ? record.planned_departure_time.strftime('%Y-%m-%d %H:%M') : '-' %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-slate-700"><%= record.route&.name || '-' %></td>
              <td class="px-4 py-3 whitespace-nowrap text-slate-700"><%= record.driver_name %></td>
              <td class="px-4 py-3 whitespace-nowrap">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset <%= review_colors[record.review_status] %>">
                  <%= review_texts[record.review_status] %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-right text-slate-700">
                <%= record.start_mileage ? "#{number_with_delimiter(record.start_mileage.to_i)} km" : '-' %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-right text-slate-700">
                <%= record.end_mileage ? "#{number_with_delimiter(record.end_mileage.to_i)} km" : '-' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white border border-slate-200 border-dashed rounded-xl p-8 text-center">
      <svg class="w-10 h-10 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
      <p class="text-sm text-slate-500">暂无出车记录</p>
    </div>
  <% end %>
</div>
