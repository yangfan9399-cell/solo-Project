<%
  maintenance_type_texts = { 'routine' => '常规保养', 'comprehensive' => '综合保养', 'emergency' => '应急保养' }
  maintenance_status_colors = {
    'pending' => 'bg-yellow-100 text-yellow-800 ring-yellow-600/20',
    'in_progress' => 'bg-blue-100 text-blue-800 ring-blue-600/20',
    'completed' => 'bg-green-100 text-green-800 ring-green-600/20',
    'overdue' => 'bg-red-100 text-red-800 ring-red-600/20',
    'cancelled' => 'bg-gray-100 text-gray-800 ring-gray-600/20'
  }
  maintenance_status_texts = {
    'pending' => '待处理',
    'in_progress' => '进行中',
    'completed' => '已完成',
    'overdue' => '已超期',
    'cancelled' => '已取消'
  }
  progress_bar_colors = {
    'pending' => 'bg-yellow-500',
    'in_progress' => 'bg-blue-500',
    'completed' => 'bg-green-500',
    'overdue' => 'bg-red-500',
    'cancelled' => 'bg-gray-400'
  }
%>

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h3 class="text-base font-semibold text-slate-900">保养计划列表</h3>
    <%= link_to new_maintenance_plan_path(vehicle_id: @vehicle.id), class: 'inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-lg transition' do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      新建计划
    <% end %>
  </div>

  <% if @maintenance_plans.any? %>
    <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-4 py-3 text-left font-semibold text-slate-700 whitespace-nowrap">计划日期</th>
            <th class="px-4 py-3 text-left font-semibold text-slate-700 whitespace-nowrap">类型</th>
            <th class="px-4 py-3 text-left font-semibold text-slate-700 whitespace-nowrap">状态</th>
            <th class="px-4 py-3 text-left font-semibold text-slate-700 whitespace-nowrap">进度</th>
            <th class="px-4 py-3 text-left font-semibold text-slate-700 whitespace-nowrap">计划里程</th>
            <th class="px-4 py-3 text-right font-semibold text-slate-700 whitespace-nowrap">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @maintenance_plans.each do |plan| %>
            <% is_overdue = plan.overdue? || (plan.pending? && plan.planned_date < Date.today) %>
            <tr class="<%= is_overdue ? 'bg-red-50/50' : 'hover:bg-slate-50' %> transition-colors">
              <td class="px-4 py-3 whitespace-nowrap">
                <span class="<%= is_overdue ? 'text-red-600 font-semibold' : 'text-slate-900' %>">
                  <%= plan.planned_date %>
                </span>
                <% if is_overdue && !plan.completed? %>
                  <span class="ml-1.5 text-xs text-red-600 font-medium">(超期)</span>
                <% end %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-slate-700">
                <%= maintenance_type_texts[plan.maintenance_type] || plan.maintenance_type %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset <%= maintenance_status_colors[plan.status] %>">
                  <%= maintenance_status_texts[plan.status] %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap w-48">
                <div class="flex items-center gap-2">
                  <div class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full <%= progress_bar_colors[plan.status] %> rounded-full transition-all" style="width: <%= plan.progress_percentage %>%"></div>
                  </div>
                  <span class="text-xs text-slate-600 font-medium w-10 text-right"><%= plan.progress_percentage %>%</span>
                </div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-slate-700">
                <%= plan.scheduled_mileage ? "#{number_with_delimiter(plan.scheduled_mileage.to_i)} km" : '-' %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-right">
                <% if plan.pending? || plan.overdue? %>
                  <%= button_to '开始保养', start_maintenance_vehicle_path(@vehicle, maintenance_plan_id: plan.id), method: :patch, class: 'inline-flex items-center px-2.5 py-1 text-xs font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-md transition' %>
                <% elsif plan.in_progress? %>
                  <%= button_to '完成保养', complete_maintenance_vehicle_path(@vehicle, maintenance_plan_id: plan.id), method: :patch, class: 'inline-flex items-center px-2.5 py-1 text-xs font-medium bg-green-600 hover:bg-green-700 text-white rounded-md transition' %>
                <% end %>
                <%= link_to '详情', maintenance_plan_path(plan), class: 'ml-2 inline-flex items-center px-2.5 py-1 text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md transition' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white border border-slate-200 border-dashed rounded-xl p-8 text-center">
      <svg class="w-10 h-10 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"/></svg>
      <p class="text-sm text-slate-500">暂无保养计划</p>
    </div>
  <% end %>
</div>
