<% content_for :title, "编辑 #{@vehicle.plate_number}" %>

<div class="min-h-screen bg-slate-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center gap-2 mb-5">
      <%= link_to vehicle_path(@vehicle), class: 'inline-flex items-center gap-1.5 text-sm text-slate-600 hover:text-slate-900 transition' do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        返回详情
      <% end %>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
      <div class="px-6 sm:px-8 py-6 border-b border-slate-100">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          </div>
          <div>
            <h1 class="text-xl font-bold text-slate-900">编辑车辆 <span class="text-blue-600"><%= @vehicle.plate_number %></span></h1>
            <p class="mt-0.5 text-sm text-slate-500">更新车辆的档案信息</p>
          </div>
        </div>
      </div>
      <div class="px-6 sm:px-8 py-6">
        <%= render 'form', vehicle: @vehicle %>
      </div>
    </div>
  </div>
</div>
