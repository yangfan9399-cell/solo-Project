<%
  status_colors = {
    'available' => { bg: 'bg-green-50', border: 'border-green-200', badge: 'bg-green-100 text-green-800 ring-green-600/20' },
    'in_maintenance' => { bg: 'bg-blue-50', border: 'border-blue-200', badge: 'bg-blue-100 text-blue-800 ring-blue-600/20' },
    'under_repair' => { bg: 'bg-orange-50', border: 'border-orange-200', badge: 'bg-orange-100 text-orange-800 ring-orange-600/20' },
    'pending_review' => { bg: 'bg-yellow-50', border: 'border-yellow-200', badge: 'bg-yellow-100 text-yellow-800 ring-yellow-600/20' },
    'decommissioned' => { bg: 'bg-red-50', border: 'border-red-200', badge: 'bg-red-100 text-red-800 ring-red-600/20' }
  }
  status_texts = {
    'available' => '正常',
    'in_maintenance' => '保养中',
    'under_repair' => '维修中',
    'pending_review' => '待复核',
    'decommissioned' => '停用'
  }
  colors = status_colors[vehicle.status] || status_colors['available']
  next_maintenance = vehicle.upcoming_maintenance
  overdue_maint = vehicle.overdue_maintenance?
  unfinished_repair = vehicle.has_unfinished_repairs?
  abnormal_fuel = vehicle.abnormal_fuel_count(30) > 0
%>

<div class="group <%= colors[:bg] %> border <%= colors[:border] %> rounded-2xl p-5 shadow-sm hover:shadow-lg transition-all duration-200 hover:-translate-y-0.5">
  <div class="flex items-start justify-between mb-4">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <h3 class="text-lg font-bold text-slate-900 tracking-wide"><%= vehicle.plate_number %></h3>
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset <%= colors[:badge] %>">
          <%= status_texts[vehicle.status] %>
        </span>
      </div>
      <p class="text-sm text-slate-600">
        <%= vehicle.vehicle_model&.brand %> <%= vehicle.vehicle_model&.name %>
      </p>
    </div>
    <div class="flex gap-1.5">
      <% if abnormal_fuel %>
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-red-100 text-red-600" title="油耗异常">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </span>
      <% end %>
      <% if unfinished_repair %>
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600" title="未完成维修">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </span>
      <% end %>
      <% if overdue_maint %>
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-red-100 text-red-600" title="保养超期">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </span>
      <% end %>
    </div>
  </div>

  <div class="space-y-2.5 mb-4">
    <div class="flex items-center text-sm">
      <svg class="w-4 h-4 text-slate-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      <span class="text-slate-500">车队：</span>
      <span class="text-slate-700 font-medium ml-1"><%= vehicle.fleet&.name || '-' %></span>
    </div>
    <div class="flex items-center text-sm">
      <svg class="w-4 h-4 text-slate-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      <span class="text-slate-500">里程：</span>
      <span class="text-slate-700 font-medium ml-1"><%= vehicle.current_mileage ? number_with_delimiter(vehicle.current_mileage.to_i) : '-' %> km</span>
    </div>
    <div class="flex items-center text-sm">
      <svg class="w-4 h-4 text-slate-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      <span class="text-slate-500">司机：</span>
      <span class="text-slate-700 font-medium ml-1"><%= vehicle.driver_name || '-' %></span>
    </div>
    <div class="flex items-center text-sm">
      <svg class="w-4 h-4 text-slate-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      <span class="text-slate-500">下次保养：</span>
      <% if next_maintenance %>
        <% overdue = next_maintenance.overdue? || next_maintenance.planned_date < Date.today %>
        <span class="font-medium ml-1 <%= overdue ? 'text-red-600' : 'text-slate-700' %>">
          <%= next_maintenance.planned_date %>
          <% if overdue %><span class="ml-1 text-xs">(超期)</span><% end %>
        </span>
      <% else %>
        <span class="text-slate-400 ml-1">暂无计划</span>
      <% end %>
    </div>
  </div>

  <%= link_to vehicle_path(vehicle), class: 'w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-slate-700 font-medium rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-colors text-sm shadow-sm' do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
    查看详情
  <% end %>
</div>
