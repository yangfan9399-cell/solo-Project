    'fuel_abnormal' => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>'
  }
  dot_colors = {
    'green' => { bg: 'bg-green-500', ring: 'ring-green-200' },
    'blue' => { bg: 'bg-blue-500', ring: 'ring-blue-200' },
    'red' => { bg: 'bg-red-500', ring: 'ring-red-200' },
    'gray' => { bg: 'bg-slate-400', ring: 'ring-slate-200' },
    'slate' => { bg: 'bg-slate-500', ring: 'ring-slate-200' }
  }
%>

<div class="space-y-4">
  <h3 class="text-base font-semibold text-slate-900">历史节点时间线</h3>

  <% if @history_nodes.any? %>
    <div class="relative pl-8">
      <div class="absolute left-3 top-2 bottom-2 w-0.5 bg-slate-200"></div>
      <% @history_nodes.each do |node| %>
        <% color = node.status_color %>
        <% dot_style = dot_colors[color] || dot_colors['slate'] %>
        <%
          case color
          when 'green'
            icon_wrap = 'bg-green-50 border-green-200 text-green-600'
          when 'blue'
            icon_wrap = 'bg-blue-50 border-blue-200 text-blue-600'
          when 'red'
            icon_wrap = 'bg-red-50 border-red-200 text-red-600'
          when 'gray'
            icon_wrap = 'bg-slate-50 border-slate-200 text-slate-600'
          else
            icon_wrap = 'bg-slate-50 border-slate-200 text-slate-600'
          end
        %>
        <div class="relative mb-5 last:mb-0">
          <div class="absolute -left-5 top-0.5 w-4 h-4 rounded-full <%= dot_style[:bg] %> ring-4 <%= dot_style[:ring] %>"></div>
          <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-start gap-3">
              <div class="shrink-0 w-10 h-10 rounded-lg border <%= icon_wrap %> flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <%= node_svgs[node.node_type] || '<circle cx="12" cy="12" r="3"/>' %>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2 mb-1">
                  <h4 class="text-sm font-semibold text-slate-900">
                    <%= node.title.presence || node_type_titles[node.node_type] || node.node_type %>
                  </h4>
                  <span class="text-xs text-slate-500 whitespace-nowrap shrink-0">
                    <%= node.happened_at ? node.happened_at.strftime('%Y-%m-%d %H:%M') : '-' %>
                  </span>
                </div>
                <p class="text-sm text-slate-600 mb-2 leading-relaxed"><%= node.description %></p>
                <div class="flex items-center gap-3 text-xs text-slate-500">
                  <span class="inline-flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    <%= node.operator || '系统' %>
                  </span>
                  <% if node.operator_role.present? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded bg-slate-100 text-slate-600">
                      <%= { 'admin' => '管理员', 'dispatcher' => '调度员', 'team_leader' => '队长', 'repair_station' => '维修站', 'safety_officer' => '安全员', 'system' => '系统' }[node.operator_role] || node.operator_role %>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white border border-slate-200 border-dashed rounded-xl p-8 text-center">
      <svg class="w-10 h-10 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <p class="text-sm text-slate-500">暂无历史记录</p>
    </div>
  <% end %>
</div>
