<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">检查记录</h1>
          <p class="mt-1 text-sm text-gray-500">记录车辆各项安全检查结果与问题</p>
        </div>
        <%= link_to new_inspection_record_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          新建
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
      <%= form_with(url: inspection_records_path, method: :get, local: true, class: "space-y-4") do %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div>
            <%= label_tag :vehicle_id, "车辆筛选", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= collection_select :vehicle, :id, Vehicle.order(:plate_number), :id, :plate_number, { selected: params[:vehicle_id], include_blank: "全部车辆" }, { class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-3 py-2 text-sm" } %>
          </div>
          <div>
            <%= label_tag :inspection_type, "检查类型", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= select_tag :inspection_type, options_for_select(InspectionRecord.inspection_types.keys.map { |k| [t("enums.inspection_record.inspection_type.#{k}", default: k.humanize), k] }, params[:inspection_type]), { include_blank: "全部类型", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-3 py-2 text-sm" } %>
          </div>
          <div>
            <%= label_tag :overall_result, "检查结果", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= select_tag :overall_result, options_for_select(InspectionRecord.overall_results.keys.map { |k| [t("enums.inspection_record.overall_result.#{k}", default: k.humanize), k] }, params[:overall_result]), { include_blank: "全部结果", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-3 py-2 text-sm" } %>
          </div>
          <div class="flex items-end gap-2">
            <%= link_to "重置", inspection_records_path, class: "flex-1 px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors text-sm text-center" %>
            <%= submit_tag "筛选", class: "flex-1 px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors text-sm cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">检查日期</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">车牌号</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">车队</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">类型</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">检查人</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">总体结果</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">异常项数</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">操作</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200" id="inspection-records">
            <% @inspection_records.each do |record| %>
              <% has_failures = record.failed_items.any? %>
              <tr class="<%= has_failures ? 'bg-red-50/60 hover:bg-red-50' : 'hover:bg-gray-50' %> transition-colors" id="<%= dom_id(record) %>">
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm font-medium text-gray-900"><%= record.inspection_date.strftime('%Y-%m-%d') %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm font-medium text-gray-900"><%= record.vehicle&.plate_number %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm text-gray-600"><%= record.vehicle&.fleet&.name %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% type_color = case record.inspection_type
                                  when 'pre_departure' then 'bg-green-100 text-green-800'
                                  when 'routine' then 'bg-blue-100 text-blue-800'
                                  when 'special' then 'bg-purple-100 text-purple-800'
                                  else 'bg-gray-100 text-gray-800'
                                  end %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= type_color %>">
                    <%= t("enums.inspection_record.inspection_type.#{record.inspection_type}", default: record.inspection_type.humanize) %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm text-gray-700"><%= record.inspector %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% result_color = case record.overall_result
                                   when 'pass' then 'bg-green-100 text-green-800'
                                   when 'fail' then 'bg-red-100 text-red-800'
                                   when 'conditional' then 'bg-yellow-100 text-yellow-800'
                                   else 'bg-gray-100 text-gray-800'
                                   end %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= result_color %>">
                    <%= t("enums.inspection_record.overall_result.#{record.overall_result}", default: record.overall_result.humanize) %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% count = record.failed_items.count %>
                  <% if count > 0 %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800">
                      <%= count %> 项异常
                    </span>
                  <% else %>
                    <span class="text-sm text-green-600 font-medium">全部正常</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "查看", inspection_record_path(record), class: "text-gray-600 hover:text-gray-900 px-3 py-1.5 rounded-md hover:bg-gray-100 transition-colors" %>
                    <%= link_to "编辑", edit_inspection_record_path(record), class: "text-blue-600 hover:text-blue-800 px-3 py-1.5 rounded-md hover:bg-blue-50 transition-colors" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @inspection_records.empty? %>
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <h3 class="mt-4 text-sm font-medium text-gray-900">暂无检查记录</h3>
          <p class="mt-1 text-sm text-gray-500">点击上方按钮创建新的检查记录</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
