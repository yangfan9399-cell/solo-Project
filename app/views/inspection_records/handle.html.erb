<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">处理台 - 缺陷整改</h1>
      <p class="text-sm text-gray-500 mt-1">记录编号：<%= @record.record_no %></p>
    </div>
    <div class="flex gap-3">
      <%= link_to '返回详情', @record, class: 'text-sm text-gray-500 hover:text-gray-700' %>
    </div>
  </div>

  <% if @record.archived? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <p class="text-sm text-yellow-800">该记录已归档，无法进行操作。</p>
    </div>
  <% else %>
    <%= render 'detail', record: @record, show_actions: false %>

    <div class="bg-white shadow rounded-lg">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">提交整改信息</h3>
        <p class="text-sm text-gray-500 mt-1">请填写业务记录、现场说明和整改措施，并上传相关证据。</p>
      </div>

      <div class="px-6 py-4">
        <%= form_with model: @correction, url: inspection_record_correction_records_path(@record), local: true do |form| %>
          <% if @correction.errors.any? %>
            <div class="mb-4 bg-red-50 border border-red-200 rounded-lg p-4">
              <h4 class="text-sm font-medium text-red-800">表单有以下错误：</h4>
              <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                <% @correction.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="space-y-4">
            <div>
              <%= form.label :business_record, '业务记录 *', class: 'block text-sm font-medium text-gray-700' %>
              <%= form.text_area :business_record, rows: 3, required: true, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请详细记录业务处理过程...' %>
            </div>

            <div>
              <%= form.label :site_description, '现场说明 *', class: 'block text-sm font-medium text-gray-700' %>
              <%= form.text_area :site_description, rows: 3, required: true, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请描述现场实际情况...' %>
            </div>

            <div>
              <%= form.label :correction_measure, '整改措施', class: 'block text-sm font-medium text-gray-700' %>
              <%= form.text_area :correction_measure, rows: 3, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请描述采取的具体整改措施...' %>
            </div>

            <div>
              <%= form.label :correction_result, '整改结果', class: 'block text-sm font-medium text-gray-700' %>
              <%= form.text_area :correction_result, rows: 3, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请描述整改完成后的结果...' %>
            </div>

            <div>
              <%= form.label :remark, '备注', class: 'block text-sm font-medium text-gray-700' %>
              <%= form.text_area :remark, rows: 2, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '其他需要说明的事项...' %>
            </div>

            <div>
              <%= form.label :correction_time, '整改时间 *', class: 'block text-sm font-medium text-gray-700' %>
              <%= form.datetime_field :correction_time, required: true, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-200">
              <%= link_to '取消', @record, class: 'px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50' %>
              <%= form.submit '保存整改记录', class: 'inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700' %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white shadow rounded-lg">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <div>
          <h3 class="text-lg font-medium text-gray-900">上传证据附件</h3>
          <p class="text-sm text-gray-500 mt-1">上传整改前后的对比照片、视频等证据材料。</p>
        </div>
        <%= link_to '上传附件', new_inspection_record_evidence_attachment_path(@record), class: 'inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700' %>
      </div>

      <% if @record.evidence_attachments.any? %>
        <div class="px-6 py-4">
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
            <% @record.evidence_attachments.each do |attachment| %>
              <%= render 'evidence_attachments/attachment', attachment: attachment %>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="px-6 py-12 text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">暂无证据附件</h3>
          <p class="mt-1 text-sm text-gray-500">请上传整改相关的证据材料</p>
        </div>
      <% end %>
    </div>

    <div class="bg-white shadow rounded-lg">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">工作流操作</h3>
        <p class="text-sm text-gray-500 mt-1">完成整改后提交复核，或执行其他状态操作。</p>
      </div>
      <div class="px-6 py-4">
        <div class="flex flex-wrap gap-3">
          <% @available_events.each do |event| %>
            <%= button_to workflow_event_inspection_record_path(@record),
                method: :post,
                params: { event: event },
                class: button_class_for_event(event),
                data: { confirm: "确认执行\"#{event_text(event)}\"操作？" } do %>
              <%= event_text(event) %>
            <% end %>
          <% end %>
          <% if @available_events.empty? %>
            <p class="text-sm text-gray-500">当前状态下无可执行的操作。</p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
