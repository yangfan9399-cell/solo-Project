<div class="max-w-5xl mx-auto">
  <div class="mb-6">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold text-gray-900">编辑巡检记录</h1>
      <span class="px-2 py-1 text-xs rounded-full <%= state_badge_class(@inspection_record.current_state) %>">
        <%= @inspection_record.current_state_text %>
      </span>
      <% if @inspection_record.archived? %>
        <span class="px-2 py-1 text-xs rounded-full bg-gray-100 text-gray-800">
          已归档，只读
        </span>
      <% end %>
    </div>
    <p class="text-sm text-gray-500 mt-1"><%= @inspection_record.record_no %> - <%= @inspection_record.toilet_name %></p>
  </div>

  <div class="bg-white shadow rounded-lg p-6">
    <% if @inspection_record.archived? %>
      <div class="mb-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-yellow-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div>
            <h4 class="text-sm font-medium text-yellow-800">记录已归档</h4>
            <p class="text-sm text-yellow-700 mt-1">该记录已归档，无法编辑。如需重新处理，请在详情页点击「重新处理」按钮，系统将创建新的处理节点。</p>
          </div>
        </div>
      </div>
      <div class="flex justify-end">
        <%= link_to '返回详情', @inspection_record, class: 'px-6 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50' %>
      </div>
    <% else %>
      <%= render 'form', record: @inspection_record %>
    <% end %>
  </div>
</div>
