<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">复核台</h1>
    <p class="text-sm text-gray-500 mt-1">质控复核人工作台</p>
  </div>

  <%= render 'statistics_panel', statistics: @statistics %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
      <div class="bg-white shadow rounded-lg mb-6">
        <div class="px-6 py-4 border-b border-gray-200 bg-purple-50">
          <h3 class="text-lg font-medium text-purple-800 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            待复核任务 (<%= @pending_review.count %>)
          </h3>
        </div>
        <div class="divide-y divide-gray-200">
          <% @pending_review.each do |record| %>
            <%= render 'record', record: record %>
          <% end %>
          <% if @pending_review.empty? %>
            <div class="px-6 py-12 text-center">
              <svg class="mx-auto h-12 w-12 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <h3 class="mt-2 text-sm font-medium text-gray-900">暂无待复核任务</h3>
              <p class="mt-1 text-sm text-gray-500">所有待复核任务都已处理完毕</p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200 bg-indigo-50">
          <h3 class="text-lg font-medium text-indigo-800 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            复核中任务 (<%= @reviewing.count %>)
          </h3>
        </div>
        <div class="divide-y divide-gray-200">
          <% @reviewing.each do |record| %>
            <%= render 'record', record: record %>
          <% end %>
          <% if @reviewing.empty? %>
            <div class="px-6 py-8 text-center text-sm text-gray-500">
              暂无复核中任务
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">最近已归档</h3>
        </div>
        <div class="divide-y divide-gray-200">
          <% @recently_archived.each do |record| %>
            <div class="px-6 py-3 hover:bg-gray-50">
              <div class="flex items-center justify-between">
                <%= link_to record.toilet_name, record, class: 'text-sm font-medium text-gray-900 hover:text-blue-600 truncate' %>
                <span class="text-xs text-gray-400"><%= time_ago_in_words(record.archived_at) %>前</span>
              </div>
              <p class="text-xs text-gray-500 mt-1"><%= record.record_no %></p>
              <div class="flex items-center gap-2 mt-1">
                <span class="text-xs <%= record.score_difference >= 0 ? 'text-green-600' : 'text-red-600' %>">
                  评分: <%= record.score_before %> → <%= record.score_after %>
                </span>
                <% if record.abnormal? %>
                  <span class="px-1.5 py-0.5 text-xs rounded bg-red-100 text-red-800"><%= record.sample_type_text %></span>
                <% end %>
              </div>
            </div>
          <% end %>
          <% if @recently_archived.empty? %>
            <div class="px-6 py-8 text-center text-sm text-gray-500">
              暂无已归档记录
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">快捷操作</h3>
        </div>
        <div class="p-4 space-y-2">
          <%= link_to inspection_records_path, class: 'w-full flex items-center justify-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50' do %>
            查看全部记录
          <% end %>
          <%= link_to statistics_inspection_records_path, class: 'w-full flex items-center justify-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50' do %>
            查看统计复盘
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
