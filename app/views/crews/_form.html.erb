<%= form_with(model: crew, local: true) do |form| %>
  <% if crew.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h2 class="text-lg font-semibold text-red-800 mb-2">
        有 <%= crew.errors.count %> 个错误需要修正
      </h2>
      <ul class="list-disc list-inside text-sm text-red-600">
        <% crew.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :name, "剧组名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :name, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500" %>
    </div>

    <div>
      <%= form.label :play_name, "剧目名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :play_name, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500" %>
    </div>

    <div>
      <%= form.label :leader_id, "剧组负责人", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.collection_select :leader_id, @users || User.all, :id, :name, { include_blank: "请选择负责人" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :start_date, "开始日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.date_field :start_date, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500" %>
      </div>
      <div>
        <%= form.label :end_date, "结束日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.date_field :end_date, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500" %>
      </div>
    </div>

    <div class="md:col-span-2">
      <%= form.label :description, "描述", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :description, rows: 3, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500" %>
    </div>
  </div>

  <div class="mt-8 flex justify-end space-x-3">
    <%= link_to "取消", crews_path, class: "px-6 py-2 border border-gray-300 rounded-lg hover:bg-gray-50" %>
    <%= form.submit class: "px-6 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 cursor-pointer" %>
  </div>
<% end %>
