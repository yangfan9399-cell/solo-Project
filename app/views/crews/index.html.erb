<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">剧组管理</h1>
    <%= link_to "新增剧组", new_crew_path, class: "px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @crews.each do |crew| %>
      <div class="bg-white rounded-lg shadow hover:shadow-md transition-shadow">
        <div class="p-6">
          <div class="flex items-start justify-between">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">
                <%= link_to crew.name, crew_path(crew), class: "hover:text-amber-600" %>
              </h3>
              <% if crew.play_name.present? %>
                <p class="text-sm text-gray-500 mt-1">🎬 <%= crew.play_name %></p>
              <% end %>
            </div>
            <div class="text-3xl">🎭</div>
          </div>
          <div class="mt-4 space-y-2 text-sm">
            <% if crew.leader.present? %>
              <p class="text-gray-600">
                <span class="text-gray-400">负责人：</span>
                <%= crew.leader.name %>
              </p>
            <% end %>
            <% if crew.start_date.present? %>
              <p class="text-gray-600">
                <span class="text-gray-400">演出周期：</span>
                <%= format_date(crew.start_date) %> - <%= format_date(crew.end_date) %>
              </p>
            <% end %>
            <p class="text-gray-600">
              <span class="text-gray-400">借调中道具：</span>
              <span class="font-medium text-amber-600"><%= crew.borrow_records.active.count %> 件</span>
            </p>
          </div>
          <% if crew.description.present? %>
            <p class="mt-3 text-sm text-gray-500 line-clamp-2"><%= crew.description %></p>
          <% end %>
        </div>
        <div class="px-6 py-3 bg-gray-50 rounded-b-lg">
          <%= link_to "查看详情", crew_path(crew), class: "text-sm text-amber-600 hover:text-amber-800 font-medium" %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @crews.empty? %>
    <div class="bg-white rounded-lg shadow p-12 text-center text-gray-500">
      暂无剧组数据
    </div>
  <% end %>
</div>
