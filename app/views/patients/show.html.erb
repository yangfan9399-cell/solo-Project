<div class="card">
  <div class="card-header">
    <h3>患者详情 - <%= @patient.name %></h3>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <table class="table table-borderless">
          <tr><th>姓名</th><td><%= @patient.name %></td></tr>
          <tr><th>身份证号</th><td><%= @patient.id_card %></td></tr>
          <tr><th>联系电话</th><td><%= @patient.phone %></td></tr>
          <tr><th>性别</th><td><%= @patient.gender %></td></tr>
          <tr><th>出生日期</th><td><%= @patient.birth_date %></td></tr>
          <tr><th>地址</th><td><%= @patient.address %></td></tr>
        </table>
      </div>
      <div class="col-md-6">
        <h4>检查记录</h4>
        <% if @patient.exams.any? %>
          <table class="table table-striped">
            <thead>
              <tr>
                <th>检查类型</th>
                <th>检查日期</th>
                <th>报告状态</th>
              </tr>
            </thead>
            <tbody>
              <% @patient.exams.each do |exam| %>
                <tr>
                  <td><%= exam.exam_type.humanize %></td>
                  <td><%= exam.exam_date %></td>
                  <td><%= exam.report ? exam.report.status.humanize : "未生成" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-muted">暂无检查记录</p>
        <% end %>
      </div>
    </div>
  </div>
  <div class="card-footer">
    <%= link_to "返回列表", patients_path, class: "btn btn-secondary" %>
  </div>
</div>