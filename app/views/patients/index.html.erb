<div class="row mb-4">
  <div class="col-md-6">
    <%= form_tag patients_path, method: :get do %>
      <div class="input-group">
        <%= text_field_tag :q, params[:q], placeholder: "搜索患者姓名、身份证号或电话", class: "form-control" %>
        <div class="input-group-append">
          <%= submit_tag "搜索", class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
  <div class="col-md-6 text-right">
    <%= link_to "新增患者", new_patient_path, class: "btn btn-primary" %>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3>患者列表</h3>
  </div>
  <div class="card-body p-0">
    <table class="table table-striped table-hover">
      <thead>
        <tr>
          <th>姓名</th>
          <th>身份证号</th>
          <th>电话</th>
          <th>性别</th>
          <th>出生日期</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @patients.each do |patient| %>
          <tr>
            <td><%= link_to patient.name, patient %></td>
            <td><%= patient.id_card %></td>
            <td><%= patient.phone %></td>
            <td><%= patient.gender %></td>
            <td><%= patient.birth_date %></td>
            <td><%= link_to "查看", patient, class: "btn btn-info btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
</div>