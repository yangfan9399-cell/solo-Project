<% content_for :title, "版本历史 - #{@component.full_code}" %>

<div class="space-y-6">
  <nav class="text-sm text-stone-500">
    <ol class="flex items-center space-x-2">
      <li><%= link_to "项目台账", projects_path, class: "hover:text-amber-600" %></li>
      <li class="text-stone-300">/</li>
      <li><%= link_to @project.name, project_path(@project), class: "hover:text-amber-600" %></li>
      <li class="text-stone-300">/</li>
      <li><%= link_to @component.code, project_component_path(@project, @component), class: "hover:text-amber-600" %></li>
      <li class="text-stone-300">/</li>
      <li class="text-stone-700 font-medium">版本历史</li>
    </ol>
  </nav>

  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-stone-800">版本历史</h1>
      <p class="text-stone-500 mt-1">构件 <%= @component.full_code %> 的所有版本记录</p>
    </div>
    <%= link_to "返回构件", project_component_path(@project, @component), class: "px-4 py-2 border border-stone-300 rounded-lg text-stone-700 hover:bg-stone-50 transition-colors" %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-stone-100 bg-stone-50/50">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-stone-800">版本记录</h2>
        <span class="text-sm text-stone-500">共 <%= @total_count %> 个版本</span>
      </div>
    </div>

    <% if @versions.any? %>
      <div class="divide-y divide-stone-100">
        <% @versions.each_with_index do |version, index| %>
          <div class="p-6 hover:bg-stone-50/50 transition-colors">
            <div class="flex items-start justify-between">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0">
                  <div class="w-10 h-10 rounded-full <%= index == 0 ? 'bg-amber-100 text-amber-700' : 'bg-stone-100 text-stone-600' %> flex items-center justify-center font-bold text-sm">
                    v<%= version.version_number %>
                  </div>
                </div>
                <div class="flex-1">
                  <div class="flex items-center space-x-3 mb-1">
                    <span class="font-semibold text-stone-800">版本 <%= version.version_number %></span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-stone-100 text-stone-700">
                      <%= version.event_type %>
                    </span>
                    <% if index == 0 %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700">
                        当前版本
                      </span>
                    <% end %>
                  </div>
                  <p class="text-stone-600 text-sm mb-2"><%= version.notes.presence || '无备注' %></p>
                  <% if version.changed_fields.present? && version.changed_fields.any? %>
                    <div class="flex flex-wrap gap-1 mb-2">
                      <% version.changed_fields.each do |field| %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs bg-blue-50 text-blue-700">
                          <%= field %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                  <div class="flex items-center space-x-4 text-xs text-stone-400">
                    <span>操作人：<%= version.operator.presence || '系统' %></span>
                    <span>时间：<%= version.recorded_at&.strftime('%Y-%m-%d %H:%M') %></span>
                    <% if version.batch_tag.present? %>
                      <span>批次：<%= version.batch_tag %></span>
                    <% end %>
                  </div>
                </div>
              </div>
              <div class="flex items-center space-x-2 ml-4">
                <%= link_to "查看详情", project_component_component_version_path(@project, @component, version), class: "text-amber-600 hover:text-amber-700 text-sm font-medium" %>
                <% unless index == 0 %>
                  <%= button_to "回滚到此版本", rollback_project_component_path(@project, @component, version_number: version.version_number), method: :post, class: "text-stone-500 hover:text-stone-700 text-sm", data: { confirm: "确定要回滚到版本 #{version.version_number} 吗？这将覆盖当前构件数据。" } %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @total_pages > 1 %>
        <div class="px-6 py-4 border-t border-stone-100 bg-stone-50/30">
          <div class="flex items-center justify-between">
            <span class="text-sm text-stone-500">
              显示 <%= (@page - 1) * @per_page + 1 %> - <%= [(@page - 1) * @per_page + @per_page, @total_count].min %> 条，共 <%= @total_count %> 条
            </span>
            <div class="flex space-x-1">
              <% if @page == 1 %>
                <span class="px-3 py-1 text-sm text-stone-300">上一页</span>
              <% else %>
                <%= link_to "上一页", project_component_component_versions_path(@project, @component, page: @page - 1), class: "px-3 py-1 text-sm text-amber-600 hover:bg-amber-50 rounded" %>
              <% end %>
              <% if @page == @total_pages %>
                <span class="px-3 py-1 text-sm text-stone-300">下一页</span>
              <% else %>
                <%= link_to "下一页", project_component_component_versions_path(@project, @component, page: @page + 1), class: "px-3 py-1 text-sm text-amber-600 hover:bg-amber-50 rounded" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="p-12 text-center">
        <svg class="w-16 h-16 text-stone-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-stone-500">暂无版本记录</p>
      </div>
    <% end %>
  </div>
</div>
