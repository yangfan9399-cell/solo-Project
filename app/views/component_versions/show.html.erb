<% content_for :title, "版本 #{@version.version_number} - #{@component.full_code}" %>

<div class="space-y-6">
  <nav class="text-sm text-stone-500">
    <ol class="flex items-center space-x-2">
      <li><%= link_to "项目台账", projects_path, class: "hover:text-amber-600" %></li>
      <li class="text-stone-300">/</li>
      <li><%= link_to @project.name, project_path(@project), class: "hover:text-amber-600" %></li>
      <li class="text-stone-300">/</li>
      <li><%= link_to @component.code, project_component_path(@project, @component), class: "hover:text-amber-600" %></li>
      <li class="text-stone-300">/</li>
      <li><%= link_to "版本历史", project_component_component_versions_path(@project, @component), class: "hover:text-amber-600" %></li>
      <li class="text-stone-300">/</li>
      <li class="text-stone-700 font-medium">版本 <%= @version.version_number %></li>
    </ol>
  </nav>

  <div class="flex items-center justify-between">
    <div>
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl font-bold text-stone-800">版本 <%= @version.version_number %></h1>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-stone-700">
          <%= @version.event_type %>
        </span>
        <% if @version == @component.latest_version %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">
            当前版本
          </span>
        <% end %>
      </div>
      <p class="text-stone-500 mt-1">构件 <%= @component.full_code %> 的版本快照</p>
    </div>
    <div class="flex space-x-3">
      <%= link_to "返回列表", project_component_component_versions_path(@project, @component), class: "px-4 py-2 border border-stone-300 rounded-lg text-stone-700 hover:bg-stone-50 transition-colors" %>
      <% if @version != @component.latest_version %>
        <%= button_to "回滚到此版本", rollback_project_component_path(@project, @component, version_number: @version.version_number), method: :post, class: "px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors font-medium", data: { confirm: "确定要回滚到版本 #{@version.version_number} 吗？这将覆盖当前构件数据。" } %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-stone-100 bg-stone-50/50">
          <h2 class="text-lg font-semibold text-stone-800">对象快照</h2>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-2 gap-6">
            <div>
              <span class="text-sm text-stone-500 block mb-1">构件编号</span>
              <span class="text-stone-800 font-medium"><%= @snapshot["code"] || @version.code %></span>
            </div>
            <div>
              <span class="text-sm text-stone-500 block mb-1">构件类型</span>
              <span class="text-stone-800"><%= @snapshot["component_type"] || @version.component_type %></span>
            </div>
            <div>
              <span class="text-sm text-stone-500 block mb-1">所在位置</span>
              <span class="text-stone-800"><%= @snapshot["position"].presence || @version.position.presence || '-' %></span>
            </div>
            <div>
              <span class="text-sm text-stone-500 block mb-1">朝向</span>
              <span class="text-stone-800"><%= @snapshot["orientation"].presence || @version.orientation.presence || '-' %></span>
            </div>
            <div>
              <span class="text-sm text-stone-500 block mb-1">状态</span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-stone-700">
                <%= @snapshot["status"] || @version.status %>
              </span>
            </div>
            <% if @version.batch_tag.present? %>
              <div>
                <span class="text-sm text-stone-500 block mb-1">批次标签</span>
                <span class="text-stone-800"><%= @version.batch_tag %></span>
              </div>
            <% end %>
          </div>
          <% if (@snapshot["notes"].presence || @version.notes.present?) %>
            <div class="mt-6 pt-6 border-t border-stone-100">
              <span class="text-sm text-stone-500 block mb-2">备注</span>
              <p class="text-stone-700 whitespace-pre-wrap"><%= @snapshot["notes"].presence || @version.notes %></p>
            </div>
          <% end %>
        </div>
      </div>

      <% if @version.changed_fields.present? && @version.changed_fields.any? %>
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
          <div class="px-6 py-4 border-b border-stone-100 bg-stone-50/50">
            <h2 class="text-lg font-semibold text-stone-800">变更字段</h2>
          </div>
          <div class="p-6">
            <div class="flex flex-wrap gap-2">
              <% @version.changed_fields.each do |field| %>
                <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm bg-blue-50 text-blue-700 font-medium">
                  <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                  </svg>
                  <%= field %>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-stone-100 bg-stone-50/50">
          <h2 class="text-lg font-semibold text-stone-800">版本信息</h2>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <span class="text-sm text-stone-500 block mb-1">版本号</span>
            <span class="text-stone-800 font-medium"><%= @version.version_number %></span>
          </div>
          <div>
            <span class="text-sm text-stone-500 block mb-1">事件类型</span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-stone-700">
              <%= @version.event_type %>
            </span>
          </div>
          <div>
            <span class="text-sm text-stone-500 block mb-1">操作人</span>
            <span class="text-stone-800"><%= @version.operator.presence || '系统' %></span>
          </div>
          <div>
            <span class="text-sm text-stone-500 block mb-1">记录时间</span>
            <span class="text-stone-800"><%= @version.recorded_at&.strftime('%Y年%m月%d日 %H:%M') %></span>
          </div>
          <% if @version.batch_tag.present? %>
            <div>
              <span class="text-sm text-stone-500 block mb-1">批次标签</span>
              <span class="text-stone-800"><%= @version.batch_tag %></span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-stone-100 bg-stone-50/50">
          <h2 class="text-lg font-semibold text-stone-800">操作</h2>
        </div>
        <div class="p-6 space-y-3">
          <% if @version.previous_version %>
            <%= link_to "上一版本 (v#{@version.previous_version.version_number})", project_component_component_version_path(@project, @component, @version.previous_version), class: "block w-full text-center px-4 py-2 border border-stone-300 rounded-lg text-stone-700 hover:bg-stone-50 transition-colors font-medium" %>
          <% else %>
            <span class="block w-full text-center px-4 py-2 border border-stone-200 rounded-lg text-stone-300 font-medium cursor-not-allowed">已是第一个版本</span>
          <% end %>
          <% if @version.next_version %>
            <%= link_to "下一版本 (v#{@version.next_version.version_number})", project_component_component_version_path(@project, @component, @version.next_version), class: "block w-full text-center px-4 py-2 border border-stone-300 rounded-lg text-stone-700 hover:bg-stone-50 transition-colors font-medium" %>
          <% else %>
            <span class="block w-full text-center px-4 py-2 border border-stone-200 rounded-lg text-stone-300 font-medium cursor-not-allowed">已是最新版本</span>
          <% end %>
          <% if @version != @component.latest_version %>
            <div class="pt-3 border-t border-stone-100">
              <%= button_to "回滚到此版本", rollback_project_component_path(@project, @component, version_number: @version.version_number), method: :post, class: "w-full px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors font-medium", data: { confirm: "确定要回滚到版本 #{@version.version_number} 吗？这将覆盖当前构件数据。" } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
