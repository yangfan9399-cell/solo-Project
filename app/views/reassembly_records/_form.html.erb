<%= form_with model: [@project, @component, @reassembly_record], class: "space-y-6" do |form| %>
  <% if @reassembly_record.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-red-800 font-medium mb-2">发现 <%= @reassembly_record.errors.count %> 个错误：</h3>
      <ul class="text-red-600 text-sm list-disc list-inside">
        <% @reassembly_record.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :checked_by, class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.text_field :checked_by, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500", placeholder: "核对人姓名" %>
    </div>

    <div>
      <%= form.label :checked_at, class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.datetime_field :checked_at, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
    </div>

    <div>
      <%= form.label :result, class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.select :result, ReassemblyRecord::RESULTS, { include_blank: "请选择核对结果" }, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 bg-white" %>
    </div>

    <div>
      <%= form.label :position_deviation, class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.text_field :position_deviation, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500", placeholder: "位置偏差描述" %>
    </div>

    <div class="flex items-end">
      <label class="flex items-center space-x-2 cursor-pointer">
        <%= form.check_box :verified, class: "w-4 h-4 text-amber-600 border-stone-300 rounded focus:ring-amber-500" %>
        <span class="text-sm font-medium text-stone-700">已验证</span>
      </label>
    </div>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-medium text-stone-700 mb-2" %>
    <%= form.text_area :notes, rows: 4, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500", placeholder: "备注信息" %>
  </div>

  <div class="flex justify-end space-x-3 pt-4 border-t border-stone-200">
    <%= link_to "取消", project_component_reassembly_records_path(@project, @component), class: "px-4 py-2 border border-stone-300 rounded-lg text-stone-700 hover:bg-stone-50 transition-colors" %>
    <%= form.submit class: "px-6 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors font-medium cursor-pointer" %>
  </div>
<% end %>
