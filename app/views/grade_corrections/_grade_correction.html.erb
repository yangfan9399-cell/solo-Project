<%= turbo_frame_tag dom_id(grade_correction) do %>
  <%= link_to grade_correction, class: "block hover:bg-gray-50 transition-colors" do %>
    <div class="px-6 py-4">
      <div class="flex items-start justify-between">
        <div class="flex-1 min-w-0">
          <div class="flex items-center space-x-3">
            <h3 class="text-sm font-medium text-gray-900 truncate">
              <%= grade_correction.application_no %>
              <span class="text-gray-500 font-normal"><%= grade_correction.student_name %></span>
            </h3>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
              <%= case grade_correction.status
                  when 'pending' then 'bg-yellow-100 text-yellow-800'
                  when 'accepted' then 'bg-blue-100 text-blue-800'
                  when 'processing' then 'bg-blue-100 text-blue-800'
                  when 'reviewing' then 'bg-purple-100 text-purple-800'
                  when 'archived' then 'bg-green-100 text-green-800'
                  when 'rejected' then 'bg-red-100 text-red-800'
                  when 'returned' then 'bg-orange-100 text-orange-800'
                  else 'bg-gray-100 text-gray-800'
                  end %>">
              <%= grade_correction.status_i18n %>
            </span>
            <% if grade_correction.has_block_reason? %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                异常
              </span>
            <% end %>
            <% unless grade_correction.notification_confirmed? %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                待确认
              </span>
            <% end %>
          </div>
          <p class="mt-1 text-sm text-gray-500">
            <%= grade_correction.course_name %>
            <span class="mx-2">·</span>
            原始 <span class="font-medium"><%= grade_correction.original_score %></span>
            →
            更正 <span class="font-medium text-blue-600"><%= grade_correction.corrected_score %></span>
            <span class="ml-2">(+<%= grade_correction.score_diff %>)</span>
          </p>
          <div class="mt-2 flex items-center text-xs text-gray-400 space-x-4">
            <span><%= grade_correction.source_i18n %></span>
            <span>申请人: <%= grade_correction.applicant %></span>
            <span>责任人: <%= grade_correction.current_owner&.name || '未分配' %></span>
            <span><%= time_ago_in_words(grade_correction.created_at) %>前提交</span>
          </div>
        </div>
        <div class="ml-4 flex-shrink-0 flex items-center space-x-2">
          <% if grade_correction.evidence_conclusion.present? %>
            <span class="text-xs text-gray-500">
              <%= grade_correction.evidence_conclusion_i18n %>
            </span>
          <% end %>
          <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
