<div class="row">
  <div class="col-12">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><%= @run_chart.name %> - 数字化标注工作台</h1>
      <div class="btn-group">
        <a href="<%= project_run_chart_path(@run_chart.project, @run_chart) %>" class="btn btn-outline-secondary">返回详情</a>
        <button onclick="generateVersion()" class="btn btn-outline-primary">生成版本</button>
      </div>
    </div>

    <% if @annotations.any? %>
      <div class="alert alert-warning d-flex align-items-center mb-4">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        <span>检测到 <%= @annotations.count %> 个异常数据，请查看右侧异常列表</span>
      </div>
    <% end %>

    <div class="row">
      <div class="col-8">
        <div class="card mb-4">
          <div class="card-header bg-light">
            <div class="d-flex justify-content-between align-items-center">
              <span><i class="fa-solid fa-crosshairs me-2"></i>坐标轴标定</span>
              <button onclick="toggleCalibration()" class="btn btn-sm btn-outline-primary">标定设置</button>
            </div>
          </div>
          <div class="card-body">
            <div id="calibration-panel" class="mb-4" style="display: none;">
              <form id="calibration-form" class="row g-3">
                <input type="hidden" name="run_chart_id" value="<%= @run_chart.id %>">
                <div class="col-md-2">
                  <label>X轴比例</label>
                  <input type="number" step="0.1" name="scale_x" class="form-control" value="<%= @run_chart.scale_x %>">
                </div>
                <div class="col-md-2">
                  <label>Y轴比例</label>
                  <input type="number" step="0.1" name="scale_y" class="form-control" value="<%= @run_chart.scale_y %>">
                </div>
                <div class="col-md-2">
                  <label>X轴偏移</label>
                  <input type="number" step="0.1" name="offset_x" class="form-control" value="<%= @run_chart.offset_x %>">
                </div>
                <div class="col-md-2">
                  <label>Y轴偏移</label>
                  <input type="number" step="0.1" name="offset_y" class="form-control" value="<%= @run_chart.offset_y %>">
                </div>
                <div class="col-md-4">
                  <label>&nbsp;</label>
                  <button type="button" onclick="submitCalibration()" class="btn btn-primary w-100">应用标定</button>
                </div>
              </form>
            </div>

            <div class="bg-light border rounded p-4" style="min-height: 500px; position: relative; overflow: hidden;" id="canvas-container">
              <div class="position-absolute top-2 left-2 text-xs text-muted z-10">
                刻度: X=<%= @run_chart.scale_x %>px/单位, Y=<%= @run_chart.scale_y %>px/单位
              </div>

              <svg id="run-chart-svg" width="100%" height="100%" viewBox="0 0 400 350" class="border" onclick="handleCanvasClick(event)">
                <defs>
                  <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                    <polygon points="0 0, 10 3.5, 0 7" fill="#666"/>
                  </marker>
                  <marker id="station-marker" markerWidth="12" markerHeight="12" refX="6" refY="6">
                    <circle cx="6" cy="6" r="5" fill="white" stroke="#0D6EFD" stroke-width="2"/>
                  </marker>
                </defs>

                <line x1="60" y1="320" x2="380" y2="320" stroke="#666" stroke-width="2"/>
                <line x1="60" y1="320" x2="60" y2="30" stroke="#666" stroke-width="2"/>

                <text x="385" y="325" font-size="12" fill="#666">时间轴</text>
                <text x="25" y="25" font-size="12" fill="#666" transform="rotate(-90 25 25)">距离轴</text>

                <% (0..8).each do |i| %>
                  <line x1="60 + i * 40" y1="320" x2="60 + i * 40" y2="325" stroke="#666"/>
                  <text x="60 + i * 40 - 10" y="335" font-size="10" fill="#666"><%= i * 2 %></text>
                <% end %>

                <% (0..6).each do |i| %>
                  <line x1="60" y1="320 - i * 50" x2="55" y2="320 - i * 50" stroke="#666"/>
                  <text x="45" y="320 - i * 50 + 3" font-size="10" fill="#666"><%= i * 100 %></text>
                <% end %>

                <% @train_routes.each do |route| %>
                  <path d="<%= route.path_data %>" stroke="<%= route.color %>" stroke-width="3" fill="none" marker-end="url(#arrowhead)" class="route-path cursor-pointer" onclick="event.stopPropagation(); selectRoute('<%= route.id %>')"/>
                <% end %>

                <% @stations.each do |station| %>
                  <circle cx="<%= station.x_coordinate %>" cy="<%= station.y_coordinate %>" r="6" fill="white" stroke="<%= station.train_route.color %>" stroke-width="2" class="station-point cursor-pointer" onclick="event.stopPropagation(); selectStation('<%= station.id %>')"/>
                  <text x="<%= station.x_coordinate + 10 %>" y="<%= station.y_coordinate + 3 %>" font-size="11" fill="#333"><%= station.name %></text>
                <% end %>

                <% @annotations.each do |annotation| %>
                  <circle cx="<%= annotation.x %>" cy="<%= annotation.y %>" r="8" fill="#DC3545" class="anomaly-marker animate-pulse" title="<%= annotation.content %>" onclick="event.stopPropagation(); showAnnotationDetail('<%= annotation.id %>')"/>
                  <text x="<%= annotation.x + 12 %>" y="<%= annotation.y - 5 %>" font-size="10" fill="#DC3545">!</text>
                <% end %>

                <g id="drawing-path" style="display: none;">
                  <path id="temp-path" stroke="#DC3545" stroke-width="3" fill="none" stroke-dasharray="5,5"/>
                </g>

                <g id="new-stations">
                </g>
              </svg>

              <div class="position-absolute bottom-2 right-2 z-10">
                <div class="btn-group btn-group-sm">
                  <button class="btn btn-outline-secondary" onclick="zoomIn()"><i class="fa-solid fa-magnifying-glass-plus"></i></button>
                  <button class="btn btn-outline-secondary" onclick="zoomOut()"><i class="fa-solid fa-magnifying-glass-minus"></i></button>
                  <button class="btn btn-outline-secondary" onclick="resetView()"><i class="fa-solid fa-arrows-rotate"></i></button>
                </div>
              </div>

              <div class="position-absolute top-2 right-2 z-10 bg-white px-3 py-2 rounded shadow">
                <span class="text-sm font-medium">当前模式:</span>
                <span id="current-mode" class="badge bg-primary ml-2">浏览</span>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header bg-light">
            <span><i class="fa-solid fa-train me-2"></i>列车径路列表</span>
          </div>
          <div class="card-body p-0">
            <table class="table table-hover mb-0">
              <thead class="bg-light">
                <tr>
                  <th width="20">#</th>
                  <th width="100">车次</th>
                  <th width="80">类型</th>
                  <th>起讫站</th>
                  <th width="80">站点数</th>
                  <th width="80">状态</th>
                  <th width="100">操作</th>
                </tr>
              </thead>
              <tbody>
                <% @train_routes.each_with_index do |route, index| %>
                  <tr class="route-row" data-id="<%= route.id %>">
                    <td><%= index + 1 %></td>
                    <td><span class="badge" style="background-color: <%= route.color %>"><%= route.train_no %></span></td>
                    <td><%= route.train_type_label %></td>
                    <td><%= route.start_station&.name %> - <%= route.end_station&.name %></td>
                    <td><%= route.stations.count %></td>
                    <td>
                      <span class="badge bg-<%= route.status == 'validated' ? 'success' : route.status == 'corrected' ? 'warning' : 'secondary' %>">
                        <%= route.status_label %>
                      </span>
                    </td>
                    <td>
                      <div class="btn-group btn-group-sm">
                        <a href="<%= project_run_chart_train_route_path(@run_chart.project, @run_chart, route) %>" class="btn btn-outline-primary"><i class="fa-solid fa-eye"></i></a>
                        <a href="<%= edit_project_run_chart_train_route_path(@run_chart.project, @run_chart, route) %>" class="btn btn-outline-secondary"><i class="fa-solid fa-pencil"></i></a>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="col-4">
        <div class="card mb-4">
          <div class="card-header bg-danger text-white">
            <span><i class="fa-solid fa-exclamation-circle me-2"></i>异常数据提示</span>
            <span class="badge bg-white text-danger ms-2"><%= @annotations.count %></span>
          </div>
          <div class="card-body">
            <% if @annotations.any? %>
              <div class="list-group">
                <% @annotations.each do |annotation| %>
                  <div class="list-group-item d-flex justify-content-between align-items-start">
                    <div>
                      <div class="d-flex align-items-center">
                        <span class="badge bg-danger me-2"><%= annotation.type_label %></span>
                        <span class="text-xs text-muted"><%= annotation.created_at.strftime('%m-%d %H:%M') %></span>
                      </div>
                      <p class="mt-1 text-sm"><%= annotation.content %></p>
                    </div>
                    <select class="form-select form-select-sm" onchange="updateAnnotationStatus('<%= annotation.id %>', this.value)">
                      <% Annotation.status_options.each do |label, value| %>
                        <option value="<%= value %>" <%= 'selected' if annotation.status == value %>><%= label %></option>
                      <% end %>
                    </select>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-4 text-muted">
                <i class="fa-solid fa-check-circle fa-3x mb-2"></i>
                <p>暂无异常数据</p>
              </div>
            <% end %>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-header bg-light">
            <span><i class="fa-solid fa-tools me-2"></i>工具栏</span>
          </div>
          <div class="card-body">
            <div class="grid gap-2">
              <button id="btn-draw" onclick="startDrawing()" class="btn btn-primary w-100"><i class="fa-solid fa-pen-to-square me-2"></i>描线模式</button>
              <button id="btn-station" onclick="startStation()" class="btn btn-info w-100"><i class="fa-solid fa-map-pin me-2"></i>添加站点</button>
              <button id="btn-annotation" onclick="startAnnotation()" class="btn btn-warning w-100"><i class="fa-solid fa-sticky-note me-2"></i>添加标注</button>
              <button id="btn-browse" onclick="startBrowse()" class="btn btn-secondary w-100"><i class="fa-solid fa-eye me-2"></i>浏览模式</button>
              <hr>
              <button onclick="runDetection()" class="btn btn-danger w-100"><i class="fa-solid fa-search-minus me-2"></i>检测异常</button>
              <hr>
              <a href="<%= project_run_chart_export_json_path(@run_chart.project, @run_chart) %>" class="btn btn-outline-success w-100"><i class="fa-solid fa-download me-2"></i>导出JSON</a>
              <a href="<%= project_run_chart_export_summary_path(@run_chart.project, @run_chart) %>" class="btn btn-outline-primary w-100"><i class="fa-solid fa-file-export me-2"></i>导出摘要</a>
            </div>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-header bg-light">
            <span><i class="fa-solid fa-bar-chart me-2"></i>统计摘要</span>
          </div>
          <div class="card-body">
            <div class="row text-center">
              <div class="col-4">
                <div class="text-2xl font-bold text-primary"><%= @train_routes.count %></div>
                <div class="text-xs text-muted">列车径路</div>
              </div>
              <div class="col-4">
                <div class="text-2xl font-bold text-success"><%= @stations.count %></div>
                <div class="text-xs text-muted">停站点</div>
              </div>
              <div class="col-4">
                <div class="text-2xl font-bold text-danger"><%= @annotations.count %></div>
                <div class="text-xs text-muted">异常数</div>
              </div>
            </div>
          </div>
        </div>

        <div class="card" id="drawing-panel" style="display: none;">
          <div class="card-header bg-primary text-white">
            <span><i class="fa-solid fa-pen-to-square me-2"></i>描线设置</span>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label>车次</label>
              <input type="text" id="draw-train-no" class="form-control" placeholder="输入车次">
            </div>
            <div class="mb-3">
              <label>列车类型</label>
              <select id="draw-train-type" class="form-select">
                <% TrainRoute.train_type_options.each do |label, value| %>
                  <option value="<%= value %>"><%= label %></option>
                <% end %>
              </select>
            </div>
            <div class="mb-3">
              <label>颜色</label>
              <input type="color" id="draw-color" class="form-control" value="#0D6EFD">
            </div>
            <div class="text-sm text-muted mb-3">
              <p><i class="fa-solid fa-circle-info me-1"></i>点击画布添加路径点</p>
              <p><i class="fa-solid fa-circle-info me-1"></i>双击结束绘制</p>
            </div>
            <div class="btn-group w-100">
              <button onclick="cancelDrawing()" class="btn btn-outline-secondary">取消</button>
              <button onclick="saveRoute()" class="btn btn-primary">保存径路</button>
            </div>
          </div>
        </div>

        <div class="card" id="station-panel" style="display: none;">
          <div class="card-header bg-info text-white">
            <span><i class="fa-solid fa-map-pin me-2"></i>添加站点</span>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label>所属列车径路</label>
              <select id="station-train-route" class="form-select">
                <% @train_routes.each do |route| %>
                  <option value="<%= route.id %>"><%= route.train_no %> (<%= route.train_type_label %>)</option>
                <% end %>
              </select>
            </div>
            <div class="mb-3">
              <label>站点名称</label>
              <input type="text" id="station-name" class="form-control" placeholder="输入站点名称">
            </div>
            <div class="mb-3">
              <label>到达时间</label>
              <input type="time" id="station-arrival" class="form-control">
            </div>
            <div class="mb-3">
              <label>出发时间</label>
              <input type="time" id="station-departure" class="form-control">
            </div>
            <div class="mb-3">
              <label>停站时长(分)</label>
              <input type="number" id="station-duration" class="form-control" min="0">
            </div>
            <div class="text-sm text-muted mb-3">
              <p><i class="fa-solid fa-circle-info me-1"></i>点击画布上的位置添加站点</p>
            </div>
            <div class="btn-group w-100">
              <button onclick="cancelStation()" class="btn btn-outline-secondary">取消</button>
              <button onclick="saveStation()" class="btn btn-info">保存站点</button>
            </div>
          </div>
        </div>

        <div class="card" id="annotation-panel" style="display: none;">
          <div class="card-header bg-warning text-white">
            <span><i class="fa-solid fa-sticky-note me-2"></i>添加标注</span>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label>标注类型</label>
              <select id="annotation-type" class="form-select">
                <% Annotation.type_options.each do |label, value| %>
                  <option value="<%= value %>"><%= label %></option>
                <% end %>
              </select>
            </div>
            <div class="mb-3">
              <label>标注内容</label>
              <textarea id="annotation-content" class="form-control" rows="3" placeholder="输入标注内容"></textarea>
            </div>
            <div class="text-sm text-muted mb-3">
              <p><i class="fa-solid fa-circle-info me-1"></i>点击画布上的位置添加标注</p>
            </div>
            <div class="btn-group w-100">
              <button onclick="cancelAnnotation()" class="btn btn-outline-secondary">取消</button>
              <button onclick="saveAnnotation()" class="btn btn-warning">保存标注</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
let currentMode = 'browse';
let drawingPoints = [];
let currentStation = null;
let currentAnnotation = null;
let zoomLevel = 1;

function toggleCalibration() {
  document.getElementById('calibration-panel').style.display = 
    document.getElementById('calibration-panel').style.display === 'none' ? 'block' : 'none';
}

function submitCalibration() {
  const form = document.getElementById('calibration-form');
  const data = new FormData(form);
  fetch('<%= project_run_chart_calibrate_path(@run_chart.project, @run_chart) %>', {
    method: 'POST',
    body: data,
    headers: { 'X-CSRF-Token': '<%= form_authenticity_token %>' }
  }).then(() => location.reload());
}

function selectRoute(id) {
  document.querySelectorAll('.route-row').forEach(r => r.classList.remove('table-primary'));
  document.querySelector(`.route-row[data-id="${id}"]`)?.classList.add('table-primary');
}

function selectStation(id) {
  alert('站点ID: ' + id);
}

function updateAnnotationStatus(id, status) {
  fetch(`/annotations/${id}`, {
    method: 'PATCH',
    headers: { 
      'Content-Type': 'application/json',
      'X-CSRF-Token': '<%= form_authenticity_token %>'
    },
    body: JSON.stringify({ annotation: { status } })
  });
}

function showAnnotationDetail(id) {
  alert('标注ID: ' + id);
}

function generateVersion() {
  fetch('<%= project_run_chart_path(@run_chart.project, @run_chart) %>/versions', {
    method: 'POST',
    headers: { 'X-CSRF-Token': '<%= form_authenticity_token %>' }
  }).then(() => location.reload());
}

function runDetection() {
  fetch('<%= project_run_chart_detect_anomalies_path(@run_chart.project, @run_chart) %>', {
    method: 'GET'
  }).then(() => location.reload());
}

function startDrawing() {
  setMode('drawing');
  drawingPoints = [];
  document.getElementById('drawing-path').style.display = 'block';
  document.getElementById('drawing-panel').style.display = 'block';
  document.getElementById('station-panel').style.display = 'none';
  document.getElementById('annotation-panel').style.display = 'none';
}

function startStation() {
  setMode('station');
  document.getElementById('station-panel').style.display = 'block';
  document.getElementById('drawing-panel').style.display = 'none';
  document.getElementById('annotation-panel').style.display = 'none';
}

function startAnnotation() {
  setMode('annotation');
  document.getElementById('annotation-panel').style.display = 'block';
  document.getElementById('drawing-panel').style.display = 'none';
  document.getElementById('station-panel').style.display = 'none';
}

function startBrowse() {
  setMode('browse');
  document.getElementById('drawing-panel').style.display = 'none';
  document.getElementById('station-panel').style.display = 'none';
  document.getElementById('annotation-panel').style.display = 'none';
  document.getElementById('drawing-path').style.display = 'none';
}

function setMode(mode) {
  currentMode = mode;
  const modeText = {
    'browse': '浏览',
    'drawing': '描线',
    'station': '添加站点',
    'annotation': '添加标注'
  };
  document.getElementById('current-mode').textContent = modeText[mode];
  document.getElementById('current-mode').className = `badge bg-${mode === 'browse' ? 'secondary' : mode === 'drawing' ? 'danger' : mode === 'station' ? 'info' : 'warning'} ml-2`;
  
  document.getElementById('btn-draw').className = mode === 'drawing' ? 'btn btn-danger w-100' : 'btn btn-primary w-100';
  document.getElementById('btn-station').className = mode === 'station' ? 'btn btn-danger w-100' : 'btn btn-info w-100';
  document.getElementById('btn-annotation').className = mode === 'annotation' ? 'btn btn-danger w-100' : 'btn btn-warning w-100';
  document.getElementById('btn-browse').className = mode === 'browse' ? 'btn btn-danger w-100' : 'btn btn-secondary w-100';
}

function handleCanvasClick(event) {
  const svg = document.getElementById('run-chart-svg');
  const rect = svg.getBoundingClientRect();
  const scaleX = svg.viewBox.baseVal.width / rect.width;
  const scaleY = svg.viewBox.baseVal.height / rect.height;
  const x = (event.clientX - rect.left) * scaleX;
  const y = (event.clientY - rect.top) * scaleY;

  if (currentMode === 'drawing') {
    drawingPoints.push({ x, y });
    updateTempPath();
  } else if (currentMode === 'station') {
    currentStation = { x, y };
    addTempStation(x, y);
  } else if (currentMode === 'annotation') {
    currentAnnotation = { x, y };
    addTempAnnotation(x, y);
  }
}

function updateTempPath() {
  if (drawingPoints.length < 2) return;
  
  let pathData = `M ${drawingPoints[0].x},${drawingPoints[0].y}`;
  drawingPoints.forEach(point => {
    pathData += ` L ${point.x},${point.y}`;
  });
  
  document.getElementById('temp-path').setAttribute('d', pathData);
}

function addTempStation(x, y) {
  const svg = document.getElementById('run-chart-svg');
  const group = document.getElementById('new-stations');
  
  group.innerHTML = '';
  
  const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  circle.setAttribute('cx', x);
  circle.setAttribute('cy', y);
  circle.setAttribute('r', 8);
  circle.setAttribute('fill', '#20C997');
  circle.setAttribute('class', 'animate-pulse');
  
  const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
  text.setAttribute('x', x + 12);
  text.setAttribute('y', y + 3);
  text.setAttribute('font-size', '11');
  text.setAttribute('fill', '#20C997');
  text.textContent = document.getElementById('station-name').value || '新站点';
  
  group.appendChild(circle);
  group.appendChild(text);
}

function addTempAnnotation(x, y) {
  const svg = document.getElementById('run-chart-svg');
  const group = document.getElementById('new-stations');
  
  group.innerHTML = '';
  
  const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  circle.setAttribute('cx', x);
  circle.setAttribute('cy', y);
  circle.setAttribute('r', 10);
  circle.setAttribute('fill', '#FFC107');
  circle.setAttribute('class', 'animate-pulse');
  
  const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
  text.setAttribute('x', x + 14);
  text.setAttribute('y', y - 3);
  text.setAttribute('font-size', '10');
  text.setAttribute('fill', '#FFC107');
  text.textContent = '标注';
  
  group.appendChild(circle);
  group.appendChild(text);
}

function cancelDrawing() {
  drawingPoints = [];
  document.getElementById('temp-path').setAttribute('d', '');
  document.getElementById('drawing-path').style.display = 'none';
  startBrowse();
}

function cancelStation() {
  currentStation = null;
  document.getElementById('new-stations').innerHTML = '';
  startBrowse();
}

function cancelAnnotation() {
  currentAnnotation = null;
  document.getElementById('new-stations').innerHTML = '';
  startBrowse();
}

function saveRoute() {
  if (drawingPoints.length < 2) {
    alert('请至少添加两个路径点');
    return;
  }
  
  const trainNo = document.getElementById('draw-train-no').value;
  if (!trainNo) {
    alert('请输入车次');
    return;
  }
  
  let pathData = `M ${drawingPoints[0].x},${drawingPoints[0].y}`;
  drawingPoints.forEach(point => {
    pathData += ` L ${point.x},${point.y}`;
  });
  
  const data = {
    train_route: {
      train_no: trainNo,
      train_type: document.getElementById('draw-train-type').value,
      color: document.getElementById('draw-color').value,
      status: 'draft',
      path_data: pathData
    }
  };
  
  fetch('<%= project_run_chart_train_routes_path(@run_chart.project, @run_chart) %>', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': '<%= form_authenticity_token %>'
    },
    body: JSON.stringify(data)
  }).then(response => {
    if (response.ok) {
      location.reload();
    } else {
      alert('保存失败');
    }
  });
}

function saveStation() {
  if (!currentStation) {
    alert('请先点击画布选择位置');
    return;
  }
  
  const name = document.getElementById('station-name').value;
  if (!name) {
    alert('请输入站点名称');
    return;
  }
  
  const trainRouteId = document.getElementById('station-train-route').value;
  const data = {
    station: {
      name: name,
      arrival_time: document.getElementById('station-arrival').value,
      departure_time: document.getElementById('station-departure').value,
      stop_duration: document.getElementById('station-duration').value,
      x_coordinate: currentStation.x,
      y_coordinate: currentStation.y,
      order: 0
    }
  };
  
  fetch(`/train_routes/${trainRouteId}/stations`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': '<%= form_authenticity_token %>'
    },
    body: JSON.stringify(data)
  }).then(response => {
    if (response.ok) {
      location.reload();
    } else {
      alert('保存失败');
    }
  });
}

function saveAnnotation() {
  if (!currentAnnotation) {
    alert('请先点击画布选择位置');
    return;
  }
  
  const content = document.getElementById('annotation-content').value;
  if (!content) {
    alert('请输入标注内容');
    return;
  }
  
  const data = {
    annotation: {
      type: document.getElementById('annotation-type').value,
      content: content,
      status: 'pending',
      x: currentAnnotation.x,
      y: currentAnnotation.y
    }
  };
  
  fetch('<%= project_run_chart_annotations_path(@run_chart.project, @run_chart) %>', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': '<%= form_authenticity_token %>'
    },
    body: JSON.stringify(data)
  }).then(response => {
    if (response.ok) {
      location.reload();
    } else {
      alert('保存失败');
    }
  });
}

function zoomIn() {
  zoomLevel = Math.min(zoomLevel + 0.2, 3);
  updateZoom();
}

function zoomOut() {
  zoomLevel = Math.max(zoomLevel - 0.2, 0.5);
  updateZoom();
}

function resetView() {
  zoomLevel = 1;
  updateZoom();
}

function updateZoom() {
  document.getElementById('run-chart-svg').style.transform = `scale(${zoomLevel})`;
  document.getElementById('run-chart-svg').style.transformOrigin = 'center center';
}
</script>