<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">油耗记录</h1>
          <p class="mt-1 text-sm text-gray-500">跟踪车辆加油记录与百公里油耗，自动检测异常</p>
        </div>
        <%= link_to new_fuel_record_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          新建
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
      <%= form_with(url: fuel_records_path, method: :get, local: true, class: "space-y-4") do %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
          <div>
            <%= label_tag :vehicle_id, "车辆筛选", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= collection_select :vehicle, :id, Vehicle.order(:plate_number), :id, :plate_number, { selected: params[:vehicle_id], include_blank: "全部车辆" }, { class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-3 py-2 text-sm" } %>
          </div>
          <div>
            <%= label_tag :is_abnormal, "异常标记", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= select_tag :is_abnormal, options_for_select([["全部", nil], ["仅异常", "true"], ["仅正常", "false"]], params[:is_abnormal]), { include_blank: false, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-3 py-2 text-sm" } %>
          </div>
          <div>
            <%= label_tag :start_date, "开始日期", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= date_field_tag :start_date, params[:start_date], class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-3 py-2 text-sm" %>
          </div>
          <div>
            <%= label_tag :end_date, "结束日期", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= date_field_tag :end_date, params[:end_date], class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-3 py-2 text-sm" %>
          </div>
          <div class="flex items-end gap-2">
            <%= link_to "重置", fuel_records_path, class: "flex-1 px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors text-sm text-center" %>
            <%= submit_tag "筛选", class: "flex-1 px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors text-sm cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">加油日期</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">车牌号</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">车队</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">燃油类型</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">加油量</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">金额</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">行驶里程</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">百公里油耗</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">状态</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">操作</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200" id="fuel-records">
            <% @fuel_records.each do |record| %>
              <% is_abnormal = record.is_abnormal? %>
              <tr class="<%= is_abnormal ? 'bg-red-50 hover:bg-red-100' : 'hover:bg-gray-50' %> transition-colors" id="<%= dom_id(record) %>">
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm font-medium text-gray-900"><%= record.record_date.strftime('%Y-%m-%d') %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm font-medium text-gray-900"><%= record.vehicle&.plate_number %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm text-gray-600"><%= record.vehicle&.fleet&.name %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm text-gray-700"><%= record.fuel_type.presence || "—" %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right">
                  <span class="text-sm font-medium text-gray-900"><%= record.fuel_amount.present? ? "#{sprintf("%.2f", record.fuel_amount)} L" : "—" %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right">
                  <span class="text-sm font-medium text-gray-900"><%= record.fuel_cost.present? ? "¥ #{number_with_delimiter(sprintf("%.2f", record.fuel_cost))}" : "—" %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right">
                  <% distance = record.mileage_distance %>
                  <span class="text-sm <%= distance > 0 ? 'text-gray-900 font-medium' : 'text-gray-400' %>">
                    <%= distance > 0 ? "#{number_with_delimiter(distance)} km" : "—" %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right">
                  <% if record.fuel_consumption.present? %>
                    <span class="text-sm font-semibold <%= is_abnormal ? 'text-red-600' : 'text-green-600' %>">
                      <%= sprintf("%.2f", record.fuel_consumption) %> L
                    </span>
                    <% standard = record.vehicle&.vehicle_model&.standard_fuel_consumption %>
                    <% if standard.present? %>
                      <div class="text-xs text-gray-400 mt-0.5">标准: <%= standard %> L</div>
                    <% end %>
                  <% else %>
                    <span class="text-sm text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <% if is_abnormal %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span>
                      异常
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span>
                      正常
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "查看", fuel_record_path(record), class: "text-gray-600 hover:text-gray-900 px-3 py-1.5 rounded-md hover:bg-gray-100 transition-colors" %>
                    <%= link_to "编辑", edit_fuel_record_path(record), class: "text-blue-600 hover:text-blue-800 px-3 py-1.5 rounded-md hover:bg-blue-50 transition-colors" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @fuel_records.empty? %>
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/>
          </svg>
          <h3 class="mt-4 text-sm font-medium text-gray-900">暂无油耗记录</h3>
          <p class="mt-1 text-sm text-gray-500">点击上方按钮创建新的加油记录</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
