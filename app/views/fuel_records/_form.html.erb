<%= form_with(model: fuel_record, class: "space-y-6") do |form| %>
  <% if fuel_record.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-red-800 font-semibold mb-2"><%= pluralize(fuel_record.errors.count, "个错误") %> 禁止保存：</h3>
      <ul class="list-disc list-inside text-red-700 text-sm">
        <% fuel_record.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :vehicle_id, "选择车辆", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.collection_select :vehicle_id, @vehicles, :id, :plate_number, { include_blank: "请选择车辆" }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :record_date, "加油日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.date_field :record_date, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :fuel_type, "燃油类型", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :fuel_type, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "如：92号汽油、0号柴油" %>
    </div>

    <div>
      <%= form.label :fuel_amount, "加油量 (L)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :fuel_amount, step: "0.01", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "例如: 50.00" %>
    </div>

    <div>
      <%= form.label :fuel_cost, "加油金额 (元)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :fuel_cost, step: "0.01", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "例如: 400.00" %>
    </div>

    <div>
      <%= form.label :gas_station, "加油站", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :gas_station, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "加油站名称或地址" %>
    </div>

    <div>
      <%= form.label :start_mileage, "起始里程 (km)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :start_mileage, step: "0.1", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "上次加油后里程" %>
    </div>

    <div>
      <%= form.label :end_mileage, "当前里程 (km)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :end_mileage, step: "0.1", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "本次加油时里程" %>
    </div>

    <div>
      <%= form.label :recorded_by, "记录人", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :recorded_by, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "输入记录人姓名" %>
    </div>

    <% if fuel_record.persisted? && fuel_record.fuel_consumption.present? %>
      <div>
        <%= label_tag :fuel_consumption_display, "百公里油耗 (L/100km)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <% consumption_class = fuel_record.is_abnormal? ? "text-red-600 font-bold" : "text-green-600 font-semibold" %>
        <div class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-2">
          <span class="<%= consumption_class %> text-lg"><%= fuel_record.fuel_consumption %></span>
          <% if fuel_record.is_abnormal? %>
            <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">异常</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if fuel_record.persisted? && fuel_record.is_abnormal? && fuel_record.abnormal_note.present? %>
    <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
      <p class="text-xs font-medium text-red-600 uppercase tracking-wider mb-1">异常说明</p>
      <p class="text-sm text-red-800"><%= fuel_record.abnormal_note %></p>
    </div>
  <% end %>

  <div>
    <%= form.label :notes, "备注", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_area :notes, rows: 3, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "输入备注信息，如加油时车况、异常情况等..." %>
  </div>

  <div class="flex justify-end space-x-4 pt-4 border-t border-gray-200">
    <%= link_to "取消", fuel_records_path, class: "px-6 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
    <%= form.submit "保存", class: "px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
