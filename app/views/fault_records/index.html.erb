<% content_for :title, "工单列表 - 站台门故障抢修系统" %>

<div class="space-y-6">
  <%= turbo_frame_tag "dashboard_stats" do %>
    <%= render "fault_records/dashboard_stats", status_counts: @status_counts, abnormal_counts: @abnormal_counts, line_counts: @line_counts, daily_counts: @daily_counts %>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-semibold text-slate-800">故障工单列表</h2>
        <p class="text-sm text-slate-500 mt-1">共 <%= @fault_records.total_count %> 条记录</p>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to new_fault_record_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors text-sm font-medium" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          新建工单
        <% end %>
      </div>
    </div>

    <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/50">
      <%= search_form_for @q, url: fault_records_path, method: :get, html: { class: "flex flex-wrap items-end gap-4" } do |f| %>
        <div class="flex flex-col">
          <%= f.label :current_status_eq, "状态", class: "text-xs font-medium text-slate-600 mb-1" %>
          <%= f.select :current_status_eq, status_options_for_select, { include_blank: "全部状态" }, class: "px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        <div class="flex flex-col">
          <%= f.label :abnormal_type_eq, "异常类型", class: "text-xs font-medium text-slate-600 mb-1" %>
          <%= f.select :abnormal_type_eq, abnormal_type_options_for_select, { include_blank: "全部类型" }, class: "px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        <div class="flex flex-col">
          <%= f.label :line_name_eq, "线路", class: "text-xs font-medium text-slate-600 mb-1" %>
          <%= f.select :line_name_eq, options_for_select(FaultRecord.distinct.pluck(:line_name).compact, params.dig(:q, :line_name_eq)), { include_blank: "全部线路" }, class: "px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        <div class="flex flex-col">
          <%= f.label :ticket_no_or_station_name_or_platform_door_no_cont, "关键词", class: "text-xs font-medium text-slate-600 mb-1" %>
          <%= f.search_field :ticket_no_or_station_name_or_platform_door_no_cont, placeholder: "工单号/车站/门编号", class: "px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        <div class="flex gap-2">
          <%= f.submit "筛选", class: "px-4 py-2 bg-slate-800 text-white rounded-lg hover:bg-slate-900 text-sm font-medium cursor-pointer" %>
          <%= link_to "重置", fault_records_path, class: "px-4 py-2 bg-white text-slate-700 border border-slate-300 rounded-lg hover:bg-slate-50 text-sm font-medium" %>
        </div>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <%= turbo_frame_tag "records_list" do %>
        <table class="w-full">
          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">工单号</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">位置</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">故障信息</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">状态</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">异常</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">当前处理人</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">报修时间</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-slate-600 uppercase tracking-wider">操作</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100" id="fault_records_body">
            <% @fault_records.each do |record| %>
              <%= render "fault_records/fault_record", fault_record: record %>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>

    <% if @fault_records.total_pages > 1 %>
      <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
        <p class="text-sm text-slate-600">
          显示第 <%= @fault_records.offset_value + 1 %> - <%= [@fault_records.offset_value + @fault_records.limit_value, @fault_records.total_count].min %> 条，共 <%= @fault_records.total_count %> 条
        </p>
        <div class="flex gap-1">
          <%= paginate @fault_records %>
        </div>
      </div>
    <% end %>
  </div>
</div>
