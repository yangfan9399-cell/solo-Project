<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
    <h3 class="text-sm font-semibold text-slate-800 flex items-center gap-2">
      <svg class="w-4 h-4 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      处理前后差异记录
    </h3>
  </div>
  <div class="divide-y divide-slate-100">
    <% if diff_snapshots.any? %>
      <% diff_snapshots.each do |diff| %>
        <div class="px-6 py-3 hover:bg-slate-50 transition-colors">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-start gap-3 flex-1">
              <div class="mt-0.5">
                <%= diff_badge(diff.diff_type) %>
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-slate-800"><%= diff.field_label %></span>
                  <span class="text-xs text-slate-400"><%= format_time(diff.created_at) %></span>
                </div>
                <div class="flex items-center gap-3 mt-1 text-xs">
                  <span class="text-slate-500">原值:</span>
                  <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-slate-600"><%= diff.display_before_value %></span>
                  <svg class="w-3 h-3 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  <span class="text-slate-500">新值:</span>
                  <span class="font-mono bg-indigo-100 px-2 py-0.5 rounded text-indigo-700"><%= diff.display_after_value %></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="px-6 py-8 text-center text-sm text-slate-400">
        <svg class="w-10 h-10 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        暂无差异变更记录
      </div>
    <% end %>
  </div>
</div>
