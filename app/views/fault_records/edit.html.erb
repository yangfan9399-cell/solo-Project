<% content_for :title, "编辑工单 - #{@fault_record.ticket_no}" %>

<div class="max-w-4xl mx-auto">
  <div class="flex items-center gap-4 mb-6">
    <%= link_to "← 返回详情", fault_record_path(@fault_record), class: "text-slate-500 hover:text-slate-700 text-sm" %>
    <h1 class="text-2xl font-bold text-slate-900">编辑工单 <%= @fault_record.ticket_no %></h1>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <%= form_with model: @fault_record, class: "px-6 py-6 space-y-6" do |f| %>
      <% if @fault_record.errors.any? %>
        <div class="p-4 rounded-lg bg-rose-50 border border-rose-200 text-rose-800">
          <p class="font-medium mb-2">请修正以下错误:</p>
          <ul class="list-disc list-inside text-sm space-y-1">
            <% @fault_record.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= f.label :fault_type, "故障类型", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.select :fault_type, fault_type_options_for_select, {}, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        <div>
          <%= f.label :fault_level, "故障等级", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.select :fault_level, fault_level_options_for_select, {}, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div>
        <%= f.label :fault_description, "故障描述", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :fault_description, rows: 3, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :responsible_unit, "责任单位", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :responsible_unit, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        <div>
          <%= f.label :responsible_person, "责任人", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :responsible_person, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :actual_start_at, "实际开始时间", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.datetime_field :actual_start_at, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        <div>
          <%= f.label :actual_end_at, "实际结束时间", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.datetime_field :actual_end_at, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :actual_cost, "实际费用 (¥)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.number_field :actual_cost, step: 0.01, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        <div class="flex items-center gap-6 pt-6">
          <div class="flex items-center gap-2">
            <%= f.check_box :handler_qualified, class: "w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500" %>
            <%= f.label :handler_qualified, "处理人符合资质", class: "text-sm text-slate-700" %>
          </div>
          <div class="flex items-center gap-2">
            <%= f.check_box :notified_confirmation, class: "w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500" %>
            <%= f.label :notified_confirmation, "运营通知已确认", class: "text-sm text-slate-700" %>
          </div>
        </div>
      </div>

      <div>
        <%= f.label :on_site_description, "现场说明", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :on_site_description, rows: 3, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :business_record, "业务记录", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :business_record, rows: 2, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :conclusion, "处理结论", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :conclusion, rows: 2, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :basis_doc, "采用依据", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :basis_doc, rows: 2, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :remediation_path, "补救路径/备注", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :remediation_path, rows: 2, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <%= link_to "取消", fault_record_path(@fault_record), class: "px-5 py-2 text-slate-700 hover:bg-slate-100 rounded-lg text-sm font-medium" %>
        <%= f.submit "保存修改", class: "px-5 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
