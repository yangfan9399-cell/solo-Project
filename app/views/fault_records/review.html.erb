<% content_for :title, "复核工单 - #{@fault_record.ticket_no}" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <%= link_to "← 返回详情", fault_record_path(@fault_record), class: "text-slate-500 hover:text-slate-700 text-sm" %>
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-slate-900">质控复核台</h1>
          <span class="text-xl text-slate-400">·</span>
          <span class="font-mono text-lg text-indigo-600"><%= @fault_record.ticket_no %></span>
          <%= status_badge(@fault_record.current_status) %>
          <%= abnormal_badge(@fault_record.abnormal_type) %>
        </div>
        <p class="text-sm text-slate-500 mt-1">复核人: <%= current_user.name %> · <%= current_user.role_text %></p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <% if @fault_record.pending_review? %>
        <%= button_to "开始复核", start_review_fault_record_path(@fault_record), method: :post, class: "px-4 py-2 bg-violet-600 text-white rounded-lg hover:bg-violet-700 text-sm font-medium" %>
      <% end %>
      <% if @fault_record.reviewing? %>
        <%= button_to "复核通过并归档", review_pass_fault_record_path(@fault_record), method: :post, class: "px-5 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 text-sm font-medium", data: { confirm: "确认复核通过并归档？此操作后工单将只读。" } %>
        <div class="relative" data-controller="dropdown">
          <button type="button" data-action="click->dropdown#toggle" class="flex items-center gap-2 px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 text-sm font-medium">
            退回补证
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-lg border border-slate-200 z-20 p-4">
            <%= form_tag return_supplement_fault_record_path(@fault_record), method: :post, class: "space-y-3" do %>
              <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">退回原因</label>
                <textarea name="comment" rows="3" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-sm" placeholder="请说明需要补充的材料..."></textarea>
              </div>
              <%= submit_tag "确认退回", class: "w-full px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 text-sm font-medium cursor-pointer" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <% if @fault_record.abnormal? %>
        <%= render "fault_records/abnormal_panel", fault_record: @fault_record %>
      <% end %>

      <%= render "fault_records/basic_info", fault_record: @fault_record %>
      <%= render "fault_records/key_objects", fault_record: @fault_record %>

      <div class="bg-violet-50 rounded-xl border border-violet-200 p-5">
        <h3 class="text-sm font-semibold text-violet-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          复核要点检查
        </h3>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-white rounded-lg p-3 border border-violet-100">
            <div class="text-xs text-slate-500 mb-1">处理人资格</div>
            <div class="text-sm font-semibold <%= @fault_record.handler_qualified? ? 'text-emerald-700' : 'text-rose-700' %>">
              <%= @fault_record.handler_qualified? ? "✓ 符合要求" : "✗ 不符合要求（异常）" %>
            </div>
          </div>
          <div class="bg-white rounded-lg p-3 border border-violet-100">
            <div class="text-xs text-slate-500 mb-1">运营通知确认</div>
            <div class="text-sm font-semibold <%= @fault_record.notified_confirmation? ? 'text-emerald-700' : 'text-rose-700' %>">
              <%= @fault_record.notified_confirmation? ? "✓ 已确认" : "✗ 未确认（异常）" %>
            </div>
          </div>
          <div class="bg-white rounded-lg p-3 border border-violet-100">
            <div class="text-xs text-slate-500 mb-1">时间窗口合规</div>
            <div class="text-sm font-semibold <%= !@fault_record.time_window_conflict? ? 'text-emerald-700' : 'text-rose-700' %>">
              <%= !@fault_record.time_window_conflict? ? "✓ 合规" : "✗ 窗口冲突（异常）" %>
            </div>
          </div>
          <div class="bg-white rounded-lg p-3 border border-violet-100">
            <div class="text-xs text-slate-500 mb-1">证据附件数量</div>
            <div class="text-sm font-semibold <%= @evidence_attachments.size >= 2 ? 'text-emerald-700' : 'text-amber-700' %>">
              <%= @evidence_attachments.size %> 份
              <%= @evidence_attachments.size >= 2 ? "✓ 充足" : "⚠ 偏少" %>
            </div>
          </div>
        </div>
        <% if @fault_record.critical_changes.any? %>
          <div class="mt-4 bg-white rounded-lg p-3 border border-rose-200">
            <div class="text-xs font-semibold text-rose-700 mb-2">⚠ 存在 <%= @fault_record.critical_changes.size %> 处关键字段变更，需重点关注</div>
            <%= link_to "查看差异详情", fault_record_path(@fault_record, anchor: "diff_snapshots"), class: "text-sm text-indigo-600 hover:text-indigo-800 underline" %>
          </div>
        <% end %>
      </div>

      <%= render "fault_records/diff_snapshots", diff_snapshots: @diff_snapshots %>
    </div>

    <div class="space-y-6">
      <%= render "fault_records/conclusion_basis", fault_record: @fault_record %>
      <%= render "fault_records/evidence_list", evidence_attachments: @evidence_attachments %>
      <%= render "fault_records/workflow_timeline", workflow_nodes: @workflow_nodes, fault_record: @fault_record %>
    </div>
  </div>
</div>
