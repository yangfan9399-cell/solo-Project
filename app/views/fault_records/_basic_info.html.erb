<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
    <h3 class="text-sm font-semibold text-slate-800 flex items-center gap-2">
      <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      基本信息
    </h3>
  </div>
  <div class="px-6 py-4 grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-4">
    <div>
      <div class="text-xs text-slate-500 mb-1">来源</div>
      <div class="text-sm font-medium text-slate-800"><%= fault_record.source_type_text %></div>
    </div>
    <div>
      <div class="text-xs text-slate-500 mb-1">报修时间</div>
      <div class="text-sm font-medium text-slate-800"><%= format_time(fault_record.reported_at) %></div>
    </div>
    <div>
      <div class="text-xs text-slate-500 mb-1">报修人</div>
      <div class="text-sm font-medium text-slate-800"><%= fault_record.reporter_name %></div>
    </div>
    <div>
      <div class="text-xs text-slate-500 mb-1">线路</div>
      <div class="text-sm font-medium text-slate-800"><%= fault_record.line_name %></div>
    </div>
    <div>
      <div class="text-xs text-slate-500 mb-1">车站</div>
      <div class="text-sm font-medium text-slate-800"><%= fault_record.station_name %></div>
    </div>
    <div>
      <div class="text-xs text-slate-500 mb-1">站台门编号</div>
      <div class="text-sm font-medium text-slate-800"><%= fault_record.platform_door_no %></div>
    </div>
    <div>
      <div class="text-xs text-slate-500 mb-1">故障类型</div>
      <div class="text-sm font-medium text-slate-800"><%= fault_record.fault_type_text %></div>
    </div>
    <div>
      <div class="text-xs text-slate-500 mb-1">故障等级</div>
      <div class="text-sm"><%= level_badge(fault_record.fault_level) %></div>
    </div>
    <div>
      <div class="text-xs text-slate-500 mb-1">当前责任人</div>
      <div class="text-sm font-medium text-slate-800"><%= fault_record.current_owner_name %></div>
    </div>
    <div class="col-span-2 md:col-span-3">
      <div class="text-xs text-slate-500 mb-1">故障描述</div>
      <div class="text-sm text-slate-700 bg-slate-50 rounded-lg p-3"><%= fault_record.fault_description.presence || "—" %></div>
    </div>
  </div>
</div>
