<div class="bg-amber-50 rounded-xl border border-amber-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-amber-200 bg-amber-100/50">
    <h3 class="text-sm font-semibold text-amber-900 flex items-center gap-2">
      <svg class="w-5 h-5 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
      </svg>
      异常告警 · <%= fault_record.abnormal_type_text %>
    </h3>
  </div>
  <div class="px-6 py-4 space-y-4">
    <% if fault_record.blocking_reason.present? %>
      <div>
        <div class="text-xs font-semibold text-amber-800 mb-1 uppercase tracking-wider">阻断原因</div>
        <div class="text-sm text-amber-900 bg-white/60 rounded-lg p-3 border border-amber-200">
          <%= fault_record.blocking_reason %>
        </div>
      </div>
    <% end %>

    <% if fault_record.critical_changes.any? %>
      <div>
        <div class="text-xs font-semibold text-amber-800 mb-2 uppercase tracking-wider">差异字段</div>
        <div class="space-y-2">
          <% fault_record.critical_changes.order(created_at: :desc).each do |diff| %>
            <div class="bg-white/60 rounded-lg p-3 border border-amber-200">
              <div class="flex items-center gap-2 mb-1">
                <%= diff_badge(diff.diff_type) %>
                <span class="text-sm font-medium text-slate-800"><%= diff.field_label %></span>
              </div>
              <div class="flex items-center gap-3 text-xs">
                <div class="flex items-center gap-1">
                  <span class="text-slate-500">修改前:</span>
                  <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-slate-700"><%= diff.display_before_value %></span>
                </div>
                <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                <div class="flex items-center gap-1">
                  <span class="text-slate-500">修改后:</span>
                  <span class="font-mono bg-indigo-100 px-2 py-0.5 rounded text-indigo-800"><%= diff.display_after_value %></span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if fault_record.remediation_path.present? %>
      <div>
        <div class="text-xs font-semibold text-emerald-800 mb-1 uppercase tracking-wider">补救路径</div>
        <div class="text-sm text-emerald-900 bg-emerald-50 rounded-lg p-3 border border-emerald-200 whitespace-pre-line">
          <%= fault_record.remediation_path %>
        </div>
      </div>
    <% end %>
  </div>
</div>
