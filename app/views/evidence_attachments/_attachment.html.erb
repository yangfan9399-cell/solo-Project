<div id="evidence_attachment_<%= attachment.id %>" class="group relative">
  <% if attachment.file_attached? && attachment.attachment_type.in?(%w[before_photo after_photo]) %>
    <div class="aspect-square rounded-lg overflow-hidden bg-gray-100 border border-gray-200">
      <% if attachment.thumbnail_url %>
        <%= image_tag attachment.thumbnail_url, class: 'w-full h-full object-cover', alt: attachment.description %>
      <% else %>
        <div class="w-full h-full flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="aspect-square rounded-lg bg-gray-50 border border-gray-200 flex items-center justify-center">
      <svg class="w-8 h-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
    </div>
  <% end %>

  <div class="mt-1">
    <p class="text-xs text-gray-900 truncate" title="<%= attachment.file_name %>"><%= attachment.file_name %></p>
    <p class="text-xs text-gray-500"><%= attachment.uploader_name %></p>
  </div>

  <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-50 transition-all rounded-lg flex items-center justify-center opacity-0 group-hover:opacity-100">
    <div class="flex gap-2">
      <%= link_to download_inspection_record_evidence_attachment_path(attachment.inspection_record, attachment), class: 'p-2 bg-white rounded-full shadow hover:bg-gray-100', title: '下载' do %>
        <svg class="w-4 h-4 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      <% end %>
      <% if policy(attachment).destroy? %>
        <%= button_to [attachment.inspection_record, attachment], method: :delete, class: 'p-2 bg-white rounded-full shadow hover:bg-red-100', title: '删除', data: { confirm: '确认删除此附件？' } do %>
          <svg class="w-4 h-4 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if attachment.description.present? %>
    <div class="absolute -top-1 -right-1">
      <svg class="w-4 h-4 text-blue-500" fill="currentColor" viewBox="0 0 20 20" title="<%= attachment.description %>">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
      </svg>
    </div>
  <% end %>
</div>
