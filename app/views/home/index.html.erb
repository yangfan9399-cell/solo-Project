<% content_for :title, "星港货柜调度竞速游戏" %>

<div class="text-center mb-12">
  <h2 class="text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
    星港货柜调度竞速
  </h2>
  <p class="text-xl text-slate-300 mb-2">
    策略地调度货柜，优化泊位利用，在时间耗尽前达成目标分数！
  </p>
  <div class="flex justify-center gap-6 text-sm text-slate-400">
    <span>🎯 重量平衡</span>
    <span>🚢 目的地匹配</span>
    <span>⏱️ 竞速挑战</span>
    <span>📊 分数复算</span>
  </div>
</div>

<% if @player %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    <div class="bg-slate-800/60 backdrop-blur rounded-xl p-6 border border-purple-500/20">
      <div class="text-3xl mb-2">🏆</div>
      <div class="text-3xl font-bold text-cyan-400"><%= @player.wins %></div>
      <div class="text-slate-400 text-sm">胜利场次</div>
    </div>
    <div class="bg-slate-800/60 backdrop-blur rounded-xl p-6 border border-purple-500/20">
      <div class="text-3xl mb-2">🎮</div>
      <div class="text-3xl font-bold text-purple-400"><%= @player.total_games %></div>
      <div class="text-slate-400 text-sm">总游戏场次</div>
    </div>
    <div class="bg-slate-800/60 backdrop-blur rounded-xl p-6 border border-purple-500/20">
      <div class="text-3xl mb-2">⭐</div>
      <div class="text-3xl font-bold text-yellow-400"><%= number_with_delimiter(@total_score) %></div>
      <div class="text-slate-400 text-sm">累计得分</div>
    </div>
  </div>
<% end %>

<div class="mb-12">
  <h3 class="text-2xl font-bold mb-6 flex items-center gap-2">
    <span>🎯</span> 选择关卡
  </h3>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <% @levels.each do |level| %>
      <div class="group bg-slate-800/60 backdrop-blur rounded-xl p-6 border border-purple-500/20 hover:border-cyan-400/50 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/10">
        <div class="flex items-center justify-between mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-medium <%= difficulty_class(level.difficulty) %>">
            <%= difficulty_label(level.difficulty) %>
          </span>
          <span class="text-2xl"><%= difficulty_emoji(level.difficulty) %></span>
        </div>
        <h4 class="text-xl font-bold mb-2 group-hover:text-cyan-400 transition"><%= level.name %></h4>
        <p class="text-slate-400 text-sm mb-4 h-12"><%= level.description %></p>
        <div class="grid grid-cols-2 gap-2 text-xs text-slate-400 mb-4">
          <div>⏱️ <%= level.time_limit %>秒</div>
          <div>🎯 <%= number_with_delimiter(level.target_score) %>分</div>
          <div>📦 <%= level.container_count %>个货柜</div>
          <div>⚓ <%= level.berth_count %>个泊位</div>
        </div>
        <%= link_to level_game_sessions_path(level), method: :post,
          class: "w-full block text-center py-3 rounded-lg bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-400 hover:to-purple-400 font-medium transition" do %>
          开始挑战
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if @recent_games.any? %>
  <div>
    <h3 class="text-2xl font-bold mb-6 flex items-center gap-2">
      <span>📋</span> 最近游戏
    </h3>
    <div class="bg-slate-800/60 backdrop-blur rounded-xl border border-purple-500/20 overflow-hidden">
      <table class="w-full">
        <thead class="bg-slate-700/50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">关卡</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">得分</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">时间</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-700/50">
          <% @recent_games.each do |session| %>
            <tr class="hover:bg-slate-700/30 transition">
              <td class="px-6 py-4 whitespace-nowrap"><%= session.level.name %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 rounded text-xs <%= status_class(session.status) %>">
                  <%= status_label(session.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap font-mono"><%= number_with_delimiter(session.score) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-slate-400 text-sm"><%= session.finished_at&.strftime('%m-%d %H:%M') %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to "查看", game_session_path(session), class: "text-cyan-400 hover:text-cyan-300 text-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<div class="mt-12 bg-slate-800/40 backdrop-blur rounded-xl p-8 border border-purple-500/20">
  <h3 class="text-xl font-bold mb-4">🎮 游戏规则</h3>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-slate-300">
    <div>
      <h4 class="font-semibold text-cyan-400 mb-2">基本操作</h4>
      <ul class="list-disc list-inside space-y-1 text-sm">
        <li>拖拽货柜到对应的泊位完成放置</li>
        <li>点击已放置的货柜可以移回待调度区</li>
        <li>使用撤销/重做按钮回退操作</li>
        <li>所有货柜放置完成或时间耗尽时结算</li>
      </ul>
    </div>
    <div>
      <h4 class="font-semibold text-purple-400 mb-2">计分规则</h4>
      <ul class="list-disc list-inside space-y-1 text-sm">
        <li>每个货柜基础分 100 分</li>
        <li>货柜重量 × 2 为重量奖励</li>
        <li>优先级 × 50 为优先级奖励</li>
        <li>目的地匹配奖励 200 分/个</li>
        <li>泊位利用率越高，奖励越多</li>
        <li>剩余时间转化为额外分数</li>
      </ul>
    </div>
  </div>
</div>
