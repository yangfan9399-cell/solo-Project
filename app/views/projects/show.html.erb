<% content_for :title, "#{@project.name} - 项目详情" %>

<div class="mb-6">
  <%= link_to projects_path, class: "inline-flex items-center text-stone-600 hover:text-amber-600 transition-colors" do %>
    <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    返回项目台账
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
  <div class="lg:col-span-2">
    <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h1 class="text-2xl font-bold text-stone-800 mb-2"><%= @project.name %></h1>
          <p class="text-stone-500">项目编号：<%= @project.code %></p>
        </div>
        <% status_class = case @project.status
          when "普查中" then "bg-blue-100 text-blue-800"
          when "拆卸中" then "bg-yellow-100 text-yellow-800"
          when "修复中" then "bg-orange-100 text-orange-800"
          when "复装中" then "bg-purple-100 text-purple-800"
          when "已完成" then "bg-green-100 text-green-800"
          else "bg-stone-100 text-stone-800"
        end %>
        <span class="px-3 py-1 text-sm font-medium rounded-full <%= status_class %>">
          <%= @project.status %>
        </span>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 py-4 border-t border-b border-stone-100">
        <div>
          <p class="text-xs text-stone-500 mb-1">建筑类型</p>
          <p class="text-sm font-medium text-stone-800"><%= @project.building_type %></p>
        </div>
        <div>
          <p class="text-xs text-stone-500 mb-1">朝代</p>
          <p class="text-sm font-medium text-stone-800"><%= @project.era %></p>
        </div>
        <div>
          <p class="text-xs text-stone-500 mb-1">地点</p>
          <p class="text-sm font-medium text-stone-800"><%= @project.location %></p>
        </div>
        <div>
          <p class="text-xs text-stone-500 mb-1">开始日期</p>
          <p class="text-sm font-medium text-stone-800"><%= @project.started_at ? @project.started_at.strftime("%Y-%m-%d") : "-" %></p>
        </div>
      </div>

      <% if @project.description.present? %>
        <div class="mt-4">
          <p class="text-xs text-stone-500 mb-2">项目描述</p>
          <p class="text-sm text-stone-700 leading-relaxed"><%= @project.description %></p>
        </div>
      <% end %>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <%= link_to edit_project_path(@project), class: "inline-flex items-center px-4 py-2 bg-amber-600 text-white font-medium rounded-lg hover:bg-amber-700 transition-colors" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          编辑项目
        <% end %>
        <%= link_to new_project_component_path(@project), class: "inline-flex items-center px-4 py-2 bg-stone-100 text-stone-700 font-medium rounded-lg hover:bg-stone-200 transition-colors" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          新建构件
        <% end %>
        <%= link_to export_components_project_path(@project), class: "inline-flex items-center px-4 py-2 bg-stone-100 text-stone-700 font-medium rounded-lg hover:bg-stone-200 transition-colors" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          导出
        <% end %>
        <%= button_to project_path(@project), method: :delete, form: { data: { turbo_confirm: "确定要删除这个项目吗？" } }, class: "inline-flex items-center px-4 py-2 bg-red-50 text-red-600 font-medium rounded-lg hover:bg-red-100 transition-colors" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          删除
        <% end %>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
      <h2 class="text-lg font-semibold text-stone-800 mb-4">统计摘要</h2>
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-sm text-stone-600">构件总数</span>
          <span class="text-xl font-bold text-stone-800"><%= @stats[:total_components] %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-stone-600">缺损数</span>
          <span class="text-xl font-bold text-orange-600"><%= @stats[:total_defects] %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-stone-600">异常数</span>
          <span class="text-xl font-bold text-red-600"><%= @anomalies_summary[:total] %></span>
        </div>
      </div>
    </div>

    <% if @anomalies_summary[:total] > 0 %>
      <div class="bg-white rounded-xl shadow-sm border border-red-200 p-6">
        <h2 class="text-lg font-semibold text-red-700 mb-4 flex items-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          异常统计
        </h2>
        <div class="space-y-2 text-sm">
          <% if @anomalies_summary[:status_anomaly] > 0 %>
            <div class="flex items-center justify-between py-1">
              <span class="text-stone-600">状态异常</span>
              <span class="font-semibold text-red-600"><%= @anomalies_summary[:status_anomaly] %> 个</span>
            </div>
          <% end %>
          <% if @anomalies_summary[:critical_defects] > 0 %>
            <div class="flex items-center justify-between py-1">
              <span class="text-stone-600">严重缺损</span>
              <span class="font-semibold text-orange-600"><%= @anomalies_summary[:critical_defects] %> 个</span>
            </div>
          <% end %>
          <% if @anomalies_summary[:no_code] > 0 %>
            <div class="flex items-center justify-between py-1">
              <span class="text-stone-600">无编号</span>
              <span class="font-semibold text-yellow-600"><%= @anomalies_summary[:no_code] %> 个</span>
            </div>
          <% end %>
          <% if @anomalies_summary[:duplicate_positions] > 0 %>
            <div class="flex items-center justify-between py-1">
              <span class="text-stone-600">位置重复</span>
              <span class="font-semibold text-amber-600"><%= @anomalies_summary[:duplicate_positions] %> 个</span>
            </div>
          <% end %>
          <% if @anomalies_summary[:awaiting_overdue] > 0 %>
            <div class="flex items-center justify-between py-1">
              <span class="text-stone-600">待复装超期</span>
              <span class="font-semibold text-red-500"><%= @anomalies_summary[:awaiting_overdue] %> 个</span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
      <h2 class="text-lg font-semibold text-stone-800 mb-4">复装完成率</h2>
      <div class="mb-2 flex items-center justify-between">
        <span class="text-sm text-stone-600">进度</span>
        <span class="text-lg font-bold text-amber-600"><%= @project.completion_rate %>%</span>
      </div>
      <div class="w-full bg-stone-200 rounded-full h-3">
        <div class="bg-gradient-to-r from-amber-400 to-amber-600 h-3 rounded-full transition-all duration-500" style="width: <%= @project.completion_rate %>%"></div>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-2 text-xs">
        <% Component::STATUSES.each do |status| %>
          <div class="flex items-center">
            <span class="w-3 h-3 rounded-full mr-2
              <%= case status
                when "在原位" then "bg-stone-400"
                when "已拆卸" then "bg-yellow-400"
                when "修复中" then "bg-orange-400"
                when "待复装" then "bg-blue-400"
                when "已复装" then "bg-green-500"
                when "异常" then "bg-red-500"
                else "bg-stone-400"
              end %>"></span>
            <span class="text-stone-600"><%= status %></span>
            <span class="ml-auto font-medium text-stone-800"><%= @stats[:by_status][status] || 0 %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-stone-200 flex items-center justify-between">
    <h2 class="text-lg font-semibold text-stone-800">构件列表</h2>
    <span class="text-sm text-stone-500">共 <%= @total_count %> 个构件</span>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-stone-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">构件编号</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">类型</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">位置</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">朝向</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">缺损数</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-stone-600 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% @components.each do |component| %>
          <tr class="hover:bg-amber-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-stone-900">
              <%= link_to component.full_code, project_component_path(@project, component), class: "text-amber-600 hover:text-amber-800 transition-colors" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600"><%= component.component_type %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600"><%= component.position %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600"><%= component.orientation %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% comp_status_class = case component.status
                when "在原位" then "bg-stone-100 text-stone-700"
                when "已拆卸" then "bg-yellow-100 text-yellow-800"
                when "修复中" then "bg-orange-100 text-orange-800"
                when "待复装" then "bg-blue-100 text-blue-800"
                when "已复装" then "bg-green-100 text-green-800"
                when "异常" then "bg-red-100 text-red-800"
                else "bg-stone-100 text-stone-700"
              end %>
              <span class="px-2.5 py-0.5 text-xs font-medium rounded-full <%= comp_status_class %>">
                <%= component.status %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if component.defect_count > 0 %>
                <span class="text-sm font-medium text-orange-600"><%= component.defect_count %></span>
              <% else %>
                <span class="text-sm text-stone-400">0</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "查看", project_component_path(@project, component), class: "text-amber-600 hover:text-amber-800 transition-colors" %>
            </td>
          </tr>
        <% end %>
        <% if @components.empty? %>
          <tr>
            <td colspan="7" class="px-6 py-12 text-center text-stone-500">
              <svg class="w-16 h-16 mx-auto mb-4 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
              <p>暂无构件数据</p>
              <%= link_to "添加第一个构件", new_project_component_path(@project), class: "mt-3 inline-block text-amber-600 hover:text-amber-800 text-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @total_pages > 1 %>
    <div class="px-6 py-4 border-t border-stone-200 flex items-center justify-between">
      <p class="text-sm text-stone-600">
        共 <%= @total_count %> 条记录，第 <%= @page %> / <%= @total_pages %> 页
      </p>
      <div class="flex items-center space-x-1">
        <% if @page > 1 %>
          <%= link_to project_path(@project, page: 1), class: "px-3 py-1.5 text-sm text-stone-600 bg-stone-100 rounded hover:bg-stone-200 transition-colors" do %>
            首页
          <% end %>
          <%= link_to project_path(@project, page: @page - 1), class: "px-3 py-1.5 text-sm text-stone-600 bg-stone-100 rounded hover:bg-stone-200 transition-colors" do %>
            上一页
          <% end %>
        <% end %>

        <% start_page = [1, @page - 2].max %>
        <% end_page = [@total_pages, @page + 2].min %>
        <% (start_page..end_page).each do |p| %>
          <% if p == @page %>
            <span class="px-3 py-1.5 text-sm text-white bg-amber-600 rounded"><%= p %></span>
          <% else %>
            <%= link_to p, project_path(@project, page: p), class: "px-3 py-1.5 text-sm text-stone-600 bg-stone-100 rounded hover:bg-stone-200 transition-colors" %>
          <% end %>
        <% end %>

        <% if @page < @total_pages %>
          <%= link_to project_path(@project, page: @page + 1), class: "px-3 py-1.5 text-sm text-stone-600 bg-stone-100 rounded hover:bg-stone-200 transition-colors" do %>
            下一页
          <% end %>
          <%= link_to project_path(@project, page: @total_pages), class: "px-3 py-1.5 text-sm text-stone-600 bg-stone-100 rounded hover:bg-stone-200 transition-colors" do %>
            末页
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<% if @anomalies_summary[:total] > 0 %>
  <div class="mt-6 bg-white rounded-xl shadow-sm border border-red-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-red-200 bg-red-50 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-red-800 flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        异常构件清单
      </h2>
      <span class="text-sm text-red-600">共 <%= @anomalies_summary[:total] %> 项异常</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-stone-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">构件编号</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">类型</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">位置</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">异常类型</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-stone-600 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% @anomalous_components.each do |component| %>
            <tr class="hover:bg-red-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-stone-900">
                <%= link_to component.full_code, project_component_path(@project, component), class: "text-amber-600 hover:text-amber-800 transition-colors" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600"><%= component.component_type %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600"><%= component.position.presence || "-" %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% comp_status_class = case component.status
                  when "在原位" then "bg-stone-100 text-stone-700"
                  when "已拆卸" then "bg-yellow-100 text-yellow-800"
                  when "修复中" then "bg-orange-100 text-orange-800"
                  when "待复装" then "bg-blue-100 text-blue-800"
                  when "已复装" then "bg-green-100 text-green-800"
                  when "异常" then "bg-red-100 text-red-800"
                  else "bg-stone-100 text-stone-700"
                end %>
                <span class="px-2.5 py-0.5 text-xs font-medium rounded-full <%= comp_status_class %>">
                  <%= component.status %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex flex-wrap gap-1">
                  <% component.anomaly_types.each do |anomaly_type| %>
                    <% anomaly_color = case anomaly_type
                      when "状态异常" then "bg-red-100 text-red-700"
                      when "严重缺损" then "bg-orange-100 text-orange-700"
                      when "无编号" then "bg-yellow-100 text-yellow-700"
                      when "位置重复" then "bg-amber-100 text-amber-700"
                      when "待复装超期" then "bg-red-100 text-red-700"
                      else "bg-stone-100 text-stone-700"
                    end %>
                    <span class="px-2 py-0.5 text-xs font-medium rounded <%= anomaly_color %>">
                      <%= anomaly_type %>
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to "查看", project_component_path(@project, component), class: "text-amber-600 hover:text-amber-800 transition-colors" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
