<div class="row">
  <div class="col-12">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1><%= @project.name %></h1>
        <p class="text-muted">项目编号: <%= @project.code %></p>
      </div>
      <div class="btn-group">
        <a href="/projects" class="btn btn-outline-secondary">返回列表</a>
        <a href="/projects/<%= @project.id %>/edit" class="btn btn-outline-primary">编辑项目</a>
      </div>
    </div>

    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card">
          <div class="card-body text-center">
            <div class="text-3xl font-bold text-primary"><%= @project.run_charts.count %></div>
            <div class="text-sm text-muted">运行图数量</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card">
          <div class="card-body text-center">
            <div class="text-3xl font-bold text-success"><%= @project.total_routes %></div>
            <div class="text-sm text-muted">列车径路数</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card">
          <div class="card-body text-center">
            <div class="text-3xl font-bold text-info"><%= @project.total_stations %></div>
            <div class="text-sm text-muted">停站点数</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card">
          <div class="card-body text-center">
            <div class="text-3xl font-bold text-warning"><%= @project.versions.count %></div>
            <div class="text-sm text-muted">版本数</div>
          </div>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header bg-light">
        <span><i class="fa-solid fa-info-circle me-2"></i>项目信息</span>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <dl class="row">
              <dt class="col-sm-3">部门</dt>
              <dd class="col-sm-9"><%= @project.department || '-' %></dd>
              <dt class="col-sm-3">创建人</dt>
              <dd class="col-sm-9"><%= @project.created_by || '-' %></dd>
              <dt class="col-sm-3">状态</dt>
              <dd class="col-sm-9">
                <span class="badge bg-<%= @project.status == 'active' ? 'success' : @project.status == 'completed' ? 'primary' : @project.status == 'draft' ? 'warning' : 'secondary' %>">
                  <%= @project.status_label %>
                </span>
              </dd>
              <dt class="col-sm-3">创建时间</dt>
              <dd class="col-sm-9"><%= @project.created_at.strftime('%Y-%m-%d %H:%M') %></dd>
            </dl>
          </div>
          <div class="col-md-6">
            <dl class="row">
              <dt class="col-sm-3">描述</dt>
              <dd class="col-sm-9"><%= @project.description || '-' %></dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-sitemap me-2"></i>运行图列表</span>
        <a href="/projects/<%= @project.id %>/run_charts/new" class="btn btn-sm btn-primary">
          <i class="fa-solid fa-plus"></i> 新建运行图
        </a>
      </div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead class="bg-light">
            <tr>
              <th>名称</th>
              <th>日期</th>
              <th>列车径路</th>
              <th>站点数</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% @run_charts.each do |run_chart| %>
              <tr>
                <td>
                  <a href="/projects/<%= @project.id %>/run_charts/<%= run_chart.id %>"><%= run_chart.name %></a>
                </td>
                <td><%= run_chart.date.strftime('%Y-%m-%d') %></td>
                <td><%= run_chart.total_routes %></td>
                <td><%= run_chart.total_stations %></td>
                <td>
                  <div class="btn-group btn-group-sm">
                    <a href="/projects/<%= @project.id %>/run_charts/<%= run_chart.id %>/workbench" class="btn btn-outline-success"><i class="fa-solid fa-wrench"></i>工作台</a>
                    <a href="/projects/<%= @project.id %>/run_charts/<%= run_chart.id %>/edit" class="btn btn-outline-secondary"><i class="fa-solid fa-pencil"></i></a>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-history me-2"></i>版本历史</span>
        <a href="/projects/<%= @project.id %>/versions" class="btn btn-sm btn-outline-primary">查看全部</a>
      </div>
      <div class="card-body">
        <% if @versions.any? %>
          <div class="list-group">
            <% @versions.each do |version| %>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                  <div class="d-flex align-items-center">
                    <span class="font-weight-bold me-2">版本 <%= version.version_no %></span>
                    <span class="badge bg-<%= version.status == 'exported' ? 'success' : version.status == 'generated' ? 'warning' : 'secondary' %>"><%= version.status_label %></span>
                  </div>
                  <div class="text-sm text-muted mt-1">
                    <span class="me-3"><i class="fa-solid fa-calendar me-1"></i><%= version.created_at.strftime('%Y-%m-%d') %></span>
                    <span class="me-3"><i class="fa-solid fa-layer-group me-1"></i><%= version.batch_no %></span>
                  </div>
                  <p class="text-sm mt-1"><%= version.change_log %></p>
                </div>
                <div class="btn-group btn-group-sm">
                  <a href="/versions/<%= version.id %>" class="btn btn-outline-primary"><i class="fa-solid fa-eye"></i></a>
                  <% if version.status == 'exported' %>
                    <a href="/versions/<%= version.id %>/export_json" class="btn btn-outline-success"><i class="fa-solid fa-download"></i></a>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-4 text-muted">
            <i class="fa-solid fa-clock fa-3x mb-2"></i>
            <p>暂无版本记录</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>