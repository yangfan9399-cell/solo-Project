<% content_for :title, "#{@project.name} - 项目详情" %>
<% content_for :page_title, @project.name %>
<% content_for :page_subtitle, @project.code %>

<div class="space-y-6">
  <div class="flex items-start justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-slate-900"><%= @project.name %></h1>
        <% status_class = { active: "bg-emerald-100 text-emerald-700", completed: "bg-blue-100 text-blue-700", archived: "bg-slate-100 text-slate-600" }[@project.status.to_sym] %>
        <% status_text = { active: "进行中", completed: "已完成", archived: "已归档" }[@project.status.to_sym] %>
        <span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full <%= status_class %>">
          <%= status_text %>
        </span>
        <% if @project.has_abnormal_data? %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-amber-700 bg-amber-50 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            数据异常
          </span>
        <% end %>
      </div>
      <div class="flex items-center gap-4 mt-2 text-sm text-slate-500">
        <span><%= @project.location %></span>
        <span>·</span>
        <span><%= @project.dynasty || "朝代未知" %></span>
        <span>·</span>
        <span><%= @project.records.count %> 条记录</span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to history_project_path(@project), class: "inline-flex items-center gap-2 px-4 py-2 border border-slate-200 text-slate-700 text-sm rounded-lg hover:bg-slate-50" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        版本历史
      <% end %>
      <%= link_to project_exports_path(@project), class: "inline-flex items-center gap-2 px-4 py-2 border border-slate-200 text-slate-700 text-sm rounded-lg hover:bg-slate-50" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        导出报告
      <% end %>
      <%= link_to edit_project_path(@project), class: "inline-flex items-center gap-2 px-4 py-2 bg-slate-800 text-white text-sm rounded-lg hover:bg-slate-700" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        编辑项目
      <% end %>
      <%= link_to new_project_record_path(@project), class: "inline-flex items-center gap-2 px-4 py-2 bg-amber-600 text-white text-sm rounded-lg hover:bg-amber-700" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        新建记录
      <% end %>
    </div>
  </div>

  <% if @project.has_abnormal_data? %>
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
      <div class="flex items-start gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div>
          <h4 class="font-medium text-amber-800">异常数据提示</h4>
          <div class="mt-2 space-y-1">
            <% @project.abnormal_records.each do |record| %>
              <p class="text-sm text-amber-700">
                · <%= record.batch_number %> (<%= record.record_date %>): <%= record.abnormal_reasons.join("、") %>
              </p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-3 gap-6">
    <div class="col-span-2 space-y-6">
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="p-4 border-b border-slate-200">
          <h3 class="font-semibold text-slate-800">项目描述</h3>
        </div>
        <div class="p-4">
          <p class="text-sm text-slate-600 leading-relaxed">
            <%= @project.description || "暂无描述" %>
          </p>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="p-4 border-b border-slate-200 flex items-center justify-between">
          <h3 class="font-semibold text-slate-800">记录批次</h3>
          <span class="text-sm text-slate-400"><%= @records.size %> 条记录</span>
        </div>
        <div class="divide-y divide-slate-200">
          <% @records.each do |record| %>
            <div class="p-4 hover:bg-slate-50 transition-colors">
              <div class="flex items-start justify-between">
                <div class="flex items-start gap-4">
                  <div class="w-16 h-16 bg-slate-100 rounded-lg flex items-center justify-center shrink-0 overflow-hidden">
                    <% if record.image_url.present? %>
                      <img src="<%= record.image_url %>" class="w-full h-full object-cover" alt="">
                    <% else %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    <% end %>
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <h4 class="font-medium text-slate-900"><%= record.batch_number %></h4>
                      <% type_class = { survey: "bg-blue-100 text-blue-700", review: "bg-emerald-100 text-emerald-700", special: "bg-purple-100 text-purple-700" }[record.version_type.to_sym] %>
                      <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full <%= type_class %>">
                        <%= record.version_type_i18n %>
                      </span>
                      <% if record.abnormal? %>
                        <span class="text-xs text-amber-600">⚠ 异常</span>
                      <% end %>
                    </div>
                    <p class="text-sm text-slate-500 mt-1">
                      <%= record.record_date %> · <%= record.photographer || "拍摄者未知" %>
                    </p>
                    <div class="flex items-center gap-4 mt-2 text-xs text-slate-500">
                      <span><%= record.annotations.count %> 处标注</span>
                      <span>温度 <%= record.temperature %>°C</span>
                      <span>湿度 <%= record.humidity %>%</span>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <%= link_to editor_project_record_path(@project, record), class: "text-sm text-amber-600 hover:text-amber-700" do %>
                    编辑标注
                  <% end %>
                  <%= link_to "查看", project_record_path(@project, record), class: "text-sm text-slate-600 hover:text-slate-800" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="p-4 border-b border-slate-200">
          <h3 class="font-semibold text-slate-800">病害统计</h3>
        </div>
        <div class="p-4 space-y-4">
          <% @disease_summary.each do |type, count| %>
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-slate-600">
                  <%= { flaking: "起甲", efflorescence: "酥碱", discoloration: "变色", crack: "裂隙", other: "其他" }[type.to_sym] || type %>
                </span>
                <span class="text-sm font-medium text-slate-800"><%= count %> 处</span>
              </div>
              <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                <% color = { flaking: "bg-red-500", efflorescence: "bg-amber-500", discoloration: "bg-purple-500", crack: "bg-blue-500", other: "bg-slate-400" }[type.to_sym] || "bg-slate-400" %>
                <% max_count = @disease_summary.values.max || 1 %>
                <div class="h-full <%= color %> rounded-full" style="width: <%= (count.to_f / max_count * 100).round %>% %>"></div>
              </div>
            </div>
          <% end %>
          <% if @disease_summary.empty? %>
            <p class="text-sm text-slate-400 text-center py-4">暂无病害数据</p>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="p-4 border-b border-slate-200">
          <h3 class="font-semibold text-slate-800">严重程度</h3>
        </div>
        <div class="p-4 space-y-3">
          <% severity_labels = { mild: ["轻微", "text-emerald-600", "bg-emerald-500"], moderate: ["中等", "text-amber-600", "bg-amber-500"], severe: ["重度", "text-red-600", "bg-red-500"] } %>
          <% severity_labels.each do |key, (label, text_class, bar_class)| %>
            <% count = @severity_summary[key.to_s] || 0 %>
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-600"><%= label %></span>
              <span class="text-sm font-medium <%= text_class %>"><%= count %> 处</span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="p-4 border-b border-slate-200">
          <h3 class="font-semibold text-slate-800">项目信息</h3>
        </div>
        <div class="p-4 space-y-3 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-500">项目编号</span>
            <span class="text-slate-800 font-mono"><%= @project.code %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">地理位置</span>
            <span class="text-slate-800"><%= @project.location %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">所属朝代</span>
            <span class="text-slate-800"><%= @project.dynasty || "-" %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">开始日期</span>
            <span class="text-slate-800"><%= @project.start_date || "-" %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">结束日期</span>
            <span class="text-slate-800"><%= @project.end_date || "-" %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
