<%= form_with model: @project do |form| %>
  <% if @project.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h3 class="text-red-800 font-medium mb-2">存在 <%= @project.errors.count %> 个错误：</h3>
      <ul class="list-disc list-inside text-red-600 text-sm space-y-1">
        <% @project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :name, "项目名称", class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.text_field :name, class: "w-full px-4 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :code, "项目编号", class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.text_field :code, class: "w-full px-4 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :building_type, "建筑类型", class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.select :building_type, Project::BUILDING_TYPES, { include_blank: "请选择建筑类型" }, class: "w-full px-4 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :era, "朝代", class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.text_field :era, class: "w-full px-4 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :location, "地点", class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.text_field :location, class: "w-full px-4 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :status, "状态", class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.select :status, Project::STATUSES, { include_blank: "请选择状态" }, class: "w-full px-4 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :started_at, "开始日期", class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.date_field :started_at, class: "w-full px-4 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :completed_at, "完成日期", class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.date_field :completed_at, class: "w-full px-4 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :description, "描述", class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.text_area :description, rows: 5, class: "w-full px-4 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors resize-y" %>
    </div>
  </div>

  <div class="mt-8 flex items-center space-x-4">
    <%= form.submit class: "px-6 py-2.5 bg-amber-600 text-white font-medium rounded-lg hover:bg-amber-700 focus:ring-4 focus:ring-amber-300 transition-colors cursor-pointer" %>
    <%= link_to "返回", projects_path, class: "px-6 py-2.5 bg-stone-100 text-stone-700 font-medium rounded-lg hover:bg-stone-200 transition-colors" %>
  </div>
<% end %>
