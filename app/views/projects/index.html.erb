<div class="row">
  <div class="col-12">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1>项目台账</h1>
      <a href="/projects/new" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> 新建项目
      </a>
    </div>

    <div class="card">
      <div class="card-body">
        <form class="row g-3">
          <div class="col-md-4">
            <input type="text" name="keyword" class="form-control" placeholder="搜索项目名称、编号或部门" value="<%= params[:keyword] %>">
          </div>
          <div class="col-md-3">
            <select name="status" class="form-select">
              <option value="">全部状态</option>
              <% Project.status_options.each do |label, value| %>
                <option value="<%= value %>" <%= 'selected' if params[:status] == value %>><%= label %></option>
              <% end %>
            </select>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">
              <i class="fa-solid fa-search"></i> 搜索
            </button>
          </div>
          <div class="col-md-2">
            <button type="button" onclick="location.href='/projects'" class="btn btn-outline-secondary w-100">
              <i class="fa-solid fa-rotate-right"></i> 重置
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="card mt-4">
      <div class="card-header bg-light">
        <div class="row">
          <div class="col-md-2"><strong>项目编号</strong></div>
          <div class="col-md-3"><strong>项目名称</strong></div>
          <div class="col-md-2"><strong>部门</strong></div>
          <div class="col-md-2"><strong>状态</strong></div>
          <div class="col-md-1"><strong>运行图</strong></div>
          <div class="col-md-1"><strong>径路数</strong></div>
          <div class="col-md-1"><strong>操作</strong></div>
        </div>
      </div>
      <div class="card-body p-0">
        <% @projects.each do |project| %>
          <div class="row border-bottom align-items-center p-3 hover:bg-light">
            <div class="col-md-2"><%= project.code %></div>
            <div class="col-md-3">
              <a href="/projects/<%= project.id %>"><%= project.name %></a>
            </div>
            <div class="col-md-2"><%= project.department || '-' %></div>
            <div class="col-md-2">
              <span class="badge bg-<%= project.status == 'active' ? 'success' : project.status == 'completed' ? 'primary' : project.status == 'draft' ? 'warning' : 'secondary' %>">
                <%= project.status_label %>
              </span>
            </div>
            <div class="col-md-1"><%= project.run_charts.count %></div>
            <div class="col-md-1"><%= project.total_routes %></div>
            <div class="col-md-1">
              <div class="btn-group">
                <a href="/projects/<%= project.id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-pencil"></i></a>
                <a href="/projects/<%= project.id %>" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-eye"></i></a>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
