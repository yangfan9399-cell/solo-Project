<% content_for :title, "项目台账 - 古建筑榫卯构件编号平台" %>

<div class="mb-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <h1 class="text-2xl font-bold text-stone-800">项目台账</h1>
    <div class="flex items-center space-x-3">
      <%= link_to export_projects_path(status: params[:status], building_type: params[:building_type], query: params[:query]), class: "inline-flex items-center px-4 py-2 bg-stone-100 text-stone-700 font-medium rounded-lg hover:bg-stone-200 transition-colors" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        导出
      <% end %>
      <%= link_to new_project_path, class: "inline-flex items-center px-4 py-2 bg-amber-600 text-white font-medium rounded-lg hover:bg-amber-700 transition-colors" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        新建项目
      <% end %>
    </div>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-stone-200 p-4 mb-6">
  <%= form_tag projects_path, method: :get, class: "grid grid-cols-1 md:grid-cols-4 gap-4" do %>
    <div>
      <%= label_tag :status, "状态筛选", class: "block text-sm font-medium text-stone-700 mb-1" %>
      <%= select_tag :status, options_for_select(Project::STATUSES, params[:status]), include_blank: "全部状态", class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors text-sm" %>
    </div>
    <div>
      <%= label_tag :building_type, "建筑类型", class: "block text-sm font-medium text-stone-700 mb-1" %>
      <%= select_tag :building_type, options_for_select(Project::BUILDING_TYPES, params[:building_type]), include_blank: "全部类型", class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors text-sm" %>
    </div>
    <div class="md:col-span-2">
      <%= label_tag :query, "搜索", class: "block text-sm font-medium text-stone-700 mb-1" %>
      <div class="flex">
        <%= text_field_tag :query, params[:query], placeholder: "搜索项目名称、编号、地点...", class: "flex-1 px-3 py-2 border border-stone-300 rounded-l-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors text-sm" %>
        <%= submit_tag "搜索", class: "px-4 py-2 bg-amber-600 text-white font-medium rounded-r-lg hover:bg-amber-700 transition-colors text-sm cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
  <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-5">
    <div class="flex items-center">
      <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center mr-4">
        <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
      </div>
      <div>
        <p class="text-sm text-stone-500">项目总数</p>
        <p class="text-2xl font-bold text-stone-800"><%= @stats[:total] %></p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-5">
    <div class="flex items-center">
      <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center mr-4">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div>
        <p class="text-sm text-stone-500">进行中</p>
        <p class="text-2xl font-bold text-stone-800"><%= @stats[:by_status].select { |k, _| k != "已完成" }.values.sum %></p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-5">
    <div class="flex items-center">
      <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center mr-4">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div>
        <p class="text-sm text-stone-500">已完成</p>
        <p class="text-2xl font-bold text-stone-800"><%= @stats[:by_status]["已完成"] || 0 %></p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-5">
    <div class="flex items-center">
      <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center mr-4">
        <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
        </svg>
      </div>
      <div>
        <p class="text-sm text-stone-500">构件总数</p>
        <p class="text-2xl font-bold text-stone-800"><%= Component.count %></p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-red-200 p-5">
    <div class="flex items-center">
      <div class="w-12 h-12 rounded-lg bg-red-100 flex items-center justify-center mr-4">
        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
      </div>
      <div>
        <p class="text-sm text-stone-500">异常数据</p>
        <p class="text-2xl font-bold text-red-600"><%= @anomaly_stats[:total] %></p>
      </div>
    </div>
    <% if @anomaly_stats[:total] > 0 %>
      <div class="mt-3 pt-3 border-t border-stone-100 text-xs text-stone-500 space-y-1">
        <% if @anomaly_stats[:status_anomaly] > 0 %>
          <div class="flex justify-between">
            <span>状态异常</span>
            <span class="font-medium text-red-600"><%= @anomaly_stats[:status_anomaly] %></span>
          </div>
        <% end %>
        <% if @anomaly_stats[:critical_defects] > 0 %>
          <div class="flex justify-between">
            <span>严重缺损</span>
            <span class="font-medium text-orange-600"><%= @anomaly_stats[:critical_defects] %></span>
          </div>
        <% end %>
        <% if @anomaly_stats[:no_code] > 0 %>
          <div class="flex justify-between">
            <span>无编号</span>
            <span class="font-medium text-yellow-600"><%= @anomaly_stats[:no_code] %></span>
          </div>
        <% end %>
        <% if @anomaly_stats[:awaiting_overdue] > 0 %>
          <div class="flex justify-between">
            <span>待复装超期</span>
            <span class="font-medium text-red-500"><%= @anomaly_stats[:awaiting_overdue] %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-stone-50 border-b border-stone-200">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">编号</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">名称</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">建筑类型</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">朝代</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">地点</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">构件数</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wider">完成率</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-stone-600 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% @projects.each do |project| %>
          <tr class="hover:bg-amber-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-stone-900"><%= project.code %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <%= link_to project_path(project), class: "text-sm font-medium text-amber-600 hover:text-amber-800 transition-colors" do %>
                <%= project.name %>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600"><%= project.building_type %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600"><%= project.era %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600"><%= project.location %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% status_class = case project.status
                when "普查中" then "bg-blue-100 text-blue-800"
                when "拆卸中" then "bg-yellow-100 text-yellow-800"
                when "修复中" then "bg-orange-100 text-orange-800"
                when "复装中" then "bg-purple-100 text-purple-800"
                when "已完成" then "bg-green-100 text-green-800"
                else "bg-stone-100 text-stone-800"
              end %>
              <span class="px-2.5 py-0.5 text-xs font-medium rounded-full <%= status_class %>">
                <%= project.status %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600"><%= project.components_count %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="w-24 bg-stone-200 rounded-full h-2 mr-2">
                  <div class="bg-amber-500 h-2 rounded-full" style="width: <%= project.completion_rate %>%"></div>
                </div>
                <span class="text-sm text-stone-600"><%= project.completion_rate %>%</span>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "查看", project_path(project), class: "text-amber-600 hover:text-amber-800 transition-colors" %>
              <span class="text-stone-300 mx-2">|</span>
              <%= link_to "编辑", edit_project_path(project), class: "text-stone-600 hover:text-stone-800 transition-colors" %>
            </td>
          </tr>
        <% end %>
        <% if @projects.empty? %>
          <tr>
            <td colspan="9" class="px-6 py-12 text-center text-stone-500">
              <svg class="w-16 h-16 mx-auto mb-4 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
              <p>暂无项目数据</p>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @total_pages > 1 %>
    <div class="px-6 py-4 border-t border-stone-200 flex items-center justify-between">
      <p class="text-sm text-stone-600">
        共 <%= @total_count %> 条记录，第 <%= @page %> / <%= @total_pages %> 页
      </p>
      <div class="flex items-center space-x-1">
        <% if @page > 1 %>
          <%= link_to projects_path(status: params[:status], building_type: params[:building_type], query: params[:query], page: 1), class: "px-3 py-1.5 text-sm text-stone-600 bg-stone-100 rounded hover:bg-stone-200 transition-colors" do %>
            首页
          <% end %>
          <%= link_to projects_path(status: params[:status], building_type: params[:building_type], query: params[:query], page: @page - 1), class: "px-3 py-1.5 text-sm text-stone-600 bg-stone-100 rounded hover:bg-stone-200 transition-colors" do %>
            上一页
          <% end %>
        <% end %>

        <% start_page = [1, @page - 2].max %>
        <% end_page = [@total_pages, @page + 2].min %>
        <% (start_page..end_page).each do |p| %>
          <% if p == @page %>
            <span class="px-3 py-1.5 text-sm text-white bg-amber-600 rounded"><%= p %></span>
          <% else %>
            <%= link_to p, projects_path(status: params[:status], building_type: params[:building_type], query: params[:query], page: p), class: "px-3 py-1.5 text-sm text-stone-600 bg-stone-100 rounded hover:bg-stone-200 transition-colors" %>
          <% end %>
        <% end %>

        <% if @page < @total_pages %>
          <%= link_to projects_path(status: params[:status], building_type: params[:building_type], query: params[:query], page: @page + 1), class: "px-3 py-1.5 text-sm text-stone-600 bg-stone-100 rounded hover:bg-stone-200 transition-colors" do %>
            下一页
          <% end %>
          <%= link_to projects_path(status: params[:status], building_type: params[:building_type], query: params[:query], page: @total_pages), class: "px-3 py-1.5 text-sm text-stone-600 bg-stone-100 rounded hover:bg-stone-200 transition-colors" do %>
            末页
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
