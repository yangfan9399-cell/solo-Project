<% content_for :title, "版本对比 - #{@project.name}" %>
<% content_for :page_title, "版本对比" %>
<% content_for :page_subtitle, "#{@project.name} · 年度变化分析" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <%= link_to history_project_path(@project), class: "text-slate-600 hover:text-slate-800 text-sm" do %>
        ← 返回版本历史
      <% end %>
      <span class="text-slate-300">|</span>
      <span class="text-sm text-slate-500">对比 <%= @records.size %> 个版本</span>
    </div>
    <div class="flex items-center gap-2">
      <select id="compare-mode" class="h-9 px-3 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500">
        <option value="side">并排对比</option>
        <option value="overlay">叠加对比</option>
        <option value="stats">统计对比</option>
      </select>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
    <h3 class="font-semibold text-slate-800 mb-4">病害变化总览</h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200">
            <th class="py-3 px-4 text-left font-medium text-slate-500">病害类型</th>
            <% @records.each do |record| %>
              <th class="py-3 px-4 text-center font-medium text-slate-500">
                <%= record.batch_number %><br>
                <span class="text-xs text-slate-400"><%= record.record_date %></span>
              </th>
            <% end %>
            <% if @records.size >= 2 %>
              <th class="py-3 px-4 text-center font-medium text-slate-500">变化量</th>
              <th class="py-3 px-4 text-center font-medium text-slate-500">变化率</th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% disease_types = [["flaking", "起甲", "#ef4444"], ["efflorescence", "酥碱", "#f59e0b"], ["discoloration", "变色", "#8b5cf6"], ["crack", "裂隙", "#3b82f6"], ["other", "其他", "#6b7280"]] %>
          <% disease_types.each do |type, label, color| %>
            <tr>
              <td class="py-3 px-4">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-sm" style="background-color: <%= color %>"></span>
                  <span class="text-slate-800"><%= label %></span>
                </div>
              </td>
              <% counts = @records.map { |r| r.annotations.where(disease_type: type).count } %>
              <% @records.each do |record| %>
                <td class="py-3 px-4 text-center text-slate-700 font-medium">
                  <%= record.annotations.where(disease_type: type).count %>
                </td>
              <% end %>
              <% if @records.size >= 2 %>
                <% diff = counts.last - counts.first %>
                <% rate = counts.first > 0 ? (diff.to_f / counts.first * 100).round(1) : 0 %>
                <td class="py-3 px-4 text-center">
                  <span class="<%= diff > 0 ? 'text-red-600' : diff < 0 ? 'text-emerald-600' : 'text-slate-600' %> font-medium">
                    <%= diff > 0 ? "+#{diff}" : diff.to_s %>
                  </span>
                </td>
                <td class="py-3 px-4 text-center">
                  <span class="<%= diff > 0 ? 'text-red-600 bg-red-50' : diff < 0 ? 'text-emerald-600 bg-emerald-50' : 'text-slate-600 bg-slate-50' %> px-2 py-0.5 rounded text-xs font-medium">
                    <%= diff > 0 ? "+#{rate}%" : "#{rate}%" %>
                  </span>
                </td>
              <% end %>
            </tr>
          <% end %>
          <tr class="bg-slate-50 font-medium">
            <td class="py-3 px-4 text-slate-800">总计</td>
            <% total_counts = @records.map { |r| r.annotations.count } %>
            <% @records.each do |record| %>
              <td class="py-3 px-4 text-center text-slate-800"><%= record.annotations.count %></td>
            <% end %>
            <% if @records.size >= 2 %>
              <% total_diff = total_counts.last - total_counts.first %>
              <% total_rate = total_counts.first > 0 ? (total_diff.to_f / total_counts.first * 100).round(1) : 0 %>
              <td class="py-3 px-4 text-center">
                <span class="<%= total_diff > 0 ? 'text-red-600' : total_diff < 0 ? 'text-emerald-600' : 'text-slate-600' %>">
                  <%= total_diff > 0 ? "+#{total_diff}" : total_diff.to_s %>
                </span>
              </td>
              <td class="py-3 px-4 text-center">
                <span class="<%= total_diff > 0 ? 'text-red-600 bg-red-50' : total_diff < 0 ? 'text-emerald-600 bg-emerald-50' : 'text-slate-600 bg-slate-50' %> px-2 py-0.5 rounded text-xs font-medium">
                  <%= total_diff > 0 ? "+#{total_rate}%" : "#{total_rate}%" %>
                </span>
              </td>
            <% end %>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
    <h3 class="font-semibold text-slate-800 mb-4">严重程度对比</h3>
    <div class="grid grid-cols-3 gap-6">
      <% severities = [["mild", "轻微", "text-emerald-600 bg-emerald-50"], ["moderate", "中等", "text-amber-600 bg-amber-50"], ["severe", "重度", "text-red-600 bg-red-50"]] %>
      <% severities.each do |sev, label, cls| %>
        <div class="p-4 bg-slate-50 rounded-lg">
          <h4 class="text-sm font-medium text-slate-700 mb-3"><%= label %></h4>
          <div class="space-y-2">
            <% @records.each do |record| %>
              <% count = record.annotations.where(severity: sev).count %>
              <div class="flex items-center justify-between">
                <span class="text-xs text-slate-500"><%= record.batch_number %></span>
                <span class="text-sm font-medium"><%= count %></span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="space-y-4">
    <h3 class="font-semibold text-slate-800">版本详情对比</h3>
    <div class="grid gap-4" style="grid-template-columns: repeat(<%= @records.size %>, minmax(0, 1fr));">
      <% @records.each do |record| %>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-4 bg-slate-50 border-b border-slate-200">
            <div class="flex items-center gap-2">
              <h4 class="font-medium text-slate-800"><%= record.batch_number %></h4>
              <% type_class = { survey: "bg-blue-100 text-blue-700", review: "bg-emerald-100 text-emerald-700", special: "bg-purple-100 text-purple-700" }[record.version_type.to_sym] %>
              <span class="px-2 py-0.5 text-xs font-medium rounded-full <%= type_class %>">
                <%= record.version_type_i18n %>
              </span>
            </div>
            <p class="text-xs text-slate-500 mt-1"><%= record.record_date %></p>
          </div>
          <div class="bg-slate-900 p-4 flex items-center justify-center" style="height: 200px;">
            <% if record.image_url.present? %>
              <img src="<%= record.image_url %>" alt="壁画图像" class="max-w-full max-h-full">
            <% else %>
              <div class="text-center text-amber-400/50 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-2 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                无图像
              </div>
            <% end %>
          </div>
          <div class="p-4 space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-slate-500">标注数</span>
              <span class="text-slate-800 font-medium"><%= record.annotations.count %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">温度</span>
              <span class="text-slate-800"><%= record.temperature ? "#{record.temperature}°C" : "-" %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">湿度</span>
              <span class="text-slate-800"><%= record.humidity ? "#{record.humidity}%" : "-" %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">拍摄者</span>
              <span class="text-slate-800"><%= record.photographer || "-" %></span>
            </div>
          </div>
          <div class="p-4 border-t border-slate-100">
            <%= link_to "查看详情", project_record_path(@project, record), class: "text-sm text-amber-600 hover:text-amber-700" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
    <h3 class="font-semibold text-slate-800 mb-4">环境参数变化</h3>
    <div class="grid grid-cols-2 gap-6">
      <div>
        <h4 class="text-sm text-slate-600 mb-2">温度变化</h4>
        <div class="flex items-end gap-3 h-32">
          <% max_temp = @records.map { |r| r.temperature || 0 }.max || 1 %>
          <% @records.each do |record| %>
            <div class="flex-1 flex flex-col items-center">
              <span class="text-xs text-slate-500 mb-1"><%= record.temperature || 0 %>°C</span>
              <div class="w-full bg-orange-100 rounded-t relative" style="height: <%= ((record.temperature || 0).to_f / max_temp * 100).round %>%">
                <div class="absolute inset-0 bg-orange-500 rounded-t"></div>
              </div>
              <span class="text-xs text-slate-400 mt-1"><%= record.batch_number.first(6) %></span>
            </div>
          <% end %>
        </div>
      </div>
      <div>
        <h4 class="text-sm text-slate-600 mb-2">湿度变化</h4>
        <div class="flex items-end gap-3 h-32">
          <% max_hum = @records.map { |r| r.humidity || 0 }.max || 1 %>
          <% @records.each do |record| %>
            <div class="flex-1 flex flex-col items-center">
              <span class="text-xs text-slate-500 mb-1"><%= record.humidity || 0 %>%</span>
              <div class="w-full bg-blue-100 rounded-t relative" style="height: <%= ((record.humidity || 0).to_f / max_hum * 100).round %>%">
                <div class="absolute inset-0 bg-blue-500 rounded-t"></div>
              </div>
              <span class="text-xs text-slate-400 mt-1"><%= record.batch_number.first(6) %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
