<%= content_for :title, '处理工作台 - 高校成绩更正申请审核系统' %>

<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-900">处理工作台</h1>
  </div>

  <%= render 'dashboard/statistics', statistics: @statistics %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 bg-blue-50">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-blue-900">处理中</h2>
          <span class="text-2xl font-bold text-blue-600"><%= @in_processing.count %></span>
        </div>
      </div>
      <div class="divide-y divide-gray-200 max-h-96 overflow-y-auto">
        <% if @in_processing.any? %>
          <% @in_processing.each do |gc| %>
            <%= link_to gc, class: "block hover:bg-gray-50" do %>
              <div class="px-6 py-4">
                <div class="flex items-start justify-between">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center space-x-2">
                      <h3 class="text-sm font-medium text-gray-900 truncate"><%= gc.application_no %></h3>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        <%= gc.student_name %>
                      </span>
                    </div>
                    <p class="mt-1 text-sm text-gray-500"><%= gc.course_name %></p>
                    <p class="mt-1 text-xs text-gray-400">
                      责任人: <%= gc.current_owner&.name || '未分配' %> · <%= time_ago_in_words(gc.updated_at) %>前更新
                    </p>
                  </div>
                  <svg class="h-5 w-5 text-gray-400 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="px-6 py-12 text-center text-gray-500">
            <svg class="mx-auto h-12 w-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <p class="text-sm">暂无处理中的申请</p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 bg-purple-50">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-purple-900">待复核</h2>
          <span class="text-2xl font-bold text-purple-600"><%= @pending_review.count %></span>
        </div>
      </div>
      <div class="divide-y divide-gray-200 max-h-96 overflow-y-auto">
        <% if @pending_review.any? %>
          <% @pending_review.each do |gc| %>
            <%= link_to review_grade_correction_path(gc), class: "block hover:bg-gray-50" do %>
              <div class="px-6 py-4">
                <div class="flex items-start justify-between">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center space-x-2">
                      <h3 class="text-sm font-medium text-gray-900 truncate"><%= gc.application_no %></h3>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                        <%= gc.student_name %>
                      </span>
                      <% if gc.has_block_reason? %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                          异常
                        </span>
                      <% end %>
                    </div>
                    <p class="mt-1 text-sm text-gray-500"><%= gc.course_name %></p>
                    <div class="mt-1 flex items-center space-x-3 text-xs">
                      <span class="text-gray-400">责任人: <%= gc.current_owner&.name || '未分配' %></span>
                      <% unless gc.notification_confirmed? %>
                        <span class="text-orange-600">待确认通知</span>
                      <% end %>
                    </div>
                  </div>
                  <svg class="h-5 w-5 text-gray-400 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="px-6 py-12 text-center text-gray-500">
            <svg class="mx-auto h-12 w-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-sm">暂无待复核的申请</p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 bg-orange-50">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-orange-900">已退回补证</h2>
          <span class="text-2xl font-bold text-orange-600"><%= @returned.count %></span>
        </div>
      </div>
      <div class="divide-y divide-gray-200 max-h-96 overflow-y-auto">
        <% if @returned.any? %>
          <% @returned.each do |gc| %>
            <%= link_to processing_grade_correction_path(gc), class: "block hover:bg-gray-50" do %>
              <div class="px-6 py-4">
                <div class="flex items-start justify-between">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center space-x-2">
                      <h3 class="text-sm font-medium text-gray-900 truncate"><%= gc.application_no %></h3>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                        <%= gc.student_name %>
                      </span>
                    </div>
                    <p class="mt-1 text-sm text-gray-500"><%= gc.course_name %></p>
                    <% if gc.remedy_path.present? %>
                      <p class="mt-1 text-xs text-orange-600 line-clamp-2">
                        补证要求: <%= gc.remedy_path.truncate(50) %>
                      </p>
                    <% end %>
                    <p class="mt-1 text-xs text-gray-400">
                      责任人: <%= gc.current_owner&.name || '未分配' %>
                    </p>
                  </div>
                  <svg class="h-5 w-5 text-gray-400 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="px-6 py-12 text-center text-gray-500">
            <svg class="mx-auto h-12 w-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <p class="text-sm">暂无退回补证的申请</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
