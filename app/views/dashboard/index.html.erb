<% provide :page_title, "仪表盘" %>

<div class="space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-blue-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-500">待审核申请</p>
          <p class="text-3xl font-bold text-gray-800 mt-1"><%= @pending_applications %></p>
        </div>
        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-3">等待版权/法务/财务审核</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-green-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-500">已完成授权</p>
          <p class="text-3xl font-bold text-gray-800 mt-1"><%= @approved_applications %></p>
        </div>
        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-3">已通过审核的申请</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-red-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-500">结算争议</p>
          <p class="text-3xl font-bold text-gray-800 mt-1"><%= @disputed_settlements %></p>
        </div>
        <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-3">需要处理的结算争议</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-amber-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-500">总营收</p>
          <p class="text-3xl font-bold text-gray-800 mt-1">¥<%= number_with_delimiter(@total_revenue.to_i) %></p>
        </div>
        <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-3">已确认结算金额</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-semibold text-gray-800">
          <% if current_user.biz_admin? %>
            我的申请
          <% else %>
            待审核列表
          <% end %>
        </h3>
        <%= link_to "查看全部", applications_path, class: "text-sm text-amber-600 hover:text-amber-700" %>
      </div>

      <% if @my_applications&.any? || @pending_reviews&.any? %>
        <div class="space-y-4">
          <% (@my_applications || @pending_reviews).each do |app| %>
            <%= link_to application_path(app), class: "block p-4 rounded-lg border border-gray-200 hover:border-amber-300 hover:bg-amber-50 transition-all" do %>
              <div class="flex items-center justify-between">
                <div class="flex-1">
                  <div class="flex items-center space-x-3">
                    <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_class(app.status) %>">
                      <%= status_text(app.status) %>
                    </span>
                    <h4 class="font-medium text-gray-800"><%= app.track.title %></h4>
                  </div>
                  <p class="text-sm text-gray-500 mt-1">
                    <%= app.client_name %> · <%= scenario_text(app.usage_scenario) %>
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-sm text-gray-400"><%= app.created_at.strftime("%m/%d") %></p>
                  <p class="text-sm font-medium text-gray-600">¥<%= number_with_delimiter(app.budget.to_i) %></p>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8 text-gray-500">
          <svg class="w-12 h-12 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          <p>暂无待处理申请</p>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-6">快速操作</h3>

      <div class="grid grid-cols-2 gap-4">
        <% if current_user.biz_admin? || current_user.admin? %>
          <%= link_to new_application_path,
              class: "p-4 rounded-lg border-2 border-dashed border-gray-300 hover:border-amber-400 hover:bg-amber-50 transition-all text-center" do %>
            <svg class="w-8 h-8 mx-auto text-gray-400 hover:text-amber-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span class="text-sm font-medium text-gray-600">新建申请</span>
          <% end %>
        <% end %>

        <%= link_to applications_path,
            class: "p-4 rounded-lg border-2 border-dashed border-gray-300 hover:border-blue-400 hover:bg-blue-50 transition-all text-center" do %>
          <svg class="w-8 h-8 mx-auto text-gray-400 hover:text-blue-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          <span class="text-sm font-medium text-gray-600">授权申请</span>
        <% end %>

        <%= link_to tracks_path,
            class: "p-4 rounded-lg border-2 border-dashed border-gray-300 hover:border-green-400 hover:bg-green-50 transition-all text-center" do %>
          <svg class="w-8 h-8 mx-auto text-gray-400 hover:text-green-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
          </svg>
          <span class="text-sm font-medium text-gray-600">曲库管理</span>
        <% end %>

        <% if current_user.finance? || current_user.admin? %>
          <%= link_to settlements_path,
              class: "p-4 rounded-lg border-2 border-dashed border-gray-300 hover:border-purple-400 hover:bg-purple-50 transition-all text-center" do %>
            <svg class="w-8 h-8 mx-auto text-gray-400 hover:text-purple-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-sm font-medium text-gray-600">结算管理</span>
          <% end %>
        <% else %>
          <div class="p-4 rounded-lg border-2 border-dashed border-gray-200 text-center opacity-50">
            <svg class="w-8 h-8 mx-auto text-gray-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
            <span class="text-sm font-medium text-gray-400">结算管理</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% if @pending_settlements&.any? %>
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-semibold text-gray-800">待结算项目</h3>
        <%= link_to "查看全部", settlements_path, class: "text-sm text-amber-600 hover:text-amber-700" %>
      </div>

      <div class="space-y-4">
        <% @pending_settlements.each do |settlement| %>
          <%= link_to settlement_path(settlement), class: "block p-4 rounded-lg border border-gray-200 hover:border-purple-300 hover:bg-purple-50 transition-all" do %>
            <div class="flex items-center justify-between">
              <div>
                <h4 class="font-medium text-gray-800"><%= settlement.application.track.title %></h4>
                <p class="text-sm text-gray-500 mt-1">
                  <%= settlement.application.client_name %> · 结算金额 ¥<%= number_with_delimiter(settlement.total_amount.to_i) %>
                </p>
              </div>
              <span class="px-3 py-1 text-sm font-medium rounded-full bg-purple-100 text-purple-700">
                待确认
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<% content_for :view_scripts do %>
<script>
function status_class(status) {
  const classes = {
    draft: 'bg-gray-100 text-gray-700',
    pending_copyright: 'bg-blue-100 text-blue-700',
    pending_legal: 'bg-indigo-100 text-indigo-700',
    pending_finance: 'bg-purple-100 text-purple-700',
    approved: 'bg-green-100 text-green-700',
    rejected: 'bg-red-100 text-red-700',
    disputed: 'bg-orange-100 text-orange-700'
  };
  return classes[status] || 'bg-gray-100 text-gray-700';
}

function status_text(status) {
  const texts = {
    draft: '草稿',
    pending_copyright: '版权审核中',
    pending_legal: '法务审核中',
    pending_finance: '财务审核中',
    approved: '已通过',
    rejected: '已驳回',
    disputed: '争议中'
  };
  return texts[status] || status;
}

function scenario_text(scenario) {
  const texts = {
    tv_ad: '电视广告',
    online_video: '线上视频',
    live_stream: '直播',
    film: '影视',
    radio: '广播',
    other: '其他'
  };
  return texts[scenario] || scenario;
}
</script>
<% end %>