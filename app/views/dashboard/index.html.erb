<div class="space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-sm text-gray-500">待处理调拨</div>
      <div class="text-3xl font-bold text-blue-600"><%= @pending_allocations %></div>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-sm text-gray-500">待审核报损</div>
      <div class="text-3xl font-bold text-orange-600"><%= @pending_loss_reports %></div>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-sm text-gray-500">临期批次</div>
      <div class="text-3xl font-bold text-red-600"><%= @near_expiry_batches %></div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-4">最近调拨</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">单号</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">来源</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">目标</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @recent_allocations.each do |allocation| %>
              <tr>
                <td class="px-4 py-2"><%= link_to allocation.allocation_number, allocation, class: "text-blue-600 hover:underline" %></td>
                <td class="px-4 py-2"><%= allocation.source_store.name %></td>
                <td class="px-4 py-2"><%= allocation.target_store.name %></td>
                <td class="px-4 py-2">
                  <span class="px-2 py-1 text-xs rounded-full <%= status_class(allocation.status) %>">
                    <%= allocation.status_i18n %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-4">最近报损</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">单号</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">物料</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">类型</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">数量</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @recent_loss_reports.each do |report| %>
              <tr>
                <td class="px-4 py-2"><%= link_to report.report_number, report, class: "text-blue-600 hover:underline" %></td>
                <td class="px-4 py-2"><%= report.batch.material.name %></td>
                <td class="px-4 py-2"><%= report.loss_type_i18n %></td>
                <td class="px-4 py-2"><%= report.quantity %><%= report.batch.material.unit %></td>
                <td class="px-4 py-2">
                  <span class="px-2 py-1 text-xs rounded-full <%= status_class(report.status) %>">
                    <%= report.status_i18n %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-4">损耗统计</h2>
      <div class="space-y-4">
        <div>
          <div class="text-sm text-gray-500">损耗率</div>
          <div class="text-2xl font-bold text-red-600"><%= @statistics[:loss_rate] %>%</div>
        </div>
        <div>
          <h3 class="text-sm font-medium text-gray-700 mb-2">按损耗类型</h3>
          <div class="space-y-2">
            <% @statistics[:loss_by_type].each do |type, qty| %>
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600"><%= LossReport.human_attribute_name("loss_type.#{type}") %></span>
                <span class="text-sm font-medium"><%= qty %>kg</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-4">按区域损耗</h2>
      <div class="space-y-2">
        <% @statistics[:loss_by_region].each do |region, qty| %>
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-600"><%= region %></span>
            <span class="text-sm font-medium"><%= qty %>kg</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
