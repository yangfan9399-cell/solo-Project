<%
  vehicle_status_labels = {
    'available' => { name: '正常', color: 'bg-green-100 text-green-700 ring-green-600/20' },
    'in_maintenance' => { name: '保养中', color: 'bg-blue-100 text-blue-700 ring-blue-600/20' },
    'under_repair' => { name: '维修中', color: 'bg-orange-100 text-orange-700 ring-orange-600/20' },
    'decommissioned' => { name: '停用', color: 'bg-red-100 text-red-700 ring-red-600/20' },
    'pending_review' => { name: '待复核', color: 'bg-yellow-100 text-yellow-700 ring-yellow-600/20' }
  }

  item_type_configs = {
    pending_trip: {
      label: '待复核出车',
      color: 'bg-amber-50 text-amber-700 ring-amber-600/20',
      dot_color: 'bg-amber-500',
      path: ->(item) { trip_record_path(item[:record]) }
    },
    unfinished_repair: {
      label: '维修中',
      color: 'bg-orange-50 text-orange-700 ring-orange-600/20',
      dot_color: 'bg-orange-500',
      path: ->(item) { repair_record_path(item[:record]) }
    },
    overdue_maintenance: {
      label: '超期保养',
      color: 'bg-red-50 text-red-700 ring-red-600/20',
      dot_color: 'bg-red-500',
      path: ->(item) { maintenance_plan_path(item[:record]) }
    }
  }

  review_status_labels = {
    'pending' => { name: '待复核', color: 'bg-yellow-100 text-yellow-700' },
    'approved' => { name: '已通过', color: 'bg-green-100 text-green-700' },
    'rejected' => { name: '已驳回', color: 'bg-red-100 text-red-700' },
    'decommissioned' => { name: '已停用', color: 'bg-gray-100 text-gray-700' }
  }

  total_vehicles = @vehicle_status_counts.values.sum
  today_date = Date.today
%>

<%= content_for(:title, '工作台 - 环卫车辆运维管理系统') %>

<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">工作台</h1>
      <p class="mt-1 text-sm text-gray-500">
        <%= today_date.strftime('%Y年%m月%d日 %A') %> · 欢迎回来，张队长
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-full text-sm font-medium ring-1 ring-inset ring-emerald-600/20">
        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
        系统运行正常
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-6 gap-4">
    <div class="bg-white rounded-2xl p-5 shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center shadow-sm">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/>
          </svg>
        </div>
        <%= link_to vehicles_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <div class="flex items-baseline gap-1">
        <span class="text-3xl font-bold text-gray-900"><%= total_vehicles %></span>
        <span class="text-sm text-gray-500">辆</span>
      </div>
      <p class="mt-1 text-sm font-medium text-gray-700">车辆总数</p>
      <div class="mt-4 flex flex-wrap gap-1.5">
        <% vehicle_status_labels.each do |key, config| %>
          <% count = @vehicle_status_counts[key] || 0 %>
          <% if count > 0 %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium ring-1 ring-inset <%= config[:color] %>">
              <%= config[:name] %> <%= count %>
            </span>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center shadow-sm">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <%= link_to trip_records_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <div class="flex items-baseline gap-1">
        <span class="text-3xl font-bold text-gray-900"><%= @pending_trip_count %></span>
        <span class="text-sm text-gray-500">单</span>
      </div>
      <p class="mt-1 text-sm font-medium text-gray-700">待复核出车单</p>
      <div class="mt-4">
        <% if @pending_trip_count > 0 %>
          <div class="flex items-center gap-2 text-sm text-amber-600">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
            <span class="font-medium">需要及时处理</span>
          </div>
        <% else %>
          <div class="flex items-center gap-2 text-sm text-green-600">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="font-medium">暂无待处理</span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center shadow-sm">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"/>
          </svg>
        </div>
        <%= link_to repair_records_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <div class="flex items-baseline gap-1">
        <span class="text-3xl font-bold text-gray-900"><%= @unfinished_repair_count %></span>
        <span class="text-sm text-gray-500">辆</span>
      </div>
      <p class="mt-1 text-sm font-medium text-gray-700">未完成维修</p>
      <div class="mt-4">
        <div class="w-full bg-gray-100 rounded-full h-2">
          <% repair_percentage = total_vehicles > 0 ? ((@unfinished_repair_count.to_f / total_vehicles) * 100).round : 0 %>
          <div class="bg-orange-500 h-2 rounded-full transition-all duration-500" style="width: <%= repair_percentage %>%"></div>
        </div>
        <p class="mt-2 text-xs text-gray-500">占比 <%= repair_percentage %>%</p>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center shadow-sm">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <%= link_to maintenance_plans_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <div class="flex items-baseline gap-1">
        <span class="text-3xl font-bold text-gray-900"><%= @overdue_maintenance_count %></span>
        <span class="text-sm text-gray-500">项</span>
      </div>
      <p class="mt-1 text-sm font-medium text-gray-700">超期保养</p>
      <div class="mt-4">
        <% if @overdue_maintenance_count > 0 %>
          <div class="flex items-center gap-2 text-sm text-red-600">
            <svg class="w-4 h-4 animate-pulse" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
            </svg>
            <span class="font-medium">请立即处理</span>
          </div>
        <% else %>
          <div class="flex items-center gap-2 text-sm text-green-600">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="font-medium">全部按时完成</span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center shadow-sm">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <%= link_to fuel_records_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <div class="flex items-baseline gap-1">
        <span class="text-3xl font-bold text-gray-900"><%= @abnormal_fuel_count %></span>
        <span class="text-sm text-gray-500">次</span>
      </div>
      <p class="mt-1 text-sm font-medium text-gray-700">30天油耗异常</p>
      <div class="mt-4">
        <p class="text-xs text-gray-500">近30天内异常记录</p>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 shadow-sm ring-1 ring-gray-900/5 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center shadow-sm">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <%= link_to trip_records_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <div class="flex items-baseline gap-1">
        <span class="text-3xl font-bold text-gray-900"><%= @today_trips.count %></span>
        <span class="text-sm text-gray-500">车次</span>
      </div>
      <p class="mt-1 text-sm font-medium text-gray-700">今日出车</p>
      <div class="mt-4 flex items-center gap-3">
        <% approved_count = @today_trips.select { |t| t.approved? }.count %>
        <% pending_count = @today_trips.select { |t| t.pending? }.count %>
        <div class="flex-1">
          <div class="flex items-center gap-1.5 text-xs text-gray-500 mb-1">
            <span class="w-2 h-2 rounded-full bg-green-500"></span>
            已出发 <%= approved_count %>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-1.5">
            <% today_percentage = @today_trips.count > 0 ? ((approved_count.to_f / @today_trips.count) * 100).round : 0 %>
            <div class="bg-green-500 h-1.5 rounded-full transition-all duration-500" style="width: <%= today_percentage %>%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <div class="xl:col-span-2 bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5">
      <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">
        <div>
          <h2 class="text-base font-semibold text-gray-900">待处理事项</h2>
          <p class="mt-0.5 text-sm text-gray-500">共 <%= @pending_items.count %> 项待处理，按时间排序</p>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <span class="inline-flex items-center gap-1 px-2 py-1 bg-amber-50 text-amber-700 rounded-md ring-1 ring-inset ring-amber-600/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            待复核
          </span>
          <span class="inline-flex items-center gap-1 px-2 py-1 bg-orange-50 text-orange-700 rounded-md ring-1 ring-inset ring-orange-600/20">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
            维修中
          </span>
          <span class="inline-flex items-center gap-1 px-2 py-1 bg-red-50 text-red-700 rounded-md ring-1 ring-inset ring-red-600/20">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
            超期
          </span>
        </div>
      </div>

      <div class="divide-y divide-gray-100 max-h-[480px] overflow-y-auto">
        <% if @pending_items.empty? %>
          <div class="px-6 py-16 text-center">
            <div class="mx-auto w-16 h-16 rounded-full bg-green-50 flex items-center justify-center mb-4">
              <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <p class="text-sm font-medium text-gray-900">暂无待处理事项</p>
            <p class="mt-1 text-sm text-gray-500">所有事项均已处理完毕，继续保持！</p>
          </div>
        <% else %>
          <% @pending_items.first(15).each do |item| %>
            <% config = item_type_configs[item[:type]] %>
            <%= link_to config[:path].call(item), class: "block px-6 py-4 hover:bg-gray-50 transition-colors group" do %>
              <div class="flex items-start gap-4">
                <div class="relative mt-0.5">
                  <div class="w-2.5 h-2.5 rounded-full <%= config[:dot_color] %> ring-4 ring-white"></div>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <p class="text-sm font-semibold text-gray-900 truncate"><%= item[:title] %></p>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium ring-1 ring-inset <%= config[:color] %> shrink-0">
                      <%= config[:label] %>
                    </span>
                  </div>
                  <p class="mt-1 text-sm text-gray-600 truncate"><%= item[:description] %></p>
                  <p class="mt-1.5 text-xs text-gray-400 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <% if item[:time].is_a?(Date) %>
                      <%= item[:time].strftime('%Y-%m-%d') %>
                    <% elsif item[:time].is_a?(Time) || item[:time].is_a?(DateTime) %>
                      <%= item[:time].strftime('%Y-%m-%d %H:%M') %>
                    <% else %>
                      <%= item[:time] %>
                    <% end %>
                  </p>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-gray-400 transition-colors shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            <% end %>
          <% end %>
          <% if @pending_items.count > 15 %>
            <div class="px-6 py-3 text-center border-t border-gray-100">
              <p class="text-sm text-gray-500">
                还有 <%= @pending_items.count - 15 %> 项待处理，请前往各模块查看
              </p>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5">
      <div class="px-6 py-5 border-b border-gray-100">
        <h2 class="text-base font-semibold text-gray-900">今日出车时间轴</h2>
        <p class="mt-0.5 text-sm text-gray-500"><%= today_date.strftime('%m月%d日') %> 共 <%= @today_trips.count %> 车次</p>
      </div>

      <div class="px-6 py-5 max-h-[480px] overflow-y-auto">
        <% if @today_trips.empty? %>
          <div class="py-12 text-center">
            <div class="mx-auto w-16 h-16 rounded-full bg-gray-50 flex items-center justify-center mb-4">
              <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <p class="text-sm font-medium text-gray-900">今日暂无出车计划</p>
            <p class="mt-1 text-sm text-gray-500">可前往出车管理模块创建出车单</p>
          </div>
        <% else %>
          <div class="relative">
            <div class="absolute left-3 top-0 bottom-0 w-px bg-gray-200"></div>
            <div class="space-y-5">
              <% @today_trips.each do |trip| %>
                <% status_config = review_status_labels[trip.review_status] || { name: trip.review_status, color: 'bg-gray-100 text-gray-700' } %>
                <% is_active = trip.approved? && trip.is_active? %>
                <div class="relative pl-10">
                  <div class="absolute left-0 top-1.5 w-7 h-7 rounded-full <%= is_active ? 'bg-emerald-500 ring-4 ring-emerald-100' : trip.pending? ? 'bg-yellow-500 ring-4 ring-yellow-100' : 'bg-gray-300 ring-4 ring-gray-100' %> flex items-center justify-center z-10">
                    <% if is_active %>
                      <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                      </svg>
                    <% elsif trip.pending? %>
                      <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    <% else %>
                      <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    <% end %>
                  </div>
                  <div class="<%= is_active ? 'bg-emerald-50/50 border-emerald-100' : '' %> rounded-xl p-3 border border-gray-100">
                    <div class="flex items-center justify-between gap-2 mb-1.5">
                      <p class="text-sm font-bold text-gray-900">
                        <%= trip.planned_departure_time.strftime('%H:%M') %>
                      </p>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= status_config[:color] %>">
                        <%= status_config[:name] %>
                      </span>
                    </div>
                    <div class="space-y-1">
                      <div class="flex items-center gap-1.5 text-sm text-gray-700">
                        <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                        <span class="truncate"><%= trip.vehicle&.plate_number || '未知车牌' %></span>
                      </div>
                      <div class="flex items-center gap-1.5 text-xs text-gray-500">
                        <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <span class="truncate"><%= trip.route&.name || '未知线路' %></span>
                      </div>
                      <div class="flex items-center gap-1.5 text-xs text-gray-500">
                        <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        <span class="truncate"><%= trip.driver_name %></span>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
    <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">
      <div>
        <h2 class="text-base font-semibold text-gray-900">各车队概览</h2>
        <p class="mt-0.5 text-sm text-gray-500">按车队统计车辆状态分布</p>
      </div>
      <%= link_to vehicles_path, class: "text-sm text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1" do %>
        查看全部
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50/80">
          <tr>
            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">车队名称</th>
            <th scope="col" class="px-6 py-3.5 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">车辆总数</th>
            <th scope="col" class="px-6 py-3.5 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-green-500"></span>
                正常
              </span>
            </th>
            <th scope="col" class="px-6 py-3.5 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-orange-500"></span>
                维修中
              </span>
            </th>
            <th scope="col" class="px-6 py-3.5 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                保养中
              </span>
            </th>
            <th scope="col" class="px-6 py-3.5 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-yellow-500"></span>
                待复核
              </span>
            </th>
            <th scope="col" class="px-6 py-3.5 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-red-500"></span>
                停用
              </span>
            </th>
            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">状态分布</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if @fleet_overview.empty? %>
            <tr>
              <td colspan="8" class="px-6 py-16 text-center">
                <p class="text-sm text-gray-500">暂无车队数据</p>
              </td>
            </tr>
          <% else %>
            <% @fleet_overview.each do |fleet_data| %>
              <% fleet = fleet_data[:fleet] %>
              <% total = fleet_data[:total_count] %>
              <%
                available = fleet_data[:available_count]
                under_repair = fleet_data[:under_repair_count]
                in_maintenance = fleet_data[:in_maintenance_count]
                pending_review = fleet_data[:pending_review_count]
                decommissioned = fleet_data[:decommissioned_count]
              %>
              <tr class="hover:bg-gray-50/50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
                      <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                      </svg>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-gray-900"><%= fleet.name %></p>
                      <p class="text-xs text-gray-500">编号: <%= fleet.code %></p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="text-lg font-bold text-gray-900"><%= total %></span>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="<%= available > 0 ? 'text-green-700 bg-green-50 ring-green-600/20' : 'text-gray-400 bg-gray-50 ring-gray-500/10' %> inline-flex items-center px-2.5 py-1 rounded-md text-sm font-semibold ring-1 ring-inset">
                    <%= available %>
                  </span>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="<%= under_repair > 0 ? 'text-orange-700 bg-orange-50 ring-orange-600/20' : 'text-gray-400 bg-gray-50 ring-gray-500/10' %> inline-flex items-center px-2.5 py-1 rounded-md text-sm font-semibold ring-1 ring-inset">
                    <%= under_repair %>
                  </span>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="<%= in_maintenance > 0 ? 'text-blue-700 bg-blue-50 ring-blue-600/20' : 'text-gray-400 bg-gray-50 ring-gray-500/10' %> inline-flex items-center px-2.5 py-1 rounded-md text-sm font-semibold ring-1 ring-inset">
                    <%= in_maintenance %>
                  </span>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="<%= pending_review > 0 ? 'text-yellow-700 bg-yellow-50 ring-yellow-600/20' : 'text-gray-400 bg-gray-50 ring-gray-500/10' %> inline-flex items-center px-2.5 py-1 rounded-md text-sm font-semibold ring-1 ring-inset">
                    <%= pending_review %>
                  </span>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="<%= decommissioned > 0 ? 'text-red-700 bg-red-50 ring-red-600/20' : 'text-gray-400 bg-gray-50 ring-gray-500/10' %> inline-flex items-center px-2.5 py-1 rounded-md text-sm font-semibold ring-1 ring-inset">
                    <%= decommissioned %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <div class="w-full max-w-xs">
                    <% if total > 0 %>
                      <div class="flex h-2.5 rounded-full overflow-hidden bg-gray-100">
                        <% if available > 0 %>
                          <div class="bg-green-500" style="width: <%= (available.to_f / total * 100).round %>%" title="正常 <%= available %>"></div>
                        <% end %>
                        <% if under_repair > 0 %>
                          <div class="bg-orange-500" style="width: <%= (under_repair.to_f / total * 100).round %>%" title="维修中 <%= under_repair %>"></div>
                        <% end %>
                        <% if in_maintenance > 0 %>
                          <div class="bg-blue-500" style="width: <%= (in_maintenance.to_f / total * 100).round %>%" title="保养中 <%= in_maintenance %>"></div>
                        <% end %>
                        <% if pending_review > 0 %>
                          <div class="bg-yellow-500" style="width: <%= (pending_review.to_f / total * 100).round %>%" title="待复核 <%= pending_review %>"></div>
                        <% end %>
                        <% if decommissioned > 0 %>
                          <div class="bg-red-500" style="width: <%= (decommissioned.to_f / total * 100).round %>%" title="停用 <%= decommissioned %>"></div>
                        <% end %>
                      </div>
                    <% else %>
                      <div class="h-2.5 rounded-full bg-gray-100"></div>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
