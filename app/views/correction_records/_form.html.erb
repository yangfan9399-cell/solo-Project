<%= form_with model: [@inspection_record, correction_record], local: true do |form| %>
  <% if correction_record.errors.any? %>
    <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
      <h4 class="text-sm font-medium text-red-800">表单有以下错误：</h4>
      <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
        <% correction_record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-6">
    <div>
      <%= form.label :business_record, '业务记录 *', class: 'block text-sm font-medium text-gray-700' %>
      <%= form.text_area :business_record, required: true, rows: 3, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '记录整改过程中的业务相关信息...' %>
    </div>

    <div>
      <%= form.label :site_description, '现场说明 *', class: 'block text-sm font-medium text-gray-700' %>
      <%= form.text_area :site_description, required: true, rows: 3, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '详细描述现场情况...' %>
    </div>

    <div>
      <%= form.label :correction_measure, '整改措施 *', class: 'block text-sm font-medium text-gray-700' %>
      <%= form.text_area :correction_measure, required: true, rows: 3, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '描述采取的具体整改措施...' %>
    </div>

    <div>
      <%= form.label :correction_result, '整改结果', class: 'block text-sm font-medium text-gray-700' %>
      <%= form.text_area :correction_result, rows: 2, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '整改后的结果描述...' %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :correction_time, '整改完成时间', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.datetime_field :correction_time, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
      </div>
      <div>
        <%= form.label :operator, '整改操作人', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.text_field :operator, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '执行整改的人员姓名' %>
      </div>
    </div>

    <div>
      <%= form.label :remark, '备注', class: 'block text-sm font-medium text-gray-700' %>
      <%= form.text_area :remark, rows: 2, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '其他需要说明的信息...' %>
    </div>
  </div>

  <div class="mt-8 flex justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to '取消', @inspection_record, class: 'px-6 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50' %>
    <%= form.submit class: 'inline-flex items-center px-6 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700' %>
  </div>
<% end %>
