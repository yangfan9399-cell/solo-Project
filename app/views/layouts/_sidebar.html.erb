<aside class="w-64 bg-slate-900 text-slate-100 flex flex-col shrink-0">
  <div class="p-5 border-b border-slate-700">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-amber-600 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <div>
        <h1 class="text-sm font-bold text-white">壁画病害观察</h1>
        <p class="text-xs text-slate-400">石窟保护工作台</p>
      </div>
    </div>
  </div>

  <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
    <% first_project_id = Project.first&.id %>
    <% is_history_page = request.path.include?('/history') %>
    <% is_exports_page = request.path.include?('/exports') %>
    <% is_abnormal_page = params[:has_abnormal] == 'true' %>
    <% is_compare_page = request.path.include?('/compare') %>

    <%= link_to projects_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm #{current_page?(projects_path) && !is_abnormal_page ? 'bg-amber-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      <span>项目台账</span>
    <% end %>

    <div class="pt-4 pb-2 px-3">
      <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">系统功能</p>
    </div>

    <%= link_to projects_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-800 hover:text-white" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <span>检索中心</span>
    <% end %>

    <%= link_to first_project_id ? history_project_path(first_project_id) : projects_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{is_history_page ? 'bg-amber-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>历史版本</span>
    <% end %>

    <%= link_to first_project_id ? project_exports_path(first_project_id) : projects_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{is_exports_page ? 'bg-amber-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <span>导出报告</span>
    <% end %>

    <%= link_to projects_path(has_abnormal: true), class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{is_abnormal_page ? 'bg-red-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span>异常预警</span>
    <% end %>
  </nav>

  <div class="p-4 border-t border-slate-700">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-slate-600 flex items-center justify-center text-sm font-medium">
        研
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium truncate">研究员</p>
        <p class="text-xs text-slate-400 truncate">保护研究所</p>
      </div>
    </div>
  </div>
</aside>
