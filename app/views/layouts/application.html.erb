<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "高校成绩更正申请审核系统" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="成绩更正审核系统">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <% if current_user %>
      <nav class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16">
            <div class="flex items-center space-x-8">
              <%= link_to root_path, class: "flex items-center space-x-2 text-xl font-bold text-blue-600" do %>
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>成绩更正审核系统</span>
              <% end %>
              <div class="hidden md:flex items-center space-x-1">
                <%= link_to dashboard_path, class: "px-3 py-2 rounded-md text-sm font-medium #{request.path == dashboard_path ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-100'}" do %>
                  <span class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                    </svg>
                    <span>看板</span>
                  </span>
                <% end %>
                <%= link_to grade_corrections_path, class: "px-3 py-2 rounded-md text-sm font-medium #{request.path == grade_corrections_path ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-100'}" do %>
                  <span class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    <span>申请列表</span>
                  </span>
                <% end %>
                <%= link_to review_dashboard_path, class: "px-3 py-2 rounded-md text-sm font-medium #{request.path == review_dashboard_path ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-100'}" do %>
                  <span class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                    </svg>
                    <span>处理台</span>
                  </span>
                <% end %>
                <%= link_to statistics_dashboard_path, class: "px-3 py-2 rounded-md text-sm font-medium #{request.path == statistics_dashboard_path ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-100'}" do %>
                  <span class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                    <span>复盘统计</span>
                  </span>
                <% end %>
              </div>
            </div>
            <div class="flex items-center space-x-4">
              <% if User.count > 1 %>
                <div class="relative" data-controller="dropdown">
                  <button type="button" class="flex items-center space-x-1 text-sm text-gray-600 hover:text-gray-900" data-action="dropdown#toggle">
                    <span class="flex items-center space-x-2 px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                      <span><%= current_user.display_name %></span>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </span>
                  </button>
                  <div class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50 border border-gray-200" data-dropdown-target="menu">
                    <div class="px-4 py-2 border-b border-gray-100">
                      <p class="text-xs text-gray-500">切换身份</p>
                    </div>
                    <% User.where.not(id: current_user.id).each do |user| %>
                      <%= button_to switch_user_path(user), method: :post, class: "w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
                        <span class="flex items-center space-x-2">
                          <span class="w-2 h-2 rounded-full <%= user.quality_reviewer? ? 'bg-purple-500' : 'bg-blue-500' %>"></span>
                          <span><%= user.display_name %></span>
                        </span>
                      <% end %>
                    <% end %>
                    <div class="border-t border-gray-100 mt-1">
                      <%= link_to logout_path, method: :delete, class: "block px-4 py-2 text-sm text-red-600 hover:bg-red-50" do %>
                        退出登录
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <% if notice %>
      <div class="bg-green-50 border-l-4 border-green-400 p-4 mx-4 mt-4 max-w-7xl mx-auto">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-green-700"><%= notice %></p>
          </div>
        </div>
      </div>
    <% end %>

    <% if alert %>
      <div class="bg-red-50 border-l-4 border-red-400 p-4 mx-4 mt-4 max-w-7xl mx-auto">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-red-700"><%= alert %></p>
          </div>
        </div>
      </div>
    <% end %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <%= yield %>
    </main>

    <%= turbo_stream_from :grade_corrections %>
  </body>
</html>
