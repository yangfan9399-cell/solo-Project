<!DOCTYPE html>
<html>
  <head>
    <title>版权音乐商用授权申请与播放场景核验平台</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100">
    <% if logged_in? %>
      <div class="flex h-screen">
        <aside class="w-64 bg-gradient-to-b from-slate-900 to-slate-800 text-white flex-shrink-0">
          <div class="p-6">
            <h1 class="text-xl font-bold text-amber-400">版权音乐平台</h1>
            <p class="text-xs text-gray-400 mt-1">授权申请与核验</p>
          </div>

          <nav class="mt-6">
            <%= link_to root_path, class: "flex items-center px-6 py-3 hover:bg-slate-700 transition-colors #{current_page?(root_path) ? 'bg-slate-700 border-l-4 border-amber-400' : ''}" do %>
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
              <span>仪表盘</span>
            <% end %>

            <% if current_user.biz_admin? || current_user.admin? %>
              <%= link_to new_application_path, class: "flex items-center px-6 py-3 hover:bg-slate-700 transition-colors #{current_page?(new_application_path) ? 'bg-slate-700 border-l-4 border-amber-400' : ''}" do %>
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                <span>新建申请</span>
              <% end %>
            <% end %>

            <%= link_to applications_path, class: "flex items-center px-6 py-3 hover:bg-slate-700 transition-colors #{controller_name == 'applications' ? 'bg-slate-700 border-l-4 border-amber-400' : ''}" do %>
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
              <span>授权申请</span>
            <% end %>

            <%= link_to tracks_path, class: "flex items-center px-6 py-3 hover:bg-slate-700 transition-colors #{controller_name == 'tracks' ? 'bg-slate-700 border-l-4 border-amber-400' : ''}" do %>
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
              </svg>
              <span>曲库管理</span>
            <% end %>

            <% if current_user.finance? || current_user.admin? %>
              <%= link_to settlements_path, class: "flex items-center px-6 py-3 hover:bg-slate-700 transition-colors #{controller_name == 'settlements' ? 'bg-slate-700 border-l-4 border-amber-400' : ''}" do %>
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>结算管理</span>
              <% end %>
            <% end %>

            <% if current_user.admin? %>
              <%= link_to analytics_index_path, class: "flex items-center px-6 py-3 hover:bg-slate-700 transition-colors #{controller_name == 'analytics' ? 'bg-slate-700 border-l-4 border-amber-400' : ''}" do %>
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                <span>复盘分析</span>
              <% end %>
            <% end %>
          </nav>

          <div class="absolute bottom-0 w-64 p-4 border-t border-slate-700">
            <div class="flex items-center">
              <div class="w-10 h-10 rounded-full bg-amber-400 flex items-center justify-center text-slate-900 font-bold">
                <%= current_user.name[0] %>
              </div>
              <div class="ml-3">
                <p class="text-sm font-medium"><%= current_user.name %></p>
                <p class="text-xs text-gray-400"><%= role_name(current_user.role) %></p>
              </div>
            </div>
            <%= button_to "退出登录", logout_path, method: :delete, class: "mt-4 w-full py-2 text-sm text-gray-300 hover:text-white hover:bg-slate-700 rounded transition-colors" %>
          </div>
        </aside>

        <main class="flex-1 overflow-y-auto">
          <header class="bg-white shadow-sm h-16 flex items-center justify-between px-8">
            <div>
              <h2 class="text-lg font-semibold text-gray-800">
                <%= yield :page_title %>
              </h2>
            </div>
            <div class="flex items-center space-x-4">
              <span class="text-sm text-gray-500">
                <%= Time.current.strftime("%Y年%m月%d日 %H:%M") %>
              </span>
            </div>
          </header>

          <div class="p-8">
            <% if notice %>
              <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-800">
                <%= notice %>
              </div>
            <% end %>

            <% if alert %>
              <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-800">
                <%= alert %>
              </div>
            <% end %>

            <%= yield %>
          </div>
        </main>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>