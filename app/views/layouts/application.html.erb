<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "样衣打版评审平台" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="样衣打版评审平台">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <script src="https://cdn.tailwindcss.com/3.4.13"></script>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-gray-50">
    <% if logged_in? %>
      <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16">
            <div class="flex items-center space-x-8">
              <h1 class="text-xl font-bold text-indigo-600">
                <%= link_to "样衣评审平台", root_path, class: "hover:text-indigo-800" %>
              </h1>
              <div class="flex space-x-4">
                <%= link_to "样衣列表", samples_path, class: "text-gray-700 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium" %>
                <%= link_to "统计复盘", analytics_path, class: "text-gray-700 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium" %>
                <% if current_user_role?(:supervisor) %>
                  <%= link_to "用户管理", users_path, class: "text-gray-700 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium" %>
                  <%= link_to "问题类型", issue_types_path, class: "text-gray-700 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium" %>
                <% end %>
              </div>
            </div>
            <div class="flex items-center space-x-4">
              <span class="text-sm text-gray-600">
                <%= current_user.name %> (<%= t("roles.#{current_user.role}", default: current_user.role) %>)
              </span>
              <%= button_to "退出登录", logout_path, method: :delete, class: "text-sm text-gray-600 hover:text-red-600" %>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
      <% if flash[:notice] %>
        <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
