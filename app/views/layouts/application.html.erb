<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "访谈稿审核系统" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="访谈稿审核系统">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= flash.each do |key, value| %>
      <div class="<%= key == 'alert' ? 'bg-red-100 border-red-400 text-red-700' : 'bg-green-100 border-green-400 text-green-700' %> border px-4 py-3 rounded relative" role="alert">
        <span class="block sm:inline"><%= value %></span>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>