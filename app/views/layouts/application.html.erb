<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "美业会员疗程消耗与退款复核系统" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://cdn.tailwindcss.com"></script>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-white shadow-sm border-b">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <h1 class="text-xl font-bold text-gray-800">美业会员管理系统</h1>
          </div>
          <div class="flex items-center space-x-4">
            <% if defined?(@current_user) && @current_user %>
              <span class="text-sm text-gray-600">
                当前用户: <strong class="text-blue-600"><%= @current_user.name %></strong>
                (<%= @current_user.manager? ? '店长' : '顾问' %>)
              </span>
              <div class="flex space-x-2">
                <% User.all.each do |user| %>
                  <%= button_to user.name, switch_user_path(user),
                    method: :post,
                    class: "px-3 py-1 text-sm rounded #{@current_user.id == user.id ? 'bg-blue-500 text-white' : 'bg-gray-200 hover:bg-gray-300'}" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <% if alert %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <%= yield %>
    </main>
  </body>
</html>
