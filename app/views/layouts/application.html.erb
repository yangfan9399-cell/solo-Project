<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "版权素材授权管理平台" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="版权素材授权管理平台">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">版权授权管理</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link <%= 'active' if controller_name == 'dashboard' %>" href="/">首页</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= 'active' if controller_name == 'materials' %>" href="/materials">素材管理</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= 'active' if controller_name == 'licenses' %>" href="/licenses">授权管理</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= 'active' if controller_name == 'usage_scenarios' %>" href="/usage_scenarios">使用场景</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= 'active' if action_name == 'statistics' %>" href="/dashboard/statistics">统计报表</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>