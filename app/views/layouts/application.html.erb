<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>影像中心胶片报告管理系统</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <header class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <%= link_to "影像中心报告管理", root_path, class: "navbar-brand" %>
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav mr-auto">
          <li class="nav-item">
            <%= link_to "报告列表", reports_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "患者管理", patients_path, class: "nav-link" %>
          </li>
          <% if current_user&.can_access_admin? %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-toggle="dropdown">管理</a>
              <div class="dropdown-menu">
                <%= link_to "仪表盘", admin_dashboard_path, class: "dropdown-item" %>
                <%= link_to "审核报告", admin_reports_path, class: "dropdown-item" %>
                <%= link_to "统计分析", admin_statistics_path, class: "dropdown-item" %>
              </div>
            </li>
          <% end %>
        </ul>
        <ul class="navbar-nav">
          <% if current_user %>
            <li class="nav-item">
              <span class="nav-link">欢迎, <%= current_user.name %></span>
            </li>
            <li class="nav-item">
              <%= link_to "退出", logout_path, method: :delete, class: "nav-link" %>
            </li>
          <% else %>
            <li class="nav-item">
              <%= link_to "登录", login_path, class: "nav-link" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </header>

  <main class="container mt-4">
    <% if notice %>
      <div class="alert alert-success"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="alert alert-danger"><%= alert %></div>
    <% end %>
    <%= yield %>
  </main>

  <footer class="footer mt-auto py-3 bg-light">
    <div class="container text-center">
      <span class="text-muted">影像中心胶片报告管理系统</span>
    </div>
  </footer>

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>