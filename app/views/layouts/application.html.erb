<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "剧场道具借调与赔付系统" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="剧场道具借调与赔付系统">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-gradient-to-r from-amber-800 to-amber-900 text-white shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center space-x-8">
            <h1 class="text-xl font-bold">🎭 剧场道具借调与赔付系统</h1>
            <div class="hidden md:flex space-x-4">
              <%= link_to "首页", root_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-700 #{request.path == '/' ? 'bg-amber-700' : ''}" %>
              <%= link_to "道具管理", props_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-700 #{request.path.start_with?('/props') ? 'bg-amber-700' : ''}" %>
              <%= link_to "借调记录", borrow_records_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-700 #{request.path.start_with?('/borrow_records') ? 'bg-amber-700' : ''}" %>
              <%= link_to "剧组管理", crews_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-700 #{request.path.start_with?('/crews') ? 'bg-amber-700' : ''}" %>
              <%= link_to "赔付管理", compensations_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-700 #{request.path.start_with?('/compensations') ? 'bg-amber-700' : ''}" %>
              <%= link_to "维修记录", repair_records_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-700 #{request.path.start_with?('/repair_records') ? 'bg-amber-700' : ''}" %>
              <%= link_to "统计复盘", statistics_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-700 #{request.path.start_with?('/statistics') ? 'bg-amber-700' : ''}" %>
              <%= link_to "用户管理", users_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-700 #{request.path.start_with?('/users') ? 'bg-amber-700' : ''}" %>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <% if current_user %>
              <div class="relative" id="user-switcher">
                <button class="flex items-center space-x-2 px-3 py-2 rounded-md hover:bg-amber-700" onclick="document.getElementById('user-dropdown').classList.toggle('hidden')">
                  <div class="w-8 h-8 bg-amber-600 rounded-full flex items-center justify-center text-sm font-bold">
                    <%= current_user.name.first %>
                  </div>
                  <div class="text-left">
                    <p class="text-sm font-medium"><%= current_user.name %></p>
                    <p class="text-xs text-amber-200"><%= current_user.role_name %></p>
                  </div>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div id="user-dropdown" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-lg shadow-lg py-2 z-50 text-gray-800">
                  <div class="px-4 py-2 border-b border-gray-100">
                    <p class="text-xs text-gray-500 uppercase font-medium">切换身份</p>
                  </div>
                  <% User.order(role: :asc, name: :asc).each do |user| %>
                    <%= form_tag switch_user_path, method: :post, class: "w-full" do %>
                      <%= hidden_field_tag :user_id, user.id %>
                      <button type="submit" class="w-full text-left px-4 py-2 hover:bg-amber-50 flex items-center justify-between <%= user.id == current_user.id ? 'bg-amber-100' : '' %>">
                        <div class="flex items-center space-x-3">
                          <div class="w-8 h-8 bg-amber-500 rounded-full flex items-center justify-center text-sm font-bold text-white">
                            <%= user.name.first %>
                          </div>
                          <div>
                            <p class="text-sm font-medium text-gray-900"><%= user.name %></p>
                            <p class="text-xs text-gray-500"><%= user.role_name %></p>
                          </div>
                        </div>
                        <% if user.id == current_user.id %>
                          <span class="text-amber-600 text-sm">✓</span>
                        <% end %>
                      </button>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <% if notice.present? %>
        <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg" role="alert">
          <%= notice %>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg" role="alert">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="bg-gray-800 text-gray-400 py-6 mt-12">
      <div class="max-w-7xl mx-auto px-4 text-center text-sm">
        <p>剧场演出道具借调与损耗赔付系统 · 围绕道具全生命周期流转管理</p>
      </div>
    </footer>
  </body>
</html>
