<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "退货管理系统" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="退货管理系统">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
  </head>

  <body>
    <nav class="navbar">
      <div class="container">
        <div class="navbar-brand">退货管理系统</div>
        <div class="navbar-menu">
          <%= link_to "首页（退货列表）", return_orders_path, class: "navbar-link #{current_page?(return_orders_path) ? 'active' : ''}" %>
          <%= link_to "统计", stats_path, class: "navbar-link #{current_page?(stats_path) ? 'active' : ''}" %>
        </div>
      </div>
    </nav>

    <main class="container main-content">
      <% if notice.present? %>
        <div class="flash flash-notice"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="flash flash-alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
