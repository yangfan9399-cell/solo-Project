<% provide :page_title, "新建授权申请" %>

<div class="max-w-4xl mx-auto">
  <div class="bg-white rounded-xl shadow-sm p-8">
    <h2 class="text-xl font-bold text-gray-800 mb-6">填写授权申请信息</h2>

    <%= form_with model: @application, local: true, class: "space-y-6" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :track_id, "选择曲目", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="relative">
            <%= f.collection_select :track_id, @tracks, :id, :title,
                { prompt: "请选择曲目" },
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent appearance-none" %>
            <svg class="w-5 h-5 absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
          <% if @application.errors[:track_id].any? %>
            <p class="mt-1 text-sm text-red-600"><%= @application.errors[:track_id].first %></p>
          <% end %>
        </div>

        <div>
          <%= f.label :usage_scenario, "使用场景", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="relative">
            <%= f.select :usage_scenario,
                options_for_select([
                  ["电视广告", "tv_ad"],
                  ["线上视频", "online_video"],
                  ["直播", "live_stream"],
                  ["影视", "film"],
                  ["广播", "radio"],
                  ["其他", "other"]
                ], @application.usage_scenario),
                { prompt: "请选择使用场景" },
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent appearance-none" %>
            <svg class="w-5 h-5 absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </div>

        <div>
          <%= f.label :client_name, "客户名称", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :client_name,
              placeholder: "请输入客户名称",
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent" %>
          <% if @application.errors[:client_name].any? %>
            <p class="mt-1 text-sm text-red-600"><%= @application.errors[:client_name].first %></p>
          <% end %>
        </div>

        <div>
          <%= f.label :client_industry, "客户行业", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="relative">
            <%= f.select :client_industry,
                options_for_select([
                  ["广告", "广告"],
                  ["电商", "电商"],
                  ["影视", "影视"],
                  ["营销", "营销"],
                  ["教育", "教育"],
                  ["金融", "金融"],
                  ["其他", "其他"]
                ], @application.client_industry),
                { prompt: "请选择客户行业" },
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent appearance-none" %>
            <svg class="w-5 h-5 absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </div>

        <div>
          <%= f.label :client_contact, "联系人", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :client_contact,
              placeholder: "请输入联系人信息",
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent" %>
        </div>

        <div>
          <%= f.label :territory, "授权地域", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="relative">
            <%= f.select :territory,
                options_for_select([
                  ["中国大陆", "中国大陆"],
                  ["港澳台", "港澳台"],
                  ["全球", "全球"],
                  ["其他", "其他"]
                ], @application.territory || "中国大陆"),
                {},
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent appearance-none" %>
            <svg class="w-5 h-5 absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </div>

        <div>
          <%= f.label :start_date, "授权开始日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.date_field :start_date,
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent" %>
        </div>

        <div>
          <%= f.label :end_date, "授权结束日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.date_field :end_date,
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent" %>
        </div>

        <div class="md:col-span-2">
          <%= f.label :budget, "预算金额 (元)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="relative">
            <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500">¥</span>
            <%= f.number_field :budget,
                placeholder: "请输入预算金额",
                min: 0,
                step: 100,
                class: "w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent" %>
          </div>
        </div>
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
        <div class="flex items-start">
          <svg class="w-5 h-5 text-amber-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div class="ml-3">
            <p class="text-sm text-amber-800 font-medium">温馨提示</p>
            <p class="text-sm text-amber-700 mt-1">
              提交申请后，系统将自动检测使用场景是否在曲库授权范围内。如场景超范围，将阻断授权确认，需调整申请内容。
            </p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end space-x-4 pt-4">
        <%= link_to "取消", applications_path,
            class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors" %>
        <%= f.submit "提交申请",
            class: "px-6 py-3 bg-gradient-to-r from-blue-900 to-blue-800 text-white rounded-lg hover:from-blue-800 hover:to-blue-700 transition-all shadow-lg hover:shadow-xl" %>
      </div>
    <% end %>
  </div>
</div>