<% content_for :title, "#{@sample.style_number} - 样衣详情" %>

<div class="space-y-6">
  <div class="mb-2">
    <%= link_to "← 返回列表", samples_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-6 border-b border-gray-200">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center space-x-4">
          <h1 class="text-2xl font-bold text-gray-900"><%= @sample.style_number %></h1>
          <%= status_badge(@sample.status) %>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <% if current_user_role?(:designer) && @sample.draft? %>
            <%= link_to "编辑", edit_sample_path(@sample), class: "px-3 py-1.5 bg-white text-gray-700 text-sm font-medium rounded-lg border border-gray-300 hover:bg-gray-50" %>
            <%= button_to "提交打版", submit_for_pattern_sample_path(@sample), method: :post, class: "px-3 py-1.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700" %>
          <% end %>

          <% if current_user_role?(:pattern_maker) && @sample.pattern_making? %>
            <%= button_to "开始打版", start_pattern_sample_path(@sample), method: :post, class: "px-3 py-1.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700" %>
            <%= button_to "提交评审", submit_for_review_sample_path(@sample), method: :post, class: "px-3 py-1.5 bg-yellow-600 text-white text-sm font-medium rounded-lg hover:bg-yellow-700" %>
          <% end %>

          <% if current_user_role?(:pattern_maker) && @sample.review? %>
            <%= button_to "开始改版", start_revision_sample_path(@sample), method: :post, class: "px-3 py-1.5 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700" %>
          <% end %>

          <% if current_user_has_role?(:reviewer, :supervisor) && @sample.review? %>
            <% if @sample.supervisor_confirmation_required? && !@sample.supervisor_confirmed? %>
              <button class="px-3 py-1.5 bg-gray-300 text-gray-500 text-sm font-medium rounded-lg cursor-not-allowed" disabled title="改版超次，需主管确认后才可定版">
                定版
              </button>
            <% else %>
              <%= button_to "定版", finalize_sample_path(@sample), method: :post, class: "px-3 py-1.5 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700" %>
            <% end %>
          <% end %>

          <% if current_user_role?(:supervisor) && @sample.supervisor_confirmation_required? && !@sample.supervisor_confirmed? %>
            <%= button_to "主管确认", supervisor_confirm_sample_path(@sample), method: :post, class: "px-3 py-1.5 bg-purple-600 text-white text-sm font-medium rounded-lg hover:bg-purple-700" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @sample.supervisor_confirmation_required? && !@sample.supervisor_confirmed? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex items-start">
        <svg class="h-5 w-5 text-yellow-400 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">改版超次警告</h3>
          <p class="mt-1 text-sm text-yellow-700">
            该样衣已改版 <%= @sample.revision_count %> 次，超过最大允许改版次数 <%= Sample::MAX_REVISIONS_BEFORE_SUPERVISOR %> 次。
            需要主管确认后才能继续定版。
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">基本信息</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">品类</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @sample.category %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">面料</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @sample.fabric || "-" %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">设计师</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @sample.designer&.name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">版师</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @sample.pattern_maker&.name || "-" %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">当前责任人</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @sample.current_owner&.name || "-" %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">改版次数</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @sample.revision_count %> 次
                <% if @sample.revision_count >= Sample::MAX_REVISIONS_BEFORE_SUPERVISOR %>
                  <span class="text-red-600">(已超次)</span>
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">提交时间</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= format_date(@sample.submitted_at) %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">定版时间</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= format_date(@sample.finalized_at) %></dd>
            </div>
            <div class="md:col-span-2">
              <dt class="text-sm font-medium text-gray-500">定版周期</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @sample.cycle_days %>
                  <%= @sample.cycle_days %> 天
                <% else %>
                  -
                <% end %>
              </dd>
            </div>
            <div class="md:col-span-2">
              <dt class="text-sm font-medium text-gray-500">描述</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @sample.description || "-" %></dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">尺码表</h2>
        </div>
        <div class="px-6 py-4">
          <% if @sample.size_chart.present? %>
            <div class="overflow-x-auto">
              <% size_chart = @sample.size_chart %>
              <% if size_chart.is_a?(Hash) %>
                <% sizes = size_chart.keys %>
                <% measurements = size_chart.values.first.is_a?(Hash) ? size_chart.values.first.keys : [] %>
                <% if measurements.any? %>
                  <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                      <tr>
                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">尺码</th>
                        <% measurements.each do |m| %>
                          <th class="px-4 py-2 text-center text-xs font-medium text-gray-500 uppercase"><%= m %></th>
                        <% end %>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <% sizes.each do |size| %>
                        <tr>
                          <td class="px-4 py-2 text-sm font-medium text-gray-900"><%= size %></td>
                          <% measurements.each do |m| %>
                            <td class="px-4 py-2 text-sm text-gray-600 text-center"><%= size_chart[size][m] || "-" %></td>
                          <% end %>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                <% else %>
                  <pre class="text-sm text-gray-600 bg-gray-50 p-4 rounded-lg overflow-x-auto"><%= display_json(size_chart) %></pre>
                <% end %>
              <% else %>
                <pre class="text-sm text-gray-600 bg-gray-50 p-4 rounded-lg overflow-x-auto"><%= display_json(size_chart) %></pre>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">暂无尺码表数据</p>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">改版历史</h2>
        </div>
        <div class="px-6 py-4">
          <% if @sample_versions.any? %>
            <div class="relative">
              <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200"></div>
              <div class="space-y-6">
                <% @sample_versions.each do |version| %>
                  <div class="relative pl-10">
                    <div class="absolute left-2.5 top-2 w-3 h-3 rounded-full bg-indigo-500 ring-4 ring-white"></div>
                    <div class="bg-gray-50 rounded-lg p-4">
                      <div class="flex items-center justify-between mb-2">
                        <span class="font-medium text-gray-900">版本 <%= version.version_number %></span>
                        <span class="text-xs text-gray-500"><%= format_date(version.created_at) %></span>
                      </div>
                      <p class="text-sm text-gray-600 mb-2"><%= version.description || "无修改说明" %></p>
                      <div class="flex items-center text-xs text-gray-500">
                        <span>创建人：<%= version.created_by&.name %></span>
                        <% if version.fabric.present? %>
                          <span class="mx-2">·</span>
                          <span>面料：<%= version.fabric %></span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">暂无改版历史</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">评审记录</h2>
        </div>
        <div class="px-6 py-4">
          <% if @reviews.any? %>
            <div class="space-y-4">
              <% @reviews.each do |review| %>
                <div class="border border-gray-200 rounded-lg p-4">
                  <div class="flex items-center justify-between mb-2">
                    <%= verdict_badge(review.verdict) %>
                    <span class="text-xs text-gray-500"><%= format_date(review.created_at) %></span>
                  </div>
                  <div class="text-sm text-gray-600 mb-2">
                    <span class="font-medium text-gray-900"><%= review.reviewer&.name %></span>
                    <span class="text-gray-400 mx-1">·</span>
                    <span class="text-gray-500">v<%= review.sample_version&.version_number %></span>
                  </div>
                  <% if review.feedback.present? %>
                    <p class="text-sm text-gray-700 mb-2"><%= review.feedback %></p>
                  <% end %>
                  <% if review.issues.present? && review.issues.is_a?(Array) && review.issues.any? %>
                    <div class="mt-2 pt-2 border-t border-gray-100">
                      <p class="text-xs font-medium text-gray-500 mb-1">问题类型：</p>
                      <div class="flex flex-wrap gap-1">
                        <% review.issues.each do |issue| %>
                          <% if issue.is_a?(Hash) && issue["type"].present? %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                              <%= issue["type"] %>
                            </span>
                          <% elsif issue.is_a?(String) %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                              <%= issue %>
                            </span>
                          <% end %>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">暂无评审记录</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
