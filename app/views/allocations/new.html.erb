<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">新建调拨单</h1>
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: @allocation, local: true do |form| %>
      <div class="space-y-4">
        <div>
          <%= form.label :source_store_id, "来源门店", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :source_store_id, @stores.where(store_type: :warehouse).map { |s| [s.name, s.id] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
        <div>
          <%= form.label :target_store_id, "目标门店", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :target_store_id, @stores.where(store_type: :restaurant).map { |s| [s.name, s.id] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
        <div>
          <%= form.label :creator_id, "创建人", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :creator_id, User.all.map { |u| [u.name, u.id] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
        <div>
          <%= form.label :remark, "备注", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :remark, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
      </div>
      <div class="mt-6 flex justify-end gap-2">
        <%= link_to "取消", allocations_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300" %>
        <%= form.submit "创建调拨单", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
