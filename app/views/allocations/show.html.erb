<div class="space-y-6">
  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold"><%= @allocation.allocation_number %></h1>
        <p class="text-gray-500">
          <%= @allocation.source_store.name %> → <%= @allocation.target_store.name %>
        </p>
      </div>
      <div class="flex gap-2">
        <span class="px-4 py-2 text-sm rounded-full <%= status_class(@allocation.status) %>">
          <%= @allocation.status_i18n %>
        </span>
        <% case @allocation.status %>
        <% when "pending" %>
          <%= button_to "批准调拨", approve_allocation_path(@allocation), method: :post, class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
        <% when "approved" %>
          <%= button_to "确认发货", mark_in_transit_allocation_path(@allocation), method: :post, class: "px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700" %>
        <% when "in_transit" %>
          <%= button_to "确认收货", receive_allocation_path(@allocation), method: :post, class: "px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700" %>
          <%= button_to "门店拒收", reject_allocation_path(@allocation), method: :post, class: "px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-4">调拨信息</h2>
      <dl class="grid grid-cols-2 gap-4">
        <div>
          <dt class="text-sm text-gray-500">调拨单号</dt>
          <dd class="text-sm font-medium"><%= @allocation.allocation_number %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">创建人</dt>
          <dd class="text-sm font-medium"><%= @allocation.creator.name %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">来源门店</dt>
          <dd class="text-sm font-medium"><%= @allocation.source_store.name %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">目标门店</dt>
          <dd class="text-sm font-medium"><%= @allocation.target_store.name %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">创建时间</dt>
          <dd class="text-sm font-medium"><%= @allocation.created_at.strftime("%Y-%m-%d %H:%M") %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">备注</dt>
          <dd class="text-sm font-medium"><%= @allocation.remark || "-" %></dd>
        </div>
      </dl>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-semibold">调拨物料</h2>
        <% if @allocation.pending? || @allocation.approved? %>
          <%= link_to "添加物料", new_allocation_item_path(allocation_id: @allocation.id), class: "px-3 py-1 text-sm bg-blue-100 text-blue-800 rounded-md hover:bg-blue-200" %>
        <% end %>
      </div>
      <% if @items.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">物料</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">批次</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">数量</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @items.each do |item| %>
              <tr>
                <td class="px-4 py-2"><%= item.batch.material.name %></td>
                <td class="px-4 py-2"><%= item.batch.batch_number %></td>
                <td class="px-4 py-2"><%= item.quantity %><%= item.batch.material.unit %></td>
                <td class="px-4 py-2">
                  <span class="px-2 py-1 text-xs rounded-full <%= status_class(item.status) %>">
                    <%= item.status_i18n %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-gray-500 text-sm">暂无调拨物料</p>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold mb-4">工作流程节点</h2>
    <% if @workflow_nodes.any? %>
      <div class="relative">
        <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200"></div>
        <div class="space-y-4">
          <% @workflow_nodes.each do |node| %>
            <div class="relative flex items-start pl-10">
              <div class="absolute left-2 w-4 h-4 rounded-full bg-blue-500 border-2 border-white"></div>
              <div class="flex-1 bg-gray-50 rounded-lg p-3">
                <div class="flex justify-between">
                  <span class="font-medium"><%= node.node_type %></span>
                  <span class="text-sm text-gray-500"><%= node.created_at.strftime("%Y-%m-%d %H:%M") %></span>
                </div>
                <% if node.actor %>
                  <div class="text-sm text-gray-500">操作人: <%= node.actor.name %></div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm">暂无流程记录</p>
    <% end %>
  </div>
</div>
