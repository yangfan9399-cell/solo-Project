<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">调拨单列表</h1>
    <div class="flex gap-2">
      <%= link_to "待处理", allocations_path(status: "pending"), class: "px-4 py-2 bg-yellow-100 text-yellow-800 rounded-md hover:bg-yellow-200" %>
      <%= link_to "已发货", allocations_path(status: "in_transit"), class: "px-4 py-2 bg-purple-100 text-purple-800 rounded-md hover:bg-purple-200" %>
      <%= link_to "新建调拨", new_allocation_path, class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">单号</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">来源门店</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">目标门店</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">创建人</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">创建时间</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @allocations.each do |allocation| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4"><%= link_to allocation.allocation_number, allocation, class: "text-blue-600 hover:underline" %></td>
              <td class="px-6 py-4"><%= allocation.source_store.name %></td>
              <td class="px-6 py-4"><%= allocation.target_store.name %></td>
              <td class="px-6 py-4"><%= allocation.creator.name %></td>
              <td class="px-6 py-4"><%= allocation.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(allocation.status) %>">
                  <%= allocation.status_i18n %>
                </span>
              </td>
              <td class="px-6 py-4">
                <% case allocation.status %>
                <% when "pending" %>
                  <%= button_to "批准", approve_allocation_path(allocation), method: :post, class: "text-blue-600 hover:underline" %>
                <% when "approved" %>
                  <%= button_to "发货", mark_in_transit_allocation_path(allocation), method: :post, class: "text-purple-600 hover:underline" %>
                <% when "in_transit" %>
                  <%= button_to "确认收货", receive_allocation_path(allocation), method: :post, class: "text-green-600 hover:underline" %>
                  <%= button_to "拒收", reject_allocation_path(allocation), method: :post, class: "text-red-600 hover:underline" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
