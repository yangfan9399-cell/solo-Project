<%= form_with(model: maintenance_plan, class: "space-y-6") do |form| %>
  <% if maintenance_plan.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-red-800 font-semibold mb-2"><%= pluralize(maintenance_plan.errors.count, "个错误") %> 禁止保存：</h3>
      <ul class="list-disc list-inside text-red-700 text-sm">
        <% maintenance_plan.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :vehicle_id, "选择车辆", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.collection_select :vehicle_id, @vehicles, :id, :plate_number, { include_blank: "请选择车辆" }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :planned_date, "计划日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.date_field :planned_date, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :maintenance_type, "保养类型", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :maintenance_type, MaintenancePlan.maintenance_types.keys.map { |k| [t("enums.maintenance_plan.maintenance_type.#{k}", default: k.humanize), k] }, { include_blank: "请选择类型" }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :status, MaintenancePlan.statuses.keys.map { |k| [t("enums.maintenance_plan.status.#{k}", default: k.humanize), k] }, { include_blank: "请选择状态" }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :scheduled_mileage, "计划里程 (km)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :scheduled_mileage, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "例如: 50000" %>
    </div>

    <div>
      <%= form.label :scheduled_by, "计划人", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :scheduled_by, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "输入计划人姓名" %>
    </div>
  </div>

  <div>
    <%= form.label :notes, "备注", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_area :notes, rows: 4, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "输入备注信息..." %>
  </div>

  <% if maintenance_plan.new_record? %>
    <div class="flex items-center">
      <%= check_box_tag :create_default_items, "true", false, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
      <%= label_tag :create_default_items, "创建默认保养项（机油、机滤、空滤、制动系统等）", class: "ml-2 text-sm text-gray-700" %>
    </div>
  <% end %>

  <div class="flex justify-end space-x-4 pt-4 border-t border-gray-200">
    <%= link_to "取消", maintenance_plans_path, class: "px-6 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
    <%= form.submit "保存", class: "px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
