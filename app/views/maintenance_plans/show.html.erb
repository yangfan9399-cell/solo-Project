<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <div class="flex items-center gap-3">
        <%= link_to maintenance_plans_path, class: "text-gray-500 hover:text-gray-700 transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        <% end %>
        <h1 class="text-2xl font-bold text-gray-900">保养计划详情</h1>
      </div>
    </div>

    <% if notice %>
      <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
        <p class="text-green-800 text-sm"><%= notice %></p>
      </div>
    <% end %>

    <% if alert %>
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-red-800 text-sm"><%= alert %></p>
      </div>
    <% end %>

    <div id="<%= dom_id(@maintenance_plan) %>">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
        <div class="px-6 py-5 border-b border-gray-200 bg-gradient-to-r from-blue-50 to-indigo-50">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
              <div class="flex items-center gap-3 mb-2">
                <h2 class="text-xl font-bold text-gray-900">计划 #<%= @maintenance_plan.id %></h2>
                <% is_overdue = @maintenance_plan.overdue? %>
                <% status_color = case @maintenance_plan.status
                                  when 'pending' then 'bg-yellow-100 text-yellow-800'
                                  when 'in_progress' then 'bg-blue-100 text-blue-800'
                                  when 'completed' then 'bg-green-100 text-green-800'
                                  when 'overdue' then 'bg-red-100 text-red-800'
                                  when 'cancelled' then 'bg-gray-100 text-gray-800'
                                  else 'bg-gray-100 text-gray-800'
                                  end %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= status_color %>">
                  <%= t("enums.maintenance_plan.status.#{@maintenance_plan.status}", default: @maintenance_plan.status.humanize) %>
                </span>
                <% if is_overdue && !@maintenance_plan.overdue? %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                    超期
                  </span>
                <% end %>
              </div>
              <% type_color = case @maintenance_plan.maintenance_type
                              when 'routine' then 'text-blue-600'
                              when 'comprehensive' then 'text-purple-600'
                              when 'emergency' then 'text-orange-600'
                              else 'text-gray-600'
                              end %>
              <p class="text-sm text-gray-600">
                <span class="font-medium <%= type_color %>"><%= t("enums.maintenance_plan.maintenance_type.#{@maintenance_plan.maintenance_type}", default: @maintenance_plan.maintenance_type.humanize) %></span>
                · 车辆：<span class="font-medium text-gray-900"><%= @maintenance_plan.vehicle&.plate_number %></span>
                · 车队：<span class="text-gray-700"><%= @maintenance_plan.vehicle&.fleet&.name %></span>
              </p>
            </div>
            <div class="flex items-center gap-2">
              <% if @maintenance_plan.pending? || @maintenance_plan.overdue? %>
                <%= button_to "开始保养", maintenance_plan_path(@maintenance_plan, maintenance_plan: { status: :in_progress }), method: :patch, class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm" %>
              <% end %>
              <% if @maintenance_plan.in_progress? && @maintenance_plan.all_items_completed? %>
                <%= button_to "标记完成", maintenance_plan_path(@maintenance_plan, maintenance_plan: { status: :completed }), method: :patch, class: "inline-flex items-center px-4 py-2 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-colors shadow-sm" %>
              <% end %>
              <% if @maintenance_plan.in_progress? && !@maintenance_plan.all_items_completed? %>
                <div class="group relative">
                  <button type="button" disabled class="inline-flex items-center px-4 py-2 bg-green-300 text-white font-medium rounded-lg cursor-not-allowed">
                    标记完成
                  </button>
                  <p class="absolute top-full left-0 mt-2 w-64 text-xs text-gray-600 bg-white rounded-lg shadow-lg p-3 border border-gray-200 hidden group-hover:block z-10">
                    请先完成所有必做保养项后再标记完成
                  </p>
                </div>
              <% end %>
              <%= link_to "编辑", edit_maintenance_plan_path(@maintenance_plan), class: "inline-flex items-center px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
            </div>
          </div>
        </div>

        <div class="px-6 py-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">计划日期</p>
            <p class="text-lg font-semibold text-gray-900"><%= @maintenance_plan.planned_date.strftime('%Y-%m-%d') %></p>
          </div>
          <div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">计划里程</p>
            <p class="text-lg font-semibold text-gray-900"><%= @maintenance_plan.scheduled_mileage.present? ? "#{number_with_delimiter(@maintenance_plan.scheduled_mileage)} km" : "未设置" %></p>
          </div>
          <div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">计划人</p>
            <p class="text-lg font-semibold text-gray-900"><%= @maintenance_plan.scheduled_by.presence || "未指定" %></p>
          </div>
          <div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">完成进度</p>
            <div class="flex items-center gap-3">
              <div class="w-24 bg-gray-200 rounded-full h-3 overflow-hidden">
                <div class="h-3 rounded-full transition-all duration-300 <%= @maintenance_plan.progress_percentage == 100 ? 'bg-green-500' : 'bg-blue-500' %>" style="width: <%= @maintenance_plan.progress_percentage %>%"></div>
              </div>
              <span class="text-lg font-semibold text-gray-900"><%= @maintenance_plan.progress_percentage %>%</span>
            </div>
          </div>
        </div>

        <% if @maintenance_plan.notes.present? %>
          <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">备注</p>
            <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= @maintenance_plan.notes %></p>
          </div>
        <% end %>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h3 class="text-lg font-semibold text-gray-900">保养项明细</h3>
          <span class="text-sm text-gray-500">
            共 <%= @maintenance_items.count %> 项 ·
            已完成 <%= @maintenance_items.where(status: :completed).count %> 项 ·
            必做 <%= @maintenance_items.where(is_required: true).count %> 项
          </span>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">保养项</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">描述</th>
                <th class="px-6 py-3.5 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">必做</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">状态</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">操作人</th>
                <th class="px-6 py-3.5 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">完成时间</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @maintenance_items.each do |item| %>
                <tr class="hover:bg-gray-50 transition-colors" id="<%= dom_id(item) %>">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <p class="text-sm font-medium text-gray-900"><%= item.name %></p>
                  </td>
                  <td class="px-6 py-4">
                    <p class="text-sm text-gray-600 max-w-md"><%= item.description.presence || "—" %></p>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <% if item.is_required %>
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-red-100">
                        <svg class="w-3.5 h-3.5 text-red-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                      </span>
                    <% else %>
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100">
                        <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% item_status_color = case item.status
                                           when 'pending' then 'bg-yellow-100 text-yellow-800'
                                           when 'completed' then 'bg-green-100 text-green-800'
                                           when 'skipped' then 'bg-gray-100 text-gray-800'
                                           else 'bg-gray-100 text-gray-800'
                                           end %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= item_status_color %>">
                      <%= t("enums.maintenance_item.status.#{item.status}", default: item.status.humanize) %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <p class="text-sm text-gray-600"><%= item.completed_by.presence || "—" %></p>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <p class="text-sm text-gray-600"><%= item.completed_at.present? ? item.completed_at.strftime('%Y-%m-%d %H:%M') : "—" %></p>
                  </td>
                </tr>
              <% end %>
              <% if @maintenance_items.empty? %>
                <tr>
                  <td colspan="6" class="px-6 py-12 text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    <p class="text-sm text-gray-500">暂无保养项</p>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
