<% content_for :title, "实验记录时间线" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
    <span>📋</span> 实验记录 & 样本分类
  </h1>
  <p class="text-sm text-slate-500 mt-1">验收样本分类：过热停止 / 模拟异常 / 回滚重算</p>
</div>

<div class="grid lg:grid-cols-3 gap-4 mb-8">
  <% @sample_categories.each do |name, tag| %>
    <% matched = @sessions.select { |s| s.batch_tag.to_s.include?(tag) || s.notes.to_s.include?(tag) } %>
    <% colors = {
      "过热停止生长正常完成" => 'warning',
      "增长模拟触发异常" => 'danger',
      "实验记录回滚重算" => 'info'
    } %>
    <% c = colors[name] || 'primary' %>
    <div class="bg-white rounded-xl p-5 shadow-sm border border-<%= c %>-200 hover:shadow-md transition">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-bold text-slate-800 text-base"><%= name %></h3>
        <span class="text-xs px-2.5 py-1 rounded-full bg-<%= c %>-100 text-<%= c %>-700 font-semibold"><%= matched.size %> 个</span>
      </div>
      <p class="text-xs text-slate-500 mb-3">
        标签包含: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-[10px]"><%= tag %></code>
      </p>
      <% if matched.empty? %>
        <p class="text-xs text-slate-400 py-3 text-center border border-dashed border-slate-200 rounded">暂无匹配样本，可运行 rake db:seed 创建</p>
      <% else %>
        <div class="space-y-2 max-h-48 overflow-y-auto">
          <% matched.take(3).each do |s| %>
            <%= link_to experiment_path(s), class: "block p-2 rounded bg-slate-50 hover:bg-#{c}-50 transition" do %>
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs truncate"><%= s.session_code %></span>
                <span class="text-xs px-2 py-0.5 rounded-full <%= status_class(s.status) %>"><%= status_label(s.status) %></span>
              </div>
              <div class="flex justify-between text-xs mt-1">
                <span class="text-slate-500">R<%= s.current_round %>/<%= s.max_rounds %></span>
                <span class="font-semibold"><%= s.completed? ? "#{s.final_score}分" : "#{s.actual_coverage}%" %></span>
              </div>
            <% end %>
          <% end %>
        </div>
        <% if matched.size > 3 %>
          <p class="text-xs text-center text-slate-400 mt-2">...共 <%= matched.size %> 个匹配实验</p>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100">
  <h2 class="text-lg font-semibold text-slate-800 mb-4">📚 全部实验时间线 (<%= @sessions.size %>)</h2>
  <% if @sessions.empty? %>
    <p class="text-slate-400 text-center py-12">暂无实验记录。<%= link_to "创建第一个实验", new_game_session_path, class: "text-primary-600 hover:underline" %></p>
  <% else %>
    <div class="relative">
      <div class="absolute left-7 top-2 bottom-2 w-0.5 bg-slate-200"></div>
      <div class="space-y-4">
        <% @sessions.each do |s| %>
          <% tag_match = @sample_categories.keys.find { |k| (s.batch_tag.to_s.include?(@sample_categories[k])) || (s.notes.to_s.include?(@sample_categories[k])) } %>
          <div class="relative pl-16">
            <div class="absolute left-2 w-10 h-10 rounded-full flex items-center justify-center bg-white border-2 <%= tag_match ? 'border-primary-400' : 'border-slate-200' %> shadow-sm text-lg">
              <% if s.completed? then '🏁'
               elsif s.rolled_back? then '🔄'
               elsif s.contamination_results.detected.any? then '🦠'
               elsif s.growth_histories.overheated_events.any? then '🔥'
               else '🧫'
               end %>
            </div>
            <%= link_to experiment_path(s), class: "block bg-white rounded-xl p-4 shadow-sm border border-slate-100 hover:border-primary-300 hover:shadow-md transition" do %>
              <div class="flex flex-wrap justify-between items-start gap-3">
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-mono text-sm text-slate-700"><%= s.session_code %></span>
                    <% if tag_match %>
                      <span class="text-[10px] px-2 py-0.5 rounded bg-primary-100 text-primary-700 font-semibold">样本: <%= tag_match %></span>
                    <% end %>
                    <% if s.batch_tag.present? %>
                      <span class="text-xs px-2 py-0.5 rounded bg-info-50 text-info-700"><%= s.batch_tag %></span>
                    <% end %>
                    <span class="text-xs px-2.5 py-0.5 rounded-full <%= status_class(s.status) %>"><%= status_label(s.status) %></span>
                  </div>
                  <div class="mt-1.5 flex items-center gap-2 text-sm">
                    <span class="w-2.5 h-2.5 rounded-full" style="background-color: <%= s.target_strain_info[:color] %>"></span>
                    <span><%= s.target_strain_info[:name] %></span>
                    <span class="text-slate-400">·</span>
                    <span class="text-slate-500"><%= s.player_name %></span>
                  </div>
                </div>
                <div class="text-right">
                  <% if s.completed? %>
                    <div class="text-2xl font-bold text-primary-700"><%= s.final_score %></div>
                    <div class="text-xs text-slate-500">最终得分</div>
                  <% else %>
                    <div class="text-lg font-bold text-slate-700">R<%= s.current_round %>/<%= s.max_rounds %></div>
                    <div class="text-xs text-slate-500"><%= s.actual_coverage %>% 覆盖</div>
                  <% end %>
                </div>
              </div>
              <div class="mt-3 flex gap-4 text-xs text-slate-500 flex-wrap">
                <span>🌡️ 温度: <%= s.temperature %>°C</span>
                <span>🧪 营养: <%= s.current_nutrient_level.round(1) %></span>
                <span>⚗️ pH: <%= s.ph_level %></span>
                <span>🦠 污染: <%= s.contamination_results.detected.count %> 次</span>
                <span>📊 生长记录: <%= s.growth_histories.count %> 条</span>
                <span>⚙️ 操作: <%= s.operation_details.count %> 次</span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
