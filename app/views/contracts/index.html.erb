<% provide :page_title, "合同管理" %>

<div class="flex items-center justify-between mb-6">
  <div class="flex items-center space-x-4">
    <%= form_with url: contracts_path, method: :get, local: true, class: "flex items-center space-x-2" do %>
      <select name="status", class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent">
        <option value="">全部状态</option>
        <option value="draft" <%= 'selected' if params[:status] == 'draft' %>>草稿</option>
        <option value="pending_signature" <%= 'selected' if params[:status] == 'pending_signature' %>>待签署</option>
        <option value="signed" <%= 'selected' if params[:status] == 'signed' %>>已签署</option>
        <option value="archived" <%= 'selected' if params[:status] == 'archived' %>>已归档</option>
      </select>
      <%= submit_tag "筛选", class: "px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors" %>
    <% end %>
  </div>

  <div class="text-sm text-gray-500">
    共 <%= @contracts.count %> 份合同
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">合同编号</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">关联申请</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">客户</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">签署日期</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @contracts.each do |contract| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4">
              <span class="font-medium text-gray-800"><%= contract.contract_number %></span>
            </td>
            <td class="px-6 py-4">
              <%= link_to application_path(contract.application), class: "text-blue-600 hover:text-blue-800" do %>
                <p class="text-sm font-medium"><%= contract.application.track.title %></p>
              <% end %>
            </td>
            <td class="px-6 py-4">
              <p class="text-sm text-gray-900"><%= contract.application.client_name %></p>
            </td>
            <td class="px-6 py-4">
              <p class="text-sm text-gray-900">
                <%= contract.signed_date&.strftime("%Y/%m/%d") || "未签署" %>
              </p>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs font-medium rounded-full <%= contract_status_badge(contract.status) %>">
                <%= contract_status_text(contract.status) %>
              </span>
            </td>
            <td class="px-6 py-4">
              <%= link_to "查看", contract_path(contract),
                  class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @contracts.empty? %>
    <div class="text-center py-12">
      <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <p class="text-gray-500">暂无合同</p>
    </div>
  <% end %>
</div>