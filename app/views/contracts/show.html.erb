<% provide :page_title, "合同详情" %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex items-start justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold text-gray-800">合同详情</h2>
          <p class="text-gray-500 mt-1">合同编号: <%= @contract.contract_number %></p>
        </div>
        <span class="px-4 py-2 text-sm font-medium rounded-full <%= contract_status_badge(@contract.status) %>">
          <%= contract_status_text(@contract.status) %>
        </span>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div>
          <p class="text-sm text-gray-500">客户名称</p>
          <p class="text-sm font-medium text-gray-800 mt-1"><%= @application.client_name %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">曲目</p>
          <p class="text-sm font-medium text-gray-800 mt-1"><%= @application.track.title %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">签署日期</p>
          <p class="text-sm font-medium text-gray-800 mt-1"><%= @contract.signed_date&.strftime("%Y/%m/%d") || "未签署" %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">合同金额</p>
          <p class="text-sm font-medium text-amber-600 mt-1">¥<%= number_with_delimiter(@application.budget.to_i) %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">关联授权申请</h3>
      <%= link_to application_path(@application), class: "block p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors" do %>
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-white font-bold">
              <%= @application.track.title[0] %>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-800"><%= @application.track.title %></p>
              <p class="text-xs text-gray-500 mt-1">
                <%= @application.client_name %> · <%= scenario_text(@application.usage_scenario) %>
              </p>
            </div>
          </div>
          <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_badge(@application.status) %>">
            <%= status_text(@application.status) %>
          </span>
        </div>
      <% end %>
    </div>

    <% if @versions.any? %>
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">合同版本历史</h3>
        <div class="space-y-4">
          <% @versions.each do |version| %>
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
              <div>
                <div class="flex items-center space-x-2">
                  <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-blue-100 text-blue-700">
                    版本 <%= version.version_number %>
                  </span>
                </div>
                <% if version.changes %>
                  <p class="text-sm text-gray-600 mt-1"><%= version.changes %></p>
                <% end %>
                <p class="text-xs text-gray-400 mt-2"><%= version.created_at.strftime("%Y/%m/%d %H:%M") %></p>
              </div>
              <button class="px-3 py-1 text-sm font-medium text-blue-600 hover:text-blue-800 border border-blue-200 rounded-lg hover:bg-blue-50 transition-colors">
                下载
              </button>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="space-y-6">
    <% if current_user.legal? || current_user.admin? %>
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">法务操作</h3>

        <div class="space-y-3">
          <% if @contract.status == 'draft' %>
            <%= form_with url: contract_path(@contract), method: :patch, local: true do %>
              <%= hidden_field_tag "contract[status]", "pending_signature" %>
              <%= submit_tag "提交签署",
                  class: "w-full px-4 py-3 bg-gradient-to-r from-blue-900 to-blue-800 text-white rounded-lg hover:from-blue-800 hover:to-blue-700 transition-all" %>
            <% end %>
          <% elsif @contract.status == 'pending_signature' %>
            <%= form_with url: contract_path(@contract), method: :patch, local: true do %>
              <%= hidden_field_tag "contract[status]", "signed" %>
              <%= hidden_field_tag "contract[signed_date]", Date.current %>
              <%= submit_tag "确认签署",
                  class: "w-full px-4 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors" %>
            <% end %>
          <% elsif @contract.status == 'signed' %>
            <%= form_with url: contract_path(@contract), method: :patch, local: true do %>
              <%= hidden_field_tag "contract[status]", "archived" %>
              <%= submit_tag "归档合同",
                  class: "w-full px-4 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors" %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="bg-white rounded-xl shadow-sm p-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">合同信息</h3>
      <div class="space-y-3">
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">创建时间</span>
          <span class="text-gray-800"><%= @contract.created_at.strftime("%Y/%m/%d %H:%M") %></span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">更新时间</span>
          <span class="text-gray-800"><%= @contract.updated_at.strftime("%Y/%m/%d %H:%M") %></span>
        </div>
      </div>
    </div>
  </div>
</div>