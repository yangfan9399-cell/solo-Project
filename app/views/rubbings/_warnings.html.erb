<% if @warnings.present? %>
  <div style="margin-bottom: 20px;">
    <h4 style="font-size: 14px; font-weight: 600; margin-bottom: 12px; color: #666;">异常数据提示</h4>
    <% @warnings.each do |warning| %>
      <div class="warning-item <%= warning[:type] %>">
        <span style="font-size: 16px;">
          <%= warning[:type] == :danger ? '⚠️' : warning[:type] == :warning ? '⚠️' : 'ℹ️' %>
        </span>
        <span><%= warning[:message] %></span>
      </div>
    <% end %>
  </div>
<% end %>
