<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">添加调拨物料</h1>
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: [@allocation, @allocation_item], local: true do |form| %>
      <div class="space-y-4">
        <div>
          <%= form.label :batch_id, "选择批次", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :batch_id,
            @batches.map { |b| ["#{b.batch_number} - #{b.material.name} (#{b.available_quantity}#{b.material.unit})", b.id] },
            {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
        <div>
          <%= form.label :quantity, "调拨数量", class: "block text-sm font-medium text-gray-700" %>
          <%= form.number_field :quantity, step: "0.01", min: "0.01", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
      </div>
      <div class="mt-6 flex justify-end gap-2">
        <%= link_to "取消", @allocation, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300" %>
        <%= form.submit "添加", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
