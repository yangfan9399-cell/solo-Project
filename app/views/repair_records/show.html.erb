<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <%= link_to "← 返回列表", repair_records_path, class: "text-gray-500 hover:text-gray-700" %>
      <h1 class="text-2xl font-bold text-gray-900">维修详情 #<%= @repair_record.id %></h1>
      <span class="px-4 py-1.5 text-sm font-medium rounded-full <%= status_badge_class(@repair_record.status) %>">
        <%= @repair_record.status_name %>
      </span>
    </div>
    <div class="flex space-x-2">
      <% if @repair_record.in_progress? %>
        <%= button_to "标记完成", complete_repair_record_path(@repair_record), method: :patch, class: "px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">🔧 维修信息</h2>
    <div class="grid grid-cols-2 gap-6">
      <div>
        <p class="text-sm text-gray-500 mb-1">道具</p>
        <p class="font-medium">
          <%= link_to @repair_record.prop.name, prop_path(@repair_record.prop), class: "text-amber-600 hover:text-amber-800" %>
        </p>
      </div>
      <div>
        <p class="text-sm text-gray-500 mb-1">处理人</p>
        <p class="font-medium"><%= @repair_record.handler&.name || "未指派" %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500 mb-1">开始日期</p>
        <p class="font-medium"><%= format_date(@repair_record.start_date) %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500 mb-1">预计完成</p>
        <p class="font-medium"><%= format_date(@repair_record.expected_finish_date) || "-" %></p>
      </div>
      <% if @repair_record.finished_date.present? %>
        <div>
          <p class="text-sm text-gray-500 mb-1">实际完成</p>
          <p class="font-medium text-green-600"><%= format_date(@repair_record.finished_date) %></p>
        </div>
      <% end %>
      <div>
        <p class="text-sm text-gray-500 mb-1">维修费用</p>
        <p class="font-medium text-amber-600">¥ <%= @repair_record.cost.to_i %></p>
      </div>
    </div>
  </div>

  <% if @repair_record.damage_description.present? %>
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-3">损坏描述</h3>
      <p class="text-gray-600"><%= @repair_record.damage_description %></p>
    </div>
  <% end %>

  <% if @repair_record.repair_method.present? %>
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-3">维修方式</h3>
      <p class="text-gray-600"><%= @repair_record.repair_method %></p>
    </div>
  <% end %>

  <% if @repair_record.borrow_record.present? %>
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-3">关联借调</h3>
      <%= link_to "查看借调详情 ##{@repair_record.borrow_record.id}", borrow_record_path(@repair_record.borrow_record), class: "text-amber-600 hover:text-amber-800" %>
    </div>
  <% end %>
</div>
