<%= form_with(model: repair_record, class: "space-y-6") do |form| %>
  <% if repair_record.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-red-800 font-semibold mb-2"><%= pluralize(repair_record.errors.count, "个错误") %> 禁止保存：</h3>
      <ul class="list-disc list-inside text-red-700 text-sm">
        <% repair_record.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :vehicle_id, "选择车辆", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.collection_select :vehicle_id, @vehicles, :id, :plate_number, { include_blank: "请选择车辆" }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :report_date, "报修日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.date_field :report_date, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :repair_type, "维修类型", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :repair_type, RepairRecord.repair_types.keys.map { |k| [t("enums.repair_record.repair_type.#{k}", default: k.humanize), k] }, { include_blank: "请选择类型" }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :status, RepairRecord.statuses.keys.map { |k| [t("enums.repair_record.status.#{k}", default: k.humanize), k] }, { include_blank: "请选择状态" }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :start_date, "维修开始日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.date_field :start_date, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :end_date, "维修结束日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.date_field :end_date, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" %>
    </div>

    <div>
      <%= form.label :technician, "维修技师", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :technician, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "输入技师姓名" %>
    </div>

    <div>
      <%= form.label :repair_station, "维修站点 / location", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :location, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "如：4S店、维修厂名称" %>
    </div>

    <div>
      <%= form.label :parts_cost, "配件费用 (元)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :parts_cost, step: "0.01", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "0.00" %>
    </div>

    <div>
      <%= form.label :labor_cost, "工时费用 (元)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :labor_cost, step: "0.01", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "0.00" %>
    </div>

    <div>
      <%= form.label :total_cost, "费用合计 (元)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :total_cost, step: "0.01", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "0.00" %>
    </div>

    <div>
      <%= form.label :decommission_days, "停用天数", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :decommission_days, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "自动计算，可手动调整" %>
    </div>
  </div>

  <div>
    <%= form.label :issue_description, "异常原因 / 问题描述", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_area :issue_description, rows: 3, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "详细描述故障现象..." %>
  </div>

  <div>
    <%= form.label :diagnosis, "诊断结果", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_area :diagnosis, rows: 2, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "输入故障诊断结果..." %>
  </div>

  <div>
    <%= form.label :solution, "解决方案", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_area :solution, rows: 2, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "输入维修方案和处理方式..." %>
  </div>

  <div>
    <%= form.label :abnormal_reason, "异常说明", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :abnormal_reason, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "如有特殊异常情况，请说明" %>
  </div>

  <div>
    <%= form.label :notes, "备注", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_area :notes, rows: 3, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2", placeholder: "输入备注信息..." %>
  </div>

  <div class="flex items-center">
    <%= form.check_box :is_urgent, class: "h-4 w-4 text-orange-600 focus:ring-orange-500 border-gray-300 rounded" %>
    <%= form.label :is_urgent, "标记为紧急维修", class: "ml-2 text-sm text-gray-700 font-medium" %>
  </div>

  <div class="flex justify-end space-x-4 pt-4 border-t border-gray-200">
    <%= link_to "取消", repair_records_path, class: "px-6 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
    <%= form.submit "保存", class: "px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
