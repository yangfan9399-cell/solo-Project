<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">维修记录</h1>
  </div>

  <div class="grid grid-cols-4 gap-4">
    <div class="bg-white rounded-lg shadow p-4">
      <p class="text-sm text-gray-500">维修总数</p>
      <p class="text-2xl font-bold text-gray-900"><%= RepairRecord.count %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
      <p class="text-sm text-gray-500">维修中</p>
      <p class="text-2xl font-bold text-blue-600"><%= RepairRecord.in_progress.count %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
      <p class="text-sm text-gray-500">已完成</p>
      <p class="text-2xl font-bold text-green-600"><%= RepairRecord.completed.count %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
      <p class="text-sm text-gray-500">总费用</p>
      <p class="text-2xl font-bold text-amber-600">¥ <%= RepairRecord.sum(:cost).to_i %></p>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">道具</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">费用</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">开始日期</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">完成日期</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @repair_records.each do |repair| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="flex items-center">
                <div class="w-10 h-10 bg-gray-200 rounded flex items-center justify-center text-xl mr-3">
                  <%= prop_icon(repair.prop.category) %>
                </div>
                <div>
                  <p class="font-medium">
                    <%= link_to repair.prop.name, prop_path(repair.prop), class: "hover:text-amber-600" %>
                  </p>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="px-3 py-1 text-xs font-medium rounded-full <%= status_badge_class(repair.status) %>">
                <%= repair.status_name %>
              </span>
            </td>
            <td class="px-6 py-4">
              ¥ <%= repair.cost.to_i %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= format_date(repair.start_date) %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= repair.finished_date ? format_date(repair.finished_date) : "-" %>
            </td>
            <td class="px-6 py-4 text-right text-sm font-medium">
              <%= link_to "详情", repair_record_path(repair), class: "text-amber-600 hover:text-amber-900" %>
              <% if repair.in_progress? %>
                <%= button_to "完成", complete_repair_record_path(repair), method: :patch, class: "ml-3 text-green-600 hover:text-green-900", onclick: "return confirm('确认维修已完成？');" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @repair_records.empty? %>
      <div class="px-6 py-12 text-center text-gray-500">
        暂无维修记录
      </div>
    <% end %>
  </div>
</div>
