<% content_for :title, "版本 v#{@sample_version.version_number} - #{@sample.style_number}" %>

<div class="space-y-6">
  <div class="mb-2">
    <%= link_to "← 返回样衣详情", sample_path(@sample), class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-6 border-b border-gray-200">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center space-x-4">
          <h1 class="text-2xl font-bold text-gray-900">版本 v<%= @sample_version.version_number %></h1>
          <span class="text-sm text-gray-500"><%= @sample.style_number %></span>
        </div>
        <div class="text-sm text-gray-500">
          创建时间：<%= format_date(@sample_version.created_at) %>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">版本信息</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">版本号</dt>
              <dd class="mt-1 text-sm text-gray-900">v<%= @sample_version.version_number %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">创建人</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @sample_version.created_by&.name %></dd>
            </div>
            <div class="md:col-span-2">
              <dt class="text-sm font-medium text-gray-500">修改说明</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @sample_version.description || "无" %></dd>
            </div>
            <div class="md:col-span-2">
              <dt class="text-sm font-medium text-gray-500">面料</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @sample_version.fabric || "无" %></dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">尺码表</h2>
        </div>
        <div class="px-6 py-4">
          <% if @sample_version.size_chart.present? %>
            <div class="overflow-x-auto">
              <% size_chart = @sample_version.size_chart %>
              <% if size_chart.is_a?(Hash) %>
                <% sizes = size_chart.keys %>
                <% measurements = size_chart.values.first.is_a?(Hash) ? size_chart.values.first.keys : [] %>
                <% if measurements.any? %>
                  <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                      <tr>
                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">尺码</th>
                        <% measurements.each do |m| %>
                          <th class="px-4 py-2 text-center text-xs font-medium text-gray-500 uppercase"><%= m %></th>
                        <% end %>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <% sizes.each do |size| %>
                        <tr>
                          <td class="px-4 py-2 text-sm font-medium text-gray-900"><%= size %></td>
                          <% measurements.each do |m| %>
                            <td class="px-4 py-2 text-sm text-gray-600 text-center"><%= size_chart[size][m] || "-" %></td>
                          <% end %>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                <% else %>
                  <pre class="text-sm text-gray-600 bg-gray-50 p-4 rounded-lg overflow-x-auto"><%= display_json(size_chart) %></pre>
                <% end %>
              <% else %>
                <pre class="text-sm text-gray-600 bg-gray-50 p-4 rounded-lg overflow-x-auto"><%= display_json(size_chart) %></pre>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">暂无尺码表数据</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">评审记录</h2>
        </div>
        <div class="px-6 py-4">
          <% @reviews = @sample_version.reviews.includes(:reviewer).order(created_at: :desc) %>
          <% if @reviews.any? %>
            <div class="space-y-4">
              <% @reviews.each do |review| %>
                <div class="border border-gray-200 rounded-lg p-4">
                  <div class="flex items-center justify-between mb-2">
                    <%= verdict_badge(review.verdict) %>
                    <span class="text-xs text-gray-500"><%= format_date(review.created_at) %></span>
                  </div>
                  <div class="text-sm text-gray-600 mb-2">
                    <span class="font-medium text-gray-900"><%= review.reviewer&.name %></span>
                  </div>
                  <% if review.feedback.present? %>
                    <p class="text-sm text-gray-700 mb-2"><%= review.feedback %></p>
                  <% end %>
                  <% if review.issues.present? && review.issues.is_a?(Array) && review.issues.any? %>
                    <div class="mt-2 pt-2 border-t border-gray-100">
                      <p class="text-xs font-medium text-gray-500 mb-1">问题类型：</p>
                      <div class="flex flex-wrap gap-1">
                        <% review.issues.each do |issue| %>
                          <% if issue.is_a?(Hash) && issue["type"].present? %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                              <%= issue["type"] %>
                            </span>
                          <% elsif issue.is_a?(String) %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                              <%= issue %>
                            </span>
                          <% end %>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">暂无评审记录</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
