<% if defined?(@blocking_issues) && @blocking_issues&.any? %>
  <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg">
    <div class="flex items-start">
      <div class="flex-shrink-0">
        <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-sm font-medium text-red-800">
          存在阻止项，无法创建出车申请
        </h3>
        <div class="mt-2 text-sm text-red-700">
          <ul class="list-disc pl-5 space-y-1">
            <% @blocking_issues.each do |issue| %>
              <li><%= issue %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
<% end %>

<% if @trip_record.errors.any? %>
  <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg">
    <div class="flex items-start">
      <div class="flex-shrink-0">
        <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-sm font-medium text-red-800">
          <%= pluralize(@trip_record.errors.count, "个错误") %> 导致表单提交失败
        </h3>
        <div class="mt-2 text-sm text-red-700">
          <ul class="list-disc pl-5 space-y-1">
            <% @trip_record.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="space-y-6">
  <div class="bg-white shadow-sm rounded-lg p-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4">基本信息</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :vehicle_id, '车辆', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <% if @trip_record.new_record? %>
          <%= form.collection_select :vehicle_id, @vehicles, :id, :plate_number, { include_blank: '请选择车辆' }, { class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' } %>
          <% if @vehicles.empty? %>
            <p class="mt-1 text-xs text-red-600">当前没有可派车的车辆，请先处理维修/保养/超期问题</p>
          <% end %>
        <% else %>
          <%= form.text_field :vehicle_id, value: @trip_record.vehicle&.plate_number, disabled: true, class: 'block w-full rounded-md border-gray-300 bg-gray-100 shadow-sm sm:text-sm py-2 px-3 border text-gray-500' %>
        <% end %>
      </div>

      <div>
        <%= form.label :route_id, '线路', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= form.collection_select :route_id, @routes, :id, :name, { include_blank: '请选择线路' }, { class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' } %>
      </div>

      <div>
        <%= form.label :driver_name, '司机姓名', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= form.text_field :driver_name, class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border', placeholder: '请输入司机姓名' %>
      </div>

      <div>
        <%= form.label :planned_departure_time, '计划出发时间', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= form.datetime_local_field :planned_departure_time, class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' %>
      </div>

      <div>
        <%= form.label :planned_return_time, '计划返回时间', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= form.datetime_local_field :planned_return_time, class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' %>
      </div>

      <div>
        <%= form.label :start_mileage, '起始里程 (km)', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= form.number_field :start_mileage, step: 0.1, min: 0, class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border', placeholder: '选填，出车时车辆里程表读数' %>
      </div>
    </div>
  </div>

  <% unless @trip_record.new_record? %>
    <div class="bg-white shadow-sm rounded-lg p-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">实际信息</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= form.label :actual_departure_time, '实际出发时间', class: 'block text-sm font-medium text-gray-700 mb-1' %>
          <%= form.datetime_local_field :actual_departure_time, class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' %>
        </div>

        <div>
          <%= form.label :actual_return_time, '实际返回时间', class: 'block text-sm font-medium text-gray-700 mb-1' %>
          <%= form.datetime_local_field :actual_return_time, class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' %>
        </div>

        <div>
          <%= form.label :end_mileage, '结束里程 (km)', class: 'block text-sm font-medium text-gray-700 mb-1' %>
          <%= form.number_field :end_mileage, step: 0.1, min: 0, class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border', placeholder: '选填，回车时车辆里程表读数' %>
        </div>

        <% if @trip_record.pending? || @trip_record.rejected? %>
          <div class="md:col-span-2">
            <%= form.label :review_status, '复核状态', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= form.select :review_status, options_for_select([['待复核', 'pending'], ['通过', 'approved'], ['驳回', 'rejected'], ['停用', 'decommissioned']], @trip_record.review_status), {}, { class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' } %>
          </div>

          <div class="md:col-span-2">
            <%= form.label :review_note, '复核备注', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= form.text_area :review_note, rows: 3, class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2 border', placeholder: '选填，复核时的备注信息' %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="flex items-center justify-end space-x-4">
    <%= link_to '取消', trip_records_path, class: 'inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
    <%= form.submit class: 'inline-flex items-center px-6 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
  </div>
</div>
