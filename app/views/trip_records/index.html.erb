<div class="min-h-screen bg-gray-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold text-gray-900">出车记录</h1>
      <%= link_to '新建出车申请', new_trip_record_path, class: 'inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
    </div>

    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
      <%= form_with(url: trip_records_path, method: :get, local: true, class: 'space-y-4') do %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
          <div>
            <%= label_tag :review_status, '复核状态', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= select_tag :review_status, options_for_select([['全部', ''], ['待复核', 'pending'], ['通过', 'approved'], ['驳回', 'rejected'], ['停用', 'decommissioned']], params[:review_status]), class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' %>
          </div>
          <div>
            <%= label_tag :vehicle_id, '车辆', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= select_tag :vehicle_id, options_from_collection_for_select(Vehicle.all, :id, :plate_number, params[:vehicle_id]), include_blank: '全部车辆', class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' %>
          </div>
          <div>
            <%= label_tag :route_id, '线路', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= select_tag :route_id, options_from_collection_for_select(Route.all, :id, :name, params[:route_id]), include_blank: '全部线路', class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' %>
          </div>
          <div>
            <%= label_tag :start_date, '开始日期', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= date_field_tag :start_date, params[:start_date], class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' %>
          </div>
          <div>
            <%= label_tag :end_date, '结束日期', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= date_field_tag :end_date, params[:end_date], class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2 px-3 border' %>
          </div>
        </div>
        <div class="flex justify-end space-x-3">
          <%= link_to '重置', trip_records_path, class: 'inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
          <%= submit_tag '筛选', class: 'inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">计划出发时间</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">车牌号</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">车队</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">线路</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">司机</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">复核状态</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">复核人/队长</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">里程</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @trip_records.each do |trip_record| %>
              <% vehicle = trip_record.vehicle %>
              <% has_unfinished_repairs = vehicle.has_unfinished_repairs? %>
              <% has_overdue_maintenance = vehicle.overdue_maintenance? %>
              <% row_class = trip_record.pending? ? 'bg-yellow-50 hover:bg-yellow-100' : '' %>
              <tr class="<%= row_class %>">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= trip_record.planned_departure_time&.strftime('%Y-%m-%d %H:%M') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center space-x-2">
                    <span class="text-sm font-medium text-gray-900"><%= vehicle.plate_number %></span>
                    <% if has_unfinished_repairs %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800" title="存在未完成的维修记录">
                        维修中
                      </span>
                    <% end %>
                    <% if has_overdue_maintenance %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-orange-100 text-orange-800" title="存在超期保养计划">
                        超期保养
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= vehicle.fleet&.name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= trip_record.route&.name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= trip_record.driver_name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% case trip_record.review_status %>
                  <% when 'pending' %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                      待复核
                    </span>
                  <% when 'approved' %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      通过
                    </span>
                  <% when 'rejected' %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      驳回
                    </span>
                  <% when 'decommissioned' %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-900 text-red-100">
                      停用
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= trip_record.reviewer || '-' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <% if trip_record.start_mileage.present? && trip_record.end_mileage.present? %>
                    <%= number_with_precision(trip_record.end_mileage - trip_record.start_mileage, precision: 1) %> km
                  <% elsif trip_record.start_mileage.present? %>
                    起始: <%= number_with_precision(trip_record.start_mileage, precision: 1) %> km
                  <% else %>
                    -
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to '查看', trip_record_path(trip_record), class: 'text-blue-600 hover:text-blue-900' %>
                  <% if trip_record.pending? %>
                    <%= link_to '编辑', edit_trip_record_path(trip_record), class: 'ml-3 text-gray-600 hover:text-gray-900' %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @trip_records.respond_to?(:total_pages) && @trip_records.total_pages > 1 %>
        <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
          <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
            <div>
              <p class="text-sm text-gray-700">
                显示第 <span class="font-medium"><%= @trip_records.offset_value + 1 %></span> 至 <span class="font-medium"><%= [@trip_records.offset_value + @trip_records.limit_value, @trip_records.total_count].min %></span> 条，共 <span class="font-medium"><%= @trip_records.total_count %></span> 条
              </p>
            </div>
            <div>
              <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <% if @trip_records.prev_page %>
                  <%= link_to '上一页', url_for(page: @trip_records.prev_page), class: 'relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50' %>
                <% end %>
                <% (1..@trip_records.total_pages).each do |page| %>
                  <% if page == @trip_records.current_page %>
                    <span class="relative inline-flex items-center px-4 py-2 border border-blue-500 bg-blue-50 text-sm font-medium text-blue-600">
                      <%= page %>
                    </span>
                  <% else %>
                    <%= link_to page, url_for(page: page), class: 'relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50' %>
                  <% end %>
                <% end %>
                <% if @trip_records.next_page %>
                  <%= link_to '下一页', url_for(page: @trip_records.next_page), class: 'relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50' %>
                <% end %>
              </nav>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
