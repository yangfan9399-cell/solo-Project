<% content_for(:title, "编辑出车单 ##{@trip_record.id}") %>

<div class="min-h-screen bg-gray-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center space-x-4 mb-6">
      <%= link_to '← 返回列表', trip_records_path, class: 'text-sm text-blue-600 hover:text-blue-800' %>
      <h1 class="text-3xl font-bold text-gray-900">编辑出车单 #<%= @trip_record.id %></h1>
    </div>

    <%= form_with(model: @trip_record, local: true) do |form| %>
      <%= render partial: 'form', locals: { form: form } %>
    <% end %>
  </div>
</div>
