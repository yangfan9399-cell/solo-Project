<% content_for(:title, "出车单 ##{@trip_record.id}") %>

<div class="min-h-screen bg-gray-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center space-x-4">
        <%= link_to '← 返回列表', trip_records_path, class: 'text-sm text-blue-600 hover:text-blue-800' %>
        <h1 class="text-3xl font-bold text-gray-900">出车单 #<%= @trip_record.id %></h1>
      </div>
      <% case @trip_record.review_status %>
      <% when 'pending' %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
          待复核
        </span>
      <% when 'approved' %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
          已通过
        </span>
      <% when 'rejected' %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
          已驳回
        </span>
      <% when 'decommissioned' %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-900 text-red-100">
          已停用
        </span>
      <% end %>
    </div>

    <% blocking_issues = @trip_record.blocking_issues %>
    <% if blocking_issues.any? %>
      <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3 flex-1">
            <h3 class="text-sm font-medium text-red-800 mb-3">
              存在 <span class="font-bold"><%= blocking_issues.count %></span> 项阻止出车问题，请先处理后再复核
            </h3>
            <div class="space-y-2">
              <% blocking_issues.each do |issue| %>
                <div class="flex items-start justify-between bg-white rounded-md p-2.5 border border-red-100">
                  <div class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-red-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <span class="text-sm text-red-700"><%= issue %></span>
                  </div>
                  <div class="ml-3 flex-shrink-0">
                    <% if issue.include?('未完成的维修') %>
                      <% @vehicle.repair_records.unfinished.each do |rr| %>
                        <%= link_to "完成维修##{rr.id}", repair_record_path(rr), class: 'inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium bg-orange-100 text-orange-700 hover:bg-orange-200 rounded transition' %>
                      <% end %>
                    <% elsif issue.include?('超期保养') %>
                      <%= link_to "查看保养计划", maintenance_plans_path(vehicle_id: @vehicle.id), class: 'inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium bg-yellow-100 text-yellow-700 hover:bg-yellow-200 rounded transition' %>
                    <% elsif issue.include?('检查未通过') || issue.include?('暂无车况检查') %>
                      <%= link_to "立即做车况检查", new_inspection_record_path(vehicle_id: @vehicle.id), class: 'inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium bg-blue-100 text-blue-700 hover:bg-blue-200 rounded transition' %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if notice %>
      <div class="mb-6 bg-green-50 border-l-4 border-green-500 p-4 rounded-r-lg">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-green-700"><%= notice %></p>
          </div>
        </div>
      </div>
    <% end %>

    <% if alert %>
      <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-red-700"><%= alert %></p>
          </div>
        </div>
      </div>
    <% end %>

    <div class="bg-white rounded-lg shadow-sm overflow-hidden mb-6">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">出车单详情</h2>
      </div>
      <div class="px-6 py-5">
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
          <div>
            <dt class="text-sm font-medium text-gray-500">车辆</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= @vehicle.plate_number %>
              <span class="ml-2 px-2 py-0.5 text-xs rounded-full <%= @vehicle.status_badge_color %>">
                <%= @vehicle.status %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">车队</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @vehicle.fleet&.name %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">线路</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @trip_record.route&.name %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">司机</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @trip_record.driver_name %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">计划出发时间</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @trip_record.planned_departure_time&.strftime('%Y-%m-%d %H:%M') %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">计划返回时间</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @trip_record.planned_return_time&.strftime('%Y-%m-%d %H:%M') || '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">实际出发时间</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @trip_record.actual_departure_time&.strftime('%Y-%m-%d %H:%M') || '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">实际返回时间</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @trip_record.actual_return_time&.strftime('%Y-%m-%d %H:%M') || '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">起始里程</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @trip_record.start_mileage ? number_with_precision(@trip_record.start_mileage, precision: 1) + ' km' : '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">结束里程</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @trip_record.end_mileage ? number_with_precision(@trip_record.end_mileage, precision: 1) + ' km' : '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">实际里程</dt>
            <dd class="mt-1 text-sm text-gray-900 font-medium text-blue-600">
              <%= number_with_precision(@trip_record.actual_distance, precision: 1) %> km
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">复核人</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @trip_record.reviewer || '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">复核时间</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @trip_record.reviewed_at&.strftime('%Y-%m-%d %H:%M') || '-' %></dd>
          </div>
          <% if @trip_record.review_note.present? %>
            <div class="md:col-span-2">
              <dt class="text-sm font-medium text-gray-500">复核备注</dt>
              <dd class="mt-1 text-sm text-gray-900 bg-gray-50 p-3 rounded-md"><%= @trip_record.review_note %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">操作</h2>

      <% if @trip_record.pending? %>
        <div class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <%= form_with(model: @trip_record, url: approve_trip_record_path(@trip_record), method: :patch, local: true) do |f| %>
              <div class="border <%= blocking_issues.any? ? 'border-gray-200 bg-gray-50' : 'border-green-200 bg-green-50' %> rounded-lg p-4">
                <h3 class="text-sm font-medium <%= blocking_issues.any? ? 'text-gray-500' : 'text-green-800' %> mb-2">复核通过</h3>
                <% if blocking_issues.any? %>
                  <p class="text-xs text-red-600 mb-2">⚠️ 存在阻止项，请先处理：<%= blocking_issues.count %>项</p>
                <% else %>
                  <p class="text-xs text-green-600 mb-3">确认此出车申请无误，批准执行</p>
                <% end %>
                <%= f.submit '通过', disabled: blocking_issues.any?, class: "w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white focus:outline-none focus:ring-2 focus:ring-offset-2 #{blocking_issues.any? ? 'bg-gray-300 cursor-not-allowed' : 'bg-green-600 hover:bg-green-700 focus:ring-green-500'}" %>
              </div>
            <% end %>

            <%= form_with(model: @trip_record, url: reject_trip_record_path(@trip_record), method: :patch, local: true, id: 'reject-form') do |f| %>
              <div class="border border-red-200 rounded-lg p-4 bg-red-50">
                <h3 class="text-sm font-medium text-red-800 mb-2">复核驳回</h3>
                <div class="mb-3">
                  <%= label_tag :review_note, '驳回理由（必填）', class: 'block text-xs font-medium text-red-700 mb-1' %>
                  <%= text_area_tag :review_note, nil, rows: 3, class: 'block w-full rounded-md border-red-300 shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm p-2 border', placeholder: '请输入驳回原因...', required: true %>
                </div>
                <%= f.submit '驳回', class: 'w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500' %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @trip_record.approved? || @trip_record.is_active? %>
        <%= form_with(model: @trip_record, url: complete_trip_record_path(@trip_record), method: :patch, local: true) do |f| %>
          <div class="border border-blue-200 rounded-lg p-4 bg-blue-50">
            <h3 class="text-sm font-medium text-blue-800 mb-2">完成出车</h3>
            <div class="mb-3">
              <%= label_tag :end_mileage, '实际结束里程（必填）', class: 'block text-xs font-medium text-blue-700 mb-1' %>
              <div class="relative">
                <%= number_field_tag :end_mileage, nil, step: 0.1, min: (@trip_record.start_mileage || 0), class: 'block w-full rounded-md border-blue-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2 pr-10 border', placeholder: '请输入实际里程...', required: true %>
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                  <span class="text-gray-500 sm:text-sm">km</span>
                </div>
              </div>
              <% if @trip_record.start_mileage.present? %>
                <p class="mt-1 text-xs text-blue-600">起始里程: <%= number_with_precision(@trip_record.start_mileage, precision: 1) %> km</p>
              <% end %>
            </div>
            <%= f.submit '完成出车', class: 'w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
          </div>
        <% end %>
      <% end %>

      <% if !@trip_record.pending? && !(@trip_record.approved? || @trip_record.is_active?) %>
        <div class="text-center py-4 text-gray-500">
          <p class="text-sm">当前状态无可执行操作</p>
          <p class="text-xs mt-1">
            <% if @trip_record.rejected? %>
              出车申请已被驳回，如需重新申请请新建出车单
            <% elsif @trip_record.decommissioned? %>
              车辆已停用
            <% else %>
              出车任务已完成
            <% end %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
