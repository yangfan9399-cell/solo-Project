<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">赔付管理</h1>
    <div class="flex space-x-2">
      <%= link_to "待赔付", compensations_path(status: :pending), class: "px-4 py-2 border rounded hover:bg-gray-50 #{'bg-amber-100 border-amber-300' if params[:status] == 'pending'}" %>
      <%= link_to "有争议", compensations_path(status: :disputed), class: "px-4 py-2 border rounded hover:bg-gray-50 #{'bg-red-100 border-red-300' if params[:status] == 'disputed'}" %>
      <%= link_to "已完成", compensations_path(status: :paid), class: "px-4 py-2 border rounded hover:bg-gray-50 #{'bg-green-100 border-green-300' if params[:status] == 'paid'}" %>
    </div>
  </div>

  <div class="grid grid-cols-4 gap-4">
    <div class="bg-white rounded-lg shadow p-4">
      <p class="text-sm text-gray-500">赔付总额</p>
      <p class="text-2xl font-bold text-red-600">¥ <%= Compensation.sum(:amount).to_i %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
      <p class="text-sm text-gray-500">待赔付</p>
      <p class="text-2xl font-bold text-amber-600"><%= Compensation.pending.count %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
      <p class="text-sm text-gray-500">有争议</p>
      <p class="text-2xl font-bold text-red-600"><%= Compensation.disputed.count %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
      <p class="text-sm text-gray-500">已赔付</p>
      <p class="text-2xl font-bold text-green-600">¥ <%= Compensation.paid.sum(:amount).to_i %></p>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">道具</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">剧组</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">金额</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">处理人</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @compensations.each do |comp| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <p class="font-medium"><%= comp.borrow_record.prop.name %></p>
              <p class="text-sm text-gray-500"><%= comp.borrow_record.prop.category %></p>
            </td>
            <td class="px-6 py-4">
              <p class="font-medium"><%= comp.borrow_record.crew.name %></p>
              <p class="text-sm text-gray-500"><%= comp.borrow_record.crew.play_name %></p>
            </td>
            <td class="px-6 py-4">
              <span class="text-lg font-bold text-red-600">¥ <%= comp.amount.to_i %></span>
            </td>
            <td class="px-6 py-4">
              <span class="px-3 py-1 text-xs font-medium rounded-full <%= status_badge_class(comp.status) %>">
                <%= comp.status_name %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= comp.handler&.name || "-" %>
            </td>
            <td class="px-6 py-4 text-right text-sm font-medium">
              <%= link_to "详情", compensation_path(comp), class: "text-amber-600 hover:text-amber-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @compensations.empty? %>
      <div class="px-6 py-12 text-center text-gray-500">
        暂无赔付记录
      </div>
    <% end %>
  </div>
</div>
