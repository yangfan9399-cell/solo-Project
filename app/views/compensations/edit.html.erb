<div class="max-w-3xl mx-auto">
  <div class="flex items-center space-x-4 mb-6">
    <%= link_to "← 返回", compensation_path(@compensation), class: "text-gray-500 hover:text-gray-700" %>
    <h1 class="text-2xl font-bold text-gray-900">编辑赔付记录</h1>
  </div>
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with(model: @compensation) do |form| %>
      <% if @compensation.errors.any? %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
          <h2 class="text-lg font-semibold text-red-800 mb-2">有 <%= @compensation.errors.count %> 个错误需要修正</h2>
          <ul class="list-disc list-inside text-sm text-red-600">
            <% @compensation.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-4">
        <div>
          <%= form.label :amount, "赔付金额", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.number_field :amount, step: "0.01", class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500" %>
        </div>
        <div>
          <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :status, Compensation.statuses.keys.map { |s| [I18n.t("compensation_statuses.#{s}", default: s.humanize), s] }, {}, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500" %>
        </div>
        <div>
          <%= form.label :basis, "赔付依据", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :basis, rows: 4, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500" %>
        </div>
        <div>
          <%= form.label :dispute_reason, "争议原因", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :dispute_reason, rows: 3, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500" %>
        </div>
        <div>
          <%= form.label :resolution, "解决方案", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :resolution, rows: 3, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-500" %>
        </div>
      </div>

      <div class="mt-8 flex justify-end space-x-3">
        <%= link_to "取消", compensations_path, class: "px-6 py-2 border border-gray-300 rounded-lg hover:bg-gray-50" %>
        <%= form.submit "保存", class: "px-6 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
