<% content_for :title, "第#{@level.level_number}关 - 河谷水磨坊" %>

<% content_for :head do %>
  <meta name="game-session-id" content="<%= @game_session.id %>">
  <meta name="csrf-token" content="<%= form_authenticity_token %>">
  <script>
    window.__INITIAL_GEARS_STATE__ = <%= raw @game_session.gears_state || '[]' %>;
    window.__TARGET_RPM__ = <%= @level.target_rpm %>;
    window.__RPM_TOLERANCE__ = <%= @level.rpm_tolerance %>;
    window.__WATER_FORCE__ = <%= @level.water_force %>;
  </script>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
  <div class="lg:col-span-3">
    <div class="card p-0 overflow-hidden">
      <div class="bg-gradient-to-r from-wood-700 to-wood-800 text-white px-6 py-3 flex justify-between items-center">
        <div>
          <span class="text-wood-200 text-sm">第<%= @level.level_number %>关：</span>
          <span class="font-bold"><%= @level.name %></span>
        </div>
        <div class="flex gap-4 text-sm">
          <div>
            <span class="text-wood-300">步数：</span>
            <span id="moves-count" class="font-bold"><%= @game_session.moves_count %></span>
          </div>
          <div>
            <span class="text-wood-300">时间：</span>
            <span id="timer" class="font-bold font-mono">00:00</span>
          </div>
        </div>
      </div>

      <div class="relative bg-gradient-to-b from-water-100 via-water-50 to-wood-50" style="height: 500px;">
        <svg id="game-canvas" class="w-full h-full" viewBox="0 0 800 500" style="cursor: grab;">
          <defs>
            <linearGradient id="waterGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:#38bdf8;stop-opacity:0.6" />
              <stop offset="100%" style="stop-color:#0284c7;stop-opacity:0.8" />
            </linearGradient>
            <linearGradient id="woodGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#d67a35" />
              <stop offset="100%" style="stop-color:#853c26" />
            </linearGradient>
            <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#a8a29e" />
              <stop offset="100%" style="stop-color:#57534e" />
            </linearGradient>
            <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="2" dy="2" stdDeviation="3" flood-opacity="0.3"/>
            </filter>
          </defs>

          <rect x="0" y="380" width="800" height="120" fill="url(#waterGrad)" opacity="0.5"/>
          <g id="water-flow">
            <% 5.times do |i| %>
              <path d="M<%= i * 180 %> 420 Q <%= i * 180 + 45 %> 410 <%= i * 180 + 90 %> 420 T <%= i * 180 + 180 %> 420"
                    fill="none" stroke="#0ea5e9" stroke-width="2" opacity="0.6" class="water-wave">
              </path>
            <% end %>
          </g>

          <g id="gears-layer">
          </g>

          <g id="connections-layer" stroke="#78716c" stroke-width="3" stroke-dasharray="5,5" opacity="0.6">
          </g>
        </svg>

        <div id="gear-hint" class="hidden absolute bg-gear-800 text-white px-3 py-1 rounded text-sm pointer-events-none z-10">
        </div>
      </div>
    </div>
  </div>

  <div class="space-y-4">
    <div class="card">
      <h3 class="font-bold text-wood-800 mb-3 flex items-center gap-2">
        <span>🎯</span> 目标转速
      </h3>
      <div class="text-center">
        <div class="text-4xl font-bold text-water-700 mb-1"><%= @level.target_rpm %></div>
        <div class="text-sm text-gear-500">± <%= @level.rpm_tolerance %> RPM</div>
      </div>
      <div class="mt-4 pt-4 border-t border-wood-200">
        <div class="text-sm text-gear-500 mb-1">当前目标齿轮转速</div>
        <div id="current-rpm" class="text-3xl font-bold text-center
          <% rpm_diff = (@game_session.current_rpm - @level.target_rpm).abs
             rpm_diff <= @level.rpm_tolerance ? 'text-emerald-600' : 'text-orange-600' %>">
          <%= @game_session.current_rpm.round(1) %> RPM
        </div>
        <div id="rpm-status" class="text-center text-sm mt-1">
          <% if rpm_diff <= @level.rpm_tolerance %>
            <span class="text-emerald-600">✓ 达标！</span>
          <% else %>
            <span class="text-orange-600">调整齿轮...</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card">
      <h3 class="font-bold text-wood-800 mb-3 flex items-center gap-2">
        <span>⚙️</span> 可用齿轮
      </h3>
      <div id="available-gears" class="space-y-2">
        <% @available_gears.each_with_index do |gear, idx| %>
          <div class="gear-item p-3 bg-gear-50 hover:bg-gear-100 rounded-lg cursor-pointer transition-all border-2 border-transparent hover:border-wood-400 flex items-center gap-3"
               data-teeth="<%= gear[:teeth] %>"
               data-size="<%= gear[:size] %>"
               data-type="available">
            <svg width="40" height="40" viewBox="-25 -25 50 50">
              <%= render_gear_svg(gear[:teeth], gear[:size] * 0.8, '#78716c', '#57534e') %>
            </svg>
            <div>
              <div class="font-semibold text-gear-800"><%= gear[:teeth] %> 齿</div>
              <div class="text-xs text-gear-500">直径 <%= (gear[:size] * 2).round %>px</div>
            </div>
          </div>
        <% end %>
      </div>
      <p class="text-xs text-gear-500 mt-3">点击选择，然后点击画布放置</p>
    </div>

    <div class="card">
      <h3 class="font-bold text-wood-800 mb-3">🔧 操作</h3>
      <div class="space-y-2">
        <button id="undo-btn" class="w-full btn-secondary disabled:opacity-50 disabled:cursor-not-allowed" <%= @game_session.can_undo? ? '' : 'disabled' %>>
          ↩ 撤销上一步
        </button>
        <button id="complete-btn" class="w-full btn-success">
          ✓ 提交并结算
        </button>
        <%= button_to '✕ 放弃', abandon_game_session_path(@game_session), method: :post,
            class: 'w-full btn-danger', data: { confirm: '确定要放弃当前关卡吗？' } %>
      </div>
    </div>

    <div class="card bg-amber-50 border-amber-200">
      <h3 class="font-bold text-amber-800 mb-2 text-sm">💡 提示</h3>
      <ul class="text-xs text-amber-700 space-y-1">
        <li>• 拖动已放置的齿轮调整位置</li>
        <li>• 双击齿轮可移除（水轮/目标除外）</li>
        <li>• 齿轮需相互靠近才能咬合</li>
        <li>• 小齿轮带动大齿轮会减速</li>
        <li>• 大齿轮带动小齿轮会加速</li>
      </ul>
    </div>
  </div>
</div>
