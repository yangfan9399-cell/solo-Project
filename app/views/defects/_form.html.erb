<%= form_with model: [@project, @component, @defect], class: "space-y-6" do |form| %>
  <% if @defect.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-red-800 font-medium mb-2">发现 <%= @defect.errors.count %> 个错误：</h3>
      <ul class="text-red-600 text-sm list-disc list-inside">
        <% @defect.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :defect_type, class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.select :defect_type, Defect::DEFECT_TYPES, { include_blank: "请选择缺损类型" }, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 bg-white" %>
    </div>

    <div>
      <%= form.label :severity, class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.select :severity, Defect::SEVERITIES, { include_blank: "请选择严重程度" }, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 bg-white" %>
    </div>

    <div>
      <%= form.label :location_on_component, class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.text_field :location_on_component, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500", placeholder: "构件上的具体位置" %>
    </div>

    <div>
      <%= form.label :measured_size, class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.text_field :measured_size, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500", placeholder: "测量尺寸，如：长5cm宽2cm" %>
    </div>

    <div>
      <%= form.label :discovered_at, class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.date_field :discovered_at, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
    </div>

    <div class="flex items-end">
      <label class="flex items-center space-x-2 cursor-pointer">
        <%= form.check_box :repaired, class: "w-4 h-4 text-amber-600 border-stone-300 rounded focus:ring-amber-500" %>
        <span class="text-sm font-medium text-stone-700">已修复</span>
      </label>
    </div>

    <div>
      <%= form.label :repaired_at, class: "block text-sm font-medium text-stone-700 mb-2" %>
      <%= form.date_field :repaired_at, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
    </div>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-stone-700 mb-2" %>
    <%= form.text_area :description, rows: 4, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500", placeholder: "缺损详细描述" %>
  </div>

  <div>
    <%= form.label :repair_notes, class: "block text-sm font-medium text-stone-700 mb-2" %>
    <%= form.text_area :repair_notes, rows: 3, class: "w-full px-3 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500", placeholder: "修复说明" %>
  </div>

  <div class="flex justify-end space-x-3 pt-4 border-t border-stone-200">
    <%= link_to "取消", project_component_defects_path(@project, @component), class: "px-4 py-2 border border-stone-300 rounded-lg text-stone-700 hover:bg-stone-50 transition-colors" %>
    <%= form.submit class: "px-6 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors font-medium cursor-pointer" %>
  </div>
<% end %>
