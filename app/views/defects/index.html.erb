<% content_for :title, "缺损记录 - #{@component.full_code}" %>

<div class="space-y-6">
  <nav class="text-sm text-stone-500">
    <ol class="flex items-center space-x-2">
      <li><%= link_to "项目台账", projects_path, class: "hover:text-amber-600" %></li>
      <li class="text-stone-300">/</li>
      <li><%= link_to @project.name, project_path(@project), class: "hover:text-amber-600" %></li>
      <li class="text-stone-300">/</li>
      <li><%= link_to @component.code, project_component_path(@project, @component), class: "hover:text-amber-600" %></li>
      <li class="text-stone-300">/</li>
      <li class="text-stone-700 font-medium">缺损记录</li>
    </ol>
  </nav>

  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-stone-800">缺损记录</h1>
      <p class="text-stone-500 mt-1">构件 <%= @component.full_code %> 的缺损记录列表</p>
    </div>
    <div class="flex space-x-3">
      <%= link_to "返回构件", project_component_path(@project, @component), class: "px-4 py-2 border border-stone-300 rounded-lg text-stone-700 hover:bg-stone-50 transition-colors" %>
      <%= link_to "新建缺损", new_project_component_defect_path(@project, @component), class: "px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors font-medium" %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-stone-100 bg-stone-50/50">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-stone-800">全部缺损</h2>
        <span class="text-sm text-stone-500">共 <%= @total_count %> 条记录</span>
      </div>
    </div>

    <% if @defects.any? %>
      <div class="divide-y divide-stone-100">
        <% @defects.each do |defect| %>
          <div class="p-6 hover:bg-stone-50/50 transition-colors">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= defect.repaired? ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' %>">
                    <%= defect.repaired? ? '已修复' : '待修复' %>
                  </span>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                    <%= case defect.severity
                        when '轻微' then 'bg-stone-100 text-stone-700'
                        when '中等' then 'bg-blue-100 text-blue-700'
                        when '严重' then 'bg-orange-100 text-orange-700'
                        when '致命' then 'bg-red-100 text-red-700'
                        else 'bg-stone-100 text-stone-700'
                        end %>">
                    <%= defect.severity %>
                  </span>
                  <span class="text-stone-600 font-medium"><%= defect.defect_type %></span>
                </div>
                <p class="text-stone-600 text-sm mb-2">
                  <%= defect.description.present? ? truncate(defect.description, length: 100) : '暂无描述' %>
                </p>
                <div class="flex items-center space-x-4 text-xs text-stone-400">
                  <span>位置：<%= defect.location_on_component.presence || '-' %></span>
                  <span>尺寸：<%= defect.measured_size.presence || '-' %></span>
                  <span>发现日期：<%= defect.discovered_at&.strftime('%Y-%m-%d') %></span>
                </div>
              </div>
              <div class="flex items-center space-x-2 ml-4">
                <%= link_to "查看", project_component_defect_path(@project, @component, defect), class: "text-amber-600 hover:text-amber-700 text-sm font-medium" %>
                <%= link_to "编辑", edit_project_component_defect_path(@project, @component, defect), class: "text-stone-500 hover:text-stone-700 text-sm" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @total_pages > 1 %>
        <div class="px-6 py-4 border-t border-stone-100 bg-stone-50/30">
          <div class="flex items-center justify-between">
            <span class="text-sm text-stone-500">
              显示 <%= (@page - 1) * @per_page + 1 %> - <%= [(@page - 1) * @per_page + @per_page, @total_count].min %> 条，共 <%= @total_count %> 条
            </span>
            <div class="flex space-x-1">
              <% if @page == 1 %>
                <span class="px-3 py-1 text-sm text-stone-300">上一页</span>
              <% else %>
                <%= link_to "上一页", project_component_defects_path(@project, @component, page: @page - 1), class: "px-3 py-1 text-sm text-amber-600 hover:bg-amber-50 rounded" %>
              <% end %>
              <% if @page == @total_pages %>
                <span class="px-3 py-1 text-sm text-stone-300">下一页</span>
              <% else %>
                <%= link_to "下一页", project_component_defects_path(@project, @component, page: @page + 1), class: "px-3 py-1 text-sm text-amber-600 hover:bg-amber-50 rounded" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="p-12 text-center">
        <svg class="w-16 h-16 text-stone-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <p class="text-stone-500 mb-4">暂无缺损记录</p>
        <%= link_to "添加第一条缺损记录", new_project_component_defect_path(@project, @component), class: "text-amber-600 hover:text-amber-700 font-medium" %>
      </div>
    <% end %>
  </div>
</div>
