<%= form_with model: [@project, @component], class: "space-y-6" do |form| %>
  <% if @component.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-red-800 font-medium mb-2"><%= @component.errors.count %> 个错误导致保存失败：</h3>
      <ul class="list-disc list-inside text-red-600 text-sm">
        <% @component.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow-sm border border-stone-200 p-6">
    <h3 class="text-lg font-semibold text-stone-800 mb-4 border-b border-stone-100 pb-2">基本信息</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :code, "构件编号", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.text_field :code, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :component_type, "构件类型", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.select :component_type, Component::COMPONENT_TYPES, { include_blank: "请选择类型" }, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :status, "状态", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.select :status, Component::STATUSES, { include_blank: "请选择状态" }, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :orientation, "朝向", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.select :orientation, Component::ORIENTATIONS, { include_blank: "请选择朝向" }, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :batch_tag, "批次标签", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.text_field :batch_tag, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :material, "材质", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.text_field :material, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :position, "拆卸位置", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.text_field :position, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :layer, "层位", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.number_field :layer, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-stone-200 p-6">
    <h3 class="text-lg font-semibold text-stone-800 mb-4 border-b border-stone-100 pb-2">尺寸信息</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <%= form.label :length, "长度 (cm)", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.number_field :length, step: "0.01", class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :width, "宽度 (cm)", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.number_field :width, step: "0.01", class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :height, "高度 (cm)", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.number_field :height, step: "0.01", class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-stone-200 p-6">
    <h3 class="text-lg font-semibold text-stone-800 mb-4 border-b border-stone-100 pb-2">关联信息</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :parent_component_id, "父构件", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.select :parent_component_id, @project.components.where.not(id: @component.id).pluck(:code, :id), { include_blank: "无父构件" }, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :sequence, "序号", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.number_field :sequence, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-stone-200 p-6">
    <h3 class="text-lg font-semibold text-stone-800 mb-4 border-b border-stone-100 pb-2">照片与备注</h3>
    <div class="space-y-4">
      <div>
        <%= form.label :photo_refs_text, "照片编号（用逗号分隔）", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.text_area :photo_refs_text, rows: 3, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent", placeholder: "例如：IMG_001, IMG_002, IMG_003", value: @component.photo_refs_text %>
        <p class="text-xs text-stone-500 mt-1">输入照片引用编号，多个编号用英文逗号分隔</p>
      </div>
      <div>
        <%= form.label :notes, "备注", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= form.text_area :notes, rows: 4, class: "w-full px-3 py-2 border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "取消", project_components_path(@project), class: "px-4 py-2 border border-stone-300 rounded-md text-stone-700 hover:bg-stone-50 transition-colors" %>
    <%= form.submit class: "px-4 py-2 bg-amber-600 text-white rounded-md hover:bg-amber-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
