<% content_for :title, "#{@component.full_code} - 构件详情" %>

<% if @component.has_anomaly? %>
  <div class="mb-4 bg-red-50 border border-red-200 rounded-lg p-4">
    <div class="flex items-start">
      <div class="flex-shrink-0">
        <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
      </div>
      <div class="ml-3 flex-1">
        <h3 class="text-sm font-semibold text-red-800">该构件存在异常</h3>
        <div class="mt-2 flex flex-wrap gap-2">
          <% @component.anomaly_types.each do |anomaly_type| %>
            <% anomaly_color = case anomaly_type
              when "状态异常" then "bg-red-100 text-red-700 border-red-200"
              when "严重缺损" then "bg-orange-100 text-orange-700 border-orange-200"
              when "无编号" then "bg-yellow-100 text-yellow-700 border-yellow-200"
              when "位置重复" then "bg-amber-100 text-amber-700 border-amber-200"
              when "待复装超期" then "bg-red-100 text-red-700 border-red-200"
              else "bg-stone-100 text-stone-700 border-stone-200"
            end %>
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium border <%= anomaly_color %>">
              <%= anomaly_type %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="mb-4">
  <nav class="text-sm text-stone-500 mb-3">
    <%= link_to "项目台账", projects_path, class: "hover:text-amber-600" %>
    <span class="mx-2">/</span>
    <%= link_to @project.name, project_path(@project), class: "hover:text-amber-600" %>
    <span class="mx-2">/</span>
    <%= link_to "构件列表", project_components_path(@project), class: "hover:text-amber-600" %>
    <span class="mx-2">/</span>
    <span class="text-stone-700"><%= @component.full_code %></span>
  </nav>
</div>

<div class="grid grid-cols-12 gap-4">
  <div class="col-span-12 lg:col-span-3 space-y-4">
    <div class="bg-white rounded-lg shadow-sm border border-stone-200 p-5">
      <div class="mb-4">
        <h1 class="text-xl font-bold text-stone-800 break-all"><%= @component.full_code %></h1>
        <div class="flex flex-wrap gap-2 mt-3">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-stone-100 text-stone-700">
            <%= @component.component_type %>
          </span>
          <% status_color = case @component.status
            when "在原位" then "bg-blue-100 text-blue-700"
            when "已拆卸" then "bg-stone-200 text-stone-700"
            when "修复中" then "bg-amber-100 text-amber-700"
            when "待复装" then "bg-yellow-100 text-yellow-700"
            when "已复装" then "bg-green-100 text-green-700"
            when "异常" then "bg-red-100 text-red-700"
            else "bg-stone-100 text-stone-700"
          end %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium <%= status_color %>">
            <%= @component.status %>
          </span>
        </div>
      </div>

      <dl class="space-y-2.5 text-sm">
        <div class="flex justify-between">
          <dt class="text-stone-500">拆卸位置</dt>
          <dd class="text-stone-700 font-medium"><%= @component.position.presence || "-" %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-stone-500">朝向</dt>
          <dd class="text-stone-700 font-medium"><%= @component.orientation.presence || "-" %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-stone-500">层位</dt>
          <dd class="text-stone-700 font-medium"><%= @component.layer.presence || "-" %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-stone-500">材质</dt>
          <dd class="text-stone-700 font-medium"><%= @component.material.presence || "-" %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-stone-500">尺寸</dt>
          <dd class="text-stone-700 font-medium">
            <% if @component.length || @component.width || @component.height %>
              <%= "#{@component.length || '-'}×#{@component.width || '-'}×#{@component.height || '-'} cm" %>
            <% else %>
              -
            <% end %>
          </dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-stone-500">批次号</dt>
          <dd class="text-stone-700 font-medium"><%= @component.batch_tag.presence || "-" %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-stone-500">序号</dt>
          <dd class="text-stone-700 font-medium"><%= @component.sequence.presence || "-" %></dd>
        </div>
      </dl>

      <% if @component.parent_component_id %>
        <% parent_component = @project.components.find_by(id: @component.parent_component_id) %>
        <% if parent_component %>
          <div class="mt-4 pt-4 border-t border-stone-100">
            <span class="text-xs text-stone-500">父构件</span>
            <div class="mt-1">
              <%= link_to parent_component.full_code, project_component_path(@project, parent_component), class: "text-amber-600 hover:text-amber-800 text-sm font-medium" %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-stone-200 p-5">
      <h3 class="text-sm font-semibold text-stone-700 mb-3">照片 (<%= @component.photo_refs&.count || 0 %>)</h3>
      <% if @component.photo_refs.present? && @component.photo_refs.any? %>
        <div class="grid grid-cols-3 gap-2">
          <% @component.photo_refs.each_with_index do |ref, idx| %>
            <div class="aspect-square bg-stone-200 rounded flex flex-col items-center justify-center text-stone-500 text-xs">
              <svg class="w-6 h-6 mb-1 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <span class="truncate w-full text-center px-1"><%= ref %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-4 text-stone-400 text-sm">
          暂无照片
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-stone-200 p-5 space-y-2">
      <%= link_to edit_project_component_path(@project, @component), class: "w-full flex items-center justify-center px-4 py-2 bg-amber-600 text-white text-sm rounded-md hover:bg-amber-700 transition-colors" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
        编辑构件
      <% end %>
      <%= button_to project_component_path(@project, @component), method: :delete, form: { data: { turbo_confirm: "确定要删除这个构件吗？" } }, class: "w-full flex items-center justify-center px-4 py-2 border border-red-200 text-red-600 text-sm rounded-md hover:bg-red-50 transition-colors" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
        删除构件
      <% end %>
      <%= link_to project_path(@project), class: "w-full flex items-center justify-center px-4 py-2 border border-stone-300 text-stone-600 text-sm rounded-md hover:bg-stone-50 transition-colors" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        返回项目
      <% end %>
    </div>
  </div>

  <div class="col-span-12 lg:col-span-6 space-y-4">
    <div class="bg-white rounded-lg shadow-sm border border-stone-200">
      <div class="px-5 py-3 border-b border-stone-200 flex items-center justify-between">
        <h2 class="text-base font-semibold text-stone-800">缺损清单</h2>
        <%= link_to new_project_component_defect_path(@project, @component), class: "inline-flex items-center px-3 py-1.5 text-xs font-medium bg-amber-600 text-white rounded-md hover:bg-amber-700 transition-colors" do %>
          <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          新增缺损
        <% end %>
      </div>
      <div class="divide-y divide-stone-100">
        <% if @defects.any? %>
          <% @defects.each do |defect| %>
            <div class="px-5 py-3 hover:bg-stone-50 transition-colors">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-sm font-medium text-stone-800"><%= defect.defect_type %></span>
                    <% severity_color = case defect.severity
                      when "轻微" then "bg-stone-100 text-stone-600"
                      when "中等" then "bg-yellow-100 text-yellow-700"
                      when "严重" then "bg-orange-100 text-orange-700"
                      when "致命" then "bg-red-100 text-red-700"
                      else "bg-stone-100 text-stone-600"
                    end %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= severity_color %>">
                      <%= defect.severity %>
                    </span>
                    <% if defect.repaired? %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700">
                        已修复
                      </span>
                    <% end %>
                  </div>
                  <div class="text-xs text-stone-500">
                    位置：<%= defect.location_on_component.presence || "未记录" %>
                  </div>
                  <% if defect.description.present? %>
                    <p class="text-sm text-stone-600 mt-1 line-clamp-2"><%= defect.description %></p>
                  <% end %>
                </div>
                <div class="flex items-center space-x-2 ml-4">
                  <%= link_to "编辑", edit_project_component_defect_path(@project, @component, defect), class: "text-xs text-stone-500 hover:text-stone-700" %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="py-8 text-center text-stone-400 text-sm">
            <svg class="w-10 h-10 mx-auto mb-2 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            暂无缺损记录
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-stone-200">
      <div class="px-5 py-3 border-b border-stone-200 flex items-center justify-between">
        <h2 class="text-base font-semibold text-stone-800">复装核对</h2>
        <button onclick="document.getElementById('reassembly-form').classList.toggle('hidden')" class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-stone-700 text-white rounded-md hover:bg-stone-800 transition-colors">
          <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          新增核对
        </button>
      </div>

      <div id="reassembly-form" class="hidden px-5 py-4 border-b border-stone-200 bg-stone-50">
        <%= form_with url: reassembly_check_project_component_path(@project, @component), method: :post, local: true, class: "space-y-3" do |f| %>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <%= f.label :checked_by, "核对人", class: "block text-xs font-medium text-stone-600 mb-1" %>
              <%= f.text_field :checked_by, class: "w-full px-3 py-1.5 text-sm border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
            </div>
            <div>
              <%= f.label :result, "核对结果", class: "block text-xs font-medium text-stone-600 mb-1" %>
              <%= f.select :result, ReassemblyRecord::RESULTS, { include_blank: "请选择" }, class: "w-full px-3 py-1.5 text-sm border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
            </div>
          </div>
          <div>
            <%= f.label :notes, "备注", class: "block text-xs font-medium text-stone-600 mb-1" %>
            <%= f.text_area :notes, rows: 2, class: "w-full px-3 py-1.5 text-sm border border-stone-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" %>
          </div>
          <div class="flex justify-end space-x-2">
            <button type="button" onclick="document.getElementById('reassembly-form').classList.add('hidden')" class="px-3 py-1.5 text-xs border border-stone-300 text-stone-600 rounded-md hover:bg-stone-100 transition-colors">取消</button>
            <%= f.submit "提交", class: "px-3 py-1.5 text-xs bg-amber-600 text-white rounded-md hover:bg-amber-700 transition-colors cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <div class="divide-y divide-stone-100">
        <% if @reassembly_records.any? %>
          <% @reassembly_records.each do |record| %>
            <div class="px-5 py-3 hover:bg-stone-50 transition-colors">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-sm font-medium text-stone-700"><%= record.checked_by.presence || "未记录核对人" %></span>
                    <% result_color = case record.result
                      when "一致" then "bg-green-100 text-green-700"
                      when "位置偏差" then "bg-yellow-100 text-yellow-700"
                      when "需调整" then "bg-orange-100 text-orange-700"
                      when "异常" then "bg-red-100 text-red-700"
                      else "bg-stone-100 text-stone-600"
                    end %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= result_color %>">
                      <%= record.result %>
                    </span>
                  </div>
                  <div class="text-xs text-stone-500">
                    <%= record.checked_at&.strftime("%Y-%m-%d %H:%M") %>
                    <% if record.position_deviation.present? %>
                      · 偏差：<%= record.position_deviation %>
                    <% end %>
                  </div>
                  <% if record.notes.present? %>
                    <p class="text-sm text-stone-600 mt-1"><%= record.notes %></p>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="py-8 text-center text-stone-400 text-sm">
            <svg class="w-10 h-10 mx-auto mb-2 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
            </svg>
            暂无复装核对记录
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-span-12 lg:col-span-3">
    <div class="bg-white rounded-lg shadow-sm border border-stone-200">
      <div class="px-5 py-3 border-b border-stone-200">
        <h2 class="text-base font-semibold text-stone-800">版本/批次历史</h2>
      </div>
      <div class="p-4">
        <% if @versions.any? %>
          <ol class="relative border-l border-stone-200 ml-2">
            <% @versions.each do |version| %>
              <li class="mb-4 ml-4">
                <div class="absolute w-3 h-3 bg-amber-500 rounded-full -left-1.5 border-2 border-white"></div>
                <div class="bg-stone-50 rounded-lg p-3 hover:bg-stone-100 transition-colors">
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-sm font-semibold text-stone-800">v<%= version.version_number %></span>
                    <%= button_to "回滚", rollback_project_component_path(@project, @component, version_number: version.version_number), method: :post, form: { data: { turbo_confirm: "确定要回滚到版本 v#{version.version_number} 吗？" } }, class: "text-xs text-amber-600 hover:text-amber-800 cursor-pointer" %>
                  </div>
                  <div class="text-xs text-stone-500 mb-2">
                    <%= version.recorded_at&.strftime("%Y-%m-%d %H:%M") %>
                  </div>
                  <div class="text-xs text-stone-600 mb-1">
                    <span class="text-stone-500">事件：</span><%= version.event_type %>
                  </div>
                  <div class="text-xs text-stone-600 mb-1">
                    <span class="text-stone-500">操作人：</span><%= version.operator.presence || "系统" %>
                  </div>
                  <% if version.changed_fields.present? && version.changed_fields.any? %>
                    <div class="mt-2">
                      <span class="text-xs text-stone-500">变更字段：</span>
                      <div class="flex flex-wrap gap-1 mt-1">
                        <% version.changed_fields.each do |field| %>
                          <span class="inline-flex px-1.5 py-0.5 bg-amber-100 text-amber-700 text-xs rounded">
                            <%= field %>
                          </span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                  <% if version.notes.present? %>
                    <p class="text-xs text-stone-500 mt-2"><%= version.notes %></p>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ol>
        <% else %>
          <div class="py-8 text-center text-stone-400 text-sm">
            <svg class="w-10 h-10 mx-auto mb-2 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            暂无版本记录
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
