<% content_for :title, "编辑构件 - #{@component.full_code}" %>

<div class="mb-6">
  <nav class="text-sm text-stone-500 mb-4">
    <%= link_to "项目台账", projects_path, class: "hover:text-amber-600" %>
    <span class="mx-2">/</span>
    <%= link_to @project.name, project_path(@project), class: "hover:text-amber-600" %>
    <span class="mx-2">/</span>
    <%= link_to "构件列表", project_components_path(@project), class: "hover:text-amber-600" %>
    <span class="mx-2">/</span>
    <%= link_to @component.full_code, project_component_path(@project, @component), class: "hover:text-amber-600" %>
    <span class="mx-2">/</span>
    <span class="text-stone-700">编辑</span>
  </nav>
  <h1 class="text-2xl font-bold text-stone-800">编辑构件</h1>
  <p class="text-stone-500 mt-1">修改构件「<%= @component.full_code %>」的信息</p>
</div>

<div class="bg-stone-50 rounded-lg border border-stone-200 p-6">
  <%= render "form", component: @component %>
</div>
