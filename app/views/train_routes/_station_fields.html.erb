<div class="station-fields border rounded p-3 mb-3 bg-light">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5>站点 #<%= f.object.order || 1 %></h5>
    <button type="button" onclick="removeStation(this)" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
  </div>
  <div class="row g-3">
    <div class="col-md-2">
      <label>序号</label>
      <%= f.number_field :order, class: 'form-control', required: true %>
    </div>
    <div class="col-md-3">
      <label>站点名称 *</label>
      <%= f.text_field :name, class: 'form-control', required: true %>
    </div>
    <div class="col-md-2">
      <label>到达时间</label>
      <%= f.time_field :arrival_time, class: 'form-control' %>
    </div>
    <div class="col-md-2">
      <label>出发时间</label>
      <%= f.time_field :departure_time, class: 'form-control' %>
    </div>
    <div class="col-md-1">
      <label>停站时长(分)</label>
      <%= f.number_field :stop_duration, class: 'form-control', min: 0 %>
    </div>
    <div class="col-md-1">
      <label>X坐标</label>
      <%= f.number_field :x_coordinate, class: 'form-control' %>
    </div>
    <div class="col-md-1">
      <label>Y坐标</label>
      <%= f.number_field :y_coordinate, class: 'form-control' %>
    </div>
  </div>
  <%= f.hidden_field :_destroy %>
</div>