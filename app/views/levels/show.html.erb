<% content_for :title, "第#{@level.level_number}关：#{@level.name} - 河谷水磨坊" %>

<div class="card max-w-3xl mx-auto">
  <div class="mb-6">
    <%= link_to '← 返回关卡列表', levels_path, class: 'text-wood-600 hover:text-wood-800 font-medium' %>
  </div>

  <div class="text-center mb-8">
    <span class="inline-block px-4 py-1 rounded-full text-sm font-semibold mb-3
      <%= case @level.difficulty
          when 'easy' then 'bg-emerald-100 text-emerald-700'
          when 'medium' then 'bg-yellow-100 text-yellow-700'
          when 'hard' then 'bg-orange-100 text-orange-700'
          when 'expert' then 'bg-red-100 text-red-700'
          else 'bg-gear-100 text-gear-700'
          end %>">
      <%= { 'easy' => '简单', 'medium' => '中等', 'hard' => '困难', 'expert' => '专家' }[@level.difficulty] || @level.difficulty %>
    </span>
    <h1 class="text-3xl font-bold text-wood-800 mb-2">第 <%= @level.level_number %> 关：<%= @level.name %></h1>
    <p class="text-gear-600 text-lg"><%= @level.description %></p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="bg-water-50 border border-water-200 rounded-xl p-4 text-center">
      <div class="text-3xl mb-2">🎯</div>
      <div class="text-sm text-water-600">目标转速</div>
      <div class="text-2xl font-bold text-water-800"><%= @level.target_rpm %> RPM</div>
      <div class="text-xs text-water-500 mt-1">(±<%= @level.rpm_tolerance %>)</div>
    </div>
    <div class="bg-wood-50 border border-wood-200 rounded-xl p-4 text-center">
      <div class="text-3xl mb-2">💧</div>
      <div class="text-sm text-wood-600">水轮动力</div>
      <div class="text-2xl font-bold text-wood-800"><%= @level.water_force %>x</div>
      <div class="text-xs text-wood-500 mt-1">基础 60 RPM</div>
    </div>
    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-center">
      <div class="text-3xl mb-2">⏱️</div>
      <div class="text-sm text-yellow-600">时间限制</div>
      <div class="text-2xl font-bold text-yellow-800"><%= @level.time_limit %> 秒</div>
    </div>
  </div>

  <div class="bg-gear-50 border border-gear-200 rounded-xl p-4 mb-8">
    <h3 class="font-semibold text-gear-800 mb-3">⭐ 星级条件</h3>
    <div class="space-y-2 text-sm">
      <div class="flex items-center gap-2">
        <span class="text-yellow-500 text-xl">★★★</span>
        <span class="text-gear-700">≤ <%= @level.three_star_moves %> 步，时间 ≤ 50%，转速误差 ≤ 30%</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-yellow-500 text-xl">★★</span>
        <span class="text-gear-700">≤ <%= @level.two_star_moves %> 步，时间 ≤ 80%</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-yellow-500 text-xl">★</span>
        <span class="text-gear-700">达成目标即可</span>
      </div>
    </div>
  </div>

  <% if @best_stars > 0 %>
    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 mb-8">
      <h3 class="font-semibold text-emerald-800 mb-2">🏆 你的最佳成绩</h3>
      <div class="flex items-center gap-4">
        <div class="flex gap-0.5">
          <% 3.times do |i| %>
            <span class="text-3xl <%= i < @best_stars ? 'star-gold' : 'star-gray' %>">★</span>
          <% end %>
        </div>
        <div class="text-2xl font-bold text-emerald-700"><%= @best_score %> 分</div>
      </div>
    </div>
  <% end %>

  <div class="text-center">
    <%= button_to '开始游戏', level_game_sessions_path(@level), method: :post, class: 'btn-primary text-xl px-12 py-4' %>
  </div>
</div>
