<% content_for :title, "#{@player.name} - 玩家档案" %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  <div class="lg:col-span-1">
    <div class="bg-slate-800/60 backdrop-blur rounded-xl p-6 border border-purple-500/20 sticky top-24">
      <div class="text-center mb-6">
        <div class="w-24 h-24 mx-auto bg-gradient-to-br from-cyan-400 to-purple-500 rounded-full flex items-center justify-center text-4xl mb-4">
          👤
        </div>
        <h2 class="text-2xl font-bold mb-1"><%= @player.name %></h2>
        <p class="text-slate-400 text-sm">星港调度员</p>
      </div>

      <div class="space-y-4">
        <div class="flex items-center justify-between p-3 bg-slate-700/50 rounded-lg">
          <span class="text-slate-400">🏆 胜利场次</span>
          <span class="text-xl font-bold text-green-400"><%= @player.wins %></span>
        </div>
        <div class="flex items-center justify-between p-3 bg-slate-700/50 rounded-lg">
          <span class="text-slate-400">🎮 总游戏场次</span>
          <span class="text-xl font-bold text-purple-400"><%= @player.total_games %></span>
        </div>
        <div class="flex items-center justify-between p-3 bg-slate-700/50 rounded-lg">
          <span class="text-slate-400">📈 胜率</span>
          <span class="text-xl font-bold text-cyan-400">
            <%= @player.total_games > 0 ? (@player.wins.to_f / @player.total_games * 100).round(1) : 0 %>%
          </span>
        </div>
        <div class="flex items-center justify-between p-3 bg-slate-700/50 rounded-lg">
          <span class="text-slate-400">⭐ 历史最高分</span>
          <span class="text-xl font-bold text-yellow-400"><%= number_with_delimiter(@player.current_score) %></span>
        </div>
      </div>

      <div class="mt-6 pt-6 border-t border-slate-700/50">
        <%= link_to "选择关卡", levels_path,
          class: "w-full block text-center py-3 rounded-lg bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-400 hover:to-purple-400 font-medium transition" %>
      </div>
    </div>
  </div>

  <div class="lg:col-span-2 space-y-8">
    <div>
      <h3 class="text-2xl font-bold mb-4 flex items-center gap-2">
        <span>🏆</span> 最佳成绩
      </h3>
      <% if @top_scores.any? %>
        <div class="bg-slate-800/60 backdrop-blur rounded-xl border border-purple-500/20 overflow-hidden">
          <table class="w-full">
            <thead class="bg-slate-700/50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">排名</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">关卡</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">得分</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">难度</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">完成时间</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-700/50">
              <% @top_scores.each_with_index do |session, index| %>
                <tr class="hover:bg-slate-700/30 transition">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="<%= index < 3 ? 'text-yellow-400 font-bold' : 'text-slate-400' %>">
                      <%= index == 0 ? '🥇' : index == 1 ? '🥈' : index == 2 ? '🥉' : "##{index + 1}" %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap"><%= session.level.name %></td>
                  <td class="px-6 py-4 whitespace-nowrap font-mono font-bold text-yellow-400"><%= number_with_delimiter(session.score) %></td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 py-1 rounded text-xs <%= difficulty_class(session.level.difficulty) %>">
                      <%= difficulty_label(session.level.difficulty) %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-slate-400 text-sm"><%= session.finished_at&.strftime('%Y-%m-%d %H:%M') %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="bg-slate-800/60 backdrop-blur rounded-xl p-12 border border-purple-500/20 text-center">
          <div class="text-5xl mb-4">🎮</div>
          <p class="text-slate-400 mb-4">还没有游戏记录</p>
          <%= link_to "开始第一局", levels_path,
            class: "px-6 py-3 rounded-lg bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-400 hover:to-purple-400 font-medium transition inline-block" %>
        </div>
      <% end %>
    </div>

    <div>
      <h3 class="text-2xl font-bold mb-4 flex items-center gap-2">
        <span>📋</span> 最近游戏
      </h3>
      <% if @game_sessions.any? %>
        <div class="bg-slate-800/60 backdrop-blur rounded-xl border border-purple-500/20 overflow-hidden">
          <table class="w-full">
            <thead class="bg-slate-700/50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">关卡</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">状态</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">得分</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">时间</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">操作</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-700/50">
              <% @game_sessions.each do |session| %>
                <tr class="hover:bg-slate-700/30 transition">
                  <td class="px-6 py-4 whitespace-nowrap"><%= session.level.name %></td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 py-1 rounded text-xs <%= status_class(session.status) %>">
                      <%= status_label(session.status) %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap font-mono"><%= number_with_delimiter(session.score) %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-slate-400 text-sm"><%= session.finished_at&.strftime('%m-%d %H:%M') %></td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <%= link_to "查看", game_session_path(session), class: "text-cyan-400 hover:text-cyan-300 text-sm" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="bg-slate-800/60 backdrop-blur rounded-xl p-8 border border-purple-500/20 text-center text-slate-400">
          暂无游戏记录
        </div>
      <% end %>
    </div>
  </div>
</div>
