<% content_for(:title, "按车队统计 - 复盘分析") %>

<div class="min-h-screen bg-gray-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="mb-6">
      <div class="flex items-center space-x-4 mb-2">
        <%= link_to '← 返回复盘分析', analytics_path(tab: 'by_fleet'), class: 'text-sm text-blue-600 hover:text-blue-800' %>
      </div>
      <h1 class="text-3xl font-bold text-gray-900">按车队统计</h1>
      <p class="mt-1 text-sm text-gray-500">各车队运营数据详细统计</p>
    </div>

    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-900">车队统计列表</h2>
        <span class="text-sm text-gray-500">共 <%= @by_fleet.size %> 个车队</span>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">车队名</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">车队编号</th>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">车辆数</th>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">出车次数</th>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">维修次数</th>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">总停用天数</th>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">平均油耗 (L/100km)</th>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">平均单车载客率</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @by_fleet.each_with_index do |fleet, index| %>
              <tr class="<%= index.even? ? 'bg-white' : 'bg-gray-50' %> hover:bg-blue-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-10 w-10 bg-blue-100 rounded-full flex items-center justify-center">
                      <svg class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                      </svg>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900"><%= fleet.name %></div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  #<%= fleet.id %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                    <%= fleet.vehicle_count %> 辆
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <div class="text-sm font-semibold text-gray-900"><%= fleet.trip_count %></div>
                  <div class="text-xs text-gray-500">次</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <div class="text-sm font-semibold <%= fleet.repair_count.to_i > 5 ? 'text-red-600' : 'text-gray-900' %>">
                    <%= fleet.repair_count %>
                  </div>
                  <div class="text-xs text-gray-500">次</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <% decommission = fleet.total_decommission_days.to_i %>
                  <% if decommission > 30 %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      <%= decommission %> 天
                    </span>
                  <% elsif decommission > 10 %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                      <%= decommission %> 天
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      <%= decommission %> 天
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <% avg_fuel = fleet.avg_fuel_consumption.to_f.round(2) %>
                  <% if avg_fuel > 0 %>
                    <div class="flex items-center justify-center">
                      <% if avg_fuel > 25 %>
                        <svg class="h-4 w-4 text-orange-500 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                      <% end %>
                      <span class="text-sm font-semibold <%= avg_fuel > 25 ? 'text-orange-600' : 'text-green-600' %>">
                        <%= avg_fuel %>
                      </span>
                    </div>
                  <% else %>
                    <span class="text-sm text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <% utilization_rate = fleet.vehicle_count.to_i > 0 ? (fleet.trip_count.to_f / fleet.vehicle_count.to_i / 30.0 * 100).round(1) : 0 %>
                  <% utilization_rate = [utilization_rate, 100].min %>
                  <div class="flex items-center justify-center">
                    <div class="w-16 bg-gray-200 rounded-full h-2 mr-2">
                      <div class="h-2 rounded-full <%= utilization_rate >= 80 ? 'bg-green-500' : utilization_rate >= 50 ? 'bg-blue-500' : 'bg-yellow-500' %>" style="width: <%= utilization_rate %>%"></div>
                    </div>
                    <span class="text-xs font-medium text-gray-600"><%= utilization_rate %>%</span>
                  </div>
                </td>
              </tr>
            <% end %>
            <% if @by_fleet.empty? %>
              <tr>
                <td colspan="8" class="px-6 py-12 text-center">
                  <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                  <h3 class="mt-2 text-sm font-medium text-gray-900">暂无数据</h3>
                  <p class="mt-1 text-sm text-gray-500">目前没有车队统计数据</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
