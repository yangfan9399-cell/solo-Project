<% content_for(:title, "按异常原因统计 - 复盘分析") %>

<div class="min-h-screen bg-gray-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="mb-6">
      <div class="flex items-center space-x-4 mb-2">
        <%= link_to '← 返回复盘分析', analytics_path(tab: 'by_reason'), class: 'text-sm text-blue-600 hover:text-blue-800' %>
      </div>
      <h1 class="text-3xl font-bold text-gray-900">按异常原因统计</h1>
      <p class="mt-1 text-sm text-gray-500">维修异常原因详细统计与分析</p>
    </div>

    <% total_count = @by_reason.sum { |r| r.reason_count.to_i } %>

    <% if total_count > 0 %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow-sm p-6">
          <p class="text-sm font-medium text-gray-500">异常原因总数</p>
          <p class="text-3xl font-bold text-gray-900 mt-1"><%= @by_reason.size %></p>
          <p class="text-xs text-gray-500 mt-1">种不同类型</p>
        </div>
        <div class="bg-white rounded-lg shadow-sm p-6">
          <p class="text-sm font-medium text-gray-500">异常发生总次数</p>
          <p class="text-3xl font-bold text-red-600 mt-1"><%= total_count %></p>
          <p class="text-xs text-gray-500 mt-1">次记录</p>
        </div>
        <div class="bg-white rounded-lg shadow-sm p-6">
          <p class="text-sm font-medium text-gray-500">最高频原因占比</p>
          <% top_reason = @by_reason.first %>
          <p class="text-3xl font-bold text-orange-600 mt-1">
            <%= top_reason ? (top_reason.reason_count.to_f / total_count * 100).round(1) : 0 %>%
          </p>
          <p class="text-xs text-gray-500 mt-1 truncate"><%= top_reason&.abnormal_reason %></p>
        </div>
      </div>
    <% end %>

    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">异常原因排行</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-16">排名</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">异常原因</th>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">发生次数</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-64">占比分布</th>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">占比</th>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">平均停用天数</th>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">最长停用天数</th>
              <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">影响评估</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @by_reason.each_with_index do |reason, index| %>
              <% percentage = total_count > 0 ? (reason.reason_count.to_f / total_count * 100).round(1) : 0 %>
              <% reason_records = RepairRecord.where(abnormal_reason: reason.abnormal_reason).where.not(decommission_days: nil) %>
              <% max_days = reason_records.maximum(:decommission_days).to_i %>
              <% avg_days = reason.avg_decommission_days.to_f.round(1) %>
              <% total_impact = reason.reason_count.to_i * avg_days %>

              <% rank_colors = [
                'bg-yellow-100 text-yellow-800 border-yellow-400',
                'bg-gray-100 text-gray-800 border-gray-400',
                'bg-orange-100 text-orange-800 border-orange-400'
              ] %>
              <% rank_color = index < 3 ? rank_colors[index] : 'bg-white text-gray-600 border-gray-200' %>
              <% rank_badge = index == 0 ? '🥇' : index == 1 ? '🥈' : index == 2 ? '🥉' : "##{index + 1}" %>

              <tr class="<%= index.even? ? 'bg-white' : 'bg-gray-50' %> hover:bg-red-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <span class="inline-flex items-center justify-center h-8 w-8 rounded-lg border <%= rank_color %> font-bold text-sm">
                    <%= rank_badge %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-8 w-8 bg-red-50 rounded-lg flex items-center justify-center mr-3">
                      <svg class="h-4 w-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                      </svg>
                    </div>
                    <span class="text-sm font-medium text-gray-900"><%= reason.abnormal_reason %></span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold bg-red-100 text-red-800">
                    <%= reason.reason_count %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="w-full bg-gray-200 rounded-full h-4 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 <%= percentage > 30 ? 'bg-red-500' : percentage > 15 ? 'bg-orange-500' : percentage > 5 ? 'bg-yellow-500' : 'bg-blue-500' %>" style="width: <%= percentage %>%"></div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <span class="text-sm font-bold <%= percentage > 30 ? 'text-red-600' : percentage > 15 ? 'text-orange-600' : 'text-gray-900' %>">
                    <%= percentage %>%
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <span class="text-sm font-semibold <%= avg_days > 7 ? 'text-red-600' : avg_days > 3 ? 'text-yellow-600' : 'text-green-600' %>">
                    <%= avg_days %> 天
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <% if max_days > 0 %>
                    <span class="text-sm font-semibold <%= max_days > 15 ? 'text-red-700' : max_days > 7 ? 'text-red-600' : 'text-gray-900' %>">
                      <%= max_days %> 天
                    </span>
                  <% else %>
                    <span class="text-sm text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <% if total_impact > 100 %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      高危
                    </span>
                  <% elsif total_impact > 30 %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                      中危
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      低危
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if @by_reason.empty? %>
              <tr>
                <td colspan="8" class="px-6 py-12 text-center">
                  <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <h3 class="mt-2 text-sm font-medium text-gray-900">暂无异常数据</h3>
                  <p class="mt-1 text-sm text-gray-500">继续保持，目前没有异常原因记录</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
