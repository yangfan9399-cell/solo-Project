<% provide :page_title, "复盘分析" %>

<div class="flex items-center justify-between mb-6">
  <div class="flex items-center space-x-4">
    <%= form_with url: analytics_index_path, method: :get, local: true, class: "flex items-center space-x-2" do %>
      <input type="date"
          name="start_date"
          value="<%= params[:start_date] %>"
          class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent">
      <span class="text-gray-400">至</span>
      <input type="date"
          name="end_date"
          value="<%= params[:end_date] %>"
          class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent">
      <%= submit_tag "筛选", class: "px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors" %>
    <% end %>
  </div>

  <button onclick="exportReport()" class="px-4 py-2 bg-gradient-to-r from-blue-900 to-blue-800 text-white rounded-lg hover:from-blue-800 hover:to-blue-700 transition-all flex items-center space-x-2">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
    </svg>
    <span>导出报告</span>
  </button>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
  <div class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">授权申请总数</p>
        <p class="text-3xl font-bold text-gray-800 mt-1"><%= @industry_stats.values.sum %></p>
      </div>
      <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">场景超范围</p>
        <p class="text-3xl font-bold text-red-600 mt-1"><%= @exception_stats[:scenario_out_of_range] %></p>
      </div>
      <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">期限冲突</p>
        <p class="text-3xl font-bold text-orange-600 mt-1"><%= @exception_stats[:date_conflict] %></p>
      </div>
      <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">结算争议</p>
        <p class="text-3xl font-bold text-purple-600 mt-1"><%= @exception_stats[:settlement_dispute] %></p>
      </div>
      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
      </div>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-white rounded-xl shadow-sm p-6">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">按客户行业分布</h3>
    <% if @industry_stats.any? %>
      <div class="space-y-4">
        <% @industry_stats.sort_by { |_, count| -count }.each do |industry, count| %>
          <div>
            <div class="flex justify-between text-sm mb-1">
              <span class="text-gray-700"><%= industry || "未分类" %></span>
              <span class="font-medium text-gray-900"><%= count %> 个</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-blue-500 h-2 rounded-full" style="width: <%= (count.to_f / @industry_stats.values.sum * 100).round %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8 text-gray-500">
        <p>暂无数据</p>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">异常原因分析</h3>
    <div class="space-y-4">
      <div class="flex items-center justify-between p-4 bg-red-50 rounded-lg">
        <div class="flex items-center space-x-3">
          <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <div>
            <p class="text-sm font-medium text-gray-800">场景超范围</p>
            <p class="text-xs text-gray-500">使用场景超出曲目授权范围</p>
          </div>
        </div>
        <span class="text-2xl font-bold text-red-600"><%= @exception_stats[:scenario_out_of_range] %></span>
      </div>

      <div class="flex items-center justify-between p-4 bg-orange-50 rounded-lg">
        <div class="flex items-center space-x-3">
          <svg class="w-8 h-8 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div>
            <p class="text-sm font-medium text-gray-800">授权期限冲突</p>
            <p class="text-xs text-gray-500">申请期限与现有授权重叠</p>
          </div>
        </div>
        <span class="text-2xl font-bold text-orange-600"><%= @exception_stats[:date_conflict] %></span>
      </div>

      <div class="flex items-center justify-between p-4 bg-purple-50 rounded-lg">
        <div class="flex items-center space-x-3">
          <svg class="w-8 h-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <div>
            <p class="text-sm font-medium text-gray-800">结算比例争议</p>
            <p class="text-xs text-gray-500">版权方与代理商分成比例分歧</p>
          </div>
        </div>
        <span class="text-2xl font-bold text-purple-600"><%= @exception_stats[:settlement_dispute] %></span>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">热门曲目 TOP 10</h3>
    <% if @track_stats.any? %>
      <div class="space-y-3">
        <% @track_stats.sort_by { |_, count| -count }.first(10).each_with_index do |(track_id, count), index| %>
          <% track = Track.find_by(id: track_id) %>
          <% if track %>
            <div class="flex items-center space-x-4 p-3 bg-gray-50 rounded-lg">
              <span class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-white text-sm font-bold">
                <%= index + 1 %>
              </span>
              <div class="flex-1">
                <p class="text-sm font-medium text-gray-800"><%= track.title %></p>
                <p class="text-xs text-gray-500"><%= track.artist %></p>
              </div>
              <span class="text-sm font-medium text-gray-600"><%= count %> 次授权</span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8 text-gray-500">
        <p>暂无数据</p>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">授权周期统计</h3>
    <div class="grid grid-cols-3 gap-4">
      <div class="text-center p-4 bg-blue-50 rounded-lg">
        <p class="text-sm text-gray-500">平均周期</p>
        <p class="text-2xl font-bold text-blue-600 mt-2">
          <%= @cycle_stats[:avg_cycle_days]&.round || 0 %>
        </p>
        <p class="text-xs text-gray-500">天</p>
      </div>
      <div class="text-center p-4 bg-green-50 rounded-lg">
        <p class="text-sm text-gray-500">最短周期</p>
        <p class="text-2xl font-bold text-green-600 mt-2">
          <%= @cycle_stats[:min_cycle_days] || 0 %>
        </p>
        <p class="text-xs text-gray-500">天</p>
      </div>
      <div class="text-center p-4 bg-red-50 rounded-lg">
        <p class="text-sm text-gray-500">最长周期</p>
        <p class="text-2xl font-bold text-red-600 mt-2">
          <%= @cycle_stats[:max_cycle_days] || 0 %>
        </p>
        <p class="text-xs text-gray-500">天</p>
      </div>
    </div>
  </div>
</div>

<script>
function exportReport() {
  alert('报告导出功能开发中...');
}
</script>