<h1 class="mb-4">授权管理</h1>

<%= link_to '添加授权', new_license_path, class: 'btn btn-primary mb-4' %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>素材名称</th>
      <th>授权方</th>
      <th>授权类型</th>
      <th>到期日期</th>
      <th>状态</th>
      <th>风险原因</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @licenses.each do |license| %>
      <tr>
        <td><%= link_to license.material.name, material_path(license.material) %></td>
        <td><%= license.licensor %></td>
        <td><%= license.license_type == 'exclusive' ? '独家授权' : '非独家授权' %></td>
        <td><%= license.end_date.strftime('%Y-%m-%d') %></td>
        <td><%= status_badge(license.status) %></td>
        <td><%= risk_reason_label(license.risk_reason) %></td>
        <td>
          <%= link_to '详情', license_path(license), class: 'btn btn-sm btn-primary' %>
          <%= link_to '编辑', edit_license_path(license), class: 'btn btn-sm btn-secondary' %>
          <% if license.status == 'expired' %>
            <%= button_to '续约', renew_license_path(license), method: :post, class: 'btn btn-sm btn-success' %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @licenses.empty? %>
  <p class="text-muted">暂无授权</p>
<% end %>