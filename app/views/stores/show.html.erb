<div class="space-y-6">
  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold"><%= @store.name %></h1>
        <p class="text-gray-500"><%= @store.code %> - <%= @store.region.name %></p>
      </div>
      <span class="px-4 py-2 text-sm rounded-full <%= status_class(@store.status) %>">
        <%= @store.status_i18n %>
      </span>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold mb-4">门店批次</h2>
    <% if @batches.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead>
          <tr>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">批次号</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">物料</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">数量</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">有效期</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @batches.each do |batch| %>
            <tr>
              <td class="px-4 py-2"><%= link_to batch.batch_number, batch, class: "text-blue-600 hover:underline" %></td>
              <td class="px-4 py-2"><%= batch.material.name %></td>
              <td class="px-4 py-2"><%= batch.quantity %><%= batch.material.unit %></td>
              <td class="px-4 py-2"><%= batch.expiry_date %></td>
              <td class="px-4 py-2">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(batch.status) %>">
                  <%= batch.status_i18n %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gray-500 text-sm">暂无批次</p>
    <% end %>
  </div>
</div>
