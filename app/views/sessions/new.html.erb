<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h3 class="text-center">登录系统</h3>
      </div>
      <div class="card-body">
        <%= form_tag login_path do %>
          <div class="form-group">
            <label>用户名</label>
            <%= text_field_tag :username, nil, class: "form-control", placeholder: "请输入用户名", required: true %>
          </div>
          <div class="form-group">
            <label>密码</label>
            <%= password_field_tag :password, nil, class: "form-control", placeholder: "请输入密码", required: true %>
          </div>
          <div class="form-group">
            <%= submit_tag "登录", class: "btn btn-primary btn-block" %>
          </div>
        <% end %>
      </div>
      <div class="card-footer text-center">
        <p class="text-muted">影像中心胶片报告管理系统</p>
      </div>
    </div>
  </div>
</div>