<% content_for :title, '选择玩家档案 - 河谷水磨坊' %>

<div class="min-h-[80vh] flex items-center justify-center">
  <div class="card max-w-2xl w-full">
    <div class="text-center mb-8">
      <div class="text-6xl mb-4">⚙️💧</div>
      <h1 class="text-4xl font-bold text-wood-800 mb-2">河谷水磨坊</h1>
      <p class="text-gear-500 text-lg">齿轮传动益智游戏</p>
    </div>

    <div class="mb-8">
      <h2 class="text-2xl font-semibold text-wood-700 mb-4">选择或创建玩家档案</h2>

      <% if @players.any? %>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
          <% @players.each do |player| %>
            <%= form_tag session_path, method: :post, class: 'block' do %>
              <%= hidden_field_tag :player_name, player.name %>
              <button type="submit" class="w-full p-4 bg-wood-50 hover:bg-wood-100 border-2 border-wood-200 hover:border-wood-400 rounded-xl transition-all text-left group">
                <div class="text-3xl mb-2">👤</div>
                <div class="font-semibold text-wood-800 group-hover:text-wood-600 truncate"><%= player.name %></div>
                <div class="text-sm text-gear-500 mt-1">
                  <span>⭐ <%= player.total_stars %></span>
                  <span class="ml-2">🏆 <%= player.total_score %></span>
                </div>
              </button>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <div class="border-t-2 border-wood-200 pt-6">
        <p class="text-gear-600 mb-3">或输入新玩家名称：</p>
        <%= form_tag session_path, method: :post, class: 'flex gap-3' do %>
          <%= text_field_tag :player_name, nil, placeholder: '输入玩家名称...', class: 'flex-1 px-4 py-3 border-2 border-wood-300 rounded-lg focus:outline-none focus:border-wood-500 text-lg' %>
          <button type="submit" class="btn-primary">
            开始游戏
          </button>
        <% end %>
      </div>
    </div>

    <div class="bg-water-50 border border-water-200 rounded-xl p-4">
      <h3 class="font-semibold text-water-800 mb-2">🎮 游戏玩法</h3>
      <ul class="text-sm text-water-700 space-y-1">
        <li>• 利用水轮产生的动力，通过齿轮传动带动目标齿轮</li>
        <li>• 拖动齿轮到合适位置，让它们互相咬合</li>
        <li>• 调整齿轮组合，使目标齿轮的转速接近目标值</li>
        <li>• 用更少的步数、更短的时间获得更高星级！</li>
      </ul>
    </div>
  </div>
</div>
