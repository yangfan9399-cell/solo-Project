<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">新建访客</h2>

  <%= form_with(model: @visitor, local: true, class: "space-y-6") do |form| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :name, "姓名", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :name, placeholder: "请输入姓名",
          class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3" %>
      </div>

      <div>
        <%= form.label :phone, "电话", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :phone, placeholder: "请输入电话号码",
          class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3" %>
      </div>

      <div>
        <%= form.label :company, "公司", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :company, placeholder: "请输入公司名称",
          class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3" %>
      </div>

      <div>
        <%= form.label :id_card_number, "身份证号", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :id_card_number, placeholder: "请输入身份证号",
          class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3" %>
      </div>

      <div>
        <%= form.label :email, "邮箱", class: "block text-sm font-medium text-gray-700" %>
        <%= form.email_field :email, placeholder: "请输入邮箱",
          class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3" %>
      </div>
    </div>

    <div class="flex justify-end gap-4">
      <%= link_to '取消', visitors_path, class: "bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600" %>
      <%= form.submit '创建', class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
    </div>
  <% end %>
</div>
