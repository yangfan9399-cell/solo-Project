<div class="bg-white shadow rounded-lg p-6">
  <div class="mb-6 flex justify-between items-center">
    <h2 class="text-2xl font-bold text-gray-900">预约详情</h2>
    <div class="flex gap-2">
      <% if @reservation.pending? %>
        <%= button_to '确认预约', confirm_reservation_path(@reservation), method: :post, class: "bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700" %>
        <%= button_to '拒绝预约', reject_reservation_path(@reservation), method: :post, class: "bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700" %>
      <% end %>
      <%= link_to '返回', reservations_path, class: "bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="border p-4 rounded-lg">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">访客信息</h3>
      <dl class="space-y-2">
        <div class="flex">
          <dt class="w-24 text-gray-500">姓名:</dt>
          <dd class="text-gray-900"><%= @reservation.visitor.name %></dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">电话:</dt>
          <dd class="text-gray-900"><%= @reservation.visitor.phone %></dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">公司:</dt>
          <dd class="text-gray-900"><%= @reservation.visitor.company || 'N/A' %></dd>
        </div>
      </dl>
    </div>

    <div class="border p-4 rounded-lg">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">车辆信息</h3>
      <dl class="space-y-2">
        <div class="flex">
          <dt class="w-24 text-gray-500">车牌:</dt>
          <dd class="text-gray-900 font-bold"><%= @reservation.vehicle.license_plate %></dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">类型:</dt>
          <dd class="text-gray-900"><%= @reservation.vehicle.vehicle_type %></dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">颜色:</dt>
          <dd class="text-gray-900"><%= @reservation.vehicle.color || 'N/A' %></dd>
        </div>
      </dl>
    </div>

    <div class="border p-4 rounded-lg">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">被访人信息</h3>
      <dl class="space-y-2">
        <div class="flex">
          <dt class="w-24 text-gray-500">姓名:</dt>
          <dd class="text-gray-900"><%= @reservation.host.name %></dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">部门:</dt>
          <dd class="text-gray-900"><%= @reservation.host.department.name %></dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">职位:</dt>
          <dd class="text-gray-900"><%= @reservation.host.position || 'N/A' %></dd>
        </div>
      </dl>
    </div>

    <div class="border p-4 rounded-lg">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">预约信息</h3>
      <dl class="space-y-2">
        <div class="flex">
          <dt class="w-24 text-gray-500">预约时段:</dt>
          <dd class="text-gray-900">
            <%= l(@reservation.scheduled_at, format: :long) %>
            <% if @reservation.scheduled_end_at %>
              - <%= l(@reservation.scheduled_end_at, format: :long) %>
            <% end %>
          </dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">入口:</dt>
          <dd class="text-gray-900"><%= @reservation.entrance.name %></dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">状态:</dt>
          <dd>
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
              <%= case @reservation.status
                  when 'pending' then 'bg-yellow-100 text-yellow-800'
                  when 'confirmed' then 'bg-green-100 text-green-800'
                  when 'rejected' then 'bg-red-100 text-red-800'
                  when 'expired' then 'bg-gray-100 text-gray-800'
                  else 'bg-gray-100 text-gray-800'
                  end %>">
              <%= Reservation.human_attribute_name("status.#{@reservation.status}") %>
            </span>
          </dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">事由:</dt>
          <dd class="text-gray-900"><%= @reservation.purpose %></dd>
        </div>
      </dl>
    </div>
  </div>

  <% if @visit_record %>
    <div class="mt-6 border p-4 rounded-lg">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">入离园信息</h3>
      <dl class="space-y-2">
        <div class="flex">
          <dt class="w-24 text-gray-500">入园时间:</dt>
          <dd class="text-gray-900">
            <%= @visit_record.actual_entry_at ? l(@visit_record.actual_entry_at, format: :long) : '未入园' %>
          </dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">入园入口:</dt>
          <dd class="text-gray-900"><%= @visit_record.entry_entrance&.name || 'N/A' %></dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">离园时间:</dt>
          <dd class="text-gray-900">
            <%= @visit_record.actual_exit_at ? l(@visit_record.actual_exit_at, format: :long) : '未离园' %>
          </dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">离园出口:</dt>
          <dd class="text-gray-900"><%= @visit_record.exit_entrance&.name || 'N/A' %></dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">停留时长:</dt>
          <dd class="text-gray-900"><%= @visit_record.stay_duration_formatted %></dd>
        </div>
        <div class="flex">
          <dt class="w-24 text-gray-500">当前状态:</dt>
          <dd>
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
              <%= case @visit_record.status
                  when 'pending_verification' then 'bg-yellow-100 text-yellow-800'
                  when 'pending_approval' then 'bg-orange-100 text-orange-800'
                  when 'approved' then 'bg-blue-100 text-blue-800'
                  when 'blocked' then 'bg-red-100 text-red-800'
                  when 'entered' then 'bg-green-100 text-green-800'
                  when 'exited' then 'bg-gray-100 text-gray-800'
                  else 'bg-gray-100 text-gray-800'
                  end %>">
              <%= VisitRecord.human_attribute_name("status.#{@visit_record.status}") %>
            </span>
          </dd>
        </div>
      </dl>
    </div>

    <div class="mt-6 border p-4 rounded-lg">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">历史节点</h3>
      <% if @visit_record.history_nodes.any? %>
        <div class="space-y-4">
          <% @visit_record.history_nodes.order(created_at: :asc).each do |node| %>
            <div class="flex items-start">
              <div class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-blue-500"></div>
              <div class="ml-4 flex-1">
                <div class="flex justify-between">
                  <span class="font-medium text-gray-900"><%= node.action %></span>
                  <span class="text-sm text-gray-500"><%= l(node.created_at, format: :long) %></span>
                </div>
                <div class="text-sm text-gray-500">
                  操作人: <%= node.actor_display_name %>
                </div>
                <% if node.notes %>
                  <div class="text-sm text-gray-600 mt-1"><%= node.notes %></div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500">暂无历史记录</p>
      <% end %>
    </div>
  <% else %>
    <% if @reservation.confirmed? %>
      <div class="mt-6 border p-4 rounded-lg bg-yellow-50">
        <p class="text-yellow-700">预约已确认，等待访客到达门岗进行核验</p>
      </div>
    <% end %>
  <% end %>
</div>
