<div class="mb-6 flex justify-between items-center">
  <h2 class="text-2xl font-bold text-gray-900">预约列表</h2>
  <%= link_to '新建预约', new_reservation_path, class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">访客</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">车牌</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">接待人</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">预约时间</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">入口</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @reservations.each do |reservation| %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm font-medium text-gray-900"><%= reservation.visitor.name %></div>
            <div class="text-sm text-gray-500"><%= reservation.visitor.phone %></div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm font-medium text-gray-900"><%= reservation.vehicle.license_plate %></div>
            <div class="text-sm text-gray-500"><%= reservation.vehicle.vehicle_type %></div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm font-medium text-gray-900"><%= reservation.host.name %></div>
            <div class="text-sm text-gray-500"><%= reservation.host.department.name %></div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm text-gray-900"><%= l(reservation.scheduled_at, format: :long) %></div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
              <%= case reservation.status
                  when 'pending' then 'bg-yellow-100 text-yellow-800'
                  when 'confirmed' then 'bg-green-100 text-green-800'
                  when 'rejected' then 'bg-red-100 text-red-800'
                  when 'expired' then 'bg-gray-100 text-gray-800'
                  else 'bg-gray-100 text-gray-800'
                  end %>">
              <%= Reservation.human_attribute_name("status.#{reservation.status}") %>
            </span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            <%= reservation.entrance.name %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
            <%= link_to '查看', reservation, class: "text-blue-600 hover:text-blue-900 mr-3" %>
            <% if reservation.pending? %>
              <%= button_to '确认', confirm_reservation_path(reservation), method: :post, class: "text-green-600 hover:text-green-900 mr-3" %>
              <%= button_to '拒绝', reject_reservation_path(reservation), method: :post, class: "text-red-600 hover:text-red-900" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
