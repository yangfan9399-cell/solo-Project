<div class="mb-6 flex justify-between items-center">
  <h2 class="text-2xl font-bold text-gray-900">黑名单管理</h2>
  <%= link_to '添加黑名单', new_blacklist_path, class: "bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700" %>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">车牌</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">原因</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">添加人</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">添加时间</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @blacklists.each do |blacklist| %>
        <tr class="<%= blacklist.is_active? ? '' : 'bg-gray-50' %>">
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm font-bold text-gray-900"><%= blacklist.license_plate %></div>
          </td>
          <td class="px-6 py-4">
            <div class="text-sm text-gray-900"><%= blacklist.reason %></div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm text-gray-900"><%= blacklist.added_by.name %></div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm text-gray-500"><%= l(blacklist.added_at, format: :long) %></div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
              <%= blacklist.is_active? ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %>">
              <%= blacklist.is_active? ? '有效' : '已移除' %>
            </span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
            <% if blacklist.is_active? %>
              <%= button_to '移除', blacklist, method: :delete, class: "text-green-600 hover:text-green-900" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
