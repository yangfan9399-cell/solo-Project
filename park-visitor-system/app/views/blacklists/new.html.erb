<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">添加黑名单</h2>

  <%= form_with(model: @blacklist, local: true, class: "space-y-6") do |form| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :license_plate, "车牌号", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :license_plate, placeholder: "如: 京A12345",
          class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3" %>
      </div>

      <div>
        <%= form.label :added_by_id, "添加人", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :added_by_id, Employee.order(:name), :id, :name,
          { prompt: "选择添加人" }, { class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3" } %>
      </div>

      <div>
        <%= form.label :added_at, "添加时间", class: "block text-sm font-medium text-gray-700" %>
        <%= form.datetime_local_field :added_at, value: Time.current.strftime("%Y-%m-%dT%H:%M"),
          class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3" %>
      </div>

      <div class="md:col-span-2">
        <%= form.label :reason, "原因", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_area :reason, rows: 3, placeholder: "请输入加入黑名单的原因",
          class: "mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3" %>
      </div>
    </div>

    <div class="flex justify-end gap-4">
      <%= link_to '取消', blacklists_path, class: "bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600" %>
      <%= form.submit '添加', class: "bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700" %>
    </div>
  <% end %>
</div>
