@model VeterinaryReviewViewModel
@{
    ViewData["Title"] = "兽医复核";
}

<div class="page-header">
    <h1>⚕️ 兽医复核病害报告</h1>
    <a asp-controller="Veterinary" asp-action="Index" class="btn btn-secondary">← 返回列表</a>
</div>

<div class="panel form-panel">
    <form asp-action="Review" method="post" class="form-container">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DiseaseReportId" />
        <input type="hidden" asp-for="CageId" />

        <div class="form-info-bar">
            <span>📍 网箱：<strong>@Model.CageCode</strong></span>
        </div>

        <div class="sub-section">
            <h4>📋 报告信息</h4>
            <div class="info-grid">
                <div class="info-item full-width">
                    <span class="info-label">症状描述</span>
                    <span class="info-value">@Model.Symptoms</span>
                </div>
                <div class="info-item">
                    <span class="info-label">死亡数量</span>
                    <span class="info-value text-danger">@Model.DeadFishCount 尾</span>
                </div>
                <div class="info-item">
                    <span class="info-label">异常数量</span>
                    <span class="info-value text-warning">@Model.AbnormalFishCount 尾</span>
                </div>
                <div class="info-item full-width">
                    <span class="info-label">病害照片</span>
                    <div class="photo-placeholder large">
                        <div class="photo-icon">📷</div>
                        <div class="photo-label">病害照片占位</div>
                    </div>
                </div>
            </div>
        </div>

        <hr />

        <div class="form-row">
            <div class="form-group">
                <label asp-for="VeterinarianId">兽医</label>
                <select asp-for="VeterinarianId" class="form-control">
                    @foreach (var vet in Model.Veterinarians)
                    {
                        <option value="@vet.Id">@vet.FullName</option>
                    }
                </select>
                <span asp-validation-for="VeterinarianId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" asp-for="IsConfirmed" />
                    <span>确认存在病害（不勾选则为驳回报告）</span>
                </label>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="DiagnosedDisease">诊断病名</label>
                <input asp-for="DiagnosedDisease" class="form-control" placeholder="如：白点病、弧菌病等" />
                <span asp-validation-for="DiagnosedDisease" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group full-width">
                <label asp-for="VeterinaryOpinion">兽医诊断意见</label>
                <textarea asp-for="VeterinaryOpinion" class="form-control" rows="4" placeholder="详细描述诊断结论..."></textarea>
                <span asp-validation-for="VeterinaryOpinion" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group full-width">
                <label asp-for="RecommendedTreatment">推荐治疗方案</label>
                <textarea asp-for="RecommendedTreatment" class="form-control" rows="4" placeholder="具体治疗措施、用药建议等..."></textarea>
                <span asp-validation-for="RecommendedTreatment" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">💾 提交复核结果</button>
            <a asp-controller="Cage" asp-action="Details" asp-route-id="@Model.CageId" class="btn btn-secondary">取消</a>
        </div>
    </form>
</div>

<div asp-validation-summary="All" class="text-danger"></div>
