@model IEnumerable<BorrowRequest>
@{
    ViewData["Title"] = "借用申请管理";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>借用申请管理</h4>
        <small class="text-muted">所有印章外借申请记录</small>
    </div>
    <a href="/BorrowRequest/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>新建申请
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>申请编号</th>
                        <th>印章</th>
                        <th>合同</th>
                        <th>借用人</th>
                        <th>部门</th>
                        <th>计划借用</th>
                        <th>计划归还</th>
                        <th>状态</th>
                        <th>异常</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model)
                    {
                        var overdueClass = req.IsOverdue && req.Status != BorrowStatus.Returned && req.Status != BorrowStatus.Cancelled ? "table-warning" : "";
                        <tr class="@overdueClass" onclick="location.href='/BorrowRequest/Details/@req.BorrowRequestId'" style="cursor:pointer">
                            <td><code>@req.RequestCode</code></td>
                            <td>
                                <div><strong>@req.Seal?.SealName</strong></div>
                                <small class="text-muted">@await Html.PartialAsync("_SealType", req.Seal?.SealType ?? SealType.CompanySeal)</small>
                            </td>
                            <td>
                                <div><small>@req.Contract?.ContractName</small></div>
                                <small class="text-muted">@req.Contract?.ContractCode</small>
                            </td>
                            <td>
                                <div>@req.Applicant?.UserName</div>
                                <small class="text-muted">@req.Applicant?.EmployeeId</small>
                            </td>
                            <td><span class="badge bg-light text-dark">@req.Applicant?.Department?.DepartmentName</span></td>
                            <td><small>@req.PlannedBorrowDate:yyyy-MM-dd</small></td>
                            <td>
                                <small>@req.PlannedReturnDate:yyyy-MM-dd</small>
                                @if (req.IsOverdue && req.Status != BorrowStatus.Returned && req.Status != BorrowStatus.Cancelled)
                                { <div><span class="badge bg-danger mt-1">已超期</span></div> }
                            </td>
                            <td onclick="event.stopPropagation()">@await Html.PartialAsync("_StatusBadge", req.Status)</td>
                            <td onclick="event.stopPropagation()">@await Html.PartialAsync("_ExceptionBadge", req.ExceptionReason)</td>
                            <td onclick="event.stopPropagation()">
                                <a href="/BorrowRequest/Details/@req.BorrowRequestId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
