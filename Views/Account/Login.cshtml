@{
    ViewData["Title"] = "登录";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3>设备点检系统 - 登录</h3>
            </div>
            <div class="card-body">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    
                    <div class="form-group">
                        <label asp-for="UserName">用户名</label>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Password">密码</label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">记住我</label>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100">登录</button>
                </form>
                
                <div class="mt-3 p-3 bg-light rounded">
                    <p class="text-muted">测试用户：</p>
                    <ul class="list-unstyled text-sm">
                        <li>操作工: <strong>operator</strong> / Password123!</li>
                        <li>班组长: <strong>teamleader</strong> / Password123!</li>
                        <li>维修员: <strong>maintenance</strong> / Password123!</li>
                        <li>设备工程师: <strong>engineer</strong> / Password123!</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>