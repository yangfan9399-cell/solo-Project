@model IEnumerable<RecordListViewModel>
@{
    ViewData["Title"] = "钻取结果";
    var title = ViewData["DrillTitle"] as string ?? "钻取结果";
    ViewData["Crumbs"] = $"首页 / <a href='{Url.Action("Index", "Review")}'>复盘统计</a> / {title}";
}

<div class="card">
    <div class="card-header">
        <h3>🔍 @title — 共 @Model.Count() 条</h3>
        <a class="btn btn-secondary btn-sm" href="@Url.Action("Index", "Review")">← 返回复盘</a>
    </div>
    <div class="card-body" style="padding:0;">
        <table>
            <thead>
                <tr>
                    <th>编号</th>
                    <th>标题 / 设备</th>
                    <th>借用人</th>
                    <th>分类</th>
                    <th>状态</th>
                    <th>摘要（含结论，与列表/详情共用同一份数据）</th>
                    <th>赔偿</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="row-no">@r.RecordNo</td>
                        <td>
                            <div class="row-title">@r.Title</div>
                            <div class="small muted">@r.EquipmentName</div>
                            @if (r.IsArchived) { <div style="margin-top:2px;"><span class="badge bg-success">已归档</span></div> }
                        </td>
                        <td>
                            <div>@r.BorrowerName</div>
                            <div class="small muted">@r.BorrowerDept</div>
                        </td>
                        <td><span class="badge @r.CategoryBadgeClass">@r.SampleCategoryText</span></td>
                        <td><span class="badge @r.StatusBadgeClass">@r.StatusText</span></td>
                        <td class="summary" style="max-width:420px;">
                            @r.Summary
                            @if (r.HasBlocking) { <div style="margin-top:6px;"><span class="block-tag">⚠ @r.BlockingReason</span></div> }
                        </td>
                        <td class="money">@(r.CompensationAmount > 0 ? "￥" + r.CompensationAmount?.ToString("F2") : "—")</td>
                        <td>
                            <a class="btn btn-sm btn-primary" href="@Url.Action("Detail", "Records", new { id = r.Id })">详情</a>
                            <a class="btn btn-sm btn-secondary" href="@Url.Action("Index", "Process", new { id = r.Id })">处理</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
