@model FuelApplication
@{
    ViewData["Title"] = "确认油样封存 - " + Model.ApplicationNumber;
}

<h1 class="page-title">🧪 确认油样封存</h1>

<div class="form-card">
    <div class="info-bar">
        <p><strong>申请编号：</strong>@Model.ApplicationNumber</p>
        <p><strong>船名：</strong>@Model.Ship?.Name</p>
        <p><strong>燃油类型：</strong>@Model.FuelType</p>
        <p><strong>实加量：</strong>@Model.ActualQuantity 吨</p>
    </div>

    <div class="alert alert-warning">
        ⚠️ 油样封存是结算的前提条件，请务必确认油样已按规定封存。
    </div>

    <form asp-action="ConfirmSample" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">轮机长姓名</label>
                <input name="chiefEngineerName" class="form-control" placeholder="请输入轮机长姓名" required />
            </div>
            <div class="form-group">
                <label class="form-label">油样编号</label>
                <input name="sampleNumber" class="form-control" placeholder="例如：SMP-20240115-001" required />
            </div>
        </div>

        <div class="form-actions">
            <a href="/FuelApplications/Details/@Model.Id" class="btn btn-outline">取消</a>
            <button type="submit" class="btn btn-warning" onclick="return confirm('确认油样已封存？')">确认封存</button>
        </div>
    </form>
</div>
