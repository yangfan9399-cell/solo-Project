@{
    Layout = "_Layout";
    ViewData["Title"] = "首页";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-primary mb-4">设备点检异常停机与维修确认系统</h1>
    <p class="lead text-muted mb-4">管理设备从点检异常、停机报修到维修复产的完整流程</p>
    
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h3 class="mb-4">功能特点</h3>
                    <ul class="list-unstyled text-start">
                        <li class="mb-3">
                            <strong>操作工</strong> - 提交设备点检异常
                        </li>
                        <li class="mb-3">
                            <strong>班组长</strong> - 确认停机，转维修工单
                        </li>
                        <li class="mb-3">
                            <strong>维修员</strong> - 处理故障，完成维修
                        </li>
                        <li class="mb-3">
                            <strong>设备工程师</strong> - 验收维修，确认复产
                        </li>
                    </ul>
                    <hr class="my-4"/>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
                        立即登录
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>