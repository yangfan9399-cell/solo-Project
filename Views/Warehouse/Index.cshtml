@{
    ViewData["Title"] = "仓库发货";
}

@model IEnumerable<Order>

<h2 style="margin-bottom:20px; color:#1a1a2e;">仓库发货管理</h2>

<div class="alert alert-info">
    <strong>💡 提示：</strong>以下订单已完成授信额度冻结，等待仓库确认发货。发货后冻结额度将转为已用额度，并生成对应应收账款。
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">待发货订单</h3>
        <span class="badge badge-frozen">@Model.Count() 笔</span>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted" style="text-align:center; padding:30px;">暂无待发货订单</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>订单号</th>
                    <th>经销商</th>
                    <th class="text-right">订单金额</th>
                    <th class="text-right">冻结额度</th>
                    <th>商品种类</th>
                    <th>财务员</th>
                    <th>冻结时间</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>@order.OrderNo</strong></td>
                        <td>@order.Dealer.Name</td>
                        <td class="text-right">@order.FinalAmount.ToString("C0")</td>
                        <td class="text-right" style="color:#fd7e14; font-weight:600;">@order.CreditFrozen.ToString("C0")</td>
                        <td>@order.Items.Count 种商品</td>
                        <td>@order.FinanceOperator</td>
                        <td>@order.CreditFrozenAt?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div style="display:flex; gap:6px;">
                                <a href="@Url.Action("Details", "Orders", new { id = order.Id })" class="btn btn-secondary btn-sm">详情</a>
                                <form asp-action="ConfirmShip" method="post">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('确认发货？发货后冻结额度将转为已用额度。')">
                                        确认发货
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:20px;">
    <a href="@Url.Action("BlockedOrders")" class="card" style="text-decoration:none; color:inherit; display:block; border-left:4px solid #dc3545;">
        <h3 class="card-title" style="color:#dc3545;">🚫 阻断发货订单</h3>
        <p class="text-muted">额度不足或异常导致无法发货的订单</p>
    </a>
    <div class="card" style="display:block; border-left:4px solid #28a745;">
        <h3 class="card-title" style="color:#28a745;">📦 发货操作说明</h3>
        <p class="text-muted" style="margin-bottom:8px;">1. 确认订单商品库存充足</p>
        <p class="text-muted" style="margin-bottom:8px;">2. 确认授信额度已正确冻结</p>
        <p class="text-muted">3. 点击确认发货完成操作</p>
    </div>
</div>
