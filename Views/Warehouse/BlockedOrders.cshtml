@{
    ViewData["Title"] = "阻断发货订单";
}

@model IEnumerable<Order>

<h2 style="margin-bottom:20px; color:#1a1a2e;">阻断发货订单</h2>

<div class="alert alert-warning">
    <strong>⚠️ 注意：</strong>以下订单因额度不足或其他异常原因被阻断发货，需要风控复核或经销商补足条件后方可继续。
</div>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>订单号</th>
                <th>经销商</th>
                <th>等级</th>
                <th class="text-right">订单金额</th>
                <th class="text-right">可用额度</th>
                <th class="text-right">差额</th>
                <th>异常原因</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                var credit = order.Dealer.CreditLimit;
                var available = credit.TotalCredit - credit.UsedCredit - credit.FrozenCredit;
                var diff = order.FinalAmount - available;

                <tr>
                    <td><strong>@order.OrderNo</strong></td>
                    <td>@order.Dealer.Name</td>
                    <td>
                        <span class="badge badge-level-@order.Dealer.Level.ToString().ToLower()">@order.Dealer.Level级</span>
                    </td>
                    <td class="text-right">@order.FinalAmount.ToString("C0")</td>
                    <td class="text-right" style="color:#dc3545; font-weight:600;">@available.ToString("C0")</td>
                    <td class="text-right" style="color:#dc3545;">@diff.ToString("C0")</td>
                    <td>
                        <span class="badge badge-exception">额度不足</span>
                    </td>
                    <td>
                        <a href="@Url.Action("Details", "Orders", new { id = order.Id })" class="btn btn-secondary btn-sm">查看详情</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="card">
    <h3 class="card-title" style="margin-bottom:15px;">💡 处理建议</h3>
    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px;">
        <div class="suggestion-card" style="margin-bottom:0;">
            <h5>方案一：回款补足</h5>
            <p>经销商先回款补足差额，财务确认到账后释放额度，订单可继续发货。</p>
            <span class="badge badge-completed">推荐方案</span>
        </div>
        <div class="suggestion-card" style="margin-bottom:0;">
            <h5>方案二：缩单发货</h5>
            <p>减少订单商品数量或金额，使订单总额在可用额度范围内，部分发货。</p>
            <span class="badge badge-frozen">备选方案</span>
        </div>
        <div class="suggestion-card" style="margin-bottom:0;">
            <h5>方案三：临时提额</h5>
            <p>风控审核通过后，临时增加经销商授信额度，订单可继续发货。</p>
            <span class="badge badge-submitted">特殊方案</span>
        </div>
    </div>
</div>
