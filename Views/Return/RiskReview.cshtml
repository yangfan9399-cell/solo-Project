@model (BorrowRequest request, ReturnViewModel form)
@{
    ViewData["Title"] = "风控复核";
    var req = Model.request;
    var form = Model.form;
}

<div class="mb-4">
    <a href="/Return/PendingRisk" class="text-muted text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i>返回待复核列表
    </a>
</div>

<h4 class="mb-4"><i class="bi bi-shield-check me-2 text-warning"></i>风控复核 - @req.RequestCode</h4>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">基本信息</div>
            <div class="card-body small">
                <div class="mb-2">
                    <div class="detail-label">印章</div>
                    <div class="fw-bold">@req.Seal?.SealName</div>
                </div>
                <div class="mb-2">
                    <div class="detail-label">借用人</div>
                    <div>@req.Applicant?.UserName (@req.Applicant?.Department?.DepartmentName)</div>
                </div>
                <div class="mb-2">
                    <div class="detail-label">合同</div>
                    <div>@req.Contract?.ContractName</div>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <div class="detail-label">借用时间</div>
                        <div>@(req.ActualBorrowDate?.ToString("MM-dd HH:mm") ?? "-")</div>
                    </div>
                    <div class="col-6">
                        <div class="detail-label">归还时间</div>
                        <div>@(req.ActualReturnDate?.ToString("MM-dd HH:mm") ?? "-")</div>
                    </div>
                </div>
                <div class="mt-3 p-2 bg-light rounded text-center">
                    <div class="detail-label">借用时长</div>
                    <div class="h3 mb-0 text-primary fw-bold">@req.BorrowDuration <small class="h6">天</small></div>
                    @if (req.ActualReturnDate > req.PlannedReturnDate)
                    {
                        <span class="badge bg-danger mt-1">
                            超期 @((((DateTime?)req.ActualReturnDate - req.PlannedReturnDate)?.Days) ?? 0) 天
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">申请的用印范围</div>
            <div class="card-body">
                <div class="card card-body bg-light py-2 small h-100">
                    @req.UsageScope
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-danger">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle me-1"></i>系统检测异常
            </div>
            <div class="card-body">
                @if (req.ExceptionReason == ExceptionReason.None)
                {
                    <div class="text-center py-4">
                        <i class="bi bi-check2-circle display-4 text-success"></i>
                        <div class="mt-2">暂未检测到异常</div>
                        <div class="small text-muted">请人工进一步核对用印范围</div>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="fw-bold">异常类型：</label>
                        @await Html.PartialAsync("_ExceptionBadge", req.ExceptionReason)
                    </div>
                    @if (!string.IsNullOrEmpty(req.ExceptionDescription))
                    {
                        <div class="mb-2">
                            <label class="fw-bold">异常描述：</label>
                            <div class="text-danger small">@req.ExceptionDescription</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="card border-warning">
    <div class="card-header bg-warning text-dark">
        <i class="bi bi-pencil-square me-2"></i>风控复核意见
    </div>
    <div class="card-body">
        <form asp-action="RiskReview" method="post">
            <input type="hidden" asp-for="form.BorrowRequestId" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3 form-check">
                <input type="checkbox" name="hasException" id="hasException" class="form-check-input" value="true"
                       @(req.ExceptionReason != ExceptionReason.None ? "checked" : "") />
                <label class="form-check-label fw-bold" for="hasException">
                    <i class="bi bi-exclamation-triangle me-1 text-danger"></i>
                    存在异常情况（用印范围不符/印章损坏等），需标记异常
                </label>
            </div>

            <div id="exceptionPanel" style="@(req.ExceptionReason != ExceptionReason.None ? "" : "display:none")">
                <div class="mb-3 ms-4">
                    <label class="form-label fw-bold">异常类型</label>
                    <select asp-for="form.ExceptionReason" class="form-select">
                        <option value="">-- 请选择异常类型 --</option>
                        <option value="1">合同缺失</option>
                        <option value="2">超期未还</option>
                        <option value="3">用印范围不符</option>
                        <option value="4">印章损坏</option>
                        <option value="99">其他</option>
                    </select>
                    <span asp-validation-for="form.ExceptionReason" class="text-danger"></span>
                </div>
                <div class="mb-3 ms-4">
                    <label class="form-label fw-bold">异常详细描述</label>
                    <textarea asp-for="form.ExceptionDescription" class="form-control" rows="3" placeholder="请详细描述异常情况，包括：超出范围的文件名称/数量、印章损坏情况等..."></textarea>
                    <span asp-validation-for="form.ExceptionDescription" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">复核备注</label>
                <textarea asp-for="form.ReturnRemark" class="form-control" rows="3" placeholder="请填写风控复核意见、整改要求、后续处理建议等..."></textarea>
                <span asp-validation-for="form.ReturnRemark" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning px-4">
                    <i class="bi bi-check-lg me-1"></i>完成复核
                </button>
                <a href="/Return/PendingRisk" class="btn btn-outline-secondary px-4">取消</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('hasException').addEventListener('change', function() {
            document.getElementById('exceptionPanel').style.display = this.checked ? '' : 'none';
        });
    </script>
}
