@model IEnumerable<BorrowRequest>
@{
    ViewData["Title"] = "待风控复核";
}

<div class="mb-4">
    <h4 class="mb-0"><i class="bi bi-shield-check me-2 text-warning"></i>风控复核</h4>
    <small class="text-muted">归还后风控部门进行最终核验</small>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>申请编号</th>
                        <th>印章</th>
                        <th>借用人</th>
                        <th>归还日期</th>
                        <th>借用时长</th>
                        <th>初步异常</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model)
                    {
                        <tr>
                            <td><code>@req.RequestCode</code></td>
                            <td>
                                <div><strong>@req.Seal?.SealName</strong></div>
                                <small class="text-muted">@req.Seal?.SealCode</small>
                            </td>
                            <td>
                                <div>@req.Applicant?.UserName</div>
                                <small class="text-muted">@req.Applicant?.Department?.DepartmentName</small>
                            </td>
                            <td><small>@(req.ActualReturnDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</small></td>
                            <td><strong>@req.BorrowDuration 天</strong></td>
                            <td>
                                @if (req.ExceptionReason == ExceptionReason.None)
                                {
                                    <span class="badge bg-success">暂未发现</span>
                                }
                                else
                                {
                                    @await Html.PartialAsync("_ExceptionBadge", req.ExceptionReason)
                                }
                            </td>
                            <td>
                                <a href="/Return/RiskReview/@req.BorrowRequestId" class="btn btn-sm btn-warning">
                                    <i class="bi bi-shield-check me-1"></i>复核
                                </a>
                                <a href="/BorrowRequest/Details/@req.BorrowRequestId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5"><i class="bi bi-check2-circle me-1"></i>暂无待复核记录</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
