@{
    ViewData["Title"] = "风控复核";
}

@model Order

@{
    var credit = Model.Dealer.CreditLimit;
    var available = credit.TotalCredit - credit.UsedCredit - credit.FrozenCredit;
}

<h2 style="margin-bottom:20px; color:#1a1a2e;">风控复核 - @Model.OrderNo</h2>

<div class="alert alert-danger">
    <strong>⚠️ 异常类型：</strong>@GetExceptionText(Model.ExceptionType)
    <br />
    <strong>异常原因：</strong>@Model.ExceptionReason
</div>

<div class="order-detail-grid">
    <div class="card">
        <h4 style="margin-bottom:15px; color:#1a1a2e;">订单信息</h4>
        <div class="info-item">
            <span class="info-label">订单号：</span>
            <span class="info-value">@Model.OrderNo</span>
        </div>
        <div class="info-item">
            <span class="info-label">经销商：</span>
            <span class="info-value">@Model.Dealer.Name</span>
        </div>
        <div class="info-item">
            <span class="info-label">经销商等级：</span>
            <span class="badge badge-level-@Model.Dealer.Level.ToString().ToLower()">@Model.Dealer.Level级</span>
        </div>
        <div class="info-item">
            <span class="info-label">订单金额：</span>
            <span class="info-value highlight">@Model.FinalAmount.ToString("C0")</span>
        </div>
        <div class="info-item">
            <span class="info-label">销售员：</span>
            <span class="info-value">@Model.SalesPerson</span>
        </div>
    </div>

    <div class="card">
        <h4 style="margin-bottom:15px; color:#1a1a2e;">授信情况</h4>
        <div class="info-item">
            <span class="info-label">总额度：</span>
            <span class="info-value">@credit.TotalCredit.ToString("C0")</span>
        </div>
        <div class="info-item">
            <span class="info-label">已用额度：</span>
            <span class="info-value">@credit.UsedCredit.ToString("C0")</span>
        </div>
        <div class="info-item">
            <span class="info-label">冻结额度：</span>
            <span class="info-value warning">@credit.FrozenCredit.ToString("C0")</span>
        </div>
        <div class="info-item">
            <span class="info-label">可用额度：</span>
            <span class="info-value @(available < 0 ? "danger" : "success")">@available.ToString("C0")</span>
        </div>
        <div class="info-item">
            <span class="info-label">账期：</span>
            <span class="info-value">@credit.PaymentDays 天</span>
        </div>
    </div>

    <div class="card full-width">
        <h4 style="margin-bottom:15px; color:#1a1a2e;">复核处理</h4>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
            <div>
                <form asp-action="Approve" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="form-group">
                        <label>处理方案</label>
                        <select name="resolution" required>
                            <option value="">请选择处理方案</option>
                            @if (Model.ExceptionType == ExceptionType.InsufficientCredit)
                            {
                                <option value="临时提额">临时提额放行</option>
                                <option value="回款确认">确认已回款补足</option>
                                <option value="缩单调整">缩单后放行</option>
                                <option value="特殊审批">特殊审批通过</option>
                            }
                            @if (Model.ExceptionType == ExceptionType.OverdueDebt)
                            {
                                <option value="确认回款">确认逾期欠款已结清</option>
                                <option value="部分回款">部分回款后放行</option>
                                <option value="特殊审批">特殊审批通过</option>
                            }
                            @if (Model.ExceptionType == ExceptionType.PricePolicyConflict)
                            {
                                <option value="政策例外">价格政策例外审批</option>
                                <option value="调价执行">按标准价执行</option>
                                <option value="组合达标">组合其他商品达标</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>复核意见</label>
                        <textarea name="comment" placeholder="请输入复核意见..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-success btn-block" onclick="return confirm('确认复核通过？订单将重新进入处理流程。')">
                        ✅ 复核通过
                    </button>
                </form>
            </div>

            <div>
                <form asp-action="Reject" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="form-group">
                        <label>驳回原因</label>
                        <textarea name="comment" placeholder="请输入驳回原因..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger btn-block" style="margin-top:42px;" onclick="return confirm('确认驳回该订单？订单将被取消。')">
                        ❌ 复核驳回
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (Model.Dealer.Debts != null && Model.Dealer.Debts.Any(d => d.IsOverdue && !d.IsPaid))
    {
        <div class="card full-width">
            <h4 style="margin-bottom:15px; color:#dc3545;">逾期欠款明细</h4>
            <table>
                <thead>
                    <tr>
                        <th>欠款描述</th>
                        <th class="text-right">金额</th>
                        <th>到期日</th>
                        <th>逾期天数</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var debt in Model.Dealer.Debts.Where(d => d.IsOverdue && !d.IsPaid).OrderBy(d => d.DueDate))
                    {
                        <tr class="debt-overdue">
                            <td>@debt.Description</td>
                            <td class="text-right">@debt.Amount.ToString("C0")</td>
                            <td>@debt.DueDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span style="color:#dc3545; font-weight:600;">@debt.OverdueDays 天</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="font-weight:600; background:#fff5f5;">
                        <td class="text-right">合计逾期：</td>
                        <td class="text-right" style="color:#dc3545;">
                            @Model.Dealer.Debts.Where(d => d.IsOverdue && !d.IsPaid).Sum(d => d.Amount).ToString("C0")
                        </td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    <div class="card full-width">
        <h4 style="margin-bottom:15px; color:#1a1a2e;">订单商品明细</h4>
        <table>
            <thead>
                <tr>
                    <th>商品名称</th>
                    <th>分类</th>
                    <th class="text-right">标准价</th>
                    <th class="text-right">优惠价</th>
                    <th class="text-right">数量</th>
                    <th class="text-right">金额</th>
                    <th>适用政策</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><strong>@item.Product.Name</strong></td>
                        <td>@item.Product.Category</td>
                        <td class="text-right">@item.UnitPrice.ToString("C0")</td>
                        <td class="text-right" style="color:#e94560;">@item.DiscountPrice.ToString("C0")</td>
                        <td class="text-right">@item.Quantity</td>
                        <td class="text-right"><strong>@item.Amount.ToString("C0")</strong></td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.PricePolicyName))
                            {
                                <span class="badge badge-frozen">@item.PricePolicyName</span>
                            }
                            else
                            {
                                <span class="text-muted">标准价</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div style="margin-top:20px;">
    <a href="@Url.Action("Index")" class="btn btn-secondary">返回列表</a>
    <a href="@Url.Action("Details", "Orders", new { id = Model.Id })" class="btn btn-primary">查看完整详情</a>
</div>

@functions {
    string GetExceptionText(ExceptionType type)
    {
        return type switch
        {
            ExceptionType.None => "无",
            ExceptionType.InsufficientCredit => "额度不足",
            ExceptionType.OverdueDebt => "逾期欠款",
            ExceptionType.PricePolicyConflict => "价格政策冲突",
            _ => type.ToString()
        };
    }
}
