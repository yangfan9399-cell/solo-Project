@model AnomalyReportViewModel
@{
    ViewData["Title"] = "异常上报";
    var orNurses = ViewData["OrNurses"] as List<User>;
}

<h1 class="page-title">异常上报</h1>

<div class="dashboard-card">
    <div class="alert alert-warning">
        <strong>器械包信息：</strong>
        <code>@Model.SetCode</code> - @Model.SetName
    </div>

    <form asp-controller="Operations" asp-action="ReportAnomaly" method="post" class="form-styled">
        <input type="hidden" asp-for="InstrumentSetId" />
        <input type="hidden" asp-for="SetCode" />
        <input type="hidden" asp-for="SetName" />

        <div class="form-grid">
            <div class="form-group">
                <label>异常类型 *</label>
                <select asp-for="AnomalyType" class="form-control">
                    <option value="@AnomalyType.MissingItems">器械缺件</option>
                    <option value="@AnomalyType.WrongDepartment">科室错领</option>
                    <option value="@AnomalyType.SterilizationExpired">灭菌过期</option>
                    <option value="@AnomalyType.Damaged">器械损坏</option>
                    <option value="@AnomalyType.Other">其他异常</option>
                </select>
            </div>
            <div class="form-group">
                <label>上报人 *</label>
                <select asp-for="ReportedByUserId" class="form-control">
                    @if (orNurses != null)
                    {
                        @foreach (var user in orNurses)
                        {
                            <option value="@user.Id">@user.Name (@user.EmployeeId)</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group form-group-full">
                <label>异常描述 *</label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="请详细描述异常情况..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-warning btn-lg">提交异常</button>
            <a asp-controller="InstrumentSets" asp-action="Details" asp-route-id="@Model.InstrumentSetId" class="btn btn-outline btn-lg">取消</a>
        </div>
    </form>
</div>
