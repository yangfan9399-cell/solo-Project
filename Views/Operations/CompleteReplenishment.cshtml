@model CompleteReplenishmentViewModel
@{
    ViewData["Title"] = Model.CanCompleteReplenishment ? "补包完成确认" : "补包 - 不可操作";
}

<h1 class="page-title">
    @if (Model.CanCompleteReplenishment)
    {
        <text>补包完成确认</text>
    }
    else
    {
        <text>补包操作 <span style="color: var(--danger-color); font-size: 1rem;">(不可执行)</span></text>
    }
</h1>

<div class="detail-grid">
    <div class="detail-main">
        <div class="dashboard-card">
            <h2 class="card-title">器械包信息</h2>
            <div class="info-grid">
                <div class="info-item">
                    <label>编号</label>
                    <div class="info-value"><code>@Model.SetCode</code></div>
                </div>
                <div class="info-item">
                    <label>名称</label>
                    <div class="info-value"><strong>@Model.SetName</strong></div>
                </div>
                <div class="info-item">
                    <label>所属科室</label>
                    <div class="info-value">@Model.DepartmentName</div>
                </div>
                <div class="info-item">
                    <label>当前状态</label>
                    <div class="info-value">
                        <span class="status-badge @GetStatusClass(Model.CurrentStatus)">
                            @GetStatusText(Model.CurrentStatus)
                        </span>
                    </div>
                </div>
                @if (Model.CanCompleteReplenishment)
                {
                    <div class="info-item">
                        <label>缺件上报时间</label>
                        <div class="info-value">@Model.ReportedAt.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                }
            </div>
        </div>

        <div class="dashboard-card">
            <h2 class="card-title">
                @if (Model.CanCompleteReplenishment)
                {
                    <text>待补齐器械清单</text>
                    <span class="badge badge-warning">共 @Model.MissingItems.Count 种，缺 @Model.TotalMissingCount 件</span>
                }
                else
                {
                    <text>器械清单</text>
                    @if (Model.MissingItems.Any())
                    {
                        <span class="badge badge-warning">缺 @Model.TotalMissingCount 件</span>
                    }
                    else
                    {
                        <span class="badge badge-success">器械齐全</span>
                    }
                }
            </h2>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>器械名称</th>
                            <th>应有数量</th>
                            <th>实有数量</th>
                            @if (Model.CanCompleteReplenishment)
                            {
                                <th>需补齐</th>
                                <th>补包后</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MissingItems.Any())
                        {
                            @foreach (var item in Model.MissingItems)
                            {
                                var missing = item.ExpectedQuantity - item.ActualQuantity;
                                <tr class="row-danger">
                                    <td><strong>@item.InstrumentName</strong></td>
                                    <td>@item.ExpectedQuantity</td>
                                    <td><span class="text-danger"><strong>@item.ActualQuantity</strong></span></td>
                                    @if (Model.CanCompleteReplenishment)
                                    {
                                        <td><span class="badge badge-danger">+@missing</span></td>
                                        <td><span class="badge badge-success">@item.ExpectedQuantity (齐全)</span></td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align: center; color: var(--gray-500); padding: 2rem;">
                                    暂无缺件器械
                                </td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.MissingItems.Any())
                    {
                        <tfoot>
                            <tr>
                                <td><strong>合计</strong></td>
                                <td><strong>@Model.MissingItems.Sum(i => i.ExpectedQuantity)</strong></td>
                                <td><strong>@Model.MissingItems.Sum(i => i.ActualQuantity)</strong></td>
                                @if (Model.CanCompleteReplenishment)
                                {
                                    <td><strong class="text-danger">@Model.TotalMissingCount 件</strong></td>
                                    <td></td>
                                }
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    <div class="detail-side">
        @if (Model.CanCompleteReplenishment)
        {
            <div class="dashboard-card">
                <h2 class="card-title">补包完成确认</h2>
                <div class="alert alert-info">
                    <strong>请确认：</strong>
                    <ul style="margin: 0.5rem 0 0 1.25rem; padding: 0;">
                        <li>所有缺件器械已补齐</li>
                        <li>器械检查无误</li>
                        <li>补包后器械数量与应有数量一致</li>
                    </ul>
                </div>

                <form asp-controller="Operations" asp-action="CompleteReplenishment" method="post" class="form-styled">
                    <input type="hidden" asp-for="InstrumentSetId" />
                    <input type="hidden" asp-for="SetCode" />
                    <input type="hidden" asp-for="SetName" />
                    <input type="hidden" asp-for="DepartmentName" />
                    <input type="hidden" asp-for="TotalMissingCount" />
                    <input type="hidden" asp-for="ReportedAt" />

                    <div asp-validation-summary="All" class="alert alert-danger" style="margin-bottom: 1rem;">
                        <strong>操作无法继续：</strong>
                    </div>

                    <div class="form-group">
                        <label>补包操作人 *</label>
                        <select asp-for="CompletedByUserId" class="form-control">
                            @if (Model.SupplyStaff != null)
                            {
                                @foreach (var user in Model.SupplyStaff)
                                {
                                    <option value="@user.Id">@user.Name (@user.EmployeeId)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>处理说明</label>
                        <textarea asp-for="ResolutionNotes" class="form-control" rows="3" placeholder="补包处理说明（可选）"></textarea>
                    </div>

                    <div class="form-group">
                        <label>备注</label>
                        <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="其他备注（可选）"></textarea>
                    </div>

                    <div class="form-actions" style="flex-direction: column;">
                        <button type="submit" class="btn btn-success btn-lg" style="width: 100%;">
                            ✓ 确认补包完成
                        </button>
                        <a asp-controller="InstrumentSets" asp-action="Details" asp-route-id="@Model.InstrumentSetId" class="btn btn-outline" style="width: 100%;">
                            返回详情
                        </a>
                    </div>
                </form>
            </div>

            <div class="dashboard-card">
                <h2 class="card-title">补包后状态变化</h2>
                <div style="display: flex; align-items: center; justify-content: space-around; padding: 1rem 0;">
                    <div style="text-align: center;">
                        <span class="status-badge status-missing" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">缺件</span>
                        <div style="font-size: 0.75rem; color: var(--gray-500); margin-top: 0.25rem;">当前状态</div>
                    </div>
                    <div style="font-size: 1.5rem; color: var(--gray-400);">→</div>
                    <div style="text-align: center;">
                        <span class="status-badge status-replenished" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">已补包</span>
                        <div style="font-size: 0.75rem; color: var(--gray-500); margin-top: 0.25rem;">补包后状态</div>
                    </div>
                </div>
                <p class="text-muted" style="font-size: 0.8125rem; text-align: center; margin: 0;">
                    补包完成后，所有缺件器械数量将更新为应有数量，异常记录将标记为已解决。
                </p>
            </div>
        }
        else
        {
            <div class="dashboard-card card-danger">
                <h2 class="card-title">
                    <span style="margin-right: 0.5rem;">🚫</span>
                    不可补包
                </h2>
                <div class="alert alert-danger" style="margin-bottom: 1rem;">
                    <strong>当前器械包无法执行补包操作：</strong>
                </div>

                <ul style="margin: 0 0 1rem 1.25rem; padding: 0; color: var(--danger-color);">
                    @foreach (var reason in Model.BlockReasons)
                    {
                        <li style="margin-bottom: 0.375rem;">@reason</li>
                    }
                </ul>

                <a asp-controller="InstrumentSets" asp-action="Details" asp-route-id="@Model.InstrumentSetId" class="btn btn-outline" style="width: 100%;">
                    返回详情页
                </a>
            </div>

            <div class="dashboard-card">
                <h2 class="card-title">当前状态</h2>
                <div style="text-align: center; padding: 1.5rem 0;">
                    <span class="status-badge @GetStatusClass(Model.CurrentStatus)" style="font-size: 1rem; padding: 0.75rem 1.25rem;">
                        @GetStatusText(Model.CurrentStatus)
                    </span>
                    <div style="font-size: 0.8125rem; color: var(--gray-500); margin-top: 0.75rem;">
                        器械包当前真实状态
                    </div>
                </div>
                <div class="info-list">
                    <div class="info-item">
                        <label>器械包</label>
                        <div class="info-value">@Model.SetName</div>
                    </div>
                    <div class="info-item">
                        <label>编号</label>
                        <div class="info-value"><code>@Model.SetCode</code></div>
                    </div>
                    <div class="info-item">
                        <label>所属科室</label>
                        <div class="info-value">@Model.DepartmentName</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    string GetStatusClass(InstrumentSetStatus status)
    {
        return status switch
        {
            InstrumentSetStatus.ReadyForUse => "status-ready",
            InstrumentSetStatus.InUse => "status-inuse",
            InstrumentSetStatus.MissingItems => "status-missing",
            InstrumentSetStatus.Expired => "status-expired",
            InstrumentSetStatus.WrongDepartment => "status-wrong",
            InstrumentSetStatus.Sterilized => "status-sterilized",
            InstrumentSetStatus.Packed => "status-packed",
            InstrumentSetStatus.Replenished => "status-replenished",
            InstrumentSetStatus.Returned => "status-returned",
            _ => "status-default"
        };
    }

    string GetStatusText(InstrumentSetStatus status)
    {
        return status switch
        {
            InstrumentSetStatus.Packed => "已打包",
            InstrumentSetStatus.Sterilized => "已灭菌",
            InstrumentSetStatus.ReadyForUse => "可使用",
            InstrumentSetStatus.InUse => "使用中",
            InstrumentSetStatus.Returned => "已退回",
            InstrumentSetStatus.MissingItems => "缺件",
            InstrumentSetStatus.Expired => "灭菌过期",
            InstrumentSetStatus.WrongDepartment => "科室错领",
            InstrumentSetStatus.Replenished => "已补包",
            InstrumentSetStatus.Quarantine => "待处理",
            _ => status.ToString()
        };
    }
}
