<h2 style="font-size:1.25rem;font-weight:600;margin-bottom:1.5rem;">编辑报修工单 #<%= @repair_request.id %></h2>

<div class="card">
  <%= form_with model: @repair_request, local: true do |f| %>
    <div class="grid grid-2">
      <div class="form-group">
        <label>原房间</label>
        <%= f.select :original_room_id, options_from_collection_for_select(@rooms, :id, :display_name, @repair_request.original_room_id) %>
      </div>
      <div class="form-group">
        <label>维修类别</label>
        <%= f.select :repair_category, RepairRequest::REPAIR_CATEGORIES.map { |c| [c.humanize, c] }, selected: @repair_request.repair_category %>
      </div>
    </div>

    <div class="form-group">
      <label>维修原因</label>
      <%= f.text_area :repair_reason, rows: 3 %>
    </div>

    <div class="grid grid-2">
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:0.5rem;">
          <%= f.check_box :needs_transfer %> 需要转房
        </label>
      </div>
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:0.5rem;">
          <%= f.check_box :needs_compensation %> 需要补偿
        </label>
      </div>
    </div>

    <div style="display:flex;gap:0.5rem;margin-top:1rem;">
      <%= f.submit "更新工单", class: "btn btn-primary" %>
      <%= link_to "取消", @repair_request, class: "btn btn-outline" %>
    </div>
  <% end %>
</div>
