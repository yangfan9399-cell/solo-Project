<div class="sign-in-container">
  <h1>🏨 酒店维修审批系统</h1>
  <div class="card">
    <%= form_with url: session_path, method: :post do |f| %>
      <div class="form-group">
        <label>邮箱</label>
        <%= f.email_field :email, placeholder: "请输入邮箱", required: true %>
      </div>
      <div class="form-group">
        <label>密码</label>
        <%= f.password_field :password, placeholder: "请输入密码", required: true %>
      </div>
      <%= f.submit "登录", class: "btn btn-primary", style: "width:100%;justify-content:center;margin-top:0.5rem;" %>
    <% end %>
  </div>
  <p style="text-align:center;font-size:0.8125rem;color:var(--gray-500);">
    预置账号：前台 front_desk@hotel.com / 值班经理 manager@hotel.com<br>密码均为 password
  </p>
</div>
