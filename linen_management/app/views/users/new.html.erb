<% content_for :title, "新增用户" %>

<div class="page-header">
  <h1 class="page-title">新增用户</h1>
  <%= link_to "返回列表", users_path, class: "btn btn-secondary" %>
</div>

<div class="card">
  <% if @user.errors.any? %>
    <div class="form-errors">
      <h4>表单有以下错误：</h4>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user do |form| %>
    <div class="form-group">
      <%= form.label :name, "用户名", class: "form-label" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= form.label :role, "角色", class: "form-label" %>
      <%= form.select :role, options_for_select(User::ROLES.map { |r| [I18n.t("roles.#{r}", default: r.humanize), r] }), { include_blank: "请选择角色" }, class: "form-select" %>
    </div>
    <div class="btn-group">
      <%= form.submit "保存", class: "btn btn-primary" %>
      <%= link_to "取消", users_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
