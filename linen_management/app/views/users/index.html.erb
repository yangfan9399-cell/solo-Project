<% content_for :title, "用户管理 - 布草洗涤管理系统" %>

<div class="page-header">
  <h1 class="page-title">用户管理</h1>
  <%= link_to "新增用户", new_user_path, class: "btn btn-primary" %>
</div>

<% if @users.any? %>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>用户名</th>
          <th>角色</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= link_to user.name, user %></td>
            <td><span class="badge badge-info"><%= user.role_name %></span></td>
            <td>
              <div class="btn-group">
                <%= link_to "查看", user, class: "btn btn-outline btn-sm" %>
                <%= link_to "编辑", edit_user_path(user), class: "btn btn-outline btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">👤</div>
    <p>暂无用户记录</p>
    <%= link_to "添加第一个用户", new_user_path, class: "btn btn-primary" %>
  </div>
<% end %>
