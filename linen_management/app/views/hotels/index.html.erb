<% content_for :title, "酒店管理 - 布草洗涤管理系统" %>

<div class="page-header">
  <h1 class="page-title">酒店管理</h1>
  <%= link_to "新增酒店", new_hotel_path, class: "btn btn-primary" %>
</div>

<% if @hotels.any? %>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>酒店名称</th>
          <th>地址</th>
          <th>联系人</th>
          <th>电话</th>
          <th>批次数量</th>
          <th>累计赔损</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @hotels.each do |hotel| %>
          <tr>
            <td><%= link_to hotel.name, hotel %></td>
            <td><%= hotel.address %></td>
            <td><%= hotel.contact_person %></td>
            <td><%= hotel.phone %></td>
            <td><%= hotel.batch_count %></td>
            <td class="amount-negative">¥<%= number_with_precision hotel.total_damage_amount, precision: 2 %></td>
            <td>
              <div class="btn-group">
                <%= link_to "查看", hotel, class: "btn btn-outline btn-sm" %>
                <%= link_to "编辑", edit_hotel_path(hotel), class: "btn btn-outline btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">🏨</div>
    <p>暂无酒店记录</p>
    <%= link_to "添加第一个酒店", new_hotel_path, class: "btn btn-primary" %>
  </div>
<% end %>
