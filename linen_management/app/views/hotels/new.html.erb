<% content_for :title, "新增酒店" %>

<div class="page-header">
  <h1 class="page-title">新增酒店</h1>
  <%= link_to "返回列表", hotels_path, class: "btn btn-secondary" %>
</div>

<div class="card">
  <% if @hotel.errors.any? %>
    <div class="form-errors">
      <h4>表单有以下错误：</h4>
      <ul>
        <% @hotel.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @hotel do |form| %>
    <div class="form-group">
      <%= form.label :name, "酒店名称", class: "form-label" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= form.label :address, "地址", class: "form-label" %>
      <%= form.text_field :address, class: "form-control" %>
    </div>
    <div class="form-row">
      <div class="form-group">
        <%= form.label :contact_person, "联系人", class: "form-label" %>
        <%= form.text_field :contact_person, class: "form-control" %>
      </div>
      <div class="form-group">
        <%= form.label :phone, "联系电话", class: "form-label" %>
        <%= form.text_field :phone, class: "form-control" %>
      </div>
    </div>
    <div class="btn-group">
      <%= form.submit "保存", class: "btn btn-primary" %>
      <%= link_to "取消", hotels_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
