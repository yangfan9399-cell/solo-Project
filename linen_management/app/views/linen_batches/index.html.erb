<% content_for :title, "批次管理 - 布草洗涤管理系统" %>

<div class="page-header">
  <h1 class="page-title">布草批次管理</h1>
  <%= link_to "新建批次", new_linen_batch_path, class: "btn btn-primary" %>
</div>

<div class="filter-bar">
  <%= form_tag linen_batches_path, method: :get do %>
    <div class="filter-item">
      <label class="form-label">状态</label>
      <%= select_tag :status, options_for_select(LinenBatch::STATUSES.map { |s| [I18n.t("batch_statuses.#{s}", default: s.humanize), s] }, params[:status]), include_blank: "全部状态", class: "form-select" %>
    </div>
    <div class="filter-item">
      <label class="form-label">酒店</label>
      <%= select_tag :hotel_id, options_from_collection_for_select(@hotels, :id, :name, params[:hotel_id]), include_blank: "全部酒店", class: "form-select" %>
    </div>
    <div class="filter-item" style="align-self: end;">
      <%= submit_tag "筛选", class: "btn btn-primary" %>
      <%= link_to "重置", linen_batches_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>

<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>批次号</th>
        <th>酒店</th>
        <th>状态</th>
        <th>交接数量</th>
        <th>返还数量</th>
        <th>问题数量</th>
        <th>赔损金额</th>
        <th>创建时间</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @linen_batches.each do |batch| %>
        <tr>
          <td><%= link_to batch.batch_number, batch %></td>
          <td><%= batch.hotel.name %></td>
          <td><span class="badge badge-<%= batch.status %>"><%= batch.status_name %></span></td>
          <td><%= batch.total_quantity_handed %></td>
          <td><%= batch.total_quantity_returned %></td>
          <td>
            <% if batch.has_quality_issues? || batch.has_shortage? %>
              <span class="amount-negative">
                <%= batch.total_quantity_stained + batch.total_quantity_damaged + batch.total_quantity_short %> 件
              </span>
            <% else %>
              <span class="amount-positive">正常</span>
            <% end %>
          </td>
          <td>¥<%= number_with_precision batch.total_damage_amount, precision: 2 %></td>
          <td><%= batch.created_at.strftime('%Y-%m-%d %H:%M') %></td>
          <td>
            <div class="btn-group">
              <%= link_to "查看", batch, class: "btn btn-outline btn-sm" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @linen_batches.none? %>
  <div class="empty-state">
    <div class="empty-state-icon">📋</div>
    <p>暂无批次记录</p>
    <%= link_to "创建第一个批次", new_linen_batch_path, class: "btn btn-primary" %>
  </div>
<% end %>
