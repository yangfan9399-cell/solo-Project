<% content_for :title, "布草类型 - 布草洗涤管理系统" %>

<div class="page-header">
  <h1 class="page-title">布草类型管理</h1>
  <%= link_to "新增类型", new_linen_type_path, class: "btn btn-primary" %>
</div>

<% if @linen_types.any? %>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>名称</th>
          <th>类别</th>
          <th>单价</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @linen_types.each do |lt| %>
          <tr>
            <td><%= link_to lt.name, lt %></td>
            <td><%= lt.category_name %></td>
            <td>¥<%= number_with_precision lt.unit_price, precision: 2 %></td>
            <td>
              <div class="btn-group">
                <%= link_to "查看", lt, class: "btn btn-outline btn-sm" %>
                <%= link_to "编辑", edit_linen_type_path(lt), class: "btn btn-outline btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">🧺</div>
    <p>暂无布草类型</p>
    <%= link_to "添加第一个类型", new_linen_type_path, class: "btn btn-primary" %>
  </div>
<% end %>
